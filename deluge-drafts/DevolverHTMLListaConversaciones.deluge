string Calendario52HTML.DevolverHTMLListaConversaciones()
{
	convs = Conversaci_n[T_cnico != 0];
	rows = "";
	cnt_ = 0;
	for each  conv in convs
	{
		if(cnt_ < 50)
		{
			cnt_ = cnt_ + 1;
			tecId = conv.T_cnico;
			tecRec = Nuevo_Empleado[ID == tecId];
			fn = ifnull(tecRec.Nombre.first_name,"");
			ln = ifnull(tecRec.Nombre.last_name,"");
			tecNombre = (fn + " " + ln).trim();
			ini_ = if(fn != "",fn.substring(0,1),"") + if(ln != "",ln.substring(0,1),"");
			ini = if(ini_ == "","?",ini_);
			msgId = conv.ltimo_Mensaje;
			preview = "Sin mensajes";
			timeStr = "";
			autorPfx = "";
			if(msgId != null && msgId != 0)
			{
				msgRec = Mensaje[ID == msgId];
				cont = ifnull(msgRec.Contenido,"");
				preview = if(cont.length() > 55,cont.substring(0,52) + "...",cont);
				fh = msgRec.Fecha_Hora;
				timeStr = if(fh.toString("dd-MM-yyyy") == zoho.currentdate.toString("dd-MM-yyyy"),fh.toString("HH:mm"),fh.toString("dd/MM"));
				autorPfx = if(msgRec.Es_Respuesta == "SI","Tú: ","");
			}
			unread = conv.Mensajes_no_le_dos;
			badge = if(unread != null && unread > 0,"<span style='background:#2563eb;color:#fff;border-radius:50%;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;padding:0 4px;flex-shrink:0'>" + unread + "</span>","");
			c = ifnull(tecId,0).toLong() % 8;
			bg = if(c==0,"#1C3A5E",if(c==1,"#0f766e",if(c==2,"#6d28d9",if(c==3,"#c2410c",if(c==4,"#047857",if(c==5,"#1d4ed8",if(c==6,"#7c3aed","#b45309")))))));
			rows = rows + "<a href='#Page:Chat_RRHH?TecnicoNo=" + tecId + "' style='display:flex;align-items:center;padding:12px 16px;text-decoration:none;color:inherit;border-bottom:1px solid #f0f0f0;gap:12px;background:#fff'><div style='width:46px;height:46px;border-radius:50%;background:" + bg + ";display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;color:#fff;flex-shrink:0'>" + ini + "</div><div style='flex:1;min-width:0'><div style='display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3px'><span style='font-weight:600;font-size:14px;color:#1a1a2e'>" + tecNombre + "</span><span style='font-size:11px;color:#888;flex-shrink:0;margin-left:8px'>" + timeStr + "</span></div><div style='display:flex;align-items:center;justify-content:space-between;gap:8px'><span style='font-size:13px;color:#666;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1'><span style='color:#1C3A5E;font-weight:500'>" + autorPfx + "</span>" + preview + "</span>" + badge + "</div></div></a>";
		}
	}
}
	if(rows == "")
	{
		return "<div style='font-family:Arial,sans-serif;padding:30px;text-align:center;color:#777'>No hay conversaciones aún.</div>";
	}
	return "<div style='font-family:Arial,sans-serif;max-width:700px;margin:0 auto;border:1px solid #ddd;border-radius:10px;overflow:hidden'><div style='background:#1C3A5E;color:#fff;padding:14px 18px;font-weight:700;font-size:16px'>&#128172; Mensajes de Empleados</div><div style='background:#fff'>" + rows + "</div></div>";
}
