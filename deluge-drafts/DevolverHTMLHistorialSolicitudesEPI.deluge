// Función: Calendario52HTML.DevolverHTMLHistorialSolicitudesEPI
// Página: Historial_Solicitudes_EPI (módulo RRHH, solo gestores)
// KPIs: Total, Pendientes, Gestionadas, Rechazadas
// Filtros CSS-only: Todas / Sin Respuesta / En Gestión / Aprobadas·Entregadas / Rechazadas
// Tabla: Empleado | Tipo | Equipo | Fecha | Estado | Acción
// Filtro fecha: últimos 3 meses (para evitar límite de statements)

string Calendario52HTML.DevolverHTMLHistorialSolicitudesEPI()
{
    // --- CSS ---
    css = "<style>" +
        "*{box-sizing:border-box;margin:0;padding:0}" +
        "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}" +
        ".wrap{max-width:1400px;margin:0 auto;padding:20px}" +
        ".hdr{background:#1C3A5E;color:#fff;padding:18px 24px;border-radius:12px;margin-bottom:20px}" +
        ".hdr h1{font-size:20px;font-weight:700;margin-bottom:2px}" +
        ".hdr p{font-size:13px;opacity:.7}" +
        ".kg{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}" +
        ".kc{background:#fff;border-radius:12px;padding:18px 16px;border-left:4px solid #cbd5e0}" +
        ".kc b{display:block;font-size:34px;font-weight:800;line-height:1;margin-bottom:6px}" +
        ".kc span{font-size:10px;color:#718096;text-transform:uppercase;letter-spacing:.6px}" +
        ".k-blue{border-left-color:#3182ce}.k-blue b{color:#3182ce}" +
        ".k-orange{border-left-color:#dd6b20}.k-orange b{color:#dd6b20}" +
        ".k-green{border-left-color:#38a169}.k-green b{color:#38a169}" +
        ".k-red{border-left-color:#e53e3e}.k-red b{color:#e53e3e}" +
        "input[type=radio]{display:none}" +
        ".flt{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}" +
        ".flt label{padding:7px 16px;border-radius:20px;font-size:13px;font-weight:600;cursor:pointer;border:2px solid #e2e8f0;color:#4a5568;background:#fff}" +
        ".flt label:hover{border-color:#3182ce;color:#3182ce}" +
        "#f0:checked~.wrap .flt label[for=f0],#f1:checked~.wrap .flt label[for=f1],#f2:checked~.wrap .flt label[for=f2],#f3:checked~.wrap .flt label[for=f3],#f4:checked~.wrap .flt label[for=f4]{background:#1C3A5E;color:#fff;border-color:#1C3A5E}" +
        "#f1:checked~.wrap .htbl tbody tr:not(.is-sin){display:none}" +
        "#f2:checked~.wrap .htbl tbody tr:not(.is-ges){display:none}" +
        "#f3:checked~.wrap .htbl tbody tr:not(.is-apro){display:none}" +
        "#f4:checked~.wrap .htbl tbody tr:not(.is-rech){display:none}" +
        ".htbl{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0}" +
        ".htbl th{background:#1C3A5E;color:#fff;padding:10px 14px;font-size:12px;text-align:left;font-weight:600;white-space:nowrap}" +
        ".htbl td{padding:10px 14px;font-size:13px;color:#2d3748;border-bottom:1px solid #f0f0f0;vertical-align:middle}" +
        ".htbl tr:last-child td{border-bottom:none}" +
        ".htbl tr:hover td{background:#f8fafc}" +
        ".htbl .eq{max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" +
        ".bd{padding:3px 10px;border-radius:10px;font-size:11px;font-weight:700;white-space:nowrap;display:inline-block}" +
        ".bb{background:#ebf8ff;color:#2b6cb0}" +
        ".bp{background:#faf5ff;color:#6b46c1}" +
        ".bg{background:#f0fff4;color:#276749}" +
        ".bo{background:#fffaf0;color:#c05621}" +
        ".br{background:#fff5f5;color:#c53030}" +
        ".bx{background:#f7fafc;color:#4a5568}" +
        ".bt{background:#e6fffa;color:#2c7a7b}" +
        ".btn{display:inline-block;padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;background:#ebf8ff;color:#2b6cb0;white-space:nowrap}" +
        ".btn:hover{background:#bee3f8}" +
        ".nota{font-size:12px;color:#718096;margin-bottom:12px}" +
        ".empty{text-align:center;padding:40px;color:#a0aec0;font-size:14px}" +
        "@media(max-width:768px){.kg{grid-template-columns:repeat(2,1fr)}.htbl td:nth-child(3),.htbl th:nth-child(3){display:none}}" +
        "</style>";

    // --- Loop: KPIs + filas tabla ---
    nTot = 0; nPend = 0; nGes = 0; nApro = 0; nRech = 0;
    rows = "";
    fechaLimite = zoho.currentdate.subMonth(3);

    for each s in Solicitud_de_EPIs_Herramientas[Added_Time > fechaLimite]
    {
        ap = ifnull(s.Aprobado, "Sin Respuesta");
        nTot = nTot + 1;

        // Contadores KPI
        if(ap == "Rechazado") { nRech = nRech + 1; }
        else if(ap == "Gestionándose") { nGes = nGes + 1; }
        else if(ap == "Sin Respuesta") { nPend = nPend + 1; }
        else { nApro = nApro + 1; }

        // Clases CSS para filtros
        fCls = if(ap == "Rechazado", "is-rech", if(ap == "Gestionándose", "is-ges", if(ap == "Sin Respuesta", "is-sin", "is-apro")));

        // Badge estado
        bdEst = if(ap == "Rechazado", "br", if(ap == "Sin Respuesta", "bx", if(ap == "Gestionándose", "bo", if(ap == "Aprobado", "bb", if(ap == "Entregado", "bt", "bg")))));

        // Badge tipo
        tipo = ifnull(s.Tipo_de_equipo_solicitado, "—");
        bdTipo = if(tipo == "EPI", "bb", if(tipo == "ROPA", "bp", "bg"));

        // Nombre empleado via lookup directo
        fn = ifnull(s.Trabajador_Solicitante.Nombre.first_name, "");
        ln = ifnull(s.Trabajador_Solicitante.Nombre.last_name, "");
        empNom = if(fn + ln == "", "—", ln + ", " + fn);

        fec = if(s.Added_Time != null, s.Added_Time.toString("dd/MM/yyyy"), "—");
        eq = ifnull(s.Equipo_Solicitado, "—");

        rows = rows + "<tr class='" + fCls + "'>" +
            "<td>" + empNom + "</td>" +
            "<td><span class='bd " + bdTipo + "'>" + tipo + "</span></td>" +
            "<td class='eq'>" + eq + "</td>" +
            "<td>" + fec + "</td>" +
            "<td><span class='bd " + bdEst + "'>" + ap + "</span></td>" +
            "<td><a class='btn' href='#Form:Responder_Solicitud_EPI?Solicitud_a_la_que_se_responde1=" + s.ID + "'>Responder</a></td>" +
            "</tr>";
    }

    if(rows == "") { rows = "<tr><td colspan='6' class='empty'>No hay solicitudes en los &#250;ltimos 3 meses</td></tr>"; }

    // --- Ensamblaje ---
    html = css +
        "<input type='radio' id='f0' name='f' checked>" +
        "<input type='radio' id='f1' name='f'>" +
        "<input type='radio' id='f2' name='f'>" +
        "<input type='radio' id='f3' name='f'>" +
        "<input type='radio' id='f4' name='f'>" +
        "<div class='wrap'>" +
        "<div class='hdr'><h1>&#128230; Historial Solicitudes EPI / Herramientas</h1><p>&#250;ltimos 3 meses &#183; " + nTot + " solicitudes</p></div>" +
        "<div class='kg'>" +
        "<div class='kc k-blue'><b>" + nTot + "</b><span>Total</span></div>" +
        "<div class='kc k-orange'><b>" + (nPend + nGes) + "</b><span>Pendientes</span></div>" +
        "<div class='kc k-green'><b>" + nApro + "</b><span>Aprobadas / Entregadas</span></div>" +
        "<div class='kc k-red'><b>" + nRech + "</b><span>Rechazadas</span></div>" +
        "</div>" +
        "<div class='flt'>" +
        "<label for='f0'>Todas</label>" +
        "<label for='f1'>Sin Respuesta</label>" +
        "<label for='f2'>En Gesti&#243;n</label>" +
        "<label for='f3'>Aprobadas / Entregadas</label>" +
        "<label for='f4'>Rechazadas</label>" +
        "</div>" +
        "<p class='nota'>Mostrando solicitudes de los &#250;ltimos 3 meses. Para ver registros m&#225;s antiguos, use el reporte <a href='#Report:Solicitudes_de_EPIs_Herramientas_Report'>Solicitud de EPI - Herramienta</a>.</p>" +
        "<table class='htbl'>" +
        "<thead><tr><th>Empleado</th><th>Tipo</th><th>Equipo Solicitado</th><th>Fecha</th><th>Estado</th><th>Acci&#243;n</th></tr></thead>" +
        "<tbody>" + rows + "</tbody>" +
        "</table>" +
        "</div>";

    return html;
}
