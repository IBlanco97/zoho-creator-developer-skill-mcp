void NuevoEmpleado.NotificarBajaEmpleado(int empId)
{
	empFound = 0;
	for each emp in Nuevo_Empleado[ID == empId]
	{
		empRec = emp;
		empFound = 1;
		break;
	}
	if(empFound == 0)
	{
		return;
	}
	nombreCompleto = empRec.Nombre.first_name + " " + empRec.Nombre.last_name;
	titulo = "Baja de Empleado - " + nombreCompleto;
	fechaBaja = zoho.currentdate.toString("dd/MM/yyyy");
	personal = List();
	doWhatsApp = false;
	doEmail = false;
	for each cfg in Configuraci_n_General[ID != 0]
	{
		for each uID in cfg.Usuarios_a_Notificar_Baja_de_un_Empleado
		{
			u = Usuario1[ID == uID];
			personal.add(u.Registro_de_Empleado);
		}
		vias = cfg.V_as_de_Notificaci_n_Baja_de_un_Empleado.toString();
		doWhatsApp = vias.contains("WhatsApp");
		doEmail = vias.contains("Correo Electrónico");
		break;
	}
	if(personal.size() > 0)
	{
		msg = "<p style='margin:0 0 16px;color:#334155;font-size:14px;'>El siguiente empleado <strong>ha pasado a estado Inactivo-Baja</strong> en el sistema de RRHH.</p>";
		msg = msg + "<table style='width:100%;border-collapse:collapse;font-size:13px;margin:0 0 20px;'>";
		msg = msg + "<tr style='background-color:#f8fafc;'><td style='padding:10px 14px;font-weight:600;color:#475569;width:38%;border-bottom:1px solid #e2e8f0;'>Empleado</td><td style='padding:10px 14px;color:#1e293b;font-weight:600;border-bottom:1px solid #e2e8f0;'>" + nombreCompleto + "</td></tr>";
		msg = msg + "<tr><td style='padding:10px 14px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;'>DNI / NIE</td><td style='padding:10px 14px;color:#1e293b;border-bottom:1px solid #e2e8f0;'>" + empRec.DNI + "</td></tr>";
		if(empRec.Puesto_laboral_actual != 0)
		{
			msg = msg + "<tr style='background-color:#f8fafc;'><td style='padding:10px 14px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;'>Puesto</td><td style='padding:10px 14px;color:#1e293b;border-bottom:1px solid #e2e8f0;'>" + empRec.Puesto_laboral_actual + "</td></tr>";
		}
		msg = msg + "<tr><td style='padding:10px 14px;font-weight:600;color:#475569;border-bottom:1px solid #e2e8f0;'>Fecha de baja</td><td style='padding:10px 14px;color:#1e293b;border-bottom:1px solid #e2e8f0;'>" + fechaBaja + "</td></tr>";
		if(empRec.Nota_en_caso_de_baja != "")
		{
			msg = msg + "<tr style='background-color:#f8fafc;'><td style='padding:10px 14px;font-weight:600;color:#475569;'>Motivo / Nota</td><td style='padding:10px 14px;color:#1e293b;'>" + empRec.Nota_en_caso_de_baja + "</td></tr>";
		}
		msg = msg + "</table>";
		msg = msg + "<p style='margin:0;font-size:12px;color:#94a3b8;'>Aviso generado automáticamente al registrar el cambio de estado en el sistema de RRHH.</p>";
		thisapp.FuncionesEstaticas.Notificacion(titulo,msg,personal,"Employee_Details",empId,doWhatsApp,doEmail);
	}
}
