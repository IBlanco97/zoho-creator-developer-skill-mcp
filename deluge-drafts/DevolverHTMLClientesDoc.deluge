string Calendario52HTML.DevolverHTMLClientesDoc()
{
	cardsH = "";
	n_all = 0;
	n_docs = 0;
	n_prob = 0;
	n_cad = 0;
	n_ok = 0;
	for each c in Nuevo_Cliente[Nombre_de_Cuenta != ""]
	{
		n_all = n_all + 1;
		n_docs = n_docs + if(c.ContadorTotal > 0, 1, 0);
		n_prob = n_prob + if(c.ContadorCaducados > 0 || c.ContadorPendietesSubir > 0 || c.ContadorNoEnviados > 0, 1, 0);
		n_cad = n_cad + if(c.ContadorCaducados > 0, 1, 0);
		n_ok = n_ok + if(c.ContadorTotal > 0 && c.ContadorNoEnviados == 0 && c.ContadorCaducados == 0 && c.ContadorPendietesSubir == 0 && c.ContadorEnviadosNoAprobados == 0, 1, 0);
		cardsH = cardsH + "<div class='card " + if(c.ContadorCaducados > 0 || c.ContadorPendietesSubir > 0 || c.ContadorNoEnviados > 0, "st-r is-prob" + if(c.ContadorCaducados > 0, " is-cad", ""), if(c.ContadorEnviadosNoAprobados > 0, "st-o", if(c.ContadorTotal > 0 && c.ContadorNoEnviados == 0 && c.ContadorCaducados == 0 && c.ContadorPendietesSubir == 0 && c.ContadorEnviadosNoAprobados == 0, "st-g is-ok", "st-x"))) + if(c.ContadorTotal > 0, " has-docs", "") + "'><div class='c-head'><span class='c-name'>" + c.Nombre_de_Cuenta + "</span><span class='c-badge " + if(c.ContadorCaducados > 0 || c.ContadorPendietesSubir > 0 || c.ContadorNoEnviados > 0, "br", if(c.ContadorEnviadosNoAprobados > 0, "bo", if(c.ContadorTotal > 0 && c.ContadorNoEnviados == 0 && c.ContadorCaducados == 0 && c.ContadorPendietesSubir == 0, "bg", "bx"))) + "'>" + if(c.ContadorCaducados > 0 || c.ContadorPendietesSubir > 0 || c.ContadorNoEnviados > 0, if(c.ContadorCaducados > 0, "Caducados", "Pendiente"), if(c.ContadorEnviadosNoAprobados > 0, "En revision", if(c.ContadorTotal > 0 && c.ContadorNoEnviados == 0 && c.ContadorCaducados == 0 && c.ContadorPendietesSubir == 0, "Validado", "Sin docs"))) + "</span></div>" + if(c.CIF != "", "<div class='c-meta'>" + c.CIF + if(c.Tel_fono != "", " \xb7 " + c.Tel_fono, "") + "</div>", "");
		cardsH = cardsH + "<div class='c-kpis'><span class='kp kx'><b>" + c.ContadorTotal + "</b><span>Total</span></span><span class='kp " + if(c.ContadorPendietesSubir > 0, "kr", "kx") + "'><b>" + c.ContadorPendietesSubir + "</b><span>P.Subir</span></span><span class='kp " + if(c.ContadorActualizados > 0, "kg", "kx") + "'><b>" + c.ContadorActualizados + "</b><span>Actual.</span></span><span class='kp " + if(c.ContadorCaducados > 0, "kr", "kx") + "'><b>" + c.ContadorCaducados + "</b><span>Cad.</span></span><span class='kp " + if(c.ContadorCercaCaducar > 0, "ky", "kx") + "'><b>" + c.ContadorCercaCaducar + "</b><span>Prox.</span></span><span class='kp " + if(c.ContadorNoEnviados > 0, "kr", "kx") + "'><b>" + c.ContadorNoEnviados + "</b><span>No Env.</span></span><span class='kp " + if(c.ContadorEnviadosNoAprobados > 0, "ko", "kx") + "'><b>" + c.ContadorEnviadosNoAprobados + "</b><span>Env.</span></span><span class='kp " + if(c.ContadorEnviadosAprobados > 0, "kb", "kx") + "'><b>" + c.ContadorEnviadosAprobados + "</b><span>Valid.</span></span></div>";
		cardsH = cardsH + "<div class='c-act'><a class='btn bv' href='#Page:Documentaci_n_del_Cliente?ClienteID=" + c.ID + "'>Ver Docs</a>" + if(c.ContadorNoEnviados > 0 || c.ContadorPendietesSubir > 0, "<a class='btn be' href='#Report:Ver_Clientes'>Enviar</a>", "") + if(c.ContadorEnviadosNoAprobados > 0, "<a class='btn bva' href='#Report:Ver_Clientes'>Validar</a>", "") + "</div></div>";
	}
	css = "<style>*{box-sizing:border-box;margin:0;padding:0;}.cdp{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;padding:16px;min-height:100vh;}.cdp input[type=radio]{display:none;}.stats{display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;}.sc{background:white;border-radius:10px;padding:14px 18px;flex:1;min-width:100px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.08);}.sc b{display:block;font-size:26px;font-weight:700;line-height:1;}.sc span{display:block;font-size:10px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-top:4px;}.s0 b{color:#1C3A5E;}.s1 b{color:#718096;}.s2 b{color:#e53e3e;}.s3 b{color:#c53030;}.s4 b{color:#38a169;}.fb{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}.fb label{cursor:pointer;padding:7px 16px;border-radius:20px;font-size:13px;font-weight:500;background:white;color:#555;border:1px solid #ddd;transition:all .2s;user-select:none;}.fb label:hover{border-color:#1C3A5E;color:#1C3A5E;}#f0:checked~.fb label[for=f0],#f1:checked~.fb label[for=f1],#f2:checked~.fb label[for=f2],#f3:checked~.fb label[for=f3],#f4:checked~.fb label[for=f4]{background:#1C3A5E;color:white;border-color:#1C3A5E;}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px;}.card{background:white;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.08);border-left:4px solid #cbd5e0;display:flex;flex-direction:column;}.st-r{border-left-color:#e53e3e;}.st-o{border-left-color:#dd6b20;}.st-g{border-left-color:#38a169;}.st-x{border-left-color:#a0aec0;}.c-head{padding:10px 12px 6px;display:flex;align-items:flex-start;gap:8px;}.c-name{font-size:12px;font-weight:700;color:#1a202c;line-height:1.3;flex:1;}.c-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:12px;white-space:nowrap;flex-shrink:0;margin-top:1px;}.br{background:#fff5f5;color:#c53030;}.bo{background:#fffaf0;color:#c05621;}.bg{background:#f0fff4;color:#276749;}.bx{background:#f7fafc;color:#718096;}.c-meta{padding:0 12px 6px;font-size:10px;color:#999;}.c-kpis{padding:8px 12px;background:#f7fafc;display:flex;flex-wrap:wrap;gap:4px;border-top:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;}.kp{display:inline-flex;flex-direction:column;align-items:center;min-width:40px;padding:3px;gap:1px;}.kp b{font-size:15px;font-weight:700;display:block;}.kp span{font-size:8px;color:#999;text-transform:uppercase;letter-spacing:.2px;display:block;}.kr b{color:#e53e3e;}.ko b{color:#dd6b20;}.kg b{color:#38a169;}.ky b{color:#d69e2e;}.kb b{color:#3182ce;}.kx b{color:#a0aec0;}.c-act{padding:8px 12px;display:flex;gap:6px;flex-wrap:wrap;}.btn{font-size:11px;font-weight:600;padding:4px 10px;border-radius:5px;text-decoration:none;background:#edf2f7;color:#4a5568;display:inline-block;}.bv{background:#ebf8ff;color:#2b6cb0;}.be{background:#fff5f5;color:#c53030;}.bva{background:#f0fff4;color:#276749;}#f1:checked~.cards .card{display:none;}#f1:checked~.cards .has-docs{display:flex;}#f2:checked~.cards .card{display:none;}#f2:checked~.cards .is-prob{display:flex;}#f3:checked~.cards .card{display:none;}#f3:checked~.cards .is-cad{display:flex;}#f4:checked~.cards .card{display:none;}#f4:checked~.cards .is-ok{display:flex;}</style>";
	html = css + "<div class='cdp'><input type='radio' id='f0' name='f' checked><input type='radio' id='f1' name='f'><input type='radio' id='f2' name='f'><input type='radio' id='f3' name='f'><input type='radio' id='f4' name='f'><div class='stats'><div class='sc s0'><b>" + n_all + "</b><span>Total Clientes</span></div><div class='sc s1'><b>" + n_docs + "</b><span>Con Docs</span></div><div class='sc s2'><b>" + n_prob + "</b><span>Con Problemas</span></div><div class='sc s3'><b>" + n_cad + "</b><span>Caducados</span></div><div class='sc s4'><b>" + n_ok + "</b><span>Validados</span></div></div>";
	html = html + "<div class='fb'><label for='f0'>Todos (" + n_all + ")</label><label for='f1'>Con Docs (" + n_docs + ")</label><label for='f2'>Con Problemas (" + n_prob + ")</label><label for='f3'>Caducados (" + n_cad + ")</label><label for='f4'>Validados (" + n_ok + ")</label></div><div class='cards'>" + cardsH + "</div></div>";
	return html;
}
