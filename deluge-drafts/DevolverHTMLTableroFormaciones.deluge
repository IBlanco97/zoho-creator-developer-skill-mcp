string Calendario52HTML.DevolverHTMLTableroFormaciones()
{
	// ── 1. KPI aggregation ──
	hoy = zoho.currentdate;
	anioStr = hoy.getYear().toString();
	inicioAnio = toDate("01-Jan-" + anioStr);
	d30 = hoy.addDay(30);
	totalAnio = 0;
	proximas30 = 0;
	tecConv = 0;
	inversionAnio = 0.0;

	// ── 2. Cards HTML (single pass) ──
	cardsH = "";
	for each f in Formaci_n[ID != 0]
	{
		fIni = f.Fecha_de_Comienzo;
		fFin = f.Fecha_de_Fin;
		fPre = ifnull(f.Precio, 0);
		fDur = ifnull(f.Duraci_n, 0);
		fTit = ifnull(f.T_tulo, "Sin t&iacute;tulo");
		// KPI counters
		if(fIni >= inicioAnio)
		{
			totalAnio = totalAnio + 1;
			inversionAnio = inversionAnio + fPre.toDecimal();
			tc_ = 0;
			for each tid in f.T_cnicos_a_convocar
			{
				tc_ = tc_ + 1;
			}
			tecConv = tecConv + tc_;
		}
		if(fIni > hoy && fIni <= d30)
		{
			proximas30 = proximas30 + 1;
		}
		// Estado badge
		est = "pasada";
		el = "Finalizada";
		ec = "bx";
		if(fIni > hoy)
		{
			est = "proxima";
			el = "Pr&oacute;xima";
			ec = "bb";
		}
		else if(fFin != null && fFin >= hoy)
		{
			est = "en-curso";
			el = "En Curso";
			ec = "bg";
		}
		// Tech avatars (max 5 + extra)
		avH = "";
		ac_ = 0;
		ax_ = 0;
		for each tid in f.T_cnicos_a_convocar
		{
			ac_ = ac_ + 1;
			if(ac_ <= 5)
			{
				ti_ = "?";
				for each tr in Nuevo_Empleado[ID == tid]
				{
					fn2_ = ifnull(tr.Nombre.first_name, "");
					ln2_ = ifnull(tr.Nombre.last_name, "");
					ti_ = if(fn2_ != "", fn2_.subString(0, 1).toUpperCase(), "?");
					if(ln2_ != "")
					{
						ti_ = ti_ + ln2_.subString(0, 1).toUpperCase();
					}
					break;
				}
				cb_ = ac_ % 6;
				bg_ = if(cb_ == 0, "#3182ce", if(cb_ == 1, "#38a169", if(cb_ == 2, "#e53e3e", if(cb_ == 3, "#dd6b20", if(cb_ == 4, "#805ad5", "#319795")))));
				avH = avH + "<i class='av' style='background:" + bg_ + "'>" + ti_ + "</i>";
			}
			else
			{
				ax_ = ax_ + 1;
			}
		}
		if(ax_ > 0)
		{
			avH = avH + "<i class='av ax'>+" + ax_.toString() + "</i>";
		}
		if(ac_ == 0)
		{
			avH = "<span class='nd'>Sin t&eacute;cnicos asignados</span>";
		}
		// Meta fields
		cenId_ = ifnull(f.Centro_Formativo, 0);
		cen_ = if(cenId_ != 0, ifnull(f.Centro_Formativo.Nombre_del_Centro,""), "");
		sedId_ = ifnull(f.Sede_Centro_Formativo, 0);
		sed_ = if(sedId_ != 0, ifnull(f.Sede_Centro_Formativo.Nombre_del_Centro,""), "");
		locStr = if(cen_ != "", cen_, "");
		if(sed_ != "" && sed_ != cen_)
		{
			locStr = locStr + if(locStr != "", " &middot; ", "") + sed_;
		}
		if(locStr == "")
		{
			locStr = "Sin sede";
		}
		preStr = if(fPre > 0, fPre.toString() + " &euro;", "&mdash;");
		durStr = if(fDur > 0, fDur.toString() + " h", "&mdash;");
		finiStr = ifnull(fIni.toString("dd/MM/yyyy HH:mm"), "");
		ffinStr = if(fFin != null, " &rarr; " + fFin.toString("dd/MM/yyyy"), "");
		cardsH = cardsH + "<div class='fc' data-estado='" + est + "'><div class='fh'><span class='badge " + ec + "'>" + el + "</span><div class='ft'>" + fTit + "</div></div><div class='fm'><div class='fi'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='4' width='18' height='18' rx='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg><span>" + finiStr + ffinStr + "</span></div><div class='fi'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg><span>" + durStr + "</span><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' style='margin-left:10px'><line x1='12' y1='1' x2='12' y2='23'/><path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'/></svg><span>" + preStr + "</span></div><div class='fi'><svg width='13' height='13' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z'/><polyline points='9 22 9 12 15 12 15 22'/></svg><span>" + locStr + "</span></div></div><div class='favs'>" + avH + "</div></div>";
	}
	if(cardsH == "")
	{
		cardsH = "<div class='empty'><svg width='40' height='40' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><rect x='3' y='4' width='18' height='18' rx='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg><div>No hay formaciones registradas</div></div>";
	}
	// ── 3. CSS ──
	invStr = if(inversionAnio > 0, inversionAnio.round(0).toString() + " &euro;", "&mdash;");
	css = "<style>*{box-sizing:border-box;margin:0;padding:0}.tf{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;min-height:100vh}.hdr{background:linear-gradient(135deg,#1C3A5E 0%,#2d5a8e 100%);padding:24px 28px;color:#fff}.ht{font-size:22px;font-weight:800;margin-bottom:2px}.hs{font-size:13px;opacity:.7;margin-bottom:18px}.hk{display:flex;gap:12px;flex-wrap:wrap}.hki{background:rgba(255,255,255,.12);border-radius:10px;padding:10px 16px;min-width:90px;text-align:center}.hki b{display:block;font-size:26px;font-weight:800}.hki span{font-size:11px;opacity:.8;text-transform:uppercase;letter-spacing:.4px}.k-b b{color:#63b3ed}.k-o b{color:#f6ad55}.k-g b{color:#68d391}.k-t b{color:#81e6d9}.cnt{padding:20px 24px}.acts{display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap}.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none}.btn-p{background:#1C3A5E;color:#fff}.btn-s{background:#fff;color:#4a5568;border:1px solid #e2e8f0}input[name=flt]{display:none}input[name=flt]+label{display:inline-block;padding:6px 14px;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid #e2e8f0;background:#fff;color:#718096;margin-right:6px;margin-bottom:12px}input[name=flt]:checked+label{background:#1C3A5E;color:#fff;border-color:#1C3A5E}#fa:checked~.cards .fc{display:block}#fp:checked~.cards .fc{display:none}#fp:checked~.cards .fc[data-estado=proxima],#fp:checked~.cards .fc[data-estado=en-curso]{display:block}#fpa:checked~.cards .fc{display:none}#fpa:checked~.cards .fc[data-estado=pasada]{display:block}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px}.fc{background:#fff;border-radius:10px;border:1px solid #e2e8f0;overflow:hidden;transition:transform .2s,box-shadow .2s}.fc:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08)}.fh{padding:14px 16px 10px;border-bottom:1px solid #f0f2f5}.ft{font-size:14px;font-weight:700;color:#2d3748;margin-top:6px;line-height:1.3}.fm{padding:12px 16px}.fi{display:flex;align-items:center;gap:6px;font-size:12px;color:#718096;margin-bottom:6px}.fi svg{opacity:.6;flex-shrink:0}.favs{display:flex;align-items:center;gap:4px;padding:10px 16px;background:#f7fafc;border-top:1px solid #edf2f7;flex-wrap:wrap;min-height:42px}.av{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;color:#fff;font-style:normal;flex-shrink:0}.ax{background:#a0aec0!important}.nd{font-size:11px;color:#a0aec0}.badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:12px;white-space:nowrap}.bb{background:#ebf8ff;color:#2b6cb0}.bg{background:#f0fff4;color:#276749}.bx{background:#f7fafc;color:#718096}.empty{text-align:center;padding:48px;color:#a0aec0;grid-column:1/-1}.empty svg{display:block;margin:0 auto 12px;opacity:.3}@media(max-width:768px){.hdr{padding:16px}.hk{gap:8px}.cnt{padding:14px 16px}.cards{grid-template-columns:1fr}}</style>";
	// ── 4. Assemble ──
	h1 = "<div class='tf'><div class='hdr'><div class='ht'>Formaciones</div><div class='hs'>Gesti&oacute;n de convocatorias y formaci&oacute;n del personal</div><div class='hk'><div class='hki k-b'><b>" + totalAnio.toString() + "</b><span>Este a&ntilde;o</span></div><div class='hki k-o'><b>" + proximas30.toString() + "</b><span>Pr&oacute;ximas 30d</span></div><div class='hki k-g'><b>" + tecConv.toString() + "</b><span>Convocatorias</span></div><div class='hki k-t'><b>" + invStr + "</b><span>Inversi&oacute;n</span></div></div></div>";
	h2 = "<div class='cnt'><div class='acts'><a class='btn btn-p' href='#Form:Formaci_n'>+ Nueva Formaci&oacute;n</a><a class='btn btn-s' href='#Report:Calendario_de_Formaciones'>Ver Calendario</a><a class='btn btn-s' href='#Report:Formaci_n_Report'>Ver Lista</a></div><input type='radio' name='flt' id='fa' checked><label for='fa'>Todas</label><input type='radio' name='flt' id='fp'><label for='fp'>Pr&oacute;ximas</label><input type='radio' name='flt' id='fpa'><label for='fpa'>Pasadas</label><div class='cards'>" + cardsH + "</div></div></div>";
	return css + h1 + h2;
}
