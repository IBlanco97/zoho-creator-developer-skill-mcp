string Configuracion.MostrarConfiguracion()
{
cfgFound = 0;
for each cfg in Configuraci_n_General[ID != 0]
{
rec = cfg;
cfgFound = 1;
break;
}
if(cfgFound == 0)
{
return "<div style='font-family:system-ui;text-align:center;padding:60px;color:#6b7280'>No hay registro de configuracion disponible.</div>";
}
fCad = ifnull(rec.Notificaciones_de_Caducidad_de_Documentos,"");
fAsig = ifnull(rec.Notificaciones_de_Asignaci_n_T_cnico_Cliente,"");
fEPI = ifnull(rec.Notificar_nuevas_solicitudes_de_Herramientas,"");
fPer = ifnull(rec.Notificar_nuevas_solicitudes_a_personal_correspondiente,"");
fResp = ifnull(rec.Notificar_respuesta_a_Empleados,"");
fMens = ifnull(rec.Notificar_respuesta_RRHH_mensajes,"");
fvCad = ifnull(rec.V_as_de_Notificaci_n_Caducidad_de_Documentos,"");
fvAsig = ifnull(rec.Vias_de_notificacion_Asignaciones_Tecnicos,"");
fvEPI = ifnull(rec.V_as_de_Notificaci_n_Solicitudes_EPI,"");
fvPer = ifnull(rec.V_as_de_Notificaci_n1,"");
fvMsg = ifnull(rec.Notificaciones_Permisos,"");
fFechas = ifnull(rec.Fechas_de_Notificaci_n_Tecnico_Cliente,"");
fApiKey = ifnull(rec.API_Key,"");
fUrl = ifnull(rec.URL,"");
fCuentaWA = ifnull(rec.Cuenta_de_Whatsapp,"");
fAsunto = ifnull(rec.Asunto_Mail_Bienvenida_Trabajadores,"");
fPlantilla = ifnull(rec.Plantilla_Mail_Bienvenida_Trabajadores,"");
recId = rec.ID;
bs = "display:inline-block;padding:3px 10px;border-radius:12px;font-size:12px;font-weight:600;";
bon = bs + "background:#dcfce7;color:#166534;";
boff = bs + "background:#fee2e2;color:#991b1b;";
bnul = bs + "background:#f3f4f6;color:#6b7280;";
sec = "background:#fff;border-radius:8px;border:1px solid #e5e7eb;margin-bottom:16px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,0.04);";
hdr = "background:#1C3A5E;padding:12px 20px;";
htx = "color:#fff;font-size:14px;font-weight:700;margin:0;";
bdy = "padding:0 20px;";
rw = "display:grid;grid-template-columns:270px 1fr;gap:12px;align-items:start;padding:11px 0;border-bottom:1px solid #f3f4f6;";
rwl = "display:grid;grid-template-columns:270px 1fr;gap:12px;align-items:start;padding:11px 0;";
lab = "color:#6b7280;font-size:13px;";
vl = "color:#111827;font-size:13px;";
badgeCad = if(fCad == "Activado","<span style='" + bon + "'>&#10003; Activado</span>",if(fCad == "Desactivado","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
badgeAsig = if(fAsig == "Activado","<span style='" + bon + "'>&#10003; Activado</span>",if(fAsig == "Desactivado","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
badgeEPI = if(fEPI == "Activado","<span style='" + bon + "'>&#10003; Activado</span>",if(fEPI == "Desactivado","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
badgePer = if(fPer == "Activado" || fPer == "true","<span style='" + bon + "'>&#10003; Activado</span>",if(fPer == "Desactivado" || fPer == "false","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
badgeResp = if(fResp == "Activado" || fResp == "true","<span style='" + bon + "'>&#10003; Activado</span>",if(fResp == "Desactivado" || fResp == "false","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
badgeMens = if(fMens == "Activado" || fMens == "true","<span style='" + bon + "'>&#10003; Activado</span>",if(fMens == "Desactivado" || fMens == "false","<span style='" + boff + "'>&#10007; Desactivado</span>","<span style='" + bnul + "'>Sin configurar</span>"));
vCad = if(fvCad != "",fvCad.toString().replaceAll(",",", "),"&#8212;");
vAsig = if(fvAsig != "",fvAsig.toString().replaceAll(",",", "),"&#8212;");
vEPI = if(fvEPI != "",fvEPI.toString().replaceAll(",",", "),"&#8212;");
vPer = if(fvPer != "",fvPer.toString().replaceAll(",",", "),"&#8212;");
vMsg = if(fvMsg != "",fvMsg.toString().replaceAll(",",", "),"&#8212;");
fechas = if(fFechas != "",fFechas.toString().replaceAll(",",", "),"&#8212;");
apiKeyLen = if(fApiKey != "",fApiKey.length(),0);
apiKeyMask = if(fApiKey != "" && apiKeyLen > 4,"&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" + fApiKey.subString(apiKeyLen - 4,apiKeyLen),if(fApiKey != "","&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;","&#8212;"));
urlWA = if(fUrl != "",fUrl,"&#8212;");
cuentaWA = if(fCuentaWA != "",fCuentaWA.replaceAll("_"," "),"&#8212;");
asunto = if(fAsunto != "",fAsunto,"&#8212;");
plantillaLen = if(fPlantilla != "",fPlantilla.length(),0);
plantillaPrev = if(fPlantilla != "" && plantillaLen > 150,fPlantilla.subString(0,150) + "...","");
plantillaPrev = if(fPlantilla != "" && plantillaPrev == "",fPlantilla,if(plantillaPrev != "",plantillaPrev,"&#8212;"));
editUrl = "#Form:Configuraci_n_General?recLinkID=" + recId + "&viewLinkName=Configuraci_n_General_Report";
pInfo = "<span style='color:#6b7280;font-size:12px;font-style:italic;'>Ver en Editar</span>";
h = "<div style='font-family:system-ui,-apple-system,sans-serif;max-width:960px;margin:0 auto;padding:24px;'>";
h = h + "<div style='background:#1C3A5E;border-radius:10px;padding:20px 24px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;'>";
h = h + "<div><h1 style='color:#fff;font-size:20px;font-weight:700;margin:0 0 4px;'>Configuracion General</h1>";
h = h + "<p style='color:#93c5fd;font-size:12px;margin:0;'>Parametros globales del sistema</p></div>";
h = h + "<a href='" + editUrl + "' style='background:#fff;color:#1C3A5E;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:13px;font-weight:700;'>Editar</a>";
h = h + "</div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Caducidad de Documentos</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Estado</span><span>" + badgeCad + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Vias de notificacion</span><span style='" + vl + "'>" + vCad + "</span></div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Personal a notificar</span>" + pInfo + "</div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Asignacion Tecnico-Cliente</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Estado</span><span>" + badgeAsig + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Vias de notificacion</span><span style='" + vl + "'>" + vAsig + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Fechas de antelacion</span><span style='" + vl + "'>" + fechas + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Personal a notificar</span>" + pInfo + "</div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Contactos a informar</span>" + pInfo + "</div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Solicitudes de Herramientas y EPI</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Estado</span><span>" + badgeEPI + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Vias de notificacion</span><span style='" + vl + "'>" + vEPI + "</span></div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Personal a notificar</span>" + pInfo + "</div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Solicitudes de Permisos</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Notif. nuevas solicitudes</span><span>" + badgePer + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Vias de notificacion</span><span style='" + vl + "'>" + vPer + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Personal a notificar</span>" + pInfo + "</div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Notif. respuesta a empleados</span><span>" + badgeResp + "</span></div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Vias notif. respuesta</span><span style='" + vl + "'>" + vMsg + "</span></div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Mensajes RRHH y Empleados</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Notif. respuesta RRHH</span><span>" + badgeMens + "</span></div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Bienvenida a Trabajadores</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>Asunto del correo</span><span style='" + vl + "'>" + asunto + "</span></div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Plantilla (preview)</span><span style='color:#374151;font-size:12px;line-height:1.6;font-style:italic;'>" + plantillaPrev + "</span></div>";
h = h + "</div></div>";
h = h + "<div style='" + sec + "'><div style='" + hdr + "'><h2 style='" + htx + "'>Integracion WhatsApp</h2></div><div style='" + bdy + "'>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>URL del servidor</span><span style='" + vl + "'>" + urlWA + "</span></div>";
h = h + "<div style='" + rw + "'><span style='" + lab + "'>API Key</span><span style='font-family:monospace;font-size:13px;color:#374151;'>" + apiKeyMask + "</span></div>";
h = h + "<div style='" + rwl + "'><span style='" + lab + "'>Cuenta WhatsApp</span><span style='" + vl + "'>" + cuentaWA + "</span></div>";
h = h + "</div></div>";
h = h + "</div>";
return h;
}
