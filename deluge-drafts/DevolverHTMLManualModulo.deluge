/**
 * DevolverHTMLManualModulo(string mod, string q)
 * Devuelve el HTML de un módulo del Manual (A/B/C/D).
 * - mod: "A", "B", "C" o "D"
 * - q: término opcional para resaltar con <mark> y filtrar toc
 * GENERADO AUTOMÁTICAMENTE por docs/manual/build-deluge-wiki.mjs
 */
string Calendario52HTML.DevolverHTMLManualModulo(string mod, string q)
{
  m = mod.toUpperCase().trim();
  qNorm = q.toLowerCase().trim();
  if(m == "A")
  {
    if(qNorm == "" || qNorm == null)
    {
      out = "";
      out = out + "<style> .wk-root{font-family:'Segoe UI',Calibri,Arial,sans-serif;color:#1a1a1a;max-width:1200px;margin:0 auto;padding:16px;} .wk-root h1{font-size:26px;color:#1C3A5E;border-bottom:3px solid #1C3A5E;padding-bottom:8px;margin:0 0 16px;} .wk-root h2{font-size:20px;color:#1C3A5E;border-bottom:1px solid #ccc;padding-bottom:6px;margin:28px 0 12px;scroll-margin-top:16px;} .wk-root h3{font-size:16px;color:#2d5a8e;margin:20px 0 10px;scroll-margin-top:16px;} .wk-root h4{font-size:14px;color:#2d5a8e;margin:14px 0 8px;} .wk-root p{line-height:1.6;margin:8px 0;} .wk-root table{width:100%;border-collapse:collapse;margin:10px 0 16px;font-size:13px;} .wk-root th{background:#1C3A5E;color:#fff;text-align:left;padding:7px 10px;font-weight:600;} .wk-root td{border:1px solid #ddd;padding:6px 10px;vertical-align:top;} .wk-root tr:nth-child(even) td{background:#f8f9fa;} .wk-root blockquote{background:#f0f7ff;b";
      out = out + "order-left:4px solid #2d5a8e;padding:10px 14px;margin:12px 0;color:#333;} .wk-root code{background:#f0f0f0;padding:1px 5px;border-radius:3px;font-size:12px;font-family:Consolas,'Courier New',monospace;} .wk-root pre{background:#f5f5f5;border:1px solid #ddd;padding:10px;border-radius:4px;font-size:12px;overflow-x:auto;} .wk-root a{color:#1C3A5E;} .wk-root hr{border:0;border-top:1px solid #e0e0e0;margin:18px 0;} .wk-root ul,.wk-root ol{line-height:1.6;} .wk-root mark{background:#ffeb3b;padding:0 2px;border-radius:2px;} /* header */ .wk-header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;} .wk-title{font-size:26px;font-weight:700;color:#1C3A5E;margin:0;} .wk-breadcrumb{font-size:13px;color:#666;} .wk-breadcrumb a{color:#1C3A5E;text-decoration:none;} .wk-breadcrumb a:hover{text-decoration:underline;} /* search box */ .wk-search{background:#f5f7fb;bord";
      out = out + "er:1px solid #d9e0ec;border-radius:8px;padding:14px 16px;margin:16px 0;} .wk-search-title{font-size:13px;color:#1C3A5E;font-weight:600;margin-bottom:8px;} .wk-tags{display:flex;flex-wrap:wrap;gap:6px;} .wk-tag{display:inline-block;padding:4px 10px;background:#fff;border:1px solid #c4cfe0;border-radius:14px;font-size:12px;color:#1C3A5E;text-decoration:none;} .wk-tag:hover{background:#e7eef9;border-color:#1C3A5E;} .wk-tag.active{background:#1C3A5E;color:#fff;border-color:#1C3A5E;} .wk-search-hint{font-size:11px;color:#666;margin-top:8px;font-style:italic;} .wk-search-clear{font-size:12px;color:#b33;text-decoration:none;margin-left:6px;} .wk-search-clear:hover{text-decoration:underline;} /* index cards */ .wk-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:20px;} .wk-card{display:block;background:#fff;border:1px solid #d9e0ec;border-radius:8px";
      out = out + ";padding:18px;text-decoration:none;color:inherit;transition:all .15s;} .wk-card:hover{border-color:#1C3A5E;box-shadow:0 2px 8px rgba(28,58,94,0.12);transform:translateY(-1px);} .wk-card-icon{font-size:32px;margin-bottom:8px;} .wk-card-title{font-size:16px;font-weight:700;color:#1C3A5E;margin:4px 0;} .wk-card-desc{font-size:13px;color:#555;line-height:1.5;} .wk-card-mod{font-size:11px;color:#999;font-weight:600;letter-spacing:.5px;} /* search results */ .wk-results{margin-top:18px;} .wk-result{background:#fff;border:1px solid #e0e6ef;border-radius:6px;padding:12px 14px;margin-bottom:8px;} .wk-result-mod{display:inline-block;background:#e7eef9;color:#1C3A5E;font-size:11px;font-weight:600;padding:2px 7px;border-radius:3px;margin-right:8px;} .wk-result-title{font-size:14px;color:#1C3A5E;text-decoration:none;font-weight:600;} .wk-result-title:hover{text-decoration:underline;} .wk-result-snipp";
      out = out + "et{font-size:12px;color:#555;margin-top:4px;line-height:1.5;} .wk-no-results{padding:24px;text-align:center;color:#888;font-style:italic;background:#fafbfd;border-radius:6px;} /* module layout */ .wk-layout{display:grid;grid-template-columns:260px 1fr;gap:24px;margin-top:18px;} @media (max-width: 900px){.wk-layout{grid-template-columns:1fr;}} .wk-toc{background:#f5f7fb;border:1px solid #d9e0ec;border-radius:8px;padding:14px;position:sticky;top:12px;max-height:calc(100vh - 40px);overflow-y:auto;font-size:13px;} .wk-toc-title{font-size:12px;font-weight:700;color:#1C3A5E;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;} .wk-toc ol{list-style:none;padding:0;margin:0;} .wk-toc li{margin:3px 0;} .wk-toc a{color:#333;text-decoration:none;display:block;padding:3px 6px;border-radius:3px;line-height:1.35;} .wk-toc a:hover{background:#e7eef9;color:#1C3A5E;} .wk-toc .lvl-3{padding-lef";
      out = out + "t:14px;font-size:12px;color:#666;} .wk-toc .lvl-4{padding-left:26px;font-size:11px;color:#888;} .wk-content{min-width:0;} </style> <div class=\"wk-root\"> <div class=\"wk-breadcrumb\"> <a href=\"#Page:Manual_de_Usuario\">📚 Manual de Usuario</a> › Módulo A </div> <div class=\"wk-header\" style=\"margin-top:6px;\"> <h1 class=\"wk-title\">👷 Portal del Empleado</h1> <div class=\"wk-breadcrumb\"> <a href=\"#Page:Manual_de_Usuario\">Índice</a> · <a href=\"#Page:Manual_de_Usuario_Modulo?Mod=B\">Módulo B →</a> </div> </div> <div class=\"wk-search\"> <div class=\"wk-search-title\">🔍 Búsqueda rápida</div> <div class=\"wk-tags\"><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=permisos\">permisos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=vacaciones\">vacaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=EPI\">EPI</a><a class=\";
      out = out + ""wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=herramientas\">herramientas</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=ropa\">ropa</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=activos\">activos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=documentos\">documentos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=clientes\">clientes</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=caducidad\">caducidad</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=mensajes\">mensajes</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=chat\">chat</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=asignaciones\">asignaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=t%C3%A9cnico\">técnico</a><a class=\"wk";
      out = out + "-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=empleado\">empleado</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=formaciones\">formaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=WhatsApp\">WhatsApp</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=encuestas\">encuestas</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=configuraci%C3%B3n\">configuración</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=notificaciones\">notificaciones</a></div> <div class=\"wk-search-hint\">💡 Usa <b>Ctrl+F</b> para buscar texto dentro de esta página, o filtra por tema con los tags.</div> </div> <div class=\"wk-layout\"> <nav class=\"wk-toc\"> <div class=\"wk-toc-title\">En esta página</div> <ol><li class=\"lvl-3\"><a href=\"#A-tarjetas-de-informacion-parte-superior\">Tarjetas de información ";
      out = out + "(parte superior)</a></li><li class=\"lvl-3\"><a href=\"#A-seccion-confirmaciones-de-entrega\">Sección &quot;Confirmaciones de Entrega&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-seccion-documentacion-con-clientes\">Sección &quot;Documentación con Clientes&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-31-mis-permisos\">3.1 Mis Permisos</a></li><li class=\"lvl-3\"><a href=\"#A-32-historial-de-solicitudes\">3.2 Historial de solicitudes</a></li><li class=\"lvl-3\"><a href=\"#A-33-nueva-solicitud-de-permiso\">3.3 Nueva solicitud de permiso</a></li><li class=\"lvl-3\"><a href=\"#A-41-mis-epis\">4.1 Mis EPIs</a></li><li class=\"lvl-3\"><a href=\"#A-42-historial-de-solicitudes-epi\">4.2 Historial de solicitudes EPI</a></li><li class=\"lvl-3\"><a href=\"#A-43-nueva-solicitud-de-epi-o-herramienta\">4.3 Nueva solicitud de EPI o herramienta</a></li><li class=\"lvl-3\"><a href=\"#A-enviar-un-nuev";
      out = out + "o-mensaje\">Enviar un nuevo mensaje</a></li><li class=\"lvl-3\"><a href=\"#A-datos-basicos\">Datos Básicos</a></li><li class=\"lvl-3\"><a href=\"#A-datos-de-contacto\">Datos de Contacto</a></li><li class=\"lvl-3\"><a href=\"#A-datos-profesionales\">Datos Profesionales</a></li><li class=\"lvl-3\"><a href=\"#A-regimen-y-otra-informacion\">Régimen y Otra Información</a></li><li class=\"lvl-3\"><a href=\"#A-campo-leida-documentacion-bienvenida\">Campo &quot;Leída Documentación Bienvenida&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-como-confirmar\">Cómo confirmar</a></li><li class=\"lvl-3\"><a href=\"#A-como-participar\">Cómo participar</a></li><li class=\"lvl-2\"><a href=\"#A-indice\">Índice</a></li><li class=\"lvl-2\"><a href=\"#A-1-acceso-al-portal\">1. Acceso al portal</a></li><li class=\"lvl-2\"><a href=\"#A-2-tablero-inicio\">2. Tablero Inicio</a></li><li class=\"lvl-2\"><a href=\"#A";
      out = out + "-3-solicitudes-de-permisos\">3. Solicitudes de Permisos</a></li><li class=\"lvl-2\"><a href=\"#A-4-epis-ropa-y-herramientas\">4. EPIs, Ropa y Herramientas</a></li><li class=\"lvl-2\"><a href=\"#A-5-mis-activos\">5. Mis Activos</a></li><li class=\"lvl-2\"><a href=\"#A-6-mis-mensajes\">6. Mis Mensajes</a></li><li class=\"lvl-2\"><a href=\"#A-7-datos-del-empleado\">7. Datos del Empleado</a></li><li class=\"lvl-2\"><a href=\"#A-8-confirmaciones-de-entrega\">8. Confirmaciones de Entrega</a></li><li class=\"lvl-2\"><a href=\"#A-9-encuestas\">9. Encuestas</a></li><li class=\"lvl-2\"><a href=\"#A-10-mis-formaciones\">10. Mis Formaciones</a></li><li class=\"lvl-2\"><a href=\"#A-resumen-de-funcionalidades\">Resumen de funcionalidades</a></li></ol> </nav> <div class=\"wk-content\"> <h1 id=\"A-modulo-a-portal-del-empleado\">Módulo A — Portal del Empleado</h1> <strong>Perfil:</strong> Usuario Trabaja";
      out = out + "dor <strong>Acceso:</strong> <a href=\"https://domo21.zohocreatorportal.com\" target=\"_blank\" rel=\"noopener\">https://domo21.zohocreatorportal.com</a> <strong>Versión:</strong> 1.1 — Abril 2026 <hr> <h2 id=\"A-indice\">Índice</h2> <ol><li><a href=\"#A-1-acceso-al-portal\">Acceso al portal</a></li> <li><a href=\"#A-2-tablero-inicio\">Tablero Inicio</a></li> <li><a href=\"#A-3-solicitudes-de-permisos\">Solicitudes de Permisos</a></li> </ol> - 3.1 <a href=\"#A-31-mis-permisos\">Mis Permisos</a> <p> - 3.2 <a href=\"#A-32-historial-de-solicitudes\">Historial de solicitudes</a></p> <p> - 3.3 <a href=\"#A-33-nueva-solicitud-de-permiso\">Nueva solicitud de permiso</a></p> <ol><li><a href=\"#A-4-epis-ropa-y-herramientas\">EPIs, Ropa y Herramientas</a></li> </ol> - 4.1 <a href=\"#A-41-mis-epis\">Mis EPIs</a> <p> - 4.2 <a href=\"#A-42-historial-de-solicitudes-epi\">Historial de solicitudes EPI</";
      out = out + "a></p> <p> - 4.3 <a href=\"#A-43-nueva-solicitud-de-epi-o-herramienta\">Nueva solicitud de EPI o herramienta</a></p> <ol><li><a href=\"#A-5-mis-activos\">Mis Activos</a></li> <li><a href=\"#A-6-mis-mensajes\">Mis Mensajes</a></li> <li><a href=\"#A-7-datos-del-empleado\">Datos del Empleado</a></li> <li><a href=\"#A-8-confirmaciones-de-entrega\">Confirmaciones de Entrega</a></li> <li><a href=\"#A-9-encuestas\">Encuestas</a></li> <li><a href=\"#A-10-mis-formaciones\">Mis Formaciones</a></li> </ol> <hr> <h2 id=\"A-1-acceso-al-portal\">1. Acceso al portal</h2> <p>Accede al portal desde cualquier navegador en la dirección:</p> <strong><a href=\"https://domo21.zohocreatorportal.com\" target=\"_blank\" rel=\"noopener\">https://domo21.zohocreatorportal.com</a></strong> <p>Introduce tu dirección de email corporativa y tu contraseña de Zoho. Si es la primera vez que accedes, recibirás un correo de ";
      out = out + "Zoho para crear o vincular tu cuenta.</p> <p>Una vez dentro, verás la barra de navegación lateral izquierda con todas las secciones disponibles para tu perfil.</p> <hr> <h2 id=\"A-2-tablero-inicio\">2. Tablero Inicio</h2> <p>El <strong>Tablero Inicio</strong> es la pantalla principal del portal. Se muestra automáticamente al entrar.</p> <h3 id=\"A-tarjetas-de-informacion-parte-superior\">Tarjetas de información (parte superior)</h3> <p>En la parte superior aparecen cuatro tarjetas con tu información:</p> <table><thead><tr><th>Tarjeta</th><th>Qué muestra</th></tr></thead><tbody><tr><td><strong>Nombre completo</strong></td><td>Tu nombre tal como está registrado en el sistema</td></tr> <tr><td><strong>Área</strong></td><td>Tu área o departamento profesional</td></tr> <tr><td><strong>Clientes Actuales</strong></td><td>Los clientes a los que estás asignado actualmente</td></tr> <tr><td><stron";
      out = out + "g>Encuestas Activas</strong></td><td>Número de encuestas pendientes de responder (badge verde)</td></tr></tbody></table> <h3 id=\"A-seccion-confirmaciones-de-entrega\">Sección \"Confirmaciones de Entrega\"</h3> <p>Justo debajo de las tarjetas aparece la lista de tareas de confirmación pendientes que RRHH te ha asignado. Si no tienes ninguna pendiente, la sección aparecerá vacía.</p> <h3 id=\"A-seccion-documentacion-con-clientes\">Sección \"Documentación con Clientes\"</h3> <p>En la parte inferior del tablero se muestra un resumen de tu documentación requerida por los clientes a los que estás asignado: qué documentos están al día, cuáles están pendientes de subir y cuáles han caducado.</p> <blockquote><strong>Nota:</strong> Si la sección aparece vacía, puede que aún no estés asignado a ningún cliente o que no se te haya requerido documentación todavía.</blockquote> <hr> <h2 id=\"A-3-solic";
      out = out + "itudes-de-permisos\">3. Solicitudes de Permisos</h2> <p>Esta sección agrupa todo lo relacionado con tus permisos laborales (vacaciones, permisos retribuidos y no retribuidos). En el menú lateral, haz clic en <strong>Solicitudes de Permisos</strong> para expandir las tres opciones disponibles.</p> <h3 id=\"A-31-mis-permisos\">3.1 Mis Permisos</h3> <p>La página <strong>Mis Permisos</strong> muestra un resumen visual de todas tus solicitudes con su estado actual.</p> <strong>Columnas de la tabla:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Tipo de permiso: Vacaciones, Permiso Retribuido o Permiso no Retribuido</td></tr> <tr><td><strong>Inicio</strong></td><td>Fecha de inicio del permiso</td></tr> <tr><td><strong>Fin</strong></td><td>Fecha de finalización del permiso</td></tr> <tr><td><strong>Estado</strong></td><td";
      out = out + ">Estado actual de la solicitud (ver colores abajo)</td></tr> <tr><td><strong>Nota</strong></td><td>Comentario adicional que incluiste al solicitarlo</td></tr></tbody></table> <strong>Estados posibles:</strong> <ul><li>🟠 <strong>Sin Respuesta</strong> — La solicitud está pendiente de revisión por RRHH</li> <li>🟢 <strong>Aprobado</strong> — RRHH ha aprobado el permiso</li> <li>🔴 <strong>Rechazado</strong> — La solicitud fue denegada</li> </ul> <p>Pulsa <strong>+ Nueva Solicitud</strong> (botón azul arriba a la derecha) para crear una nueva solicitud directamente desde esta vista.</p> <h3 id=\"A-32-historial-de-solicitudes\">3.2 Historial de solicitudes</h3> <p>La opción <strong>Solicitudes Permisos</strong> del menú muestra el listado completo de tus solicitudes de permiso, con columnas adicionales como el tipo de permiso retribuido o no retribuido. Puedes usar el botón <strong>Búsqueda";
      out = out + " Avanzada</strong> para filtrar por fechas o estado.</p> <h3 id=\"A-33-nueva-solicitud-de-permiso\">3.3 Nueva solicitud de permiso</h3> <p>Haz clic en <strong>Nueva Solicitud Permiso</strong> en el menú (o en el botón <strong>+ Nueva Solicitud</strong> desde cualquier vista de permisos).</p> <blockquote>⚠️ <strong>Importante:</strong> Las solicitudes deben hacerse con al menos <strong>15 días de antelación</strong>.</blockquote> <strong>Campos del formulario:</strong> <table><thead><tr><th>Campo</th><th>Obligatorio</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>✓</td><td>Selecciona: Vacaciones / Permiso Retribuido / Permiso no Retribuido</td></tr> <tr><td><strong>Fecha de comienzo</strong></td><td>✓</td><td>Se rellena automáticamente con la fecha de hoy + 15 días</td></tr> <tr><td><strong>Fecha de Fin</strong></td><td>✓</td><td>Se rellena con ~7 días de";
      out = out + "spués de la fecha de inicio</td></tr> <tr><td><strong>Nota</strong></td><td>—</td><td>Texto libre opcional para añadir contexto</td></tr></tbody></table> <p>Pulsa <strong>Enviar</strong> para registrar la solicitud. RRHH la recibirá y la tramitará. Puedes consultar el estado en <strong>Mis Permisos</strong> o en <strong>Solicitudes Permisos</strong>.</p> <hr> <h2 id=\"A-4-epis-ropa-y-herramientas\">4. EPIs, Ropa y Herramientas</h2> <p>Esta sección agrupa las solicitudes de Equipos de Protección Individual (EPI), ropa de trabajo y herramientas. En el menú lateral, haz clic en <strong>Solicitud de EPI - Herramientas</strong> para expandir las opciones.</p> <h3 id=\"A-41-mis-epis\">4.1 Mis EPIs</h3> <p>La página <strong>Mis EPIs</strong> muestra un resumen visual de todos los equipos y herramientas que has solicitado, con su estado actual en formato de tabla con badges de colores.</p> <stro";
      out = out + "ng>Columnas:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Badge de color: EPI (azul), ROPA (morado), HERRAMIENTA (verde)</td></tr> <tr><td><strong>Equipo Solicitado</strong></td><td>Descripción del equipo que solicitaste</td></tr> <tr><td><strong>Equipo Asignado</strong></td><td>Nombre del equipo concreto que te fue asignado</td></tr> <tr><td><strong>Fecha Entrega</strong></td><td>Fecha en que fue entregado</td></tr> <tr><td><strong>Estado</strong></td><td>Estado actual (ver colores abajo)</td></tr></tbody></table> <strong>Estados posibles:</strong> <ul><li>🟢 <strong>Entregado / Confirmado</strong> — El equipo fue entregado y confirmada la recepción</li> <li>🟠 <strong>Aprobado / Gestionándose</strong> — La solicitud está aprobada y en proceso</li> <li>🔴 <strong>Rechazado</strong> — La solicitud fue denegada</l";
      out = out + "i> <li>⚫ <strong>Pendiente</strong> — En espera de revisión</li> </ul> <p>Pulsa <strong>+ Nueva Solicitud</strong> para crear una solicitud desde esta vista.</p> <h3 id=\"A-42-historial-de-solicitudes-epi\">4.2 Historial de solicitudes EPI</h3> <p>La opción <strong>Solicitudes EPI - Herramientas</strong> del menú muestra el listado detallado de tus solicitudes, incluyendo el historial de cambios de estado (columna <strong>Historia de la Solicitud</strong>) y la columna <strong>Confirmar</strong>.</p> <strong>Columna \"Confirmar\":</strong> <p>Cuando el equipo te sea entregado físicamente, pulsa el botón <strong>Confirmar</strong> en la fila correspondiente para registrar la recepción. El botón aparece deshabilitado si la entrega ya fue confirmada.</p> <strong>Historia de la solicitud (ejemplo):</strong> <pre><code>Creado - 10-12-2025 16:13:29 Entregado - 16-12-2025 14:07:30 </code></pre>";
      out = out + " <h3 id=\"A-43-nueva-solicitud-de-epi-o-herramienta\">4.3 Nueva solicitud de EPI o herramienta</h3> <p>Haz clic en <strong>Nueva Solicitud EPI - H...</strong> en el menú.</p> <strong>Campos del formulario:</strong> <table><thead><tr><th>Campo</th><th>Obligatorio</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo de equipo solicitado</strong></td><td>✓</td><td>Selecciona: EPI / ROPA / HERRAMIENTA</td></tr> <tr><td><strong>Equipo Solicitado</strong></td><td>✓</td><td>Describe con detalle qué necesitas (texto libre)</td></tr> <tr><td><strong>Motivo de la Solicitud</strong></td><td>—</td><td>Explica por qué lo necesitas (opcional pero recomendado)</td></tr></tbody></table> <p>Pulsa <strong>Enviar</strong>. RRHH recibirá la solicitud y la gestionará. Sigue el estado en <strong>Mis EPIs</strong> o en <strong>Solicitudes EPI - Herramientas</strong>.</p> <hr> <h2 id=\"A-5-mis-activ";
      out = out + "os\">5. Mis Activos</h2> <strong>Ruta de menú:</strong> Portal del Empleado → Mis Activos <strong>URL directa:</strong> <code>#Page:Mis_Activos</code> <p>La sección <strong>Mis Activos</strong> muestra todos los equipos, herramientas y prendas de trabajo que tienes asignados actualmente en estado <strong>activo</strong>, es decir, que sigues teniendo en tu poder.</p> <strong>Columnas de la tabla:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Badge de color: EPI (azul), ROPA (morado), HERR. (verde)</td></tr> <tr><td><strong>Elemento</strong></td><td>Nombre del activo asignado (ej. \"Gato hidráulico\")</td></tr> <tr><td><strong>Serie</strong></td><td>Número de serie del equipo (ej. GH00002)</td></tr> <tr><td><strong>Unidades</strong></td><td>Cantidad asignada</td></tr></tbody></table> <blockquote>Si la tabla aparece";
      out = out + " vacía, significa que no tienes activos registrados a tu nombre en este momento.</blockquote> <p>Pulsa <strong>+ Solicitar EPI / Herramienta</strong> para solicitar un nuevo equipo o herramienta si lo necesitas.</p> <hr> <h2 id=\"A-6-mis-mensajes\">6. Mis Mensajes</h2> <p>La sección <strong>Mis Mensajes</strong> es el canal de comunicación directa entre tú y el equipo de RRHH.</p> <p>La vista muestra una interfaz tipo chat con:</p> <ul><li><strong>Burbujas derechas (verde/gris oscuro)</strong> — Tus mensajes enviados a RRHH</li> <li><strong>Burbujas izquierdas (blancas)</strong> — Respuestas del equipo de RRHH, con la etiqueta del autor (nombre del gestor o \"RRHH\")</li> <li><strong>Marcas de tiempo</strong> — Fecha y hora de cada mensaje</li> <li><strong>Indicador ✓</strong> — Confirma que tu mensaje fue recibido</li> </ul> <h3 id=\"A-enviar-un-nuevo-mensaje\">Enviar un nuevo mensaje</";
      out = out + "h3> <p>Pulsa el botón <strong>✉ Enviar nuevo mensaje</strong> en la parte inferior del chat. Se abrirá un formulario con un único campo de texto libre. Escribe tu consulta y pulsa <strong>Enviar</strong>.</p> <blockquote><strong>Consejo:</strong> Usa este canal para consultas sobre tu contrato, nóminas, días de vacaciones disponibles, o cualquier duda relacionada con tu situación laboral.</blockquote> <hr> <h2 id=\"A-7-datos-del-empleado\">7. Datos del Empleado</h2> <p>La sección <strong>Datos del Empleado</strong> te permite consultar y actualizar tu información personal y profesional registrada en el sistema.</p> <p>El formulario está dividido en cuatro secciones:</p> <h3 id=\"A-datos-basicos\">Datos Básicos</h3> <table><thead><tr><th>Campo</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Nombre</strong></td><td>Nombre y apellidos (First Name + Last Name)</td></tr> <tr><td><";
      out = out + "strong>Email</strong></td><td>Email corporativo (principal)</td></tr> <tr><td><strong>Email Personal o Secundario</strong></td><td>Email alternativo para comunicaciones</td></tr> <tr><td><strong>Moneda</strong></td><td>Moneda de referencia para tu contrato</td></tr> <tr><td><strong>Fecha de Nacimiento</strong></td><td>Formato dd-MM-yyyy</td></tr> <tr><td><strong>Foto</strong></td><td>Foto de perfil (puedes subir desde tu equipo o pegar una URL)</td></tr> <tr><td><strong>DNI / NIE / Pasaporte</strong></td><td>Documento de identidad</td></tr> <tr><td><strong>Móvil</strong></td><td>Teléfono móvil con prefijo de país</td></tr> <tr><td><strong>Teléfono</strong></td><td>Teléfono fijo opcional</td></tr> <tr><td><strong>Idioma</strong></td><td>Idioma preferido</td></tr> <tr><td><strong>Sexo</strong></td><td>Masculino / Femenino</td></tr></tbody></table> <h3 id=\"A-datos-de-contacto\">Datos de Co";
      out = out + "ntacto</h3> <p>Dirección completa: calle, código postal, país, ciudad, estado/provincia y comarca. También incluye campos para indicar si dispones de <strong>habitación de empresa</strong> o si la necesitas.</p> <h3 id=\"A-datos-profesionales\">Datos Profesionales</h3> <table><thead><tr><th>Campo</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Área Profesional</strong></td><td>Tu área de trabajo (ej: INFORMÁTICA, CONSTRUCCIÓN)</td></tr> <tr><td><strong>Profesión</strong></td><td>Tu profesión específica</td></tr> <tr><td><strong>Categoría Profesional</strong></td><td>Nivel (ej: INGENIERO, TÉCNICO)</td></tr> <tr><td><strong>Puesto laboral actual</strong></td><td>Denominación actual del puesto</td></tr> <tr><td><strong>Especialidad</strong></td><td>Especialidad dentro de tu profesión</td></tr> <tr><td><strong>Información adicional</strong></td><td>Campo libre para información co";
      out = out + "mplementaria</td></tr></tbody></table> <h3 id=\"A-regimen-y-otra-informacion\">Régimen y Otra Información</h3> <p>Datos sobre tu tipo de régimen laboral (General / Autónomo), y si dispones de carnet de conducir o vehículo propio.</p> <h3 id=\"A-campo-leida-documentacion-bienvenida\">Campo \"Leída Documentación Bienvenida\"</h3> <p>Al final del formulario encontrarás un campo <strong>Leída Documentación Bienvenida</strong> con opciones SI / NO. Márcalo como <strong>SI</strong> cuando hayas leído el documento de bienvenida de la empresa. Esto se sincroniza automáticamente con la sección <strong>Confirmaciones de Entrega</strong>.</p> <p>Cuando termines de editar, pulsa <strong>Enviar</strong> para guardar los cambios.</p> <hr> <h2 id=\"A-8-confirmaciones-de-entrega\">8. Confirmaciones de Entrega</h2> <p>La sección <strong>Confirmaciones de Entrega</strong> muestra las tareas de confirmació";
      out = out + "n que RRHH te ha asignado. Cada tarea requiere que confirmes que has recibido o leído algo.</p> <strong>Columnas:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Mensaje</strong></td><td>Descripción de lo que debes confirmar</td></tr> <tr><td><strong>Estado</strong></td><td>Pendiente / Confirmado</td></tr> <tr><td><strong>Confirmar</strong></td><td>Botón para marcar como confirmado</td></tr> <tr><td><strong>Tipo</strong></td><td>Categoría (ej: Lectura Documentación Bienvenida)</td></tr></tbody></table> <h3 id=\"A-como-confirmar\">Cómo confirmar</h3> <ol><li>Lee el mensaje de la tarea.</li> <li>Realiza la acción indicada (por ejemplo, lee el documento de bienvenida).</li> <li>Pulsa el botón <strong>Confirmar</strong> en la columna correspondiente.</li> <li>El estado cambiará a <strong>Confirmado</strong> y el botón quedará deshabilitado.<";
      out = out + "/li> </ol> <blockquote><strong>Nota:</strong> Una vez confirmada, la acción no se puede deshacer. Confirma solo cuando hayas completado efectivamente la tarea.</blockquote> <hr> <h2 id=\"A-9-encuestas\">9. Encuestas</h2> <p>La sección <strong>Encuestas</strong> muestra las encuestas activas que la empresa ha preparado para ti a través de Zoho Survey.</p> <p>Cada encuesta aparece como una tarjeta con:</p> <ul><li><strong>Nombre de la encuesta</strong></li> <li><strong>Enlace directo</strong> para acceder a ella</li> </ul> <h3 id=\"A-como-participar\">Cómo participar</h3> <ol><li>Ve a <strong>Encuestas</strong> en el menú lateral.</li> <li>Haz clic en el enlace de la encuesta que quieras responder.</li> <li>Se abrirá la encuesta en una nueva pestaña (Zoho Survey).</li> <li>Completa la encuesta y envíala.</li> </ol> <p>El número de encuestas pendientes también aparece como un <strong>badge ";
      out = out + "verde</strong> en la tarjeta del Tablero Inicio.</p> <hr> <hr> <h2 id=\"A-10-mis-formaciones\">10. Mis Formaciones</h2> <strong>Ruta de menú:</strong> Portal del Empleado → Mis Formaciones <strong>URL directa:</strong> <code>#Page:Mis_Formaciones</code> <p>La sección <strong>Mis Formaciones</strong> muestra las formaciones a las que estás convocado o en las que has participado.</p> <p>En la parte superior aparece una tarjeta con tu nombre, apellidos y área profesional.</p> <strong>Sección \"Próximas Formaciones\":</strong> <p>Cursos y jornadas formativas pendientes a los que has sido convocado. Si no tienes ninguna próxima, aparece el mensaje <em>\"No tienes próximas formaciones convocadas\"</em>.</p> <strong>Sección \"Historial\":</strong> <p>Muestra tus formaciones pasadas (ya finalizadas), con el número total entre paréntesis. Las columnas son:</p> <table><thead><tr><th>Columna</th><t";
      out = out + "h>Descripción</th></tr></thead><tbody><tr><td><strong>Estado</strong></td><td>Estado de la formación (ej. Finalizada)</td></tr> <tr><td><strong>Formación</strong></td><td>Nombre o descripción del curso</td></tr> <tr><td><strong>Fecha</strong></td><td>Fecha de celebración</td></tr> <tr><td><strong>Dur.</strong></td><td>Duración en horas</td></tr> <tr><td><strong>Centro</strong></td><td>Centro formativo donde se impartió</td></tr></tbody></table> <blockquote>Si la sección aparece vacía, el departamento aún no ha registrado formaciones en el sistema o no has sido convocado a ninguna.</blockquote> <hr> <h2 id=\"A-resumen-de-funcionalidades\">Resumen de funcionalidades</h2> <table><thead><tr><th>Sección</th><th>Qué puedes hacer</th></tr></thead><tbody><tr><td>Tablero Inicio</td><td>Ver tu información resumida y documentación con clientes</td></tr> <tr><td>Mis Permisos</td><td>Ver el estado de";
      out = out + " todas tus solicitudes de permiso</td></tr> <tr><td>Solicitudes Permisos</td><td>Historial detallado de solicitudes</td></tr> <tr><td>Nueva Solicitud Permiso</td><td>Solicitar vacaciones o permisos (min. 15 días de antelación)</td></tr> <tr><td>Mis EPIs</td><td>Ver todos tus equipos/herramientas solicitados con sus estados</td></tr> <tr><td>Solicitudes EPI</td><td>Historial detallado, confirmar entregas</td></tr> <tr><td>Nueva Solicitud EPI</td><td>Solicitar EPI, ropa de trabajo o herramientas</td></tr> <tr><td><strong>Mis Activos</strong></td><td>Ver equipos y herramientas actualmente asignados a tu nombre</td></tr> <tr><td>Mis Mensajes</td><td>Chat directo con RRHH</td></tr> <tr><td>Datos del Empleado</td><td>Ver y actualizar tu información personal y profesional</td></tr> <tr><td>Confirmaciones de Entrega</td><td>Confirmar recepción de documentos o equipos</td></tr> <tr><td>Encuestas<";
      out = out + "/td><td>Responder encuestas de la empresa</td></tr> <tr><td><strong>Mis Formaciones</strong></td><td>Consultar próximas formaciones y tu historial de cursos</td></tr></tbody></table> <hr> <em>Manual actualizado el 07/04/2026 — Gestión de Recursos Humanos v2026</em> </div> </div> </div>";
      return out;
    }
    out = "";
    out = out + "<style> .wk-root{font-family:'Segoe UI',Calibri,Arial,sans-serif;color:#1a1a1a;max-width:1200px;margin:0 auto;padding:16px;} .wk-root h1{font-size:26px;color:#1C3A5E;border-bottom:3px solid #1C3A5E;padding-bottom:8px;margin:0 0 16px;} .wk-root h2{font-size:20px;color:#1C3A5E;border-bottom:1px solid #ccc;padding-bottom:6px;margin:28px 0 12px;scroll-margin-top:16px;} .wk-root h3{font-size:16px;color:#2d5a8e;margin:20px 0 10px;scroll-margin-top:16px;} .wk-root h4{font-size:14px;color:#2d5a8e;margin:14px 0 8px;} .wk-root p{line-height:1.6;margin:8px 0;} .wk-root table{width:100%;border-collapse:collapse;margin:10px 0 16px;font-size:13px;} .wk-root th{background:#1C3A5E;color:#fff;text-align:left;padding:7px 10px;font-weight:600;} .wk-root td{border:1px solid #ddd;padding:6px 10px;vertical-align:top;} .wk-root tr:nth-child(even) td{background:#f8f9fa;} .wk-root blockquote{background:#f0f7ff;b";
    out = out + "order-left:4px solid #2d5a8e;padding:10px 14px;margin:12px 0;color:#333;} .wk-root code{background:#f0f0f0;padding:1px 5px;border-radius:3px;font-size:12px;font-family:Consolas,'Courier New',monospace;} .wk-root pre{background:#f5f5f5;border:1px solid #ddd;padding:10px;border-radius:4px;font-size:12px;overflow-x:auto;} .wk-root a{color:#1C3A5E;} .wk-root hr{border:0;border-top:1px solid #e0e0e0;margin:18px 0;} .wk-root ul,.wk-root ol{line-height:1.6;} .wk-root mark{background:#ffeb3b;padding:0 2px;border-radius:2px;} /* header */ .wk-header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;} .wk-title{font-size:26px;font-weight:700;color:#1C3A5E;margin:0;} .wk-breadcrumb{font-size:13px;color:#666;} .wk-breadcrumb a{color:#1C3A5E;text-decoration:none;} .wk-breadcrumb a:hover{text-decoration:underline;} /* search box */ .wk-search{background:#f5f7fb;bord";
    out = out + "er:1px solid #d9e0ec;border-radius:8px;padding:14px 16px;margin:16px 0;} .wk-search-title{font-size:13px;color:#1C3A5E;font-weight:600;margin-bottom:8px;} .wk-tags{display:flex;flex-wrap:wrap;gap:6px;} .wk-tag{display:inline-block;padding:4px 10px;background:#fff;border:1px solid #c4cfe0;border-radius:14px;font-size:12px;color:#1C3A5E;text-decoration:none;} .wk-tag:hover{background:#e7eef9;border-color:#1C3A5E;} .wk-tag.active{background:#1C3A5E;color:#fff;border-color:#1C3A5E;} .wk-search-hint{font-size:11px;color:#666;margin-top:8px;font-style:italic;} .wk-search-clear{font-size:12px;color:#b33;text-decoration:none;margin-left:6px;} .wk-search-clear:hover{text-decoration:underline;} /* index cards */ .wk-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:20px;} .wk-card{display:block;background:#fff;border:1px solid #d9e0ec;border-radius:8px";
    out = out + ";padding:18px;text-decoration:none;color:inherit;transition:all .15s;} .wk-card:hover{border-color:#1C3A5E;box-shadow:0 2px 8px rgba(28,58,94,0.12);transform:translateY(-1px);} .wk-card-icon{font-size:32px;margin-bottom:8px;} .wk-card-title{font-size:16px;font-weight:700;color:#1C3A5E;margin:4px 0;} .wk-card-desc{font-size:13px;color:#555;line-height:1.5;} .wk-card-mod{font-size:11px;color:#999;font-weight:600;letter-spacing:.5px;} /* search results */ .wk-results{margin-top:18px;} .wk-result{background:#fff;border:1px solid #e0e6ef;border-radius:6px;padding:12px 14px;margin-bottom:8px;} .wk-result-mod{display:inline-block;background:#e7eef9;color:#1C3A5E;font-size:11px;font-weight:600;padding:2px 7px;border-radius:3px;margin-right:8px;} .wk-result-title{font-size:14px;color:#1C3A5E;text-decoration:none;font-weight:600;} .wk-result-title:hover{text-decoration:underline;} .wk-result-snipp";
    out = out + "et{font-size:12px;color:#555;margin-top:4px;line-height:1.5;} .wk-no-results{padding:24px;text-align:center;color:#888;font-style:italic;background:#fafbfd;border-radius:6px;} /* module layout */ .wk-layout{display:grid;grid-template-columns:260px 1fr;gap:24px;margin-top:18px;} @media (max-width: 900px){.wk-layout{grid-template-columns:1fr;}} .wk-toc{background:#f5f7fb;border:1px solid #d9e0ec;border-radius:8px;padding:14px;position:sticky;top:12px;max-height:calc(100vh - 40px);overflow-y:auto;font-size:13px;} .wk-toc-title{font-size:12px;font-weight:700;color:#1C3A5E;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;} .wk-toc ol{list-style:none;padding:0;margin:0;} .wk-toc li{margin:3px 0;} .wk-toc a{color:#333;text-decoration:none;display:block;padding:3px 6px;border-radius:3px;line-height:1.35;} .wk-toc a:hover{background:#e7eef9;color:#1C3A5E;} .wk-toc .lvl-3{padding-lef";
    out = out + "t:14px;font-size:12px;color:#666;} .wk-toc .lvl-4{padding-left:26px;font-size:11px;color:#888;} .wk-content{min-width:0;} </style> <div class=\"wk-root\"> <div class=\"wk-breadcrumb\"> <a href=\"#Page:Manual_de_Usuario\">📚 Manual de Usuario</a> › Módulo A </div> <div class=\"wk-header\" style=\"margin-top:6px;\"> <h1 class=\"wk-title\">👷 Portal del Empleado</h1> <div class=\"wk-breadcrumb\"> <a href=\"#Page:Manual_de_Usuario\">Índice</a> · <a href=\"#Page:Manual_de_Usuario_Modulo?Mod=B\">Módulo B →</a> </div> </div> <div class=\"wk-search\"> <div class=\"wk-search-title\">🔍 Búsqueda rápida</div> <div class=\"wk-tags\"><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=permisos\">permisos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=vacaciones\">vacaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=EPI\">EPI</a><a class=\";
    out = out + ""wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=herramientas\">herramientas</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=ropa\">ropa</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=activos\">activos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=documentos\">documentos</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=clientes\">clientes</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=caducidad\">caducidad</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=mensajes\">mensajes</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=chat\">chat</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=asignaciones\">asignaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=t%C3%A9cnico\">técnico</a><a class=\"wk";
    out = out + "-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=empleado\">empleado</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=formaciones\">formaciones</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=WhatsApp\">WhatsApp</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=encuestas\">encuestas</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=configuraci%C3%B3n\">configuración</a><a class=\"wk-tag\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A&Q=notificaciones\">notificaciones</a></div> <div class=\"wk-search-hint\">Mostrando coincidencias para \"%%Q_DISP%%\". <a class=\"wk-search-clear\" href=\"#Page:Manual_de_Usuario_Modulo?Mod=A\">✕ limpiar</a></div> </div> <div class=\"wk-layout\"> <nav class=\"wk-toc\"> <div class=\"wk-toc-title\">En esta página</div> <ol><li class=\"lvl-3\"><a href=\"#A-tarjetas-de-informacion-p";
    out = out + "arte-superior\">Tarjetas de información (parte superior)</a></li><li class=\"lvl-3\"><a href=\"#A-seccion-confirmaciones-de-entrega\">Sección &quot;Confirmaciones de Entrega&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-seccion-documentacion-con-clientes\">Sección &quot;Documentación con Clientes&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-31-mis-permisos\">3.1 Mis Permisos</a></li><li class=\"lvl-3\"><a href=\"#A-32-historial-de-solicitudes\">3.2 Historial de solicitudes</a></li><li class=\"lvl-3\"><a href=\"#A-33-nueva-solicitud-de-permiso\">3.3 Nueva solicitud de permiso</a></li><li class=\"lvl-3\"><a href=\"#A-41-mis-epis\">4.1 Mis EPIs</a></li><li class=\"lvl-3\"><a href=\"#A-42-historial-de-solicitudes-epi\">4.2 Historial de solicitudes EPI</a></li><li class=\"lvl-3\"><a href=\"#A-43-nueva-solicitud-de-epi-o-herramienta\">4.3 Nueva solicitud de EPI o herramienta</a></li><li cla";
    out = out + "ss=\"lvl-3\"><a href=\"#A-enviar-un-nuevo-mensaje\">Enviar un nuevo mensaje</a></li><li class=\"lvl-3\"><a href=\"#A-datos-basicos\">Datos Básicos</a></li><li class=\"lvl-3\"><a href=\"#A-datos-de-contacto\">Datos de Contacto</a></li><li class=\"lvl-3\"><a href=\"#A-datos-profesionales\">Datos Profesionales</a></li><li class=\"lvl-3\"><a href=\"#A-regimen-y-otra-informacion\">Régimen y Otra Información</a></li><li class=\"lvl-3\"><a href=\"#A-campo-leida-documentacion-bienvenida\">Campo &quot;Leída Documentación Bienvenida&quot;</a></li><li class=\"lvl-3\"><a href=\"#A-como-confirmar\">Cómo confirmar</a></li><li class=\"lvl-3\"><a href=\"#A-como-participar\">Cómo participar</a></li><li class=\"lvl-2\"><a href=\"#A-indice\">Índice</a></li><li class=\"lvl-2\"><a href=\"#A-1-acceso-al-portal\">1. Acceso al portal</a></li><li class=\"lvl-2\"><a href=\"#A-2-tablero-inicio\">2. Tablero Inicio<";
    out = out + "/a></li><li class=\"lvl-2\"><a href=\"#A-3-solicitudes-de-permisos\">3. Solicitudes de Permisos</a></li><li class=\"lvl-2\"><a href=\"#A-4-epis-ropa-y-herramientas\">4. EPIs, Ropa y Herramientas</a></li><li class=\"lvl-2\"><a href=\"#A-5-mis-activos\">5. Mis Activos</a></li><li class=\"lvl-2\"><a href=\"#A-6-mis-mensajes\">6. Mis Mensajes</a></li><li class=\"lvl-2\"><a href=\"#A-7-datos-del-empleado\">7. Datos del Empleado</a></li><li class=\"lvl-2\"><a href=\"#A-8-confirmaciones-de-entrega\">8. Confirmaciones de Entrega</a></li><li class=\"lvl-2\"><a href=\"#A-9-encuestas\">9. Encuestas</a></li><li class=\"lvl-2\"><a href=\"#A-10-mis-formaciones\">10. Mis Formaciones</a></li><li class=\"lvl-2\"><a href=\"#A-resumen-de-funcionalidades\">Resumen de funcionalidades</a></li></ol> </nav> <div class=\"wk-content\"> <h1 id=\"A-modulo-a-portal-del-empleado\">Módulo A — Portal del Empleado</h1> ";
    out = out + "<strong>Perfil:</strong> Usuario Trabajador <strong>Acceso:</strong> <a href=\"https://domo21.zohocreatorportal.com\" target=\"_blank\" rel=\"noopener\">https://domo21.zohocreatorportal.com</a> <strong>Versión:</strong> 1.1 — Abril 2026 <hr> <h2 id=\"A-indice\">Índice</h2> <ol><li><a href=\"#A-1-acceso-al-portal\">Acceso al portal</a></li> <li><a href=\"#A-2-tablero-inicio\">Tablero Inicio</a></li> <li><a href=\"#A-3-solicitudes-de-permisos\">Solicitudes de Permisos</a></li> </ol> - 3.1 <a href=\"#A-31-mis-permisos\">Mis Permisos</a> <p> - 3.2 <a href=\"#A-32-historial-de-solicitudes\">Historial de solicitudes</a></p> <p> - 3.3 <a href=\"#A-33-nueva-solicitud-de-permiso\">Nueva solicitud de permiso</a></p> <ol><li><a href=\"#A-4-epis-ropa-y-herramientas\">EPIs, Ropa y Herramientas</a></li> </ol> - 4.1 <a href=\"#A-41-mis-epis\">Mis EPIs</a> <p> - 4.2 <a href=\"#A-42-historial-de-solicitu";
    out = out + "des-epi\">Historial de solicitudes EPI</a></p> <p> - 4.3 <a href=\"#A-43-nueva-solicitud-de-epi-o-herramienta\">Nueva solicitud de EPI o herramienta</a></p> <ol><li><a href=\"#A-5-mis-activos\">Mis Activos</a></li> <li><a href=\"#A-6-mis-mensajes\">Mis Mensajes</a></li> <li><a href=\"#A-7-datos-del-empleado\">Datos del Empleado</a></li> <li><a href=\"#A-8-confirmaciones-de-entrega\">Confirmaciones de Entrega</a></li> <li><a href=\"#A-9-encuestas\">Encuestas</a></li> <li><a href=\"#A-10-mis-formaciones\">Mis Formaciones</a></li> </ol> <hr> <h2 id=\"A-1-acceso-al-portal\">1. Acceso al portal</h2> <p>Accede al portal desde cualquier navegador en la dirección:</p> <strong><a href=\"https://domo21.zohocreatorportal.com\" target=\"_blank\" rel=\"noopener\">https://domo21.zohocreatorportal.com</a></strong> <p>Introduce tu dirección de email corporativa y tu contraseña de Zoho. Si es la primera ";
    out = out + "vez que accedes, recibirás un correo de Zoho para crear o vincular tu cuenta.</p> <p>Una vez dentro, verás la barra de navegación lateral izquierda con todas las secciones disponibles para tu perfil.</p> <hr> <h2 id=\"A-2-tablero-inicio\">2. Tablero Inicio</h2> <p>El <strong>Tablero Inicio</strong> es la pantalla principal del portal. Se muestra automáticamente al entrar.</p> <h3 id=\"A-tarjetas-de-informacion-parte-superior\">Tarjetas de información (parte superior)</h3> <p>En la parte superior aparecen cuatro tarjetas con tu información:</p> <table><thead><tr><th>Tarjeta</th><th>Qué muestra</th></tr></thead><tbody><tr><td><strong>Nombre completo</strong></td><td>Tu nombre tal como está registrado en el sistema</td></tr> <tr><td><strong>Área</strong></td><td>Tu área o departamento profesional</td></tr> <tr><td><strong>Clientes Actuales</strong></td><td>Los clientes a los que estás asign";
    out = out + "ado actualmente</td></tr> <tr><td><strong>Encuestas Activas</strong></td><td>Número de encuestas pendientes de responder (badge verde)</td></tr></tbody></table> <h3 id=\"A-seccion-confirmaciones-de-entrega\">Sección \"Confirmaciones de Entrega\"</h3> <p>Justo debajo de las tarjetas aparece la lista de tareas de confirmación pendientes que RRHH te ha asignado. Si no tienes ninguna pendiente, la sección aparecerá vacía.</p> <h3 id=\"A-seccion-documentacion-con-clientes\">Sección \"Documentación con Clientes\"</h3> <p>En la parte inferior del tablero se muestra un resumen de tu documentación requerida por los clientes a los que estás asignado: qué documentos están al día, cuáles están pendientes de subir y cuáles han caducado.</p> <blockquote><strong>Nota:</strong> Si la sección aparece vacía, puede que aún no estés asignado a ningún cliente o que no se te haya requerido documentación todav";
    out = out + "ía.</blockquote> <hr> <h2 id=\"A-3-solicitudes-de-permisos\">3. Solicitudes de Permisos</h2> <p>Esta sección agrupa todo lo relacionado con tus permisos laborales (vacaciones, permisos retribuidos y no retribuidos). En el menú lateral, haz clic en <strong>Solicitudes de Permisos</strong> para expandir las tres opciones disponibles.</p> <h3 id=\"A-31-mis-permisos\">3.1 Mis Permisos</h3> <p>La página <strong>Mis Permisos</strong> muestra un resumen visual de todas tus solicitudes con su estado actual.</p> <strong>Columnas de la tabla:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Tipo de permiso: Vacaciones, Permiso Retribuido o Permiso no Retribuido</td></tr> <tr><td><strong>Inicio</strong></td><td>Fecha de inicio del permiso</td></tr> <tr><td><strong>Fin</strong></td><td>Fecha de finalización del permiso</td></tr>";
    out = out + " <tr><td><strong>Estado</strong></td><td>Estado actual de la solicitud (ver colores abajo)</td></tr> <tr><td><strong>Nota</strong></td><td>Comentario adicional que incluiste al solicitarlo</td></tr></tbody></table> <strong>Estados posibles:</strong> <ul><li>🟠 <strong>Sin Respuesta</strong> — La solicitud está pendiente de revisión por RRHH</li> <li>🟢 <strong>Aprobado</strong> — RRHH ha aprobado el permiso</li> <li>🔴 <strong>Rechazado</strong> — La solicitud fue denegada</li> </ul> <p>Pulsa <strong>+ Nueva Solicitud</strong> (botón azul arriba a la derecha) para crear una nueva solicitud directamente desde esta vista.</p> <h3 id=\"A-32-historial-de-solicitudes\">3.2 Historial de solicitudes</h3> <p>La opción <strong>Solicitudes Permisos</strong> del menú muestra el listado completo de tus solicitudes de permiso, con columnas adicionales como el tipo de permiso retribuido o no retribuid";
    out = out + "o. Puedes usar el botón <strong>Búsqueda Avanzada</strong> para filtrar por fechas o estado.</p> <h3 id=\"A-33-nueva-solicitud-de-permiso\">3.3 Nueva solicitud de permiso</h3> <p>Haz clic en <strong>Nueva Solicitud Permiso</strong> en el menú (o en el botón <strong>+ Nueva Solicitud</strong> desde cualquier vista de permisos).</p> <blockquote>⚠️ <strong>Importante:</strong> Las solicitudes deben hacerse con al menos <strong>15 días de antelación</strong>.</blockquote> <strong>Campos del formulario:</strong> <table><thead><tr><th>Campo</th><th>Obligatorio</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>✓</td><td>Selecciona: Vacaciones / Permiso Retribuido / Permiso no Retribuido</td></tr> <tr><td><strong>Fecha de comienzo</strong></td><td>✓</td><td>Se rellena automáticamente con la fecha de hoy + 15 días</td></tr> <tr><td><strong>Fecha de Fin</strong></td";
    out = out + "><td>✓</td><td>Se rellena con ~7 días después de la fecha de inicio</td></tr> <tr><td><strong>Nota</strong></td><td>—</td><td>Texto libre opcional para añadir contexto</td></tr></tbody></table> <p>Pulsa <strong>Enviar</strong> para registrar la solicitud. RRHH la recibirá y la tramitará. Puedes consultar el estado en <strong>Mis Permisos</strong> o en <strong>Solicitudes Permisos</strong>.</p> <hr> <h2 id=\"A-4-epis-ropa-y-herramientas\">4. EPIs, Ropa y Herramientas</h2> <p>Esta sección agrupa las solicitudes de Equipos de Protección Individual (EPI), ropa de trabajo y herramientas. En el menú lateral, haz clic en <strong>Solicitud de EPI - Herramientas</strong> para expandir las opciones.</p> <h3 id=\"A-41-mis-epis\">4.1 Mis EPIs</h3> <p>La página <strong>Mis EPIs</strong> muestra un resumen visual de todos los equipos y herramientas que has solicitado, con su estado actual en formato d";
    out = out + "e tabla con badges de colores.</p> <strong>Columnas:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Badge de color: EPI (azul), ROPA (morado), HERRAMIENTA (verde)</td></tr> <tr><td><strong>Equipo Solicitado</strong></td><td>Descripción del equipo que solicitaste</td></tr> <tr><td><strong>Equipo Asignado</strong></td><td>Nombre del equipo concreto que te fue asignado</td></tr> <tr><td><strong>Fecha Entrega</strong></td><td>Fecha en que fue entregado</td></tr> <tr><td><strong>Estado</strong></td><td>Estado actual (ver colores abajo)</td></tr></tbody></table> <strong>Estados posibles:</strong> <ul><li>🟢 <strong>Entregado / Confirmado</strong> — El equipo fue entregado y confirmada la recepción</li> <li>🟠 <strong>Aprobado / Gestionándose</strong> — La solicitud está aprobada y en proceso</li> <li>🔴 <strong>Rechazado";
    out = out + "</strong> — La solicitud fue denegada</li> <li>⚫ <strong>Pendiente</strong> — En espera de revisión</li> </ul> <p>Pulsa <strong>+ Nueva Solicitud</strong> para crear una solicitud desde esta vista.</p> <h3 id=\"A-42-historial-de-solicitudes-epi\">4.2 Historial de solicitudes EPI</h3> <p>La opción <strong>Solicitudes EPI - Herramientas</strong> del menú muestra el listado detallado de tus solicitudes, incluyendo el historial de cambios de estado (columna <strong>Historia de la Solicitud</strong>) y la columna <strong>Confirmar</strong>.</p> <strong>Columna \"Confirmar\":</strong> <p>Cuando el equipo te sea entregado físicamente, pulsa el botón <strong>Confirmar</strong> en la fila correspondiente para registrar la recepción. El botón aparece deshabilitado si la entrega ya fue confirmada.</p> <strong>Historia de la solicitud (ejemplo):</strong> <pre><code>Creado - 10-12-2025 16:13:29 Entre";
    out = out + "gado - 16-12-2025 14:07:30 </code></pre> <h3 id=\"A-43-nueva-solicitud-de-epi-o-herramienta\">4.3 Nueva solicitud de EPI o herramienta</h3> <p>Haz clic en <strong>Nueva Solicitud EPI - H...</strong> en el menú.</p> <strong>Campos del formulario:</strong> <table><thead><tr><th>Campo</th><th>Obligatorio</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo de equipo solicitado</strong></td><td>✓</td><td>Selecciona: EPI / ROPA / HERRAMIENTA</td></tr> <tr><td><strong>Equipo Solicitado</strong></td><td>✓</td><td>Describe con detalle qué necesitas (texto libre)</td></tr> <tr><td><strong>Motivo de la Solicitud</strong></td><td>—</td><td>Explica por qué lo necesitas (opcional pero recomendado)</td></tr></tbody></table> <p>Pulsa <strong>Enviar</strong>. RRHH recibirá la solicitud y la gestionará. Sigue el estado en <strong>Mis EPIs</strong> o en <strong>Solicitudes EPI - Herramientas</";
    out = out + "strong>.</p> <hr> <h2 id=\"A-5-mis-activos\">5. Mis Activos</h2> <strong>Ruta de menú:</strong> Portal del Empleado → Mis Activos <strong>URL directa:</strong> <code>#Page:Mis_Activos</code> <p>La sección <strong>Mis Activos</strong> muestra todos los equipos, herramientas y prendas de trabajo que tienes asignados actualmente en estado <strong>activo</strong>, es decir, que sigues teniendo en tu poder.</p> <strong>Columnas de la tabla:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Tipo</strong></td><td>Badge de color: EPI (azul), ROPA (morado), HERR. (verde)</td></tr> <tr><td><strong>Elemento</strong></td><td>Nombre del activo asignado (ej. \"Gato hidráulico\")</td></tr> <tr><td><strong>Serie</strong></td><td>Número de serie del equipo (ej. GH00002)</td></tr> <tr><td><strong>Unidades</strong></td><td>Cantidad asignada</td></tr></tbody>";
    out = out + "</table> <blockquote>Si la tabla aparece vacía, significa que no tienes activos registrados a tu nombre en este momento.</blockquote> <p>Pulsa <strong>+ Solicitar EPI / Herramienta</strong> para solicitar un nuevo equipo o herramienta si lo necesitas.</p> <hr> <h2 id=\"A-6-mis-mensajes\">6. Mis Mensajes</h2> <p>La sección <strong>Mis Mensajes</strong> es el canal de comunicación directa entre tú y el equipo de RRHH.</p> <p>La vista muestra una interfaz tipo chat con:</p> <ul><li><strong>Burbujas derechas (verde/gris oscuro)</strong> — Tus mensajes enviados a RRHH</li> <li><strong>Burbujas izquierdas (blancas)</strong> — Respuestas del equipo de RRHH, con la etiqueta del autor (nombre del gestor o \"RRHH\")</li> <li><strong>Marcas de tiempo</strong> — Fecha y hora de cada mensaje</li> <li><strong>Indicador ✓</strong> — Confirma que tu mensaje fue recibido</li> </ul> <h3 id=\"A-enviar-un-n";
    out = out + "uevo-mensaje\">Enviar un nuevo mensaje</h3> <p>Pulsa el botón <strong>✉ Enviar nuevo mensaje</strong> en la parte inferior del chat. Se abrirá un formulario con un único campo de texto libre. Escribe tu consulta y pulsa <strong>Enviar</strong>.</p> <blockquote><strong>Consejo:</strong> Usa este canal para consultas sobre tu contrato, nóminas, días de vacaciones disponibles, o cualquier duda relacionada con tu situación laboral.</blockquote> <hr> <h2 id=\"A-7-datos-del-empleado\">7. Datos del Empleado</h2> <p>La sección <strong>Datos del Empleado</strong> te permite consultar y actualizar tu información personal y profesional registrada en el sistema.</p> <p>El formulario está dividido en cuatro secciones:</p> <h3 id=\"A-datos-basicos\">Datos Básicos</h3> <table><thead><tr><th>Campo</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Nombre</strong></td><td>Nombre y apellidos (Fir";
    out = out + "st Name + Last Name)</td></tr> <tr><td><strong>Email</strong></td><td>Email corporativo (principal)</td></tr> <tr><td><strong>Email Personal o Secundario</strong></td><td>Email alternativo para comunicaciones</td></tr> <tr><td><strong>Moneda</strong></td><td>Moneda de referencia para tu contrato</td></tr> <tr><td><strong>Fecha de Nacimiento</strong></td><td>Formato dd-MM-yyyy</td></tr> <tr><td><strong>Foto</strong></td><td>Foto de perfil (puedes subir desde tu equipo o pegar una URL)</td></tr> <tr><td><strong>DNI / NIE / Pasaporte</strong></td><td>Documento de identidad</td></tr> <tr><td><strong>Móvil</strong></td><td>Teléfono móvil con prefijo de país</td></tr> <tr><td><strong>Teléfono</strong></td><td>Teléfono fijo opcional</td></tr> <tr><td><strong>Idioma</strong></td><td>Idioma preferido</td></tr> <tr><td><strong>Sexo</strong></td><td>Masculino / Femenino</td></tr></tbody></table> <h";
    out = out + "3 id=\"A-datos-de-contacto\">Datos de Contacto</h3> <p>Dirección completa: calle, código postal, país, ciudad, estado/provincia y comarca. También incluye campos para indicar si dispones de <strong>habitación de empresa</strong> o si la necesitas.</p> <h3 id=\"A-datos-profesionales\">Datos Profesionales</h3> <table><thead><tr><th>Campo</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Área Profesional</strong></td><td>Tu área de trabajo (ej: INFORMÁTICA, CONSTRUCCIÓN)</td></tr> <tr><td><strong>Profesión</strong></td><td>Tu profesión específica</td></tr> <tr><td><strong>Categoría Profesional</strong></td><td>Nivel (ej: INGENIERO, TÉCNICO)</td></tr> <tr><td><strong>Puesto laboral actual</strong></td><td>Denominación actual del puesto</td></tr> <tr><td><strong>Especialidad</strong></td><td>Especialidad dentro de tu profesión</td></tr> <tr><td><strong>Información adicional</strong>";
    out = out + "</td><td>Campo libre para información complementaria</td></tr></tbody></table> <h3 id=\"A-regimen-y-otra-informacion\">Régimen y Otra Información</h3> <p>Datos sobre tu tipo de régimen laboral (General / Autónomo), y si dispones de carnet de conducir o vehículo propio.</p> <h3 id=\"A-campo-leida-documentacion-bienvenida\">Campo \"Leída Documentación Bienvenida\"</h3> <p>Al final del formulario encontrarás un campo <strong>Leída Documentación Bienvenida</strong> con opciones SI / NO. Márcalo como <strong>SI</strong> cuando hayas leído el documento de bienvenida de la empresa. Esto se sincroniza automáticamente con la sección <strong>Confirmaciones de Entrega</strong>.</p> <p>Cuando termines de editar, pulsa <strong>Enviar</strong> para guardar los cambios.</p> <hr> <h2 id=\"A-8-confirmaciones-de-entrega\">8. Confirmaciones de Entrega</h2> <p>La sección <strong>Confirmaciones de Entrega</s";
    out = out + "trong> muestra las tareas de confirmación que RRHH te ha asignado. Cada tarea requiere que confirmes que has recibido o leído algo.</p> <strong>Columnas:</strong> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Mensaje</strong></td><td>Descripción de lo que debes confirmar</td></tr> <tr><td><strong>Estado</strong></td><td>Pendiente / Confirmado</td></tr> <tr><td><strong>Confirmar</strong></td><td>Botón para marcar como confirmado</td></tr> <tr><td><strong>Tipo</strong></td><td>Categoría (ej: Lectura Documentación Bienvenida)</td></tr></tbody></table> <h3 id=\"A-como-confirmar\">Cómo confirmar</h3> <ol><li>Lee el mensaje de la tarea.</li> <li>Realiza la acción indicada (por ejemplo, lee el documento de bienvenida).</li> <li>Pulsa el botón <strong>Confirmar</strong> en la columna correspondiente.</li> <li>El estado cambiará a <strong>Confirmado</st";
    out = out + "rong> y el botón quedará deshabilitado.</li> </ol> <blockquote><strong>Nota:</strong> Una vez confirmada, la acción no se puede deshacer. Confirma solo cuando hayas completado efectivamente la tarea.</blockquote> <hr> <h2 id=\"A-9-encuestas\">9. Encuestas</h2> <p>La sección <strong>Encuestas</strong> muestra las encuestas activas que la empresa ha preparado para ti a través de Zoho Survey.</p> <p>Cada encuesta aparece como una tarjeta con:</p> <ul><li><strong>Nombre de la encuesta</strong></li> <li><strong>Enlace directo</strong> para acceder a ella</li> </ul> <h3 id=\"A-como-participar\">Cómo participar</h3> <ol><li>Ve a <strong>Encuestas</strong> en el menú lateral.</li> <li>Haz clic en el enlace de la encuesta que quieras responder.</li> <li>Se abrirá la encuesta en una nueva pestaña (Zoho Survey).</li> <li>Completa la encuesta y envíala.</li> </ol> <p>El número de encuestas pendiente";
    out = out + "s también aparece como un <strong>badge verde</strong> en la tarjeta del Tablero Inicio.</p> <hr> <hr> <h2 id=\"A-10-mis-formaciones\">10. Mis Formaciones</h2> <strong>Ruta de menú:</strong> Portal del Empleado → Mis Formaciones <strong>URL directa:</strong> <code>#Page:Mis_Formaciones</code> <p>La sección <strong>Mis Formaciones</strong> muestra las formaciones a las que estás convocado o en las que has participado.</p> <p>En la parte superior aparece una tarjeta con tu nombre, apellidos y área profesional.</p> <strong>Sección \"Próximas Formaciones\":</strong> <p>Cursos y jornadas formativas pendientes a los que has sido convocado. Si no tienes ninguna próxima, aparece el mensaje <em>\"No tienes próximas formaciones convocadas\"</em>.</p> <strong>Sección \"Historial\":</strong> <p>Muestra tus formaciones pasadas (ya finalizadas), con el número total entre paréntesis. Las columnas son:<";
    out = out + "/p> <table><thead><tr><th>Columna</th><th>Descripción</th></tr></thead><tbody><tr><td><strong>Estado</strong></td><td>Estado de la formación (ej. Finalizada)</td></tr> <tr><td><strong>Formación</strong></td><td>Nombre o descripción del curso</td></tr> <tr><td><strong>Fecha</strong></td><td>Fecha de celebración</td></tr> <tr><td><strong>Dur.</strong></td><td>Duración en horas</td></tr> <tr><td><strong>Centro</strong></td><td>Centro formativo donde se impartió</td></tr></tbody></table> <blockquote>Si la sección aparece vacía, el departamento aún no ha registrado formaciones en el sistema o no has sido convocado a ninguna.</blockquote> <hr> <h2 id=\"A-resumen-de-funcionalidades\">Resumen de funcionalidades</h2> <table><thead><tr><th>Sección</th><th>Qué puedes hacer</th></tr></thead><tbody><tr><td>Tablero Inicio</td><td>Ver tu información resumida y documentación con clientes</td></tr> <tr><";
    out = out + "td>Mis Permisos</td><td>Ver el estado de todas tus solicitudes de permiso</td></tr> <tr><td>Solicitudes Permisos</td><td>Historial detallado de solicitudes</td></tr> <tr><td>Nueva Solicitud Permiso</td><td>Solicitar vacaciones o permisos (min. 15 días de antelación)</td></tr> <tr><td>Mis EPIs</td><td>Ver todos tus equipos/herramientas solicitados con sus estados</td></tr> <tr><td>Solicitudes EPI</td><td>Historial detallado, confirmar entregas</td></tr> <tr><td>Nueva Solicitud EPI</td><td>Solicitar EPI, ropa de trabajo o herramientas</td></tr> <tr><td><strong>Mis Activos</strong></td><td>Ver equipos y herramientas actualmente asignados a tu nombre</td></tr> <tr><td>Mis Mensajes</td><td>Chat directo con RRHH</td></tr> <tr><td>Datos del Empleado</td><td>Ver y actualizar tu información personal y profesional</td></tr> <tr><td>Confirmaciones de Entrega</td><td>Confirmar recepción de documento";
    out = out + "s o equipos</td></tr> <tr><td>Encuestas</td><td>Responder encuestas de la empresa</td></tr> <tr><td><strong>Mis Formaciones</strong></td><td>Consultar próximas formaciones y tu historial de cursos</td></tr></tbody></table> <hr> <em>Manual actualizado el 07/04/2026 — Gestión de Recursos Humanos v2026</em> </div> </div> </div>";
    out = out.replaceAll("%%Q_DISP%%", q);
    qUp = q.toUpperCase();
    qLo = q.toLowerCase();
    out = out.replaceAll(q, "<mark>" + q + "</mark>");
    if(qUp != q) { out = out.replaceAll(qUp, "<mark>" + qUp + "</mark>"); }
    if(qLo != q && qLo != qUp) { out = out.replaceAll(qLo, "<mark>" + qLo + "</mark>"); }
    return out;
  }
