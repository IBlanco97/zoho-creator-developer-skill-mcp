string Calendario52HTML.DevolverHTMLTableroSTOP2(string periodo)
{
	// periodo: "7" | "30" | "90" | "all" (default "30")
	per_ = if(periodo == null || periodo == "" || periodo == "null","30",periodo);
	hoy = zoho.currentdate;
	desde_ = if(per_ == "all",hoy.addYear(-50),hoy.addDay(per_.toLong() * -1));
	regs = STOP2_Analisis_Previo[Fecha_Hora >= desde_];

	cntTotal = 0;
	cntValid = 0;
	cntInvalid = 0;
	cntPend = 0;
	cE1 = 0;
	cE2 = 0;
	cE4 = 0;
	cM2 = 0;
	cA2 = 0;
	cP3 = 0;

	cliTot = Map();
	cliOk = Map();
	cliNom = Map();
	tecTot = Map();
	tecOk = Map();
	tecNom = Map();

	for each r in regs
	{
		cntTotal = cntTotal + 1;
		v_ = ifnull(r.Valida_Intervencion,null);
		if(v_ == true)
		{
			cntValid = cntValid + 1;
		}
		else
		{
			if(v_ == false)
			{
				cntInvalid = cntInvalid + 1;
				if(r.E1_Zona_Obra == true) { cE1 = cE1 + 1; }
				if(r.E2_Zona_Vehiculos == true) { cE2 = cE2 + 1; }
				if(r.E4_Intemperie == true) { cE4 = cE4 + 1; }
				if(r.M2_Limpieza == true) { cM2 = cM2 + 1; }
				if(r.A2_Permiso_Trabajo == "No") { cA2 = cA2 + 1; }
				if(r.P3_Herramientas == "No") { cP3 = cP3 + 1; }
			}
			else
			{
				cntPend = cntPend + 1;
			}
		}
		if(r.Cliente != null)
		{
			ck = r.Cliente.toString();
			prevCT = if(cliTot.containKey(ck),cliTot.get(ck).toLong(),0);
			cliTot.put(ck,(prevCT + 1).toString());
			if(!cliNom.containKey(ck))
			{
				cliNom.put(ck,ifnull(r.Cliente.Nombre_de_Cuenta,"—"));
			}
			if(v_ == true)
			{
				prevCO = if(cliOk.containKey(ck),cliOk.get(ck).toLong(),0);
				cliOk.put(ck,(prevCO + 1).toString());
			}
		}
		if(r.Empleado != null)
		{
			tk = r.Empleado.toString();
			prevTT = if(tecTot.containKey(tk),tecTot.get(tk).toLong(),0);
			tecTot.put(tk,(prevTT + 1).toString());
			if(!tecNom.containKey(tk))
			{
				tecNom.put(tk,ifnull(r.Empleado.Nombre.first_name,"") + " " + ifnull(r.Empleado.Nombre.last_name,""));
			}
			if(v_ == true)
			{
				prevTO = if(tecOk.containKey(tk),tecOk.get(tk).toLong(),0);
				tecOk.put(tk,(prevTO + 1).toString());
			}
		}
	}

	nCliDist = cliTot.keys().size();
	nTecDist = tecTot.keys().size();
	pctGlobal = if(cntTotal > 0,(cntValid * 100) / cntTotal,0);

	// ── Ranking top 8 clientes por volumen ──
	topCli = List();
	usedCli = Map();
	for each idx in {0,1,2,3,4,5,6,7}
	{
		bestKey = "";
		bestVal = -1;
		for each k in cliTot.keys()
		{
			if(usedCli.containKey(k))
			{
				continue;
			}
			v2_ = cliTot.get(k).toLong();
			if(v2_ > bestVal)
			{
				bestVal = v2_;
				bestKey = k;
			}
		}
		if(bestKey == "")
		{
			break;
		}
		usedCli.put(bestKey,1);
		topCli.add(bestKey);
	}

	// ── Ranking top 8 técnicos por volumen ──
	topTec = List();
	usedTec = Map();
	for each idx in {0,1,2,3,4,5,6,7}
	{
		bestKeyT = "";
		bestValT = -1;
		for each k in tecTot.keys()
		{
			if(usedTec.containKey(k))
			{
				continue;
			}
			v3_ = tecTot.get(k).toLong();
			if(v3_ > bestValT)
			{
				bestValT = v3_;
				bestKeyT = k;
			}
		}
		if(bestKeyT == "")
		{
			break;
		}
		usedTec.put(bestKeyT,1);
		topTec.add(bestKeyT);
	}

	// ── HTML: filas de ranking clientes ──
	cliRowsH = "";
	for each ck in topCli
	{
		tot_ = cliTot.get(ck).toLong();
		ok_ = if(cliOk.containKey(ck),cliOk.get(ck).toLong(),0);
		pct_ = if(tot_ > 0,(ok_ * 100) / tot_,0);
		barCls = if(pct_ >= 90,"bg-g",if(pct_ >= 70,"bg-o","bg-r"));
		cliRowsH = cliRowsH + "<div class='rk-row'><span class='rk-n'>" + cliNom.get(ck) + "</span><span class='rk-c'>" + tot_ + "</span><div class='rk-bar'><div class='rk-fill " + barCls + "' style='width:" + pct_ + "%'></div></div><span class='rk-p'>" + pct_ + "%</span></div>";
	}
	if(cliRowsH == "")
	{
		cliRowsH = "<div class='es'>Sin datos en el periodo</div>";
	}

	// ── HTML: filas de ranking técnicos ──
	tecRowsH = "";
	for each tk in topTec
	{
		totT_ = tecTot.get(tk).toLong();
		okT_ = if(tecOk.containKey(tk),tecOk.get(tk).toLong(),0);
		pctT_ = if(totT_ > 0,(okT_ * 100) / totT_,0);
		barClsT = if(pctT_ >= 90,"bg-g",if(pctT_ >= 70,"bg-o","bg-r"));
		tecRowsH = tecRowsH + "<div class='rk-row'><span class='rk-n'>" + tecNom.get(tk) + "</span><span class='rk-c'>" + totT_ + "</span><div class='rk-bar'><div class='rk-fill " + barClsT + "' style='width:" + pctT_ + "%'></div></div><span class='rk-p'>" + pctT_ + "%</span></div>";
	}
	if(tecRowsH == "")
	{
		tecRowsH = "<div class='es'>Sin datos en el periodo</div>";
	}

	// ── HTML: desglose de invalidantes ──
	invMax = cE1;
	if(cE2 > invMax) { invMax = cE2; }
	if(cE4 > invMax) { invMax = cE4; }
	if(cM2 > invMax) { invMax = cM2; }
	if(cA2 > invMax) { invMax = cA2; }
	if(cP3 > invMax) { invMax = cP3; }
	invMaxSafe = if(invMax == 0,1,invMax);
	invRowsH = "<div class='rk-row'><span class='rk-n'>Zona en obra (E1)</span><span class='rk-c'>" + cE1 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cE1 * 100) / invMaxSafe) + "%'></div></div></div>";
	invRowsH = invRowsH + "<div class='rk-row'><span class='rk-n'>Zona veh&iacute;culos (E2)</span><span class='rk-c'>" + cE2 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cE2 * 100) / invMaxSafe) + "%'></div></div></div>";
	invRowsH = invRowsH + "<div class='rk-row'><span class='rk-n'>Intemperie (E4)</span><span class='rk-c'>" + cE4 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cE4 * 100) / invMaxSafe) + "%'></div></div></div>";
	invRowsH = invRowsH + "<div class='rk-row'><span class='rk-n'>Limpieza previa (M2)</span><span class='rk-c'>" + cM2 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cM2 * 100) / invMaxSafe) + "%'></div></div></div>";
	invRowsH = invRowsH + "<div class='rk-row'><span class='rk-n'>Sin permiso de trabajo (A2)</span><span class='rk-c'>" + cA2 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cA2 * 100) / invMaxSafe) + "%'></div></div></div>";
	invRowsH = invRowsH + "<div class='rk-row'><span class='rk-n'>Herramientas en mal estado (P3)</span><span class='rk-c'>" + cP3 + "</span><div class='rk-bar'><div class='rk-fill bg-r' style='width:" + ((cP3 * 100) / invMaxSafe) + "%'></div></div></div>";

	// ── CSS ──
	css = "<style>*{box-sizing:border-box;margin:0;padding:0}";
	css = css + ".ts{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;min-height:100vh}";
	css = css + ".hdr{background:linear-gradient(135deg,#1C3A5E 0%,#2d5a8e 100%);color:#fff;padding:24px 28px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px}";
	css = css + ".hdr h1{font-size:22px;font-weight:800;letter-spacing:-.4px}.hdr p{font-size:12px;opacity:.65;margin-top:3px}";
	css = css + ".pf{display:flex;gap:6px}.pf a{font-size:11px;font-weight:700;padding:6px 12px;border-radius:16px;background:rgba(255,255,255,.14);color:#fff;text-decoration:none;transition:background .15s}.pf a:hover{background:rgba(255,255,255,.26)}.pf a.on{background:#fff;color:#1C3A5E}";
	css = css + ".cnt{padding:20px 24px}";
	css = css + ".kg{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}";
	css = css + ".kc{background:#fff;border-radius:12px;padding:18px 16px;box-shadow:0 1px 4px rgba(0,0,0,.06);border-left:4px solid #cbd5e0;text-align:center}";
	css = css + ".kc b{font-size:32px;font-weight:800;display:block;line-height:1;letter-spacing:-1px}.kc span{font-size:10px;color:#718096;text-transform:uppercase;letter-spacing:.6px;margin-top:5px;display:block}";
	css = css + ".k-b{border-left-color:#3182ce}.k-b b{color:#3182ce}.k-g{border-left-color:#38a169}.k-g b{color:#38a169}.k-r{border-left-color:#e53e3e}.k-r b{color:#e53e3e}.k-n{border-left-color:#1C3A5E}.k-n b{color:#1C3A5E}";
	css = css + ".gr2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px}";
	css = css + "@media(max-width:900px){.gr2{grid-template-columns:1fr}}";
	css = css + ".pan{background:#fff;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,.06);padding:16px 18px}";
	css = css + ".pan h2{font-size:13px;font-weight:700;color:#2d3748;margin-bottom:10px}";
	css = css + ".rk-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #f0f2f5}.rk-row:last-child{border-bottom:none}";
	css = css + ".rk-n{font-size:12px;color:#2d3748;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}";
	css = css + ".rk-c{font-size:11px;color:#718096;font-weight:700;width:26px;text-align:right}";
	css = css + ".rk-bar{flex:1.4;height:8px;background:#edf2f7;border-radius:4px;overflow:hidden;max-width:140px}";
	css = css + ".rk-fill{height:100%;border-radius:4px}.bg-g{background:#38a169}.bg-o{background:#dd6b20}.bg-r{background:#e53e3e}";
	css = css + ".rk-p{font-size:11px;font-weight:700;color:#2d3748;width:36px;text-align:right}";
	css = css + ".es{text-align:center;padding:16px;color:#a0aec0;font-size:12px}";
	css = css + "@media(max-width:768px){.kg{grid-template-columns:repeat(2,1fr)}.hdr{padding:18px 16px}.cnt{padding:16px}}";
	css = css + "</style>";

	// ── Header con selector de periodo ──
	pf7 = if(per_ == "7"," on","");
	pf30 = if(per_ == "30"," on","");
	pf90 = if(per_ == "90"," on","");
	pfAll = if(per_ == "all"," on","");
	h1 = "<div class='ts'><div class='hdr'><div><h1>Tablero STOP2</h1><p>Visi&oacute;n agregada de checklists de seguridad</p></div>";
	h1 = h1 + "<div class='pf'><a class='" + pf7.trim() + "' href='#Page:Tablero_STOP2?Periodo=7'>7 d&iacute;as</a><a class='" + pf30.trim() + "' href='#Page:Tablero_STOP2?Periodo=30'>30 d&iacute;as</a><a class='" + pf90.trim() + "' href='#Page:Tablero_STOP2?Periodo=90'>90 d&iacute;as</a><a class='" + pfAll.trim() + "' href='#Page:Tablero_STOP2?Periodo=all'>Todo</a></div></div>";

	// ── KPI row ──
	h2 = "<div class='cnt'><div class='kg'>";
	h2 = h2 + "<div class='kc k-n'><b>" + cntTotal + "</b><span>Checklists en el periodo</span></div>";
	h2 = h2 + "<div class='kc k-g'><b>" + pctGlobal + "%</b><span>Cumplimiento global</span></div>";
	h2 = h2 + "<div class='kc k-r'><b>" + cntInvalid + "</b><span>Intervenciones bloqueadas</span></div>";
	h2 = h2 + "<div class='kc k-b'><b>" + nCliDist + "</b><span>Clientes con actividad</span></div>";
	h2 = h2 + "</div>";

	// ── Panels: rankings + invalidantes ──
	h3 = "<div class='gr2'>";
	h3 = h3 + "<div class='pan'><h2>Ranking por cliente (" + nCliDist + ")</h2>" + cliRowsH + "</div>";
	h3 = h3 + "<div class='pan'><h2>Ranking por t&eacute;cnico (" + nTecDist + ")</h2>" + tecRowsH + "</div>";
	h3 = h3 + "</div>";
	h3 = h3 + "<div class='pan'><h2>Motivos de bloqueo m&aacute;s frecuentes</h2>" + invRowsH + "</div>";
	h3 = h3 + "</div></div>";

	return css + h1 + h2 + h3;
}
