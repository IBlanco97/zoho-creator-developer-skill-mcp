string Calendario52HTML.DevolverHTMLTableroPRL()
{
	// Count employees
	nEmp = 0;
	for each e in Nuevo_Empleado[ID != 0]
	{
		nEmp = nEmp + 1;
	}
	// Global KPI counters + client counters + card HTML — single loop
	gT = 0;
	gPS = 0;
	gCd = 0;
	gCC = 0;
	gAc = 0;
	gNE = 0;
	gNA = 0;
	gVA = 0;
	nC = 0;
	nD = 0;
	nP = 0;
	nK = 0;
	nOk = 0;
	cH = "";
	for each c in Nuevo_Cliente[Nombre_de_Cuenta != ""]
	{
		nC = nC + 1;
		gT = gT + c.ContadorTotal;
		gPS = gPS + c.ContadorPendietesSubir;
		gCd = gCd + c.ContadorCaducados;
		gCC = gCC + c.ContadorCercaCaducar;
		gAc = gAc + c.ContadorActualizados;
		gNE = gNE + c.ContadorNoEnviados;
		gNA = gNA + c.ContadorEnviadosNoAprobados;
		gVA = gVA + c.ContadorEnviadosAprobados;
		nD = nD + if(c.ContadorTotal > 0, 1, 0);
		hp = c.ContadorCaducados > 0 || c.ContadorPendietesSubir > 0 || c.ContadorNoEnviados > 0;
		nP = nP + if(hp, 1, 0);
		nK = nK + if(c.ContadorCaducados > 0, 1, 0);
		io = c.ContadorTotal > 0 && c.ContadorNoEnviados == 0 && c.ContadorCaducados == 0 && c.ContadorPendietesSubir == 0 && c.ContadorEnviadosNoAprobados == 0;
		nOk = nOk + if(io, 1, 0);
		sc = if(hp, "st-r is-prob" + if(c.ContadorCaducados > 0, " is-cad", ""), if(c.ContadorEnviadosNoAprobados > 0, "st-o", if(io, "st-g is-ok", "st-x")));
		bd = if(hp, if(c.ContadorCaducados > 0, "Caducados", "Pendiente"), if(c.ContadorEnviadosNoAprobados > 0, "En revisión", if(io, "Validado", "Sin docs")));
		bc = if(hp, "br", if(c.ContadorEnviadosNoAprobados > 0, "bo", if(io, "bg", "bx")));
		cH = cH + "<div class='cd " + sc + if(c.ContadorTotal > 0, " has-docs", "") + "'><div class='dh'><span class='dn'>" + c.Nombre_de_Cuenta + "</span><span class='db " + bc + "'>" + bd + "</span></div>" + if(c.CIF != "", "<div class='dm'>" + c.CIF + if(c.Tel_fono != "", " · " + c.Tel_fono, "") + "</div>", "");
		cH = cH + "<div class='dkpi'><span class='kp kx'><b>" + c.ContadorTotal + "</b><span>Total</span></span><span class='kp " + if(c.ContadorPendietesSubir > 0, "kr", "kx") + "'><b>" + c.ContadorPendietesSubir + "</b><span>P.Subir</span></span><span class='kp " + if(c.ContadorActualizados > 0, "kg2", "kx") + "'><b>" + c.ContadorActualizados + "</b><span>Actual.</span></span><span class='kp " + if(c.ContadorCaducados > 0, "kr", "kx") + "'><b>" + c.ContadorCaducados + "</b><span>Cad.</span></span><span class='kp " + if(c.ContadorCercaCaducar > 0, "ky", "kx") + "'><b>" + c.ContadorCercaCaducar + "</b><span>Prox.</span></span><span class='kp " + if(c.ContadorNoEnviados > 0, "kr", "kx") + "'><b>" + c.ContadorNoEnviados + "</b><span>No Env.</span></span><span class='kp " + if(c.ContadorEnviadosNoAprobados > 0, "ko", "kx") + "'><b>" + c.ContadorEnviadosNoAprobados + "</b><span>Pend.</span></span><span class='kp " + if(c.ContadorEnviadosAprobados > 0, "kb", "kx") + "'><b>" + c.ContadorEnviadosAprobados + "</b><span>Valid.</span></span></div>";
		cH = cH + "<div class='da'><a class='btn bv' href='#Page:Documentaci_n_del_Cliente?ClienteID=" + c.ID + "'>Ver Docs</a>" + if(c.ContadorNoEnviados > 0 || c.ContadorPendietesSubir > 0, "<a class='btn bse' href='#Report:Ver_Clientes'>Enviar</a>", "") + if(c.ContadorEnviadosNoAprobados > 0, "<a class='btn bval' href='#Report:Ver_Clientes'>Validar</a>", "") + "</div></div>";
	}
	// Progress bar percentages
	p1 = if(gT > 0,((gAc * 100) / gT).round(0),0);
	p2 = if(gT > 0,((gCC * 100) / gT).round(0),0);
	p3 = if(gT > 0,((gCd * 100) / gT).round(0),0);
	p4 = 100 - p1 - p2 - p3;
	// CSS — unified styling for entire dashboard
	css = "<style>*{box-sizing:border-box;margin:0;padding:0}.tp{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0f2f5;min-height:100vh}.hdr{background:linear-gradient(135deg,#1C3A5E 0%,#2d5a8e 100%);color:#fff;padding:28px 28px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}.hdr h1{font-size:24px;font-weight:800;letter-spacing:-.4px}.hdr p{font-size:12px;opacity:.65;margin-top:3px}.hs{display:flex;gap:20px}.hs>div{text-align:center;background:rgba(255,255,255,.12);border-radius:10px;padding:10px 18px;min-width:80px}.hs b{font-size:26px;display:block;font-weight:800;line-height:1}.hs span{font-size:9px;opacity:.7;text-transform:uppercase;letter-spacing:.8px;margin-top:3px;display:block}.cnt{padding:20px 24px}.prg{background:#fff;border-radius:12px;padding:18px 20px;margin-bottom:20px;box-shadow:0 1px 4px rgba(0,0,0,.06)}.prg-l{font-size:11px;font-weight:700;color:#4a5568;margin-bottom:10px;text-transform:uppercase;letter-spacing:.6px}.prg-b{height:14px;border-radius:7px;background:#edf2f7;overflow:hidden;display:flex}.prg-b div{height:100%}.p-g{background:#38a169}.p-y{background:#ecc94b}.p-r{background:#e53e3e}.p-x{background:#cbd5e0}.prg-lg{display:flex;gap:20px;margin-top:10px;flex-wrap:wrap}.prg-lg span{font-size:11px;color:#4a5568;display:flex;align-items:center;gap:5px;font-weight:500}.prg-lg span::before{content:'';width:10px;height:10px;border-radius:3px;display:inline-block;flex-shrink:0}.l-g::before{background:#38a169}.l-y::before{background:#ecc94b}.l-r::before{background:#e53e3e}.l-x::before{background:#cbd5e0}.sec{margin-bottom:22px}.stl{font-size:11px;font-weight:700;color:#a0aec0;text-transform:uppercase;letter-spacing:1px;margin-bottom:10px;padding-left:4px}.kg{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kc{background:#fff;border-radius:12px;padding:18px 16px;box-shadow:0 1px 4px rgba(0,0,0,.06);border-left:4px solid #cbd5e0;text-align:center;transition:transform .15s,box-shadow .15s}.kc:hover{transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.1)}.kc b{font-size:34px;font-weight:800;display:block;line-height:1;letter-spacing:-1px}.kc span{font-size:10px;color:#718096;text-transform:uppercase;letter-spacing:.6px;margin-top:5px;display:block}.k-r{border-left-color:#e53e3e}.k-r b{color:#e53e3e}.k-dr{border-left-color:#c53030}.k-dr b{color:#c53030}.k-y{border-left-color:#ecc94b}.k-y b{color:#d69e2e}.k-g{border-left-color:#38a169}.k-g b{color:#38a169}.k-b{border-left-color:#3182ce}.k-b b{color:#3182ce}.k-n{border-left-color:#1C3A5E}.k-n b{color:#1C3A5E}.k-o{border-left-color:#dd6b20}.k-o b{color:#dd6b20}.dvd{border:none;border-top:2px solid #e2e8f0;margin:28px 0 22px}.cst{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}.cs{background:#fff;border-radius:10px;padding:12px 16px;flex:1;min-width:90px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,.06);transition:transform .15s}.cs:hover{transform:translateY(-1px)}.cs b{display:block;font-size:24px;font-weight:800;line-height:1}.cs span{display:block;font-size:9px;color:#a0aec0;text-transform:uppercase;letter-spacing:.5px;margin-top:4px;font-weight:600}.c0 b{color:#1C3A5E}.c1 b{color:#718096}.c2 b{color:#e53e3e}.c3 b{color:#c53030}.c4 b{color:#38a169}input[type=radio]{display:none}.fb{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}.fb label{cursor:pointer;padding:7px 16px;border-radius:20px;font-size:12px;font-weight:600;background:#fff;color:#718096;border:1.5px solid #e2e8f0;transition:all .2s;user-select:none}.fb label:hover{border-color:#1C3A5E;color:#1C3A5E;background:#f7fafc}#f0:checked~.cnt .fb label[for=f0],#f1:checked~.cnt .fb label[for=f1],#f2:checked~.cnt .fb label[for=f2],#f3:checked~.cnt .fb label[for=f3],#f4:checked~.cnt .fb label[for=f4]{background:#1C3A5E;color:#fff;border-color:#1C3A5E}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}.cd{background:#fff;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.07);border-left:4px solid #cbd5e0;display:flex;flex-direction:column;transition:box-shadow .15s}.cd:hover{box-shadow:0 3px 10px rgba(0,0,0,.1)}.st-r{border-left-color:#e53e3e}.st-o{border-left-color:#dd6b20}.st-g{border-left-color:#38a169}.st-x{border-left-color:#a0aec0}.dh{padding:10px 12px 5px;display:flex;align-items:flex-start;gap:8px}.dn{font-size:11.5px;font-weight:700;color:#1a202c;line-height:1.3;flex:1}.db{font-size:9px;font-weight:700;padding:2px 8px;border-radius:12px;white-space:nowrap;flex-shrink:0;margin-top:1px}.br{background:#fff5f5;color:#c53030}.bo{background:#fffaf0;color:#c05621}.bg{background:#f0fff4;color:#276749}.bx{background:#f7fafc;color:#718096}.dm{padding:0 12px 5px;font-size:9.5px;color:#a0aec0}.dkpi{padding:7px 10px;background:#f7fafc;display:flex;flex-wrap:wrap;gap:3px;border-top:1px solid #edf2f7;border-bottom:1px solid #edf2f7}.kp{display:inline-flex;flex-direction:column;align-items:center;min-width:38px;padding:2px;gap:0}.kp b{font-size:14px;font-weight:700}.kp span{font-size:7.5px;color:#a0aec0;text-transform:uppercase;letter-spacing:.2px}.kr b{color:#e53e3e}.ko b{color:#dd6b20}.kg2 b{color:#38a169}.ky b{color:#d69e2e}.kb b{color:#3182ce}.kx b{color:#a0aec0}.da{padding:7px 10px;display:flex;gap:5px;flex-wrap:wrap}.btn{font-size:10px;font-weight:600;padding:4px 10px;border-radius:6px;text-decoration:none;display:inline-block;transition:opacity .15s}.btn:hover{opacity:.8}.bv{background:#ebf8ff;color:#2b6cb0}.bse{background:#fff5f5;color:#c53030}.bval{background:#f0fff4;color:#276749}#f1:checked~.cnt .cards .cd{display:none}#f1:checked~.cnt .cards .has-docs{display:flex}#f2:checked~.cnt .cards .cd{display:none}#f2:checked~.cnt .cards .is-prob{display:flex}#f3:checked~.cnt .cards .cd{display:none}#f3:checked~.cnt .cards .is-cad{display:flex}#f4:checked~.cnt .cards .cd{display:none}#f4:checked~.cnt .cards .is-ok{display:flex}@media(max-width:768px){.hdr{padding:20px 16px}.hs{gap:10px}.hs>div{padding:8px 12px;min-width:60px}.hs b{font-size:20px}.cnt{padding:16px}.kg{grid-template-columns:repeat(2,1fr)}.kc b{font-size:26px}.cst{gap:6px}.cs{padding:8px 10px;min-width:60px}.cs b{font-size:18px}}</style>";
	// Header HTML
	h1 = "<div class='tp'><input type='radio' id='f0' name='f' checked><input type='radio' id='f1' name='f'><input type='radio' id='f2' name='f'><input type='radio' id='f3' name='f'><input type='radio' id='f4' name='f'><div class='hdr'><div><h1>Tablero PRL</h1><p>Prevención de Riesgos Laborales — Estado de Documentación</p></div><div class='hs'><div><b>" + nC + "</b><span>Clientes</span></div><div><b>" + nEmp + "</b><span>Empleados</span></div><div><b>" + gT + "</b><span>Documentos</span></div></div></div>";
	// Progress bar
	h2 = "<div class='cnt'><div class='prg'><div class='prg-l'>Estado general de documentación</div><div class='prg-b'><div class='p-g' style='width:" + p1 + "%'></div><div class='p-y' style='width:" + p2 + "%'></div><div class='p-r' style='width:" + p3 + "%'></div><div class='p-x' style='width:" + p4 + "%'></div></div><div class='prg-lg'><span class='l-g'>Actualizados (" + gAc + " · " + p1 + "%)</span><span class='l-y'>Próximos a caducar (" + gCC + " · " + p2 + "%)</span><span class='l-r'>Caducados (" + gCd + " · " + p3 + "%)</span><span class='l-x'>Pendiente subir (" + gPS + " · " + p4 + "%)</span></div></div>";
	// KPI Section 1 — Document Status
	h3 = "<div class='sec'><div class='stl'>Estado de Documentos</div><div class='kg'><div class='kc k-r'><b>" + gPS + "</b><span>Pendiente Subir</span></div><div class='kc k-dr'><b>" + gCd + "</b><span>Caducados</span></div><div class='kc k-y'><b>" + gCC + "</b><span>Próximos a Caducar</span></div><div class='kc k-g'><b>" + gAc + "</b><span>Actualizados</span></div></div></div>";
	// KPI Section 2 — Send/Validation Status
	h4 = "<div class='sec'><div class='stl'>Estado de Envío</div><div class='kg'><div class='kc k-n'><b>" + gT + "</b><span>Total Documentos</span></div><div class='kc k-o'><b>" + gNE + "</b><span>No Enviados</span></div><div class='kc k-y'><b>" + gNA + "</b><span>En Proceso Validación</span></div><div class='kc k-b'><b>" + gVA + "</b><span>Validados por Cliente</span></div></div></div>";
	// Divider + Client section
	h5 = "<hr class='dvd'><div class='sec'><div class='stl'>Estado por Cliente</div><div class='cst'><div class='cs c0'><b>" + nC + "</b><span>Total</span></div><div class='cs c1'><b>" + nD + "</b><span>Con Docs</span></div><div class='cs c2'><b>" + nP + "</b><span>Con Problemas</span></div><div class='cs c3'><b>" + nK + "</b><span>Caducados</span></div><div class='cs c4'><b>" + nOk + "</b><span>Validados</span></div></div>";
	h6 = "<div class='fb'><label for='f0'>Todos (" + nC + ")</label><label for='f1'>Con Docs (" + nD + ")</label><label for='f2'>Con Problemas (" + nP + ")</label><label for='f3'>Caducados (" + nK + ")</label><label for='f4'>Validados (" + nOk + ")</label></div><div class='cards'>" + cH + "</div></div></div></div>";
	// Assemble
	html = css + h1 + h2 + h3 + h4 + h5 + h6;
	return html;
}
