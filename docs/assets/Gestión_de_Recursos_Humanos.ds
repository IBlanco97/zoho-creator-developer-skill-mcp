	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Personal_Email
			(
    			type = email
				displayname = "Personal Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
