		page Prueba_de_ZML1
		{
			displayname = "Prueba de ZML"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\thtml_ = thisapp.Calendario52HTML.DevolverHTMLCalendario52Semanas();\n\t%&gt;\n&lt;div&gt;&lt;%=html_%&gt;&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				// Obtener registros del formulario
				asignaciones = Asignacion_T_cnico_Cliente[Estado != null];
				// Convertir a formato simple para JS
				records_list = list();
				for each  rec in asignaciones
				{
					day_name = if(rec.Fecha_de_Inicio.getDayOfWeek() == 1,"Lun",if(rec.Fecha_de_Inicio.getDayOfWeek() == 2,"Mar",if(rec.Fecha_de_Inicio.getDayOfWeek() == 3,"Mié",if(rec.Fecha_de_Inicio.getDayOfWeek() == 4,"Jue",if(rec.Fecha_de_Inicio.getDayOfWeek() == 5,"Vie",if(rec.Fecha_de_Inicio.getDayOfWeek() == 6,"Sáb","Dom"))))));
					temp = Map();
					temp.put("Tecnico",rec.Tecnico.toString());
					temp.put("Cliente",rec.Cliente.toString());
					temp.put("Dia",day_name);
					//temp.put("Turno",ifnull(rec.Turnos_Activos1,""));
					records_list.add(temp);
				}
				// Convertir a JSON string
				AsignacionesJSON = records_list.toJSONList();
			}
		}
