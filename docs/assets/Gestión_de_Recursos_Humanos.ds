			Enviar_Encuestas_a_Trabaj as "Enviar Encuestas a Trabajadores"
			{
				type =  form
				form = Encuesta
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  trabajador in Nuevo_Empleado[ID != 0]
										{
											preguntas = List();
											for each  pregunta in input.Preguntas
											{
												respuestas = List();
												for each  respuesta in pregunta.Opci_n_Respuesta
												{
													respuestaClon = insert into Opci_n_Respuesta
													[
														Texto_Opci_n_de_Respuesta1=respuesta.Texto_Opci_n_de_Respuesta1
														Added_User=zoho.loginuser
													];
													respuestas.add(respuesta);
												}
												preguntaClon = insert into Pregunta_Encuesta
												[
													Tipo_Respuesta=pregunta.Tipo_Respuesta
													Pregunta1=pregunta.Pregunta1
													Added_User=zoho.loginuser
													Opci_n_Respuesta=respuestas
													Respuesta_Desarrollo1=pregunta.Respuesta_Desarrollo1
												];
												preguntas.add(preguntaClon);
											}
											EncuestaTrabajador = insert into Encuesta
											[
												Added_User=zoho.loginuser
												Nombre_De_Encuesta=input.Nombre_De_Encuesta
												Preguntas=preguntas
												Trabajador=trabajador
												Encuesta_Madre=input.ID
												Es_Modelo_de_Encuesta="NO"
											];
										}
						)
					}
				}

			}
