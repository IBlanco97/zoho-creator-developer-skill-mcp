			Run_Scripts_On_Always43 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_weekly_Logs
				record event = on add or edit

				on add row of Logs
				{
					actions 
					{
						custom deluge script
						(
											if(input.From_Date != null && input.To_Date != null)
										{
											/*     if (input.From_Date  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Sunday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(1)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Monday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(2)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Tuesday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(3)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Wednesday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(4)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Thursday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(5)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Friday = "00:00";
																																																																																												    }
																																																																																												    if (input.From_Date.addDay(6)  >  zoho.currentdate)
																																																																																												    {
																																																																																												        row.Saturday = "00:00";
																																																																																												    } */
											trackedLogsForWeek = Add_Time_Logs[Log_Date >= input.From_Date && Log_Date <= input.To_Date && Added_User == zoho.loginuser].ID.getAll();
											logCount = 0;
											for each  eachRow in input.Logs
											{
												logCount = logCount + 1;
											}
											if(logCount > 0)
											{
												for each  eachRow in input.Logs
												{
													sameLogs = Add_Time_Logs[Project_Name == eachRow.Project_Name && Job_Name == eachRow.Job_Name && Log_Date >= input.From_Date && Log_Date <= input.To_Date && Added_User == zoho.loginuser].ID.getAll();
													trackedLogsForWeek.removeall(sameLogs);
												}
											}
											if(trackedLogsForWeek.size() > 0)
											{
												trackedLogs = Add_Time_Logs[ID == trackedLogsForWeek.get(0)];
												row.Project_Name=trackedLogs.Project_Name;
												row.Job_Name=trackedLogs.Job_Name;
												repeatedLogs = Add_Time_Logs[Project_Name == trackedLogs.Project_Name && Job_Name == trackedLogs.Job_Name && Log_Date >= input.From_Date && Log_Date <= input.To_Date && Added_User == zoho.loginuser];
												for each  eachSameLog in repeatedLogs
												{
													dayVal = eachSameLog.Log_Date.getDayOfWeek();
													if(dayVal == 1)
													{
														row.Sunday=eachSameLog.Hours;
													}
													else if(dayVal == 2)
													{
														row.Monday=eachSameLog.Hours;
													}
													else if(dayVal == 3)
													{
														row.Tuesday=eachSameLog.Hours;
													}
													else if(dayVal == 4)
													{
														row.Wednesday=eachSameLog.Hours;
													}
													else if(dayVal == 5)
													{
														row.Thursday=eachSameLog.Hours;
													}
													else if(dayVal == 6)
													{
														row.Friday=eachSameLog.Hours;
													}
													else if(dayVal == 7)
													{
														row.Saturday=eachSameLog.Hours;
													}
												}
											}
										}
						)
					}
				}

			}
