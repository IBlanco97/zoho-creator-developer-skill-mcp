			On_Send1 as "On Send"
			{
				type =  form
				form = Asignar_Trabajador_a_Cliente
				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											trabajador = Nuevo_Empleado[ID == input.Trabajador];
										clientes2 = thisapp.NuevoEmpleado.getClientesAll(trabajador);
										// Por cada clienteID en la lista general de clientes
										for each  clienteID in input.Clientes
										{
											cliente = Nuevo_Cliente[ID == clienteID];
											found = false;
											//Por cada cliente en la lista de clientes
											//ClienteID2 es un cliente en la lista actual de clientes del trabajador.
											for each  clienteID2 in clientes2
											{
												if(clienteID == clienteID2)
												{
													//SI es encontrado el cliente del trabajador en la lista global de clientes, terminar ciclo
													found = true;
													break;
												}
											}
											// Si el cliente global no fue encontrado entre los clientes del trabajador
											if(!found)
											{
												trabajadores = List();
												trabajadores.addAll(cliente.Trabajadores_Habituales);
												// Agregar cliente nuevo a la lista de clientes del trabajador.
												trabajadores.add(input.Trabajador);
												thisapp.NuevoCliente.SetTrabajadores(clienteID,trabajadores);
											}
										}
										//desasignando
										// Ahora pasemos a buscar clientes que estan en la lista del trabajador pero que no estan en la lista introducida por el usuario,
										// o sea, que el usuario ha quitado de la lsita para desasignar al trabajador de ese cliente.
										// Por cada cliente en la lista de clientes del trabajador...
										for each  clienteID2 in clientes2
										{
											cliente = Nuevo_Cliente[ID == clienteID2];
											found = false;
											// Por cada clienteID en el input de clientes dado por el usuario
											for each  clienteID in input.Clientes
											{
												if(clienteID == clienteID2)
												{
													// si el cliente en la lista de clientes del trabajador aparece tambien en la lista input:
													// cerrar ciclo y luego no se eliminara este cliente de los clientes del trabajador,
													// ya que el usuario ha querido que se mantenga
													found = true;
													break;
												}
											}
											// Por el contrario, si el cliente en la lista del trabajador no aparece en el input, significa que debe ser eliminado de la l
											if(!found)
											{
												trabajadores = List();
												for each  trab in cliente.Trabajadores_Habituales
												{
													if(trab != input.Trabajador)
													{
														trabajadores.add(trab);
													}
												}
												thisapp.NuevoCliente.SetTrabajadores(clienteID2,trabajadores);
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
