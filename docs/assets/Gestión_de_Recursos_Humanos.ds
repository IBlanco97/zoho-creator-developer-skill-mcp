		form Exit_Interview
		{
			displayname = "Exit Interview"
			success message = "Data Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Reason_for_leaving_the_job
			(
				type = picklist
				displayname = "Reason for leaving the job"
				values = {"Personal","Maternity","Lack of Opportunities","Dissatisfied with Pay"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<a><font size=\"3\">Questionairre</font></a>"
	 			row = 1
	 			column = 1   
				width = 300px
			)
			How_satisfied_were_you_with_this_job
			(
				type = radiobuttons
				displayname = "How satisfied were you with this job?"
				values = {"Very Satisfied","Satisfied","Neutral","Unsatisfied","Very Unsatisfied","N/A"}
	 			row = 1
	 			column = 1   
				width = 300px
			)
			Did_you_find_opportunities
			(
				type = radiobuttons
				displayname = "Did you find opportunities to develop your skills?"
				values = {"Yes","A Little","Never"}
