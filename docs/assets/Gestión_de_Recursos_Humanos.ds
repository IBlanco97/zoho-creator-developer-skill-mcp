		list Historial_de_Asignaciones_de_Activos_2
		{
			displayName = "Historial de Asignaciones de Activos"
			show all rows from Asignar_Activo_Empleado  [Empleado.Correo_Electr_nico == zoho.loginuserid || Empleado.Official_Email == zoho.loginuserid || Empleado.Mail_Portal_Empleado == zoho.loginuserid]  
			(
				Empleado
				Activo
				Estado
				custom action "Confirmar"
				(
	  			workflow = Confirmar_Recibo_Activo
				show action in view header = true
				show action in edit record menu = true
				column header = "Confirmar"
				condition = (Estado != "Recibido" || Estado is null || Estado == "Sin Confirmar" && Confirmaci_n == "Pendiente" || Confirmaci_n is null)
				confirmation before execution
				(
					message for individual record = "¿Está seguro que que desea Confirmar que ha recibido este Activo?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
			)
		}
