			Env_o_de_Formulario1 as "Envío de Formulario"
			{
				type =  form
				form = Unassign_Driver
				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											//Updating the assignment status to maintain assignment history 
										assignedVehicle = Assign_Driver[Vehiculo == input.Vehiculo && Estado_de_la_Asignaci_n == "Activa"];
										assignedVehicle.Estado_de_la_Asignaci_n="Inactiva";
										assignedVehicle.Fecha_de_Finalizacion=input.Fecha_de_Finalizaci_n;
										assignedVehicle.Odometro_Final=input.Odometro_Final;
										assignedVehicle.Comentarios=input.Comentarios;
										//Removing the access for previously assigned vehicles
										vehicleRecord = Add_Vehicle[ID == input.Vehiculo];
										vehicleRecord.Chofer=null;
						)
					}
				}

			}
