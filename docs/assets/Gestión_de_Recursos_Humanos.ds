			Run_Scripts_On_Always47 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of Hours
				{
					actions 
					{
						custom deluge script
						(
											if(thisapp.TimeCalc.TimeValidation(input.Hours))
										{
											hrsVal = input.Hours.getPrefix(":");
											minsVal = input.Hours.getSuffix(":");
											if(hrsVal.length() < 2 || minsVal.length() < 2)
											{
												input.Hours = thisapp.TimeCalc.GetStringTime(hrsVal.toLong(),minsVal.toLong());
											}
										}
										else
										{
											alert "Please enter time in 24 hours format";
										}
						)
					}
				}

			}
			Run_Scripts_On_Always48 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of Log_Date
				{
					actions 
					{
						custom deluge script
						(
											if(input.Log_Date > zoho.currentdate)
										{
											alert "You are not allowed to add log for future date";
										}
										else if(input.Log_Date != null)
										{
											runningRec = Add_Time_Logs[Status == "Tracking Time" && Added_User == zoho.loginuser && Log_Date == input.Log_Date];
											if(runningRec.count() > 0)
											{
												alert "You are not allowed to add log for current date while timer is activated";
											}
										}
						)
					}
				}

			}
			Run_Scripts_On_Always49 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of End_Time
				{
					actions 
					{
						custom deluge script
						(
											if(input.Log_Date != null)
										{
											if(thisapp.TimeCalc.TimeVal(input.End_Time) && thisapp.TimeCalc.TimeVal(input.Start_Time))
											{
												hrsVal = input.End_Time.getPrefix(":");
												minsVal = input.End_Time.getSuffix(":");
												if(hrsVal.length() < 2 || minsVal.length() < 2)
												{
													input.End_Time = thisapp.TimeCalc.GetStringTime(hrsVal.toLong(),minsVal.toLong());
												}
												input.Hours = thisapp.TimeCalc.HoursCalculation(input.Start_Time,input.End_Time,input.Log_Date);
											}
											else
											{
												input.Hours = "00:00";
												alert "Please enter time in 24 hours format";
											}
										}
						)
					}
				}

			}
			Run_Scripts_On_Always50 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of Job_Name
				{
					actions 
					{
						custom deluge script
						(
											if(input.Job_Name != null)
										{
											projectID = Add_Project[Jobs == input.Job_Name].ID;
											if(projectID != null)
											{
												input.Project_Name = projectID;
											}
										}
										else
										{
											projectList = Add_Project[Project_Manager.Official_Email == zoho.loginuserid || Project_Members.Official_Email == zoho.loginuserid].ID.getAll();
											input.Project_Name:ui.add(projectList);
											jobsList = Add_Job[Assignees.Official_Email == zoho.loginuserid || Added_User == zoho.loginuser && Status == "Active"].ID.getAll();
											input.Job_Name:ui.add(jobsList);
										}
						)
					}
				}

			}
			Run_Scripts_On_Always51 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of Project_Name
				{
					actions 
					{
						custom deluge script
						(
											if(input.Project_Name != null)
										{
											jobsList = Add_Job[Project == input.Project_Name && Assignees.Official_Email == zoho.loginuserid && Status == "Active"].ID.getAll();
											if(!jobsList.contains(input.Job_Name) || input.Job_Name == null)
											{
												input.Job_Name:ui.add(jobsList);
											}
										}
										else
										{
											jobsList = Add_Job[Assignees.Official_Email == zoho.loginuserid || Added_User == zoho.loginuser && Status == "Active"].ID.getAll();
											input.Job_Name:ui.add(jobsList);
										}
						)
					}
				}

			}
			Run_Scripts_On_Always52 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Time_Logs
				record event = on add or edit

				on user input of Track_as
				{
					actions 
					{
						custom deluge script
						(
											if(input.Track_as == "Start Timer")
										{
											hide Start_Time;
											hide End_Time;
											hide Hours;
											if(input.Log_Date == zoho.currentdate)
											{
												logHoursList = Add_Time_Logs[Log_Date == input.Log_Date && Added_User == zoho.loginuser].Hours.getAll();
												totalTime = thisapp.TimeCalc.TotalHours(input.Log_Date,logHoursList);
												todaysRemainingTime = thisapp.TimeCalc.GetDifference(zoho.currenttime,zoho.currentdate.addDay(1).toTime());
												addedTimeVal = thisapp.TimeCalc.AddHoursToDate(totalTime,todaysRemainingTime);
												TimerStopAt = input.Log_Date.addHour(23).addMinutes(59).addSeconds(59);
												if(zoho.currentdate != addedTimeVal.toDate())
												{
													activeHrs = thisapp.TimeCalc.GetDifference(totalTime,zoho.currentdate.addDay(1).toTime());
													stopAt = thisapp.TimeCalc.AddHoursToDate(zoho.currenttime,activeHrs);
													show plain;
													input.plain = "<font color='#ff0000'>You have already tracked log for " + totalTime.getHour() + ":" + totalTime.getMinutes() + "<br>So your timer will be active till " + stopAt + "</font>";
													TimerStopAt = stopAt;
												}
											}
										}
										else if(input.Track_as == "Hours")
										{
											hide Start_Time;
											hide End_Time;
											enable Hours;
											show Hours;
											hide plain;
											TimerStopAt = null;
										}
										else
										{
											show Start_Time;
											show End_Time;
											disable Hours;
											hide plain;
											TimerStopAt = null;
										}
						)
					}
				}

			}
