			Registrar_Modificacion_As as "Registrar Modificacion Asignaciones"
			{
				type =  form
				form = Asignar_Trabajador_a_Cliente
				record event = on add or edit

				on user input of Clientes
				{
					actions 
					{
						custom deluge script
						(
											trabajador = Nuevo_Empleado[ID == input.Trabajador];
										clientesListaPrevia = thisapp.NuevoEmpleado.getClientesAll(trabajador);
										// Checar si se ha quitado algún cliente de la lista
										// Declaro found afuera para saber fuera del ciclo si hubo un cliente que no fue encontrado
										// El ciclo para al primer cliente que no aparezca
										found = false;
										for each  c2ID in clientesListaPrevia
										{
											c2 = Nuevo_Cliente[ID == c2ID];
											found = false;
											for each  c in input.Clientes
											{
												if(c == c2)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												// Primero Eliminar lista de requisitos
												listaRequisitos = Nueva_Lista_de_Requisitos[Trabajador == input.Trabajador && Cliente1 == c2];
												if(listaRequisitos.ID != null)
												{
													thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(listaRequisitos);
												}
												// Desligar Técnico de CLiente
												cliente = Nuevo_Cliente[ID == c2];
												if(cliente.ID != null)
												{
													esClienteHabitual = trabajador.Clientes_Habituales.contains(cliente.ID);
													thisapp.NuevoEmpleado.DesasignarCliente(trabajador,cliente,esClienteHabitual);
												}
												// Registrar fecha de fin en el registro de asignaciones
												asignacion = Asignacion_T_cnico_Cliente[Tecnico == input.Trabajador && Cliente = c2] sort by Added_Time desc;
												if(asignacion.ID != null)
												{
													fechaID = asignacion.Fechas.ID;
													fecha = Rango_Fechas_Asingacion[ID == fechaID];
													fecha.Fecha_de_Fin=zoho.currenttime;
													delete from Jornada[Asignacion_T_cnico_Cliente == asignacion.ID && Hora_de_Inicio > zoho.currenttime];
													asignacion.Estado="Finalizada";
													//Rectificar registro de calendario
													info "Redistribuyendo fechas de asignacion";
													thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asignacion);
												}
											}
										}
										clientesListaPrevia = thisapp.NuevoEmpleado.getClientesAll(trabajador);
										// Checar si se ha añadido algún cliente
										for each  c in input.Clientes
										{
											found = false;
											for each  c2 in clientesListaPrevia
											{
												if(c == c2)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												openUrl("#Form:Asignacion_T_cnico_Cliente?Tecnico=" + input.Trabajador + "&Cliente=" + c,"popup window");
												break;
											}
										}
						)
					}
				}

			}
