				condition = (Tipo == "Permiso" && S1 == " " && Estado != "Iniciada" && Estado != "Finalizada" && Estado == "Programada" && Semana_Actual < 1)
				fields = [S1]
				format = "background-color:#fdf4f5;"
				}
				"1 Permiso Futuro iniciada"
				{
				condition = (Tipo == "Permiso" && S1 == " " || S1 == "1" && Semana_Actual < 1 && Estado == "Iniciada")
				fields = [S1]
				format = "background-color:#fce7eb;"
				}
				"1 Permiso Semana Actual"
				{
				condition = (Tipo == "Permiso" && S1 == " " || S1 == "1" && Semana_Actual == 1)
				fields = [S1]
				format = "background-color:#f9ccd5;"
				}
