		list Documentacion_Incompleta
		{
			displayName = "Listas Requisitos sin actualizar"
			show all rows from Nueva_Lista_de_Requisitos  [Estado == "Problemas con la Documentación"]  
			(
				N_Orden as "Nº Orden"
				Nombre
				Cliente1 as "Cliente"
				Trabajador
				Estado
				Lista_Requisitos_Documentaci_n.Plantilla as "Lista Requisitos Documentación"
			)
			group by
			(
				Cliente1 ascending
			)
			sort by
			(
				Cliente1 ascending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Estado == "Documentación Actualizada")
				fields = [Estado]
				format = "background-color:#92d191;"
				}
				"New Formatting"
				{
				condition = (Estado == "Problemas con la Documentación")
				fields = [Estado]
				format = "background-color:#f27d7d;"
				}
			)
		}
		list Docs_No_Subidos
		{
			displayName = "Requisitos sin actualizar"
			show all rows from Nuevo_Requisitos_Doc    
			(
				Plantilla
				Cliente1 as "Cliente"
				Trabajador
				Documento as "Documentos"
				Estado as "Estado Caducidad"
				N_Orden as "Nº Orden"
				Nombre
			)
		}
		default list Clientes_Requisitos
		{
			displayName = "Documentación"
			show all rows from Nuevo_Requisitos_Doc    
			(
				Cliente1 as "Cliente"
				(
					view = Ver_Clientes
				)
				Trabajador
				(
					view = Employee_Details
				)
				Estado as "Estado Caducidad"
				N_Orden as "Nº Orden"
				Empresa1 as "Empresa"
				(
					view = Ver_Empresa
				)
				Enviado
				Aprobado_Cliente as "Validado"
				custom action "Validar"
				(
	  			workflow = Doc_Aceptado_por_Cliente
				show action in edit record menu = true
				column header = "Validar"
				condition = (Enviado == "SI" && Aprobado_Cliente == "Sin respuesta" || Aprobado_Cliente is null)
				)
				custom action "Subir"
				(
	  			workflow = Subir_Documentos_Pendient
				show action in edit record menu = true
				column header = "Subir"
				condition = (Estado != "Actualizado" || Documento.ID is null)
				)
				Con_Empresa_o_Con_Trabajador as "Con Empresa o Con Trabajador"
				Documento.Documento
				custom action "Enviar"
				(
	  			workflow = Acci_n_Enviar_Documento_R
				show action in edit record menu = true
				column header = "Enviar"
				condition = (Enviado == "NO" && Estado != "Pendiente Subir" && Estado != "Caducado")
				)
				Caducidad_Tolerancia as "Fecha Caducidad"
				Estado1 as "Estado"
				Documento.Nombre_Documento as "Nombre Documento"
				Documento.Fecha_validez_documento as "Fecha Inicio de Validez"
				Documento.Fecha_caducidad_documento as "Fecha caducidad documento"
				Nombre
			)
			filters
			(
				Cliente1
				Trabajador
				Estado
				Enviado
				Aprobado_Cliente
				"Documentos para Actualizar"  :  Estado != "Actualizado"
			)
			group by
			(
				Cliente1 ascending
				Con_Empresa_o_Con_Trabajador custom
			)
			sort by
			(
				Trabajador ascending
				Empresa1 ascending
				Enviado ascending
				Estado custom
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación")
				fields = [Estado, Caducidad_Tolerancia]
				format = "color:#cc1111;background-color:#ffffff;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Estado, Caducidad_Tolerancia]
				format = "color:#cc9711;background-color:#ffffff;"
				}
				"New Formatting"
				{
				condition = (Estado == "Actualizado")
				fields = [Estado, Caducidad_Tolerancia]
				format = "color:#337131;background-color:#ffffff;"
				}
				"Cliente Doc No Enviada"
				{
				condition = (Cliente1.Estado_General_Documentacion == "No Enviada" || Cliente1.Estado_General_Documentacion is null)
				fields = [Cliente1]
				format = "color:#cc1111;"
				}
				"Cliente Doc Enviada"
				{
				condition = (Cliente1.Estado_General_Documentacion == "Enviada")
				fields = [Cliente1]
				format = "color:#8b4908;"
				}
				"Cliente Doc Enviada y aprobada"
				{
				condition = (Cliente1.Estado_General_Documentacion == "Enviada y Aprobada")
				fields = [Cliente1]
				format = "color:#2f78d0;"
				}
				"New Formatting"
				{
				condition = (Enviado == "SI")
				fields = [Empresa1, Enviado, Aprobado_Cliente, Documento.Documento, Estado1]
				format = "color:#8b4908;"
				}
				"New Formatting"
				{
				condition = (Enviado == "NO")
				fields = [Empresa1, Enviado, Aprobado_Cliente, Documento.Documento, Estado1]
				format = "color:#cc1111;"
				}
				"New Formatting"
				{
				condition = (Enviado == "SI" && Aprobado_Cliente == "SI")
				fields = [Empresa1, Enviado, Aprobado_Cliente, Documento.Documento, Estado1]
				format = "color:#2f78d0;background-color:#ffffff;"
				}
				"trabajador"
				{
				condition = (Lista_Requisitos_Pertenece.Estado_Cliente == "Enviada y Aprobada")
				fields = [Trabajador]
				format = "color:#2f78d0;"
				}
				"New Formatting"
				{
				condition = (Lista_Requisitos_Pertenece.Estado_Cliente == "Enviada")
				fields = [Trabajador]
				format = "color:#8b4908;"
				}
				"New Formatting"
				{
				condition = (Lista_Requisitos_Pertenece.Estado_Cliente == "No Enviada")
				fields = [Trabajador]
				format = "color:#cc1111;"
				}
			)
		}
		default list Ver_Listas_de_Documentaci_n_Requerida
		{
			displayName = "Ver Listas de Documentación Requerida"
			show all rows from Nueva_Lista_de_Requisitos    
			(
				Cliente1 as "Cliente"
				(
					view = Ver_Clientes
				)
				Trabajador
				(
					view = Employee_Details
				)
				N_Orden as "Nº Orden"
				Nombre
				Estado
				Empresa1 as "Empresa"
				(
					view = Ver_Empresa
				)
				Lista_Requisitos_Documentaci_n.Nombre_con_Color_Estado as "Lista Requisitos Documentación"
				(
					view = Clientes_Requisitos
				)
				Es_Lista_con_empresa as "Es Lista con empresa"
				Estado_Cliente as "Estado Cliente"
				Trabajador_Color as "Trabajador Color"
				Cliente_Color as "Cliente Color"
				Nombre_Contraparte as "Nombre Contraparte Trabajador o Empresa"
				ContadorPendietesSubir
				ContadorActualizados
				ContadorCercaCaducar
				ContadorNoEnviados
				ContadorEnviadosNoAprobados
				ContadorEnviadosAprobados
				ContadorCaducados
				Total_Requisitos as "Total Requisitos"
			)
			group by
			(
				Empresa1 ascending
				Cliente1 ascending
			)
			sort by
			(
				Estado custom
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Estado == "Actualizado")
				fields = [Estado]
				format = "background-color:#b6deb5;"
				}
				"New Formatting"
				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación")
				fields = [Estado]
				format = "background-color:#f6abab;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Estado]
				format = "background-color:#f2c47d;"
				}
			)
		}
