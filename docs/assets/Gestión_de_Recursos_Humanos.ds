		calendar Calendario_Asignaciones_T_cnico
		{
			displayName = "Calendario Asignaciones Técnico"
			show all rows from Rango_Fechas_Asingacion    
			(
				Asignacion_T_cnico_Cliente as "Asignacion Técnico Cliente"
				Fecha_de_Comienzo1 as "Fecha de Comienzo"
				Fecha_de_Fin as "Fecha de Fin"
				Etiqueta
			)
			options
			(
				display type = month
				week start day = monday
				display field = Etiqueta
				start date = Fecha_de_Comienzo1
				end date = Fecha_de_Fin
				default date 
				(
	    			day   = Today
	    			month = Currentmonth
	    			year  = Currentyear
				)
			)
			conditional formatting
			(
				"Finalizada Cliente"
				{
				condition = (Asignacion_T_cnico_Cliente.Estado == "Finalizada" && Tipo == "Cliente")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#b6deb5;"
				}
				"Programada Cliente"
				{
				condition = (Tipo == "Cliente" && Asignacion_T_cnico_Cliente.Estado == "Programada")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#e7e7e7;"
				}
				"New Formatting"
				{
				condition = (Asignacion_T_cnico_Cliente.Estado == "Iniciada" && Tipo == "Cliente")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#eaf5ea;"
				}
				"New Formatting"
				{
				condition = (Asignacion_T_cnico_Cliente.Estado == "Finalizada" && Tipo == "Permiso")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#f6abbb;"
				}
				"New Formatting"
				{
				condition = (Asignacion_T_cnico_Cliente.Estado == "Programada" && Tipo == "Permiso")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#fdf4f5;"
				}
				"New Formatting"
				{
				condition = (Asignacion_T_cnico_Cliente.Estado == "Iniciada" && Tipo == "Permiso")
				fields = [Asignacion_T_cnico_Cliente, Etiqueta]
				format = "background-color:#fce7eb;"
				}
			)
		}
