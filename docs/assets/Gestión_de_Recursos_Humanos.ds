			script
			{
				/* Escriba la lógica de la secuencia de comandos aquí. Puede asignar valores a las variables de página que ha creado en la pestaña anterior. Ingrese “input” para enumerar las variables de página creadas. */
				cliente = Nuevo_Cliente[ID == input.ClienteID];
				input.ClienteNombre = cliente.Nombre_de_Cuenta;
				input.TotalRequisitos = cliente.ContadorTotal;
				input.NumeroEmpleados = cliente.Trabajadores_Habituales.size();
				input.NumeroModelosEmpleado = cliente.Plantillas_Requeridas.size();
				input.NumeroModelosEmpresa = cliente.Plantillas_con_Empresa.size();
				input.NumeroModelosAutonomo = cliente.Documentos_Aut_nomo.size();
				input.NumeroModelosCliente = cliente.Documentos_Cliente.size();
			}
		}
