	customize
	{
		icon
		{
			icon = "zc-ab-project-mgmt8"
			background color = "green"
			foreground color = "#FFFFFF"
		}
	}

	connections
	{
		zoho_recruit_connection
		(
			displayname = "Zoho Recruit Connection"
			connector = zohorecruit
			permissions = {"create_candidates_record","create_clients_record","create_contacts_record","create_jobopenings_record","fetch_all_candidates_records","fetch_all_clients_records","fetch_all_contacts_records","fetch_all_jobopenings_records","fetch_candidates_record","fetch_clients_record","fetch_contacts_record","fetch_jobopenings_record","search_candidates_record","search_clients_record","search_contacts_record","search_jobopenings_record","sync_candidates_records","sync_clients_records","sync_contacts_records","sync_jobopenings_records","update_candidates_record","update_clients_record","update_contacts_record","update_jobopenings_record"}
		)
	}
	datasources
	{
		zohocrm_contacts
		{
			displayname = "ZohoCRM Contacts"
			module = Contacts
			system connection = zohocrm
			account_name
			(
				type = text
				displayname = "Account Name"
				source field name = "Account_Name"
				search operators = {"startsWith"}
			)
			contactid
			(
				type = text
				displayname = "CONTACTID"
				source field name = "CONTACTID"
				primary = true
				report only = true
			)
			date_of_birth
