				 void CustomAction.stopTimer(int Id)
                 {
                 	logRecords = Add_Time_Logs[ID = input.Id];
                 	currentHrs = zoho.currenttime.getHour();
                 	currentMins = zoho.currenttime.getMinutes();
                 	logRecords.End_Time=thisapp.TimeCalc.GetStringTime(currentHrs,currentMins);
                 	logRecords.Hours=thisapp.TimeCalc.HoursCalculation(logRecords.Start_Time,logRecords.End_Time,logRecords.Log_Date);
