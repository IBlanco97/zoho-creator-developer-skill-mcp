			Entrada_de_Fecha_de_Alta1 as "Entrada de Fecha de Alta"
			{
				type =  form
				form = Importaci_n_Empleado_Recruit
				record event = on add or edit

				on user input of Fecha_de_Alta
				{
					actions 
					{
						custom deluge script
						(
											if(Fecha_de_Alta != null)
										{
											months = input.Fecha_de_Alta.monthsDiff(zoho.currentdate) % 12;
											years = input.Fecha_de_Alta.yearsDiff(zoho.currentdate);
											Antig_edad_ = "";
											Antig_edad_ = years + " años y ";
											Antig_edad_ = Antig_edad_ + months + " meses";
											input.Antig_edad = Antig_edad_;
										}
										else
										{
											input.Antig_edad = "";
										}
						)
					}
				}

			}
			Validar_Cantidad1 as "Validar Cantidad"
			{
				type =  form
				form = Dar_de_Alta_Baja_Activos_Empleados
				record event = on add or edit

				on user input of Cantidad_de_Unidades_de_Alta_Baja
				{
					actions 
					{
						custom deluge script
						(
											if(Cantidad_de_Unidades_de_Alta_Baja < 1)
										{
											alert "La cantidad especificada debe ser mínimo 1.";
											input.Cantidad_de_Unidades_de_Alta_Baja = 1;
										}
										else if(Tipo == {"Baja"})
										{
											if(Cantidad_de_Unidades_de_Alta_Baja > input.Activo.Unidades_Disponibles)
											{
												alert "La cantidad especificada no puede ser mayor que las unidades disponibles: " + input.Activo.Unidades_Disponibles;
												input.Cantidad_de_Unidades_de_Alta_Baja = input.Activo.Unidades_Disponibles;
											}
										}
						)
					}
				}

			}
			Validar_Unidades_Disponib as "Validar Unidades Disponibles"
			{
				type =  form
				form = Activo_Empleado
				record event = on add or edit

				on user input of Unidades_Disponibles
				{
					actions 
					{
						custom deluge script
						(
											if(Unidades_Disponibles > Unidades_Totales)
										{
											alert "Las unidades disponibles no pueden superar el total de unidades.";
											input.Unidades_Disponibles = input.Unidades_Totales;
										}
										else if(Unidades_Disponibles < 0)
										{
											alert "Las unidades disponibles no pueden ser un número menor que cero";
											input.Unidades_Disponibles = 0;
										}
						)
					}
				}

			}
			Validar_Unidades_Totales as "Validar Unidades Totales"
