			Agregar_Trabajador_a_Clie as "Agregar Trabajador a Cliente"
			{
				type =  form
				form = Nuevo_Cliente
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  trab in input.Trabajadores_Habituales
										{
											found = false;
											for each  req_list in input.Lista_de_Requisitos
											{
												if(req_list.Trabajador == trab)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												cliente = null;
												for each  c in Nuevo_Cliente[ID == input.ID]
												{
													cliente = c;
												}
												thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitos(trab.ID,trab.Nombre,cliente);
											}
										}
										for each  lista in input.Lista_de_Requisitos
										{
											found = false;
											for each  trabajador in input.Trabajadores_Habituales
											{
												for each  l in Nueva_Lista_de_Requisitos[ID == input.Lista_de_Requisitos]
												{
													if(l.Trabajador == trabajador)
													{
														found = true;
													}
												}
											}
											if(!found)
											{
												for each  l in Nueva_Lista_de_Requisitos[ID == lista]
												{
													thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(l);
												}
											}
										}
						)
					}
				}

			}
