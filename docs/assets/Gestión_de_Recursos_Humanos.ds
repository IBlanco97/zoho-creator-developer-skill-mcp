			Actualizacioes_segun_fech as "Actualizacioes segun fecha comienzo"
			{
				type =  form
				form = Asignacion_T_cnico_Cliente
				record event = on add or edit

				on user input of Fechas.Fecha_de_Comienzo1
				{
					actions 
					{
						custom deluge script
						(
											Fecha_Inicio = null;
										Fecha_Fin = null;
										for each  fecha in input.Fechas
										{
											Fecha_Inicio = fecha.Fecha_de_Comienzo1;
											Fecha_Fin = fecha.Fecha_de_Fin;
											break;
										}
										if(Fecha_Inicio != null)
										{
											if(Fecha_Fin <= Fecha_Inicio)
											{
												Fecha_Fin = Fecha_Inicio.addWeek(1);
											}
											if(Fecha_Inicio <= zoho.currentdate)
											{
												if(Fecha_Fin == null || Fecha_Fin > zoho.currentdate)
												{
													input.Estado = "Iniciada";
												}
												else
												{
													input.Estado = "Finalizada";
												}
											}
											else
											{
												input.Estado = "Programada";
											}
										}
										//Actualizar Fechas Limites inical y final que se muestran en el reporte
										input.Fecha_de_Inicio = Fecha_Inicio;
										input.Fecha_de_Fin = Fecha_Fin;
						)
					}
				}

			}
			OnInput_Fechas_Fecha_Fin as "OnInput Fechas Fecha Fin"
			{
				type =  form
				form = Asignacion_T_cnico_Cliente
				record event = on add or edit

				on user input of Fechas.Fecha_de_Fin
				{
					actions 
					{
						custom deluge script
						(
											Fecha_Inicio = null;
										Fecha_Fin = null;
										for each  fecha in input.Fechas
										{
											Fecha_Inicio = fecha.Fecha_de_Comienzo1;
											Fecha_Fin = fecha.Fecha_de_Fin;
											break;
										}
										if(Fecha_Fin != null)
										{
											if(Fecha_Fin <= Fecha_Inicio)
											{
												alert "La fecha de finalizacion debe ser posterior a la fecha de comienzo.";
												Fecha_Fin = Fecha_Inicio.addWeek(1);
											}
											if(Fecha_Inicio <= zoho.currentdate)
											{
												if(Fecha_Fin == null || Fecha_Fin > zoho.currentdate)
												{
													input.Estado = "Iniciada";
												}
												else
												{
													input.Estado = "Finalizada";
												}
											}
											else
											{
												input.Estado = "Programada";
											}
										}
										//Actualizar Fechas Globales
										input.Fecha_de_Inicio = Fecha_Inicio;
										input.Fecha_de_Fin = Fecha_Fin;
						)
					}
				}

			}
