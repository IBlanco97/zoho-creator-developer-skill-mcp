				(
	  			workflow = Desasignar
				show action in edit record menu = true
				column header = "Desasignar"
				condition = (Estado != "Desasignado")
				confirmation before execution
				(
					message for individual record = "¿Ejecutar la acción Desasignar para este registro?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
				Etiqueta
				N_mero_de_Serie as "Número de Serie"
