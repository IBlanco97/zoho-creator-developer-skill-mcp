	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Documentos_req
			(
				type = checkboxes	
				displayname = "Documentos a enviar"
				values  = Nuevo_Requisitos_Doc[Cliente1.ID == input.Cliente && Estado == "Actualizado" || Estado == "Cerca de Caducar"].ID
