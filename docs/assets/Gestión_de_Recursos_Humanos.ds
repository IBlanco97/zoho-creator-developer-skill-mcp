				on user input of Turnos.Turno
				{
					actions 
					{
						custom deluge script
						(
											for each  turno in input.Turnos
										{
											if(turno.Turno == "Mañana")
											{
												turno.Hora_de_Entrada='08:00:00';
												turno.Hora_de_Salida='16:00:00';
											}
											if(turno.Turno == "Tarde")
											{
												turno.Hora_de_Entrada='16:00:00';
												turno.Hora_de_Salida='23:59:59';
											}
											if(turno.Turno == "Noche")
											{
												turno.Hora_de_Entrada='00:00:00';
												turno.Hora_de_Salida='08:00:00';
											}
										}
						)
					}
				}

			}
