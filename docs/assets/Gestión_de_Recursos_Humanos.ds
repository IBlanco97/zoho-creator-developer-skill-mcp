				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Subir")
				fields = [Numero_Documento, Estado]
				format = "background-color:#f9cccc;"
				}
				"Cerca de Caducar"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Numero_Documento, Estado]
				format = "background-color:#f9e4cc;"
				}
			)
		}
