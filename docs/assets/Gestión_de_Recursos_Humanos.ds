			Checar_Documento_seg_n_pl as "Checar Documento según plantilla"
			{
				type =  form
				form = Nuevo_Requisitos_Doc
				record event = on add or edit
					status = inactive

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Plantilla != null && input.Trabajador != null && input.Cliente1 != null && Documento == null)
										{
											found = false;
											p = Plantilla[ID == input.Plantilla];
											for each  doc in Subir_Documento[Plantilla == input.Plantilla]
											{
												if(p.Trabajador1 != "SI" || doc.TRABAJADOR == input.Trabajador && p.CLIENTE != "SI" || doc.CLIENTE == input.Cliente1)
												{
													input.Documento = doc.ID;
													found = true;
												}
											}
											if(!found)
											{
												thisapp.NuevoRequisitoDoc.SetEstado(input.ID,1);
											}
										}
						)
					}
				}

			}
			Checar_Estado_Requisito as "Checar Estado Requisito"
			{
				type =  form
				form = Nuevo_Requisitos_Doc
				record event = on add or edit

				on user input of Plantilla
				{
					actions 
					{
						custom deluge script
						(
											if(input.Plantilla != null)
										{
											p = Plantilla[ID == input.Plantilla];
											if(p.Trabajador1 != "SI" || input.Trabajador != null && p.CLIENTE != "SI" || input.Cliente1 != null)
											{
												found = false;
												for each  doc in Subir_Documento[Plantilla == input.Plantilla]
												{
