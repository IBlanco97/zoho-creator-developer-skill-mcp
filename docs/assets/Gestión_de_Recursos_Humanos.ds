			Run_Scripts_On_Click_of_S as "Run Scripts - On Click of 'Schedule' Button"
			{
				type =  form
				form = Schedule_Interview
				button = Schedule
				on click
				{
					actions 
					{
					on click
					(
						if(input.Date_field < zoho.currentdate)
										{
											alert "Please enter a valid Date!";
										}
										else
										{
											OrgDetail = Add_Your_Organisation[ID != 0];
											for each  Candidate in input.Candidates
											{
												CandidateRec = Job_Application[ID == Candidate];
												CandidateRec.Interview_On=input.Date_field;
												CandidateRec.Status="Interview Scheduled";
												sendmail
												[
													from :zoho.adminuserid
													to :CandidateRec.Personal_Email
													subject :"Interview Call from " + OrgDetail.Organisation_Name
													message :"Dear " + CandidateRec.Name + ",<div><br></div><div>As a result of your application for the position of&nbsp;" + CandidateRec.Applying_for.Designation + ", I would like to invite you to attend an interivew on " + input.Date_field + " at our office.</div><div><br></div><div>If the date of interview is inconvenient, please contact us inorder to reschedule the interview.</div><div><br></div><div>We look forward to seeing you.</div><div><br></div><div>Best Regards,</div><div>&nbsp;</div><div>HR Team</div><div>" + OrgDetail.Organisation_Name + "<br></div><div>" + OrgDetail.Address1 + "<br></div><div><br></div>"
												]
											}
										}
										openUrl("#Script:dialog.close","same window");
					)
					}
				}
			}
