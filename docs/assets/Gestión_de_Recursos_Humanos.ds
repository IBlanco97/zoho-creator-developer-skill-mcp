				 void SolicitudEPI.NotificarSolicitudEPI(Solicitud_de_EPIs_Herramientas solicitud)
                 {
                 	info "mensaje de debug";
                 	trabajador = Nuevo_Empleado[ID == solicitud.Trabajador_Solicitante];
                 	// Variables de la configuracion general
                 	config = Configuraci_n_General[ID != 0];
                 	if(config.Notificar_nuevas_solicitudes_de_Herramientas == "Activado")
                 	{
                 		// Campos para notificar
                 		titulo = "Solicitud de " + solicitud.Tipo_de_equipo_solicitado + " recibida.";
                 		mensaje = "Una solicitud de " + solicitud.Tipo_de_equipo_solicitado + " ha sido recibida de parte del trabajdor " + trabajador.Nombre + ".";
                 		if(solicitud.Equipo_Solicitado != "" && solicitud.Equipo_Solicitado != null)
                 		{
                 			mensaje = mensaje + " Equipo solicitado: " + solicitud.Equipo_Solicitado + ".";
                 		}
                 		if(solicitud.Motivo_de_la_Solucitud != null && solicitud.Motivo_de_la_Solucitud != null)
                 		{
                 			mensaje = mensaje + " Motivo: " + solicitud.Motivo_de_la_Solucitud + ".";
                 		}
                 		personalAAvisar = config.Personal_que_recibe_notificaciones_de_solicitudes_de_herramientas;
                 		reportToRedirectPush = "Solicitudes_de_EPIs_Herramientas_Report";
                 		registroID = solicitud.ID;
                 		usarWhatsapp = config.V_as_de_Notificaci_n_Solicitudes_EPI.contains("WhatsApp");
                 		usarMail = config.V_as_de_Notificaci_n_Solicitudes_EPI.contains("Correo Electrónico");
                 		thisapp.FuncionesEstaticas.Notificacion(titulo,mensaje,personalAAvisar,reportToRedirectPush,registroID,usarWhatsapp,usarMail);
                 	}
                 }
				 void SolicitudPermiso.NotificarAEmpleado(Nuevo_Empleado Trabajador_Solicitante, date Fecha_de_comienzo, date Fecha_de_Fin, int solicitudID)
                 {
                 	configuracion_general = Configuraci_n_General[ID != 0];
                 	cuenta = configuracion_general.Cuenta_de_Whatsapp;
                 	if(configuracion_general.Notificar_respuesta_a_Empleados == "Activado")
                 	{
                 		mailsList = {Trabajador_Solicitante.Correo_Electr_nico,Trabajador_Solicitante.Official_Email,Trabajador_Solicitante.Mail_Portal_Empleado};
                 		tittle = "Solicitud de permiso aprobada";
                 		message_ = "Su Solicitud de Permiso entre el " + Fecha_de_comienzo + " y " + Fecha_de_Fin + " ha sido aprobada.";
                 		zoho.pushNotification(mailsList,tittle,message_,"Ver_Solicitud",solicitudID);
                 		whatsapp = configuracion_general.Notificar_respuesta_a_Empleados.contains("WhatsApp");
                 		correo = configuracion_general.Notificaciones_Permisos.contains("Correo Electónico");
                 		if(whatsapp)
                 		{
                 			if(Trabajador_Solicitante.Tel_fono != null)
                 			{
                 				thisapp.NuevoEmpleado.whatsapp(cuenta,Trabajador_Solicitante.Tel_fono,message_);
                 			}
                 			if(Trabajador_Solicitante.M_vil != null)
                 			{
                 				thisapp.NuevoEmpleado.whatsapp(cuenta,Trabajador_Solicitante.M_vil,message_);
                 			}
                 		}
                 		if(correo)
                 		{
                 			if(Trabajador_Solicitante.Official_Email != null)
                 			{
                 				sendmail
                 				[
                 					from :zoho.adminuserid
                 					to :Trabajador_Solicitante.Official_Email
                 					subject :tittle
                 					message :message_
                 				]
                 			}
                 			if(Trabajador_Solicitante.Correo_Electr_nico != null)
                 			{
                 				sendmail
                 				[
                 					from :zoho.adminuserid
                 					to :Trabajador_Solicitante.Correo_Electr_nico
                 					subject :tittle
                 					message :message_
                 				]
                 			}
                 			if(Trabajador_Solicitante.Official_Email != null)
                 			{
                 				sendmail
                 				[
                 					from :zoho.adminuserid
                 					to :Trabajador_Solicitante.Mail_Portal_Empleado
                 					subject :tittle
                 					message :message_
                 				]
                 			}
                 		}
                 	}
                 }
				 void SubirDocumento.ActualizarEstadoDocumentos()
                 {
                 	estadoPendiente = thisapp.FuncionesEstaticas.GetEstadosRequisitos(1);
                 	for each  r in Subir_Documento[ID != 0 && Estado != estadoPendiente]
                 	{
                 		if(r.Fecha_caducidad_documento != null)
                 		{
                 			fechaCaducidad = r.Fecha_caducidad_documento;
                 			valorSemaforo = "Actualizado";
                 			if(fechaCaducidad < zoho.currentdate)
                 			{
                 				valorSemaforo = "Caducado";
                 			}
                 			else if(zoho.currentdate.addDay(15) >= fechaCaducidad && fechaCaducidad >= zoho.currentdate)
                 			{
                 				valorSemaforo = "Cerca de Caducar";
                 			}
                 			//Si el valor del semaforo no es el correcto, actualizalo
                 			if(!valorSemaforo.equalsIgnoreCase(r.Estado))
                 			{
                 				r.Estado=valorSemaforo;
                 			}
                 		}
                 		r.D_as_para_caducar=thisapp.SubirDocumento.CalcularDiasParaCaducar(r.Fecha_caducidad_documento);
                 	}
                 }
				 void SubirDocumento.AsignarDocumentosTrabajadorNombre()
                 {
                 	for each  empleado in Nuevo_Empleado[ID != 0]
                 	{
                 		lastName = empleado.Nombre.last_name;
                 		firstName = empleado.Nombre.first_name;
                 		list_ = lastName.toList(" ");
                 		list_.addAll(firstName.toList());
                 		info "Nombre: " + list_;
                 		for each  documento in Subir_Documento[TRABAJADOR == null && Nombre_Documento.contains(lastName) && Nombre_Documento.contains(firstName)]
                 		{
                 			info "doc: " + documento.Nombre_Documento;
                 			haveAll = true;
                 			for each  word in list_
                 			{
                 				haveAll = documento.Nombre_Documento.contains(word);
                 				if(!haveAll)
                 				{
                 					break;
                 				}
                 			}
                 			//if (haveAll) {
                 			documento.TRABAJADOR=empleado.ID;
                 			//}
                 		}
                 	}
                 }
				 int SubirDocumento.CalcularDiasParaCaducar(date Fecha_caducidad_documento)
                 {
                 	result = null;
                 	if(Fecha_caducidad_documento != null)
                 	{
                 		result = zoho.currenttime.daysBetween(Fecha_caducidad_documento);
                 	}
                 	return result;
                 }
