				 void NuevoCliente.SiguienteCliente(int clienteID)
                 {
                 	cliente = Nuevo_Cliente[ID == clienteID];
                 	nextCli = null;
                 	stopInNextIteration = false;
                 	for each  c in Nuevo_Cliente[ID != 0] sort by Nombre_de_Cuenta asc
                 	{
                 		if(stopInNextIteration)
                 		{
                 			nextCli = c.ID;
                 			break;
                 		}
                 		if(!stopInNextIteration && c.ID == clienteID)
                 		{
                 			stopInNextIteration = true;
                 		}
                 	}
                 	openUrl("#Page:Documentaci_n_del_Cliente?ClienteID=" + nextCli,"same window");
                 }
				 void NuevoCliente.SincronizarClientes()
                 {
                 	records_ = zoho.crm.searchRecords("Accounts","Activo:equals:True");
                 	info records_;
                 }
				 void NuevoEmpleado.AnteriorEmpleado(int empleadoID)
                 {
                 	empleado = Nuevo_Empleado[ID == empleadoID];
                 	anteriorEmpl = null;
                 	for each  empl in Nuevo_Empleado[ID != 0] sort by C_digo_de_Operario asc
                 	{
                 		if(empl.ID == empleadoID)
                 		{
                 			break;
                 		}
                 		else
                 		{
                 			anteriorEmpl = empl.ID;
                 		}
                 	}
                 	openUrl("#Page:Documentaci_n_Empleado?Empleado=" + anteriorEmpl,"same window");
                 }
				 void NuevoEmpleado.AsignarCliente(Nuevo_Empleado empleado, Nuevo_Cliente cliente, bool esClienteHabitual)
                 {
                 	if(esClienteHabitual)
                 	{
                 		clientes = empleado.Clientes_Habituales;
                 		if(clientes == null)
                 		{
                 			clientes = List();
                 		}
                 		clientes.add(cliente);
                 		empleado.Clientes_Habituales=clientes;
                 	}
                 	else
                 	{
                 		clientes = empleado.Clientes_No_Habituales;
                 		if(clientes == null)
                 		{
                 			clientes = List();
                 		}
                 		clientes.add(cliente);
                 		empleado.Clientes_No_Habituales=clientes;
                 	}
                 }
				 void NuevoEmpleado.AsignarEPIaEmpleado(int EmpleadoID, int unidadID)
                 {
                 	epiEmpleado = Unidad_de_EPI_Herramienta[ID == unidadID];
                 	info epiEmpleado;
                 	thisapp.NuevoEPIRopaHerramienta.SetAsignada(epiEmpleado,true,null);
                 	epi = epiEmpleado.EPI_Herramienta;
                 	insert into Asignacion_EPI_Ropa_Herramienta
                 	[
                 		Added_User=zoho.loginuser
                 		EPI_Herramienta=epi
                 		Codigo_de_Serie=unidadID
                 		Fecha_desde=zoho.currenttime
                 		Fecha_hasta=null
                 		Trabajador=EmpleadoID
                 	]
                 }
				 void NuevoEmpleado.ContarRequisitoAnadido(int empleadoID, int requisitoID, bool requisitoEmpresa)
                 {
                 	empleado = Nuevo_Empleado[ID == empleadoID];
                 	requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 	empleado.Total_Requisitos=empleado.Total_Requisitos + 1;
                 	estadoActualizado = thisapp.FuncionesEstaticas.GetEstadosRequisitos(5);
                 	indiceEstado = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(thisapp.NuevoRequisitoDoc.GetEstado(requisito.ID));
                 }
				 void NuevoEmpleado.CorregirMaysculasNombre()
                 {
                 	for each  trabajador in Nuevo_Empleado[ID != 0]
                 	{
                 		trabajador.Nombre.first_name=trabajador.Nombre.first_name.proper();
                 		trabajador.Nombre.last_name=trabajador.Nombre.last_name.proper();
                 	}
                 }
				 void NuevoEmpleado.DesasignarCliente(Nuevo_Empleado empleado, Nuevo_Cliente cliente, bool esClienteHabitual)
                 {
                 	clientes = List();
                 	if(esClienteHabitual)
                 	{
                 		clientes = empleado.Clientes_Habituales;
                 	}
                 	else
                 	{
                 		clientes = empleado.Clientes_No_Habituales;
                 	}
                 	if(clientes == null)
                 	{
                 		clientes = Collection();
                 	}
                 	if(clientes.contains(cliente.ID))
                 	{
                 		nuevaListaClientes = Collection();
                 		for each  c in clientes
                 		{
                 			if(c != cliente.ID)
                 			{
                 				nuevaListaClientes.insert(c);
                 			}
                 		}
                 		if(esClienteHabitual)
                 		{
                 			empleado.Clientes_Habituales=nuevaListaClientes;
                 		}
                 		else
                 		{
                 			empleado.Clientes_No_Habituales=nuevaListaClientes;
                 		}
                 		listaRequisitos = Nueva_Lista_de_Requisitos[Trabajador = empleado.ID && Cliente1 == cliente.ID];
                 		if(listaRequisitos.ID != null)
                 		{
                 			thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(listaRequisitos);
                 		}
                 	}
                 }
