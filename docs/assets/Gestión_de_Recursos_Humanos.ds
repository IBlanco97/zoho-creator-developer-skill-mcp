						thisapp.NuevoRequisitoDoc.SetEstado(input.ID,8);
										thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(input.Trabajador,input.Cliente1);
										cliente = Nuevo_Cliente[ID == input.Cliente1];
										thisapp.NuevoCliente.EstadoClientePRL(cliente);
					)
					}
				}
			}
			Aprobado_por_Cliente as "Aprobado por Cliente"
			{
				type =  functions
				form = Nueva_Lista_de_Requisitos
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						for each  req in input.Lista_Requisitos_Documentaci_n
										{
											if(req.Enviado == "SI" && req.Aprobado_Cliente != "SI")
											{
												//el numero 8 representa el estado enviado y aprobado
												thisapp.NuevoRequisitoDoc.SetEstado(req.ID,8);
											}
										}
										thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(input.Trabajador,input.Cliente1);
										cliente = Nuevo_Cliente[ID == input.Cliente1];
										thisapp.NuevoCliente.EstadoClientePRL(cliente);
					)
					}
				}
			}
			Enviar_Documentos_trabaja as "Enviar Documentos trabajador - Clietne"
			{
				type =  functions
				form = Nueva_Lista_de_Requisitos
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						for each  listaDeRequisitos in Nueva_Lista_de_Requisitos[ID == input.ID]
										{
											lista = List();
											lista.add(listaDeRequisitos);
											reqs = List();
											for each  req in input.Lista_Requisitos_Documentaci_n
											{
												estadoIndice = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(thisapp.NuevoRequisitoDoc.GetEstado(req.ID));
												if(req.Enviado != "SI" && estadoIndice > 3)
												{
													reqs.add(req);
												}
											}
											openUrl("#Form:Env_o_de_documentaci_n?Cliente=" + input.Cliente1 + "&Trabajadores=" + lista + "&Documentos_req=" + reqs,"Popup window");
										}
					)
					}
				}
			}
