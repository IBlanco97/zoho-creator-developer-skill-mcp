	reports
	{
		list Open_Requirements
		{
			displayName = "Open Requirements"
			show all rows from Raise_Your_Requirement  [No_of_Vacancy > 0]  
			(
				Gender
				Age_Preference as "Age Preference"
				Work_Experience as "Work Experience"
				Last_Date_of_Registration as "Last Date of Registration"
				Department
				Designation
				Number_of_Posts as "Number of Posts"
				No_of_Vacancy as "No of Vacancy"
			)
			group by
			(
				Department ascending
			)
		}
		list Closed_Requirements
		{
			displayName = "Closed Requirements"
			show all rows from Raise_Your_Requirement  [No_of_Vacancy == 0]  
			(
				Gender
				Age_Preference as "Age Preference"
				Work_Experience as "Work Experience"
				Last_Date_of_Registration as "Last Date of Registration"
				Department
				Designation
				Number_of_Posts as "Number of Posts"
				No_of_Vacancy as "No of Vacancy"
			)
			group by
			(
				Department ascending
			)
		}
		list Applied_Candidates
		{
			displayName = "Applied Candidates"
			show all rows from Job_Application  [Status == "Applied"]  
			(
				Name 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Resume
				Work_Experience as "Work Experience"
				Applying_for as "Applying for"
				Reference_No as "Reference No"
				Mobile_Number1 as "Mobile Number"
				Date_of_Birth as "Date of Birth"
				Personal_Email as "Personal Email"
				Gender
			)
			group by
			(
				Applying_for ascending
			)
			custom actions
			(
				"Schedule Interview"
				(
	  			workflow = Schedule_Interview
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				success message = ""
				)
			)
		}
		custom Interview_Scheduled_Candidates
		{
			displayName = "Interview Scheduled Candidates"
			show all rows from Job_Application  [Status == "Interview Scheduled"]  
			(
				Gender
				(
					width = 86px
				)
				custom action "Select"
				(
	  			workflow = Select
				show action in view header = true
				show action in edit record menu = true
				column header = "Select"
				success message = ""
				)
				custom action "Reject"
				(
	  			workflow = Reject
				show action in view header = true
				show action in edit record menu = true
				column header = "Reject"
				success message = ""
				)
				Resume
				Reference_No as "Reference No"
				Present_Address1  as "Present Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Show_As_Text
	 			)
				Name 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Personal_Email as "Personal Email"
				Mobile_Number1 as "Mobile Number"
				Work_Experience as "Work Experience"
				Interview_On as "Interview On"
			)
			group by
			(
				Interview_On ascending
			)
		}
		custom Selected_Candidates
		{
			displayName = "Selected Candidates"
			show all rows from Job_Application  [Status == "Selected" || Status == "Offer Letter Sent"]  
			(
				Status
				custom action "Send Offer Letter"
				(
	  			workflow = Send_Offer_Letter
				show action in view header = true
				show action in edit record menu = true
				column header = "Send Offer Letter"
				success message = ""
				condition = (Status == "Selected")
				)
				Applying_for as "Applying for"
				Work_Experience as "Work Experience"
				Mobile_Number1 as "Mobile Number"
				Date_of_Birth as "Date of Birth"
				Personal_Email as "Personal Email"
				Name 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Present_Address1  as "Present Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Show_As_Text
	 			)
			)
			group by
			(
				Status descending
			)
		}
		list Offered_Candidates
		{
			displayName = "Offered Candidates"
			show all rows from Add_Candidate_Details  [Status == "Offer Letter Sent"]  
			(
				Date_of_Joining as "Date of Joining"
				Offer_Expires_On as "Offer Expires On"
				Work_Experience as "Experience"
				Reference_No as "Reference No"
				custom action "View Offer Letter"
				(
	  			workflow = View_Offer_Letter
				show action in view header = true
				show action in edit record menu = true
				column header = "View Offer Letter"
				success message = ""
				)
				CTC
				custom action "Decline"
				(
	  			workflow = Decline
				show action in view header = true
				show action in edit record menu = true
				column header = "Decline"
				success message = ""
				)
				Designation
				Reference_No.Personal_Email as "Personal Email"
			)
		}
		list Accepted_Offers
		{
			displayName = "Accepted Offers"
			show all rows from Add_Candidate_Details  [Status == "Offer Letter Accepted" || Status == "Onboarding Completed"]  
			(
				Work_Experience as "Work Experience"
				Status
				custom action "Complete Onboarding"
				(
	  			workflow = Complete_Onboarding
				show action in view header = true
				show action in edit record menu = true
				column header = "Complete Onboarding"
				success message = ""
				condition = (Status == "Offer Letter Accepted")
				)
				Designation
				CTC
				Reference_No as "Reference No"
				Date_of_Joining as "Date of Joining"
				Photo
				Reference_No.Personal_Email as "Personal Email"
				Reference_No.Mobile_Number1 as "Mobile Number"
			)
			group by
			(
				Status ascending
			)
		}
		custom Rejected_Candidates
		{
			displayName = "Rejected Candidates"
			show all rows from Job_Application  [Status == "Rejected"]  
			(
				Resume
				Interview_On as "Interview On"
				Work_Experience as "Work Experience"
				Reference_No as "Reference No"
				Mobile_Number1 as "Mobile Number"
