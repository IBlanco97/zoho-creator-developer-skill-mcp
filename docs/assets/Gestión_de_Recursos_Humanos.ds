 application "Gestión de Recursos Humanos"
 {
 	date format = "dd-MM-yyyy"
 	time zone = "Europe/Madrid"
 	time format = "24-hr"
 	forms
	{
		form Add_Announcement
		{
			displayname = "Add Announcement"
			success message = "New Announcement Added Successfully!"
			feature property = 32
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Title
			(
    			type = text
				displayname = "Subject"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Message
			(
    			type = textarea
				height = 150px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expires_On
			(
    			type = date
				displayname = "Expires On"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Announced_By
			(
				type = picklist	
				displayname = "Announced By"
				values  = Nuevo_Empleado.ID
    			displayformat = [Official_Email]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
