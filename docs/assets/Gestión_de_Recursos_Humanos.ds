											Tipo="Permiso"
											Solicitud=solicitud.ID
											Etiqueta=etiqueta
											Tecnico=solicitud.Trabajador_Solicitante.ID
										];
										thisapp.ProgramaAnualActividadTecnico.CrearSolicitudPermisoEnCalendario52(solicitud);
						)
					}
