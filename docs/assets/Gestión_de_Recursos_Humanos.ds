'51.8892px'\n\ttype = 'icon'\n\tvalue = 'arrows-2-small-right'\n\tsize = '33px'\n\tcornerRadius = '26px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				if(input.Anio == null)
				{
					input.Anio = zoho.currentdate.getYear();
				}
				if(input.Next == null)
				{
					input.Next = false;
				}
				if(input.Next)
				{
					input.Anio = input.Anio + 1;
					input.Next = false;
				}
			}
		}
