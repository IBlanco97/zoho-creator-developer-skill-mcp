			Calcular_valor_sem_foro as "Calcular valor semáforo"
			{
				type =  form
				form = Subir_Documento
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(Fecha_caducidad_documento != null)
										{
											if(Fecha_caducidad_documento < zoho.currentdate)
											{
												input.Estado = "Caducado";
											}
											else if(zoho.currentdate.addDay(15) >= Fecha_caducidad_documento && Fecha_caducidad_documento >= zoho.currentdate)
											{
												input.Estado = "Cerca de Caducar";
											}
											else
											{
												input.Estado = "Actualizado";
											}
										}
										else
										{
											input.Estado = thisapp.FuncionesEstaticas.GetEstadosRequisitos(5);
										}
						)
					}
				}

			}
			Autocrear_nombre_de_formu as "Autocrear nombre de formulario"
			{
				type =  form
				form = Subir_Documento
				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											nombre = input.Plantilla.Nombre_de_la_plantilla;
										if(Plantilla.EMPRESA != null)
										{
											nombre = nombre + " - " + input.Plantilla.EMPRESA.N_Orden + "_" + input.Plantilla.EMPRESA.Nombre;
										}
										if(CLIENTE != null)
										{
											nombre = nombre + " - " + input.CLIENTE.N_Orden + "_" + input.CLIENTE.Nombre_de_Cuenta;
										}
										if(TRABAJADOR != null)
										{
											nombre = nombre + " - " + input.TRABAJADOR.N_Orden + "_" + input.TRABAJADOR.Nombre;
										}
										input.Nombre_Documento = nombre + " - DOC-No-" + input.Numero_Documento;
						)
					}
				}

			}
