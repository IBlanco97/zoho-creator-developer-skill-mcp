				value = "Personal Information"
	 			row = 1
	 			column = 1   
				width = 300px
			)
			Photo
			(
    			type = image
				source  = public_url,file
				enable = link, title
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Blood_Group
			(
				type = picklist
				displayname = "Blood Group"
				values = {""}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Marital_Status
			(
				type = picklist
				displayname = "Marital Status"
				values = {"Single","Married","Widowed","Separated","Divorced"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Present_Address
			(
    			type = address
				displayname = "Present Address"
     			capture_coordinates = true
     			adjust_using_map = false
