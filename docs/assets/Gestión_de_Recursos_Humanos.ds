				ContadorCercaCaducar as "Contador Cerca Caducar"
				ContadorCaducados as "Contador Caducados"
				ContadorNoEnviados as "Contador No Enviados"
				ContadorEnviadosNoAprobados
				ContadorEnviadosAprobados
			)
			options
			(
	 			display field = Localizacion
         		location
         		(
	 		 		latitude  = 41.4848
	 		 		longitude = 2.16266
         		)
	 	 		radius = 100 Miles
	 		)
			conditional formatting
			(
				"Map"
				{
				format = "color:#00b0ff;map-icon:location-map-pin;map-icon-color:#ffffff;"
				}
			)
		}
