			Eliminar_Encuesta as "Eliminar Encuesta"
			{
				type =  form
				form = Encuesta
				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  encuesta in Encuesta[Encuesta_Madre == input.ID]
										{
											for each  pregunta in encuesta.Preguntas
											{
												for each  respuesta in pregunta.Opci_n_Respuesta
												{
													delete from Opci_n_Respuesta[ID == respuesta];
												}
												delete from Pregunta_Encuesta[ID == pregunta];
											}
											delete from Encuesta[ID == encuesta.ID];
										}
						)
					}
				}

			}
