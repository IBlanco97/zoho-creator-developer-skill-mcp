		schedule
		{
			actualizarSemaforosCaduci1 as "actualizarSemaforosCaducidadDocumentos"
			{
				type =  schedule
				form = Subir_Documento
				start = before 16 days from Fecha_caducidad_documento at "00:05:00"
				end   = after 1 days from Fecha_caducidad_documento
				frequency = daily
				time zone = "Europe/Madrid"
				on start
				{
					actions 
					{
					on load
					(
						estadoPendiente = thisapp.FuncionesEstaticas.GetEstadosRequisitos(1);
										for each  r in Subir_Documento[ID != 0 && Estado != estadoPendiente]
										{
											info r;
											fechaCaducidad = r.Fecha_caducidad_documento;
											valorSemaforo = "Actualizado";
											if(fechaCaducidad < zoho.currentdate)
											{
												valorSemaforo = "Caducado";
											}
											else if(zoho.currentdate.addDay(15) >= fechaCaducidad && fechaCaducidad >= zoho.currentdate)
											{
												valorSemaforo = "Cerca de Caducar";
											}
											//Si el valor del semaforo no es el correcto, actualizalo
											if(!valorSemaforo.equalsIgnoreCase(r.Estado))
											{
												r.Estado=valorSemaforo;
											}
										}
					)
					}
				}
			}
			EnvioProgramadoWhatsapp as "EnvioProgramadoWhatsapp"
			{
				type =  schedule
				form = WhatsApp[Fecha_y_Hora is not null]
				start = Fecha_y_Hora
				time zone = "Europe/Madrid"
				on start
				{
					actions 
					{
					on load
					(
						info "X";
										if(input.Enviar_a = "Todos los trabajadores")
										{
											input.Trabajadores_Seleccionados = null;
											for each  trabajador in Nuevo_Empleado[ID != 0]
											{
												telefono = trabajador.M_vil;
												if(telefono == null || telefono == "")
												{
													telefono = trabajador.Tel_fono;
												}
												thisapp.NuevoEmpleado.whatsapp(input.Cuenta,telefono,input.Mensaje);
											}
										}
										else
										{
											for each  trabajador in input.Trabajadores_Seleccionados
											{
												telefono = trabajador.M_vil;
												if(telefono == null || telefono == "")
												{
													telefono = trabajador.Tel_fono;
												}
												thisapp.NuevoEmpleado.whatsapp(input.Cuenta,telefono,input.Mensaje);
											}
										}
										for each  contactoID in input.Contactos
										{
											contacto = Contacto[ID == contactoID];
											telefono = contacto.Tel_fono;
											if(telefono != null)
											{
												thisapp.NuevoEmpleado.whatsapp(input.Cuenta,telefono,input.Mensaje);
											}
										}
					)
					}
				}
			}
			EnvioProgramadoDocumentac as "EnvioProgramadoDocumentacion"
			{
				type =  schedule
				form = Env_o_de_documentaci_n[Programar_Env_o == "SI" && Fecha_y_hora is not null]
				start = Fecha_y_hora
				time zone = "Europe/Madrid"
				on start
				{
					actions 
					{
					on load
					(
						if(Forma_de_env_o.Forma_de_env_o1 == "Mail")
										{
											docs = List();
											for each  req_id in input.Documentos_req
											{
												req = Nuevo_Requisitos_Doc[ID == req_id];
												doc = Subir_Documento[ID == req.Documento];
												docs.add(doc.Documento);
											}
											message_content = input.Mensaje;
											iterar = List("1,2,3");
											for each  i in iterar
											{
												try 
												{
													sendmail
													[
														from :zoho.adminuserid
														to :input.Email
														subject :"Documentos Domo21"
														message :message_content
														Attachments :file:docs
													]
													break;
												}
												catch (e)
												{
													info e.lineNo;
													// Displays line number of the statement that caused the error 
													info e.message;
													// Displays the error message 
													info e;
													// Displays both line number and error message
												}
											}
										}
										for each  req_id in input.Documentos_req
										{
											thisapp.NuevoRequisitoDoc.SetEstado(req_id,7);
											req.Nombre_Color_Enviado=thisapp.NuevoRequisitoDoc.AutorrellenarNombreColorEnviado(req.Enviado,req.Aprobado_Cliente,req.Plantilla.Nombre_de_la_plantilla);
										}
					)
					}
					actions 
					{
					on load
					(
						cliente = Nuevo_Cliente[ID == input.Cliente];
										for each  Trabajador in cliente.Trabajadores_Habituales
										{
											thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(Trabajador,input.Cliente);
										}
										thisapp.NuevoCliente.EstadoClientePRL(cliente);
					)
					}
				}
			}
			CalclularAniguedadTrabaja as "CalclularAniguedadTrabajadores"
			{
				type =  schedule
				start = "2025-07-29 00:00:00"
				frequency = daily
				time zone = "Europe/Madrid"
				on start
				{
					actions 
					{
					on load
					(
						for each  trabajador in Nuevo_Empleado[ID != 0]
										{
											if(trabajador.Fecha_de_Alta != null)
											{
												months = trabajador.Fecha_de_Alta.monthsDiff(zoho.currentdate) % 12;
												years = trabajador.Fecha_de_Alta.yearsDiff(zoho.currentdate);
												Antig_edad = "";
												Antig_edad = years + " años y ";
												Antig_edad = Antig_edad + months + " meses";
												trabajador.Antig_edad=Antig_edad;
											}
											else
											{
												trabajador.Antig_edad="";
											}
										}
					)
					}
				}
			}
