				 void NuevoCliente.ChecarAgregarRequisitos(Nuevo_Cliente cliente)
                 {
                 	// Requisitos Trabajadores
                 	Lista_de_Requisitos = cliente.Lista_de_Requisitos;
                 	// Modelos de documentos trabajadores
                 	Plantillas_Requeridas = cliente.Plantillas_Requeridas;
                 	// Requisitos Empresa
                 	Lista_Documentos_Requeridos_Empresa = cliente.Lista_Documentos_Requeridos_Empresa;
                 	// Modleos requeridos Empresa
                 	Plantillas_con_Empresa = cliente.Plantillas_con_Empresa;
                 	// Requisitos Autónomo
                 	Documentos_Aut_nomo = cliente.Documentos_Aut_nomo;
                 	// Por cada lista de requisitos que lleva el cliente
                 	for each  lrID in Lista_de_Requisitos
                 	{
                 		//info "lista requisitos revisando plantillas: " + lr.ID;
                 		//flag de si no hubo cambios
                 		notfound = true;
                 		// Lista de Requisitos
                 		lr = Nueva_Lista_de_Requisitos[ID == lrID];
                 		if(lr.ID != input.Lista_Documentos_Requeridos_Empresa)
                 		{
                 			// Nuevamente las plantillas del trabajador
                 			plantillas = Plantillas_Requeridas;
                 			info "Numero de plantillas para trabajador: " + plantillas.size();
                 			// Trabajador asociado a la lista de requisitos
                 			trabajador = Nuevo_Empleado[ID == lr.Trabajador];
                 			// SI el trabajador es autónomo
                 			if(trabajador.Tipo_de_R_gimen == "Especial/Autónomo")
                 			{
                 				//incluir en las plantillas a revisar los documentos de autónomo
                 				plantillas.addAll(input.Documentos_Aut_nomo);
                 				info "Numero de plantillas para trabajador y autónomo: " + plantillas.size();
                 			}
                 		}
                 		// SI se trata de la lista de requisitos con la empresa
                 		if(lr.ID == input.Lista_Documentos_Requeridos_Empresa)
                 		{
                 			// sustituir las plantillas de empleado por las plantillas de Empresa
                 			plantillas = input.Plantillas_con_Empresa;
                 			info "Numero de plantillas para empresa: " + plantillas.size();
                 		}
                 		// Finalemte revisar si existe un requisito para cada plantilla que debe contener esa lista de requisitos de trabajador, autonomo o empresa
                 		for each  pla in plantillas
                 		{
                 			// plantilla itereada de la que se quiere encontrar un requisito en la lista o en su defecto, crear un nuevo requisito para esa plantilla
                 			p = Plantilla[ID == pla];
                 			if(lr.Es_Lista_con_empresa == "NO")
                 			{
                 				info "Checando Plantilla " + p.Nombre_de_la_plantilla + " para trabajador " + trabajador.Nombre;
                 			}
                 			else
                 			{
                 				info "Checando Plantilla " + p.Nombre_de_la_plantilla + " para empresa";
                 			}
                 			found = false;
                 			// Por cada requisito
                 			for each  req in lr.Lista_Requisitos_Documentaci_n
                 			{
                 				// SI el requisito es de la plantilla buscada
                 				if(p == req.Plantilla)
                 				{
                 					// Se ha encontrado un requisito de esta plantilla en la lista. Se puede romper el ciclo de busqueda y continuar con la siguiente plantilla.
                 					found = true;
                 					notfound = false;
                 					break;
                 				}
                 			}
                 			// Si no fue encotrado un requisito de esa plantilla en la lista de requisitos, crear un requisito de esa plantilla
                 			if(!found)
                 			{
                 				cliente = Nuevo_Cliente[ID == lr.Cliente1];
                 				listareq = Nueva_Lista_de_Requisitos[ID == lr.ID];
                 				nOrden = thisapp.NuevoRequisitoDoc.CrearRequsitoAtomaticamente(lr.Trabajador.ID,lr.Trabajador.Nombre,cliente,p.ID,p.Nombre_de_la_plantilla,p.Trabajador1,p.CLIENTE,listareq);
                 				reqID = Nuevo_Requisitos_Doc[N_Orden == nOrden];
                 				estadoIndice = thisapp.NuevoRequisitoDoc.getEstadoIndice(reqID.ID);
                 				thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lrID,estadoIndice,true);
                 				thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lrID,6,true);
                 			}
                 		}
                 		// si hubo algun cambio
                 		if(!notfound)
                 		{
                 			lisReq = Nueva_Lista_de_Requisitos[ID == lr.ID];
                 			lr.Estado=thisapp.RequisitoDoc.EstadoListaSegunRequisitos(lisReq);
                 			thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(lr.Trabajador,lr.Cliente1);
                 		}
                 	}
                 }
				 void NuevoCliente.ChecarEliminarRequisitosEmpresa(int Lista_Documentos_Requeridos_Empresa, list Plantillas_con_Empresa)
                 {
                 	listaRequisitosEmpresa = Nueva_Lista_de_Requisitos[ID = input.Lista_Documentos_Requeridos_Empresa];
                 	for each  requisitoID in listaRequisitosEmpresa.Lista_Requisitos_Documentaci_n
                 	{
                 		found = false;
                 		for each  plantilla in Plantillas_con_Empresa
                 		{
                 			requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 			if(requisito.Plantilla == plantilla)
                 			{
                 				found = true;
                 				break;
                 			}
                 		}
                 		if(!found)
                 		{
                 			thisapp.NuevoRequisitoDoc.EliminarRequisito(requisitoID);
                 			listaRequisitosEmpresa.Estado=thisapp.RequisitoDoc.EstadoListaSegunRequisitos(listaRequisitosEmpresa);
                 			thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(listaRequisitosEmpresa.Trabajador,listaRequisitosEmpresa.Cliente1);
                 		}
                 	}
                 }
				 void NuevoCliente.ChecarEliminarRequisitosTrabajador(list Lista_de_Requisitos, list Plantillas_Requeridas, list Documentos_Aut_nomo)
                 {
                 	plantillas = Plantillas_Requeridas;
                 	for each  listaRequisitosID in Lista_de_Requisitos
                 	{
                 		listaRequisitos = Nueva_Lista_de_Requisitos[ID = listaRequisitosID];
                 		trabajador = Nuevo_Empleado[ID == listaRequisitos.Trabajador];
                 		if(trabajador.Tipo_de_R_gimen == "Especial/Autónomo")
                 		{
                 			plantillas.addAll(input.Documentos_Aut_nomo);
                 		}
                 		if(listaRequisitos.Es_Lista_con_empresa == null || listaRequisitos.Es_Lista_con_empresa == "NO" || listaRequisitos.Es_Lista_con_empresa == "")
                 		{
                 			for each  requisitoID in listaRequisitos.Lista_Requisitos_Documentaci_n
                 			{
                 				requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 				found = false;
                 				for each  plantilla in plantillas
                 				{
                 					if(requisito.Plantilla == plantilla)
                 					{
                 						found = true;
                 						break;
                 					}
                 				}
                 				if(!found)
                 				{
                 					thisapp.NuevoRequisitoDoc.EliminarRequisito(requisitoID);
                 					listaRequisitos.Estado=thisapp.RequisitoDoc.EstadoListaSegunRequisitos(listaRequisitos);
                 					thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(listaRequisitos.Trabajador,listaRequisitos.Cliente1);
                 				}
                 			}
                 		}
                 	}
                 }
				 void NuevoCliente.contarRequisitoSegunEstado(int clienteID, int indiceEstado, bool incrementar)
                 {
                 	valor = 0;
                 	if(incrementar)
                 	{
                 		valor = 1;
                 	}
                 	else
                 	{
                 		valor = -1;
                 	}
                 	cliente = Nuevo_Cliente[ID == clienteID];
                 	if(indiceEstado == 1)
                 	{
                 		cliente.ContadorPendietesSubir=cliente.ContadorPendietesSubir + valor;
                 	}
                 	else if(indiceEstado == 3)
                 	{
                 		cliente.ContadorCaducados=cliente.ContadorCaducados + valor;
                 	}
                 	else if(indiceEstado == 4)
                 	{
                 		cliente.ContadorCercaCaducar=cliente.ContadorCercaCaducar + valor;
                 	}
                 	else if(indiceEstado == 5)
                 	{
                 		cliente.ContadorActualizados=cliente.ContadorActualizados + valor;
                 	}
                 	else if(indiceEstado == 6)
                 	{
                 		cliente.ContadorNoEnviados=cliente.ContadorNoEnviados + valor;
                 	}
                 	else if(indiceEstado == 7)
                 	{
                 		cliente.ContadorEnviadosNoAprobados=cliente.ContadorEnviadosNoAprobados + valor;
                 	}
                 	else if(indiceEstado == 8)
                 	{
                 		cliente.ContadorEnviadosAprobados=cliente.ContadorEnviadosAprobados + valor;
                 	}
                 	//Esto garantiza que no cuente el doble de requisitos, solo los cuente por estado de caducidad
                 	if(indiceEstado < 6)
                 	{
                 		cliente.ContadorTotal=cliente.ContadorTotal + valor;
                 	}
                 	thisapp.NuevoCliente.EstadoClientePRL(cliente);
                 	/* DEBUG
                 	message_ = cliente.Nombre_de_Cuenta;
                 	if(incrementar)
                 	{
                 		message_ = message_ + " +";
                 	}
                 	else
                 	{
                 		message_ = message_ + " -";
                 	}
                 	info message_ + thisapp.FuncionesEstaticas.GetEstadosRequisitos(indiceEstado);
                 	*/
                 }
				 void NuevoCliente.EstadoClientePRL(Nuevo_Cliente cliente)
                 {
                 	status = 3;
                 	//cliente = Nuevo_Cliente[ID == ClienteID];
                 	for each  lrID in cliente.Lista_de_Requisitos
                 	{
                 		if(lrID.ID != cliente.Lista_Documentos_Requeridos_Empresa)
                 		{
                 			EstadoCliente = Nueva_Lista_de_Requisitos[ID == lrID.ID].Estado_Cliente;
                 			if(status > 2 && EstadoCliente == thisapp.NuevaListaDeRequisitos.GetStatusEnviadoByIndex(2))
                 			{
                 				status = 2;
                 			}
                 			if(status > 1 && EstadoCliente == thisapp.NuevaListaDeRequisitos.GetStatusEnviadoByIndex(1))
                 			{
                 				status = 1;
                 				break;
                 			}
                 		}
                 	}
                 	cliente.Estado_General_Documentacion=thisapp.NuevaListaDeRequisitos.GetStatusEnviadoByIndex(status);
                 }
