					actions  (TIPO is null)
					{
						hide Tipo_de_Ropa,Talla,CADUCIDAD,TIPO_CADUCIDAD_A_OS,CERTIFICACI_N_FABRICANTE;
					}
					actions  (Forma_de_Contabilizar_Unidades == "Serializadas" || Forma_de_Contabilizar_Unidades is null)
					{
