			Asignar_Unidad_EPI as "Asignar Unidad EPI"
			{
				type =  functions
				form = Unidad_de_EPI_Herramienta
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						if(Estado == "No Asignado" || Estado == "No Asignada")
										{
											openUrl("#Form:Asignacion_EPI_Ropa_Herramienta?Codigo_de_Serie=" + input.ID + "&EPI_Herramienta=" + input.EPI_Herramienta,"popup window");
										}
										else
										{
											Asignacion = Asignacion_EPI_Ropa_Herramienta[Trabajador == input.Asignado_a && EPI_Herramienta == input.EPI_Herramienta && Codigo_de_Serie == input.ID && Estado == "Activa"];
											Asignacion.Estado="Inactiva";
											Asignacion.Fecha_hasta=zoho.currenttime;
											input.Asignado_a = null;
											input.Estado = "No Asignado";
											epi = Nuevo_EPI_Herramienta[ID == input.EPI_Herramienta];
											sumar = 1;
											if(input.Contabilidad == "No Serializada")
											{
												sumar = input.Cantidad;
											}
											thisapp.NuevoEPIRopaHerramienta.ModificarCantidadUnidades(epi,sumar,true,false);
											delete from Unidad_de_EPI_Herramienta[ID == input.ID];
										}
					)
					}
				}
			}
