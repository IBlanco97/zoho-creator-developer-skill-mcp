				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Asignacion_EPI_Ropa_Herramienta
		{
			displayname = "Asignacion EPI Ropa Herramienta"
			success message = "Los datos se han agregado correctamente!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Fecha_desde
			(
    			type = datetime
				displayname = "Fecha desde"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Fecha_hasta
			(
    			type = datetime
				displayname = "Fecha hasta"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Trabajador
			(
				type = picklist	
				values  = Nuevo_Empleado.ID
    			displayformat = [" " + Nombre.last_name + " " + Nombre.first_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			EPI_Herramienta
			(
				type = picklist	
				displayname = "EPI - Herramienta"
				values  = Nuevo_EPI_Herramienta.ID
    			displayformat = [Nombre]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Codigo_de_Serie
			(
				type = picklist	
				displayname = "Código de Serie"
				values  = Unidad_de_EPI_Herramienta[Estado == "No Asignado" && EPI_Herramienta.ID == input.EPI_Herramienta].ID
    			displayformat = [Codigo_de_Serie]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unidades
			(
				type = number
				initial value = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estado
			(
				type = picklist
				maxchar = 100
				values = {"Activa","Inactiva"}
				initial value = "Activa"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comentarios
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Forma_Contabilidad
			(
				type = radiobuttons
				displayname = "Forma Contabilidad"
				maxchar = 100
				values = {"Serializadas","No Serializadas"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Enviar"
					)
					reset
					(
   						type = reset
   						displayname = "Restablecer"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Actualizar"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancelar"
					)
				}
			}
		}
