			}
			Entrada_de_Trabajadores as "Entrada de Trabajadores"
			{
				type =  form
				form = Elegir_Trabajador
				record event = on add

				on user input of Trabajadores
				{
					actions 
					{
						custom deluge script
						(
											cliente = Nuevo_Cliente[ID == input.Cliente];
										found = false;
										for each  trabajador in cliente.Trabajadores_Habituales
										{
											found = false;
											for each  t in input.Trabajadores
											{
												if(trabajador == t)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												// Primero Eliminar lista de requisitos
												listaRequisitos = Nueva_Lista_de_Requisitos[Cliente1 == cliente.ID && Trabajador == trabajador];
												if(listaRequisitos.ID != null)
												{
													thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(listaRequisitos);
												}
												// Desligar Técnico de CLiente
												trabajadorRegistro = Nuevo_Empleado[ID == trabajador];
												if(trabajadorRegistro.ID != null)
												{
													thisapp.NuevoEmpleado.DesasignarCliente(trabajadorRegistro,cliente,false);
												}
												// Registrar fecha de fin en el registro de asignaciones
												asignacion = Asignacion_T_cnico_Cliente[Tecnico == trabajador && Cliente == cliente.ID] sort by Fecha_de_Inicio;
												if(asignacion.ID != null)
												{
													asignacion.Fecha_de_Fin=zoho.currenttime;
													asignacion.Estado="Finalizada";
													for each  fechaID in asignacion.Fechas
													{
														rangoFecha = Rango_Fechas_Asingacion[ID == fechaID];
														rangoFecha.Fecha_de_Fin=asignacion.Fecha_de_Fin;
													}
													//Rectificar registro de calendario
													thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asignacion);
												}
											}
										}
										// Checar si se ha añadido algún cliente
										for each  t in input.Trabajadores
										{
											found = false;
											for each  trabajador in cliente.Trabajadores_Habituales
											{
												if(t == trabajador)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												openUrl("#Form:Asignacion_T_cnico_Cliente?Tecnico=" + t + "&Cliente=" + cliente.ID,"popup window");
												break;
											}
										}
						)
					}
				}

			}
			CrearAsignacionCalendario as "CrearAsignacionCalendario"
