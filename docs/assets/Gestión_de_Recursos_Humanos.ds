				 void NuevoCliente.setCaducidadTolerancia(int clienteID, string valor)
                 {
                 	cliente = Nuevo_Cliente[ID == clienteID];
                 	if(cliente.Bloqueo_de_Acceso == null || cliente.Bloqueo_de_Acceso == "")
                 	{
                 		cliente.Bloqueo_de_Acceso=valor;
                 	}
                 	else
                 	{
                 		fechaBloq = null;
                 		if(cliente.Bloqueo_de_Acceso.contains(" "))
                 		{
                 			fechaBloq = cliente.Bloqueo_de_Acceso.getprefix(" ").toDate();
                 		}
                 		else
                 		{
                 			fechaBloq = cliente.Bloqueo_de_Acceso.toDate();
                 		}
                 		info "valor: " + valor;
                 		if(valor != "")
                 		{
                 			pref = valor.getprefix(" ");
                 			if(isDate(pref))
                 			{
                 				fechaNueva = pref.toDate();
                 				info fechaBloq;
                 				if(fechaBloq >= fechaNueva)
                 				{
                 					cliente.Bloqueo_de_Acceso=valor;
                 				}
                 			}
                 		}
                 	}
                 }
				 void NuevoCliente.SetTrabajadores(int ClienteID, list trabajadoresNuevaLista)
                 {
                 	cliente = Nuevo_Cliente[ID == ClienteID];
                 	//creando nuevas listas de requisitos para nuevos trabajadores
                 	for each  trabajadorNuevoID in trabajadoresNuevaLista
                 	{
                 		trabajadorNuevo = Nuevo_Empleado[ID == trabajadorNuevoID];
                 		info "Trabajador Revisado: " + trabajadorNuevo.Nombre;
                 		found = false;
                 		for each  trabajadorCliID in cliente.Trabajadores_Habituales
                 		{
                 			if(trabajadorCliID == trabajadorNuevoID)
                 			{
                 				info "Nuevo Trabajador Encontrado.";
                 				found = true;
                 				break;
                 			}
                 		}
                 		if(!found)
                 		{
                 			thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitos(trabajadorNuevoID,trabajadorNuevo.Nombre,cliente);
                 		}
                 	}
                 	//eliminando listas de requisitos de trabajadores que fueron eliminados
                 	for each  lrID in cliente.Lista_de_Requisitos
                 	{
                 		if(lrID != cliente.Lista_Documentos_Requeridos_Empresa)
                 		{
                 			lr = Nueva_Lista_de_Requisitos[ID == lrID];
                 			found = false;
                 			for each  trabajadorNuevoID in trabajadoresNuevaLista
                 			{
                 				if(lr.Trabajador == trabajadorNuevoID)
                 				{
                 					found = true;
                 					break;
                 				}
                 			}
                 			if(!found)
                 			{
                 				thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(lr);
                 			}
                 		}
                 	}
                 	//trabajador = Nuevo_Empleado[ID == TrabajadorID];
                 	cliente.Trabajadores_Habituales=trabajadoresNuevaLista;
                 }
