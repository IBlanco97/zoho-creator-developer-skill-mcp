			Validar_Cantidad2 as "Validar Cantidad"
			{
				type =  form
				form = Alta_Baja_EPI_Herramientas
				record event = on add or edit

				on user input of Cantidad_de_Unidades_de_Alta_Baja
				{
					actions 
					{
						custom deluge script
						(
											if(Cantidad_de_Unidades_de_Alta_Baja < 1)
										{
											alert "La cantidad especificada debe ser mínimo 1.";
											input.Cantidad_de_Unidades_de_Alta_Baja = 1;
										}
										else if(Tipo == {"Baja"})
										{
											if(Cantidad_de_Unidades_de_Alta_Baja > input.EPI_Herramienta.Unidades_Disponibles)
											{
												alert "La cantidad especificada no puede ser mayor que las unidades disponibles: " + input.EPI_Herramienta.Unidades_Disponibles;
												input.Cantidad_de_Unidades_de_Alta_Baja = input.EPI_Herramienta.Unidades_Disponibles;
											}
										}
						)
					}
				}

			}
			Validar_Unidades_Asignada as "Validar Unidades Asignadas"
			{
				type =  form
				form = Asignacion_EPI_Ropa_Herramienta
				record event = on add

				on user input of Unidades
				{
					actions 
					{
						custom deluge script
						(
											disponibles = input.EPI_Herramienta.Unidades_Disponibles;
										if(Unidades > disponibles)
										{
											alert "No hay suficientes unidades disponibles.";
											input.Unidades = disponibles;
										}
										if(Unidades < 1)
										{
											alert "La cantidad de unidades a asignar debe ser al menos 1.";
											input.Unidades = 1;
										}
						)
					}
				}

			}
