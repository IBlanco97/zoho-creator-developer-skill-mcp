		list Otros_Documentos
		{
			displayName = "Documentos"
			show all rows from Subir_Documento  [Estado == "Caducado" || Requisitos_enlazados.ID is null]  
			(
				Plantilla
				TRABAJADOR as "Trabajador"
				EMPRESA as "Empresa"
				CLIENTE as "Cliente"
				Fecha_creaci_n_documento as "Fecha creación_documento"
				Fecha_validez_documento as "Fecha validez documento"
				Fecha_caducidad_documento as "Fecha caducidad documento"
