		timeline calendario_de_prueba
		{
			displayName = "calendario de prueba"
			show all rows from Asignacion_T_cnico_Cliente    
			(
				Etiqueta
				Tecnico as "Técnico"
				Cliente
				Fecha_de_Inicio as "Fecha de Inicio"
				Fecha_de_Fin as "Fecha de Fin"
				Estado
				Observaciones
				Enlace_de_regreso as "Enlace de regreso"
				Status
			)
			options
			(
				display type = week
				week start day = sunday
				display field = Cliente
				start date = Fecha_de_Inicio
				end date = Fecha_de_Fin
				default date 
				(
	    			day   = Today
	    			month = Currentmonth
	    			year  = Currentyear
				)
			)
		}
		calendar Calendario_Prueba_2
		{
			displayName = "Calendario Prueba 2"
			show all rows from Asignacion_T_cnico_Cliente    
			(
				Etiqueta
				Tecnico as "Técnico"
