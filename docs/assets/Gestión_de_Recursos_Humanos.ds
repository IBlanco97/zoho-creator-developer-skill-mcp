				{
				condition = (Estado == "Actualizado")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#92d191;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f2c47d;"
				}
				"New Formatting"
				{
				condition = (Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación" || Estado == "Caducado")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f6abab;"
				}
			)
		}
		default list Ver_Solicitudes
		{
			displayName = "Solicitudes de Permisos o Vacaciones"
			show all rows from Solicitud    
			(
				Fecha_de_comienzo as "Fecha de comienzo"
				Fecha_de_Fin as "Fecha de Fin"
				Nota
				Aprobado as "Estado"
				Trabajador_Solicitante as "Trabajador Solicitante"
				(
					view = Employee_Details
				)
				custom action "Aprobar"
				(
	  			workflow = Aprobar1
				show action in edit record menu = true
				column header = "Aprobar"
				condition = (Aprobado == "Sin Respuesta")
				)
				custom action "Denegar"
				(
	  			workflow = Denegar1
				show action in edit record menu = true
				column header = "Denegar"
				condition = (Aprobado == "Sin Respuesta")
				)
				Tipo
				Tipo_de_Permiso_Retribu_do as "Tipo de Permiso Retribuido"
				Trabajador_Solicitante.Clientes_Habituales as "Cliente"
				Tipo_de_Permiso_No_Retribuido as "Tipo de Permiso No Retribuido"
			)
			filters
			(
				"Vacaciones"  :  Tipo == "Vacaciones"
				"Solicitudes de Permisos Retribuidos"  :  Tipo == "Permiso Retribuidos"
				"Solicitudes de Permisos No Retribuidos"  :  Tipo == "Permiso no Retribuidos"
			)
			sort by
			(
				Fecha_de_comienzo descending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Aprobado == "SI")
				fields = [Aprobado]
				format = "background-color:#92d191;"
				}
				"New Formatting"
				{
				condition = (Aprobado == "NO")
				fields = [Aprobado]
				format = "background-color:#f27d7d;"
				}
			)
		}
		default list Solicitudes_de_EPIs_Herramientas_Report
		{
			displayName = "Solicitud de EPI - Herramienta"
			show all rows from Solicitud_de_EPIs_Herramientas    
			(
				Motivo_de_la_Solucitud as "Motivo de la Solucitud"
				Trabajador_Solicitante as "Trabajador Solicitante"
				(
					view = Employee_Details
				)
				Aprobado as "Estado"
				Added_Time as "Hora agregado"
				custom action "Responder / Modificar Estado"
				(
	  			workflow = Aprobar_EPI
				show action in edit record menu = true
				column header = "Responder / Modificar Estado"
				condition = (Trabajador_Solicitante.ID is not null && Aprobado != "Confirmado")
				)
				Equipo_Solicitado as "Equipo Solicitado"
				Fecha_Prevista_de_Entrega as "Fecha Prevista de Entrega"
				Trabajador_Solicitante.Clientes_Habituales as "Cliente"
				Nota_Sobre_Respuesta_a_la_Soilicitud as "Nota Sobre Respuesta a la Soilicitud"
				Historia_de_la_Solicitud as "Historia de la Solicitud"
				(
					foldcontent = enable
				)
			)
			filters
			(
				"Solicitudes de EPI"  :  Tipo_de_equipo_solicitado == "EPI"
				"Solicitudes de Herramientas"  :  Tipo_de_equipo_solicitado == "Herramienta"
				"Solicitudes de Ropa"  :  Tipo_de_equipo_solicitado == "Ropa"
			)
			sort by
			(
				Aprobado custom
				Added_Time ascending
			)
			conditional formatting
			(
				"Aprobado Entregado"
				{
				condition = (Aprobado == "Aprobado" || Aprobado == "Entregado")
				fields = [Aprobado]
				format = "background-color:#92d191;"
				}
				"Rechazado"
				{
				condition = (Aprobado == "Rechazado")
				fields = [Aprobado]
				format = "background-color:#f27d7d;"
				}
				"Gestionandose"
				{
				condition = (Aprobado == "Gestiónandose")
				fields = [Aprobado]
				format = "background-color:#f2c47d;"
				}
				"Confirmado"
				{
				condition = (Aprobado == "Confirmado")
				fields = [Aprobado]
				format = "background-color:#aec6f8;"
				}
			)
		}
		list Documentos_Empresa
		{
			displayName = "Empresa"
			show all rows from Subir_Documento  [Plantilla.EMPRESA is not null && Archivado != "SI" || Archivado is null && Plantilla.EMPRESA1 == "SI" && Estado != "Pendiente Subir"]  
			(
				Plantilla
				(
					view = Ver_Plantillas
				)
				TRABAJADOR as "Trabajador"
				(
					view = Employee_Details
				)
				EMPRESA as "Empresa"
				(
					view = Ver_Empresa
				)
				CLIENTE as "Cliente"
				(
					view = Ver_Clientes
				)
				Fecha_creaci_n_documento as "Fecha creación_documento"
				Fecha_validez_documento as "Fecha validez documento"
				Fecha_caducidad_documento as "Caducidad"
				Observaciones
				Nombre_Documento as "Nombre Documento"
				Numero_Documento as "Numero Documento"
				Documento
				Estado
				Archivado
				D_as_para_caducar as "Días para caducar"
			)
			group by
			(
				EMPRESA ascending
			)
			sort by
			(
				TRABAJADOR ascending
				CLIENTE ascending
				Estado custom
				Nombre_Documento ascending
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Estado == "Actualizado")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#92d191;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f2c47d;"
				}
				"New Formatting"
				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f27d7d;"
				}
				"New Formatting"
				{
				fields = [EMPRESA]
				format = "color:#000000;background-color:#ffffff;"
				}
				"New Formatting"
				{
				condition = (Estado == "Actualizado")
				fields = [Plantilla, TRABAJADOR, CLIENTE, Nombre_Documento, D_as_para_caducar]
				format = "color:#337131;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Plantilla, TRABAJADOR, CLIENTE, Nombre_Documento, D_as_para_caducar]
				format = "color:#8b6608;"
				}
				"New Formatting"
				{
				condition = (Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación" || Estado == "Pendiente Aprobación")
				fields = [Plantilla, TRABAJADOR, CLIENTE, Nombre_Documento, D_as_para_caducar]
				format = "color:#cc1111;"
				}
			)
		}
