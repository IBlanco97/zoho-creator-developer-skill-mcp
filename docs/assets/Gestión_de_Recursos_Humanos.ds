			)
		}
		default list Documentos_Trabajador
		{
			displayName = "Trabajadores"
			show all rows from Subir_Documento  [Plantilla.Trabajador1 == "SI" && Estado != "Pendiente Subir"]  
			(
				Plantilla
				(
					view = Ver_Plantillas
				)
				Fecha_creaci_n_documento as "Fecha creación_documento"
				Fecha_validez_documento as "Fecha validez documento"
				Fecha_caducidad_documento as "Caducidad"
				Observaciones
				Numero_Documento as "Numero Documento"
				CLIENTE as "Cliente"
				(
					view = Ver_Clientes
				)
				TRABAJADOR as "Trabajador"
				(
					view = Employee_Details
				)
				Documento
				Estado
				Plantilla.FIRMA_TRABAJADOR as "Firma Trabajador"
				Nombre_Documento as "Nombre Documento"
				EMPRESA as "Empresa"
				(
					view = Ver_Empresa
				)
				Archivado
				Color_Estado as "Color Estado"
				D_as_para_caducar as "Días para caducar"
				Carga_M_ltiple as "Carga Múltiple"
				Etiqueta
				Clientes_Seleccionados as "Clientes Seleccionados:"
				Subir_tambi_n_a_otros_clientes as "Subir también a otros clientes:"
			)
			group by
			(
				TRABAJADOR ascending
			)
			sort by
			(
				EMPRESA ascending
				CLIENTE ascending
				Estado ascending
				Nombre_Documento ascending
			)
			conditional formatting
			(
				"Documentos lejos de caducar"
				{
				condition = (Estado == "Actualizado")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#92d191;"
				}
				"Documentos caducados"
				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Subir" || Estado == "Pendiente Aprobación")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f27d7d;"
				}
				"Documento cerca de caducar"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Fecha_caducidad_documento, Estado]
				format = "background-color:#f2c47d;"
				}
				"Eliminar"
				{
				condition = (ID is not null)
				format = "background-color:#92d191;"
				}
				"New Formatting"
				{
				condition = (Estado == "Actualizado")
				fields = [Plantilla, Fecha_creaci_n_documento, Fecha_validez_documento, Observaciones, CLIENTE, Nombre_Documento, EMPRESA, D_as_para_caducar]
				format = "color:#337131;"
				}
				"New Formatting"
				{
				condition = (Estado == "Cerca de Caducar")
				fields = [Plantilla, Fecha_creaci_n_documento, Fecha_validez_documento, Observaciones, CLIENTE, Nombre_Documento, EMPRESA, D_as_para_caducar]
				format = "color:#cc9711;"
				}
				"New Formatting"
				{
				condition = (Estado == "Caducado" || Estado == "Pendiente Aprobación" || Estado == "Pendiente Subir")
				fields = [Plantilla, Fecha_creaci_n_documento, Fecha_validez_documento, Observaciones, CLIENTE, Nombre_Documento, EMPRESA, D_as_para_caducar]
				format = "color:#cc1111;"
				}
				"New Formatting"
				{
				fields = [TRABAJADOR]
				format = "color:#000000;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Layout 1"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#0ABB51'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
			)
		}
