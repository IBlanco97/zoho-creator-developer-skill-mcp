			conditional formatting
			(
				"1 transcurrido"
				{
				condition = (S1 == " " || S1 == "1" && Estado == "Iniciada" || Estado == "Finalizada" && Semana_Actual >= 1 && Tipo != "Permiso")
				fields = [S1]
				format = "background-color:#b6deb5;"
				}
				"1 futuro"
				{
				condition = (S1 == " " || S1 == "1" && Estado != "Iniciada" && Estado != "Finalizada" && Estado == "Programada" && Semana_Actual < 1 && Tipo != "Permiso")
				fields = [S1]
				format = "background-color:#e7e7e7;"
				}
				"1 futuro iniciada"
				{
				condition = (S1 == " " || S1 == "1" && Semana_Actual < 1 && Estado == "Iniciada" && Tipo != "Permiso")
				fields = [S1]
				format = "background-color:#eaf5ea;"
				}
				"1 Semana Actual"
				{
				condition = (S1 == " " || S1 == "1" && Semana_Actual == 1 && Tipo != "Permiso")
				fields = [S1]
				format = "background-color:#d2e9d1;"
				}
				"1 Permiso transcurrido"
				{
