			Carga_del_Formulario2 as "Carga del Formulario"
			{
				type =  form
				form = Subir_Documento
				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Plantilla.EMPRESA1 == "SI" && Plantilla.Trabajador1 == "NO" || Plantilla.Trabajador1 == null && Plantilla.Trabajador_de_R_gimen_Especial == "NO" || Plantilla.Trabajador_de_R_gimen_Especial == null && Plantilla.CLIENTE == "NO" || Plantilla.CLIENTE == null)
										{
											show Subir_tambi_n_a_otros_clientes;
										}
										else
