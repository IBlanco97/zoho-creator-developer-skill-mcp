			(
    			type = datetime
				displayname = "Fecha-Hora"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tecnico
			(
				type = picklist	
				displayname = "Técnico"
