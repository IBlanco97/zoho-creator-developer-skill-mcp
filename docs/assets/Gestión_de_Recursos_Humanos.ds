		list Ver_Solicitud_de_EPIs_Herramientas
		{
			displayName = "Solicitudes EPIs - Herramientas"
			show all rows from Solicitud_de_EPIs_Herramientas  [Trabajador_Solicitante.Official_Email == zoho.loginuserid || Trabajador_Solicitante.Correo_Electr_nico == zoho.loginuserid || Trabajador_Solicitante.Mail_Portal_Empleado == zoho.loginuserid]  
			(
				Motivo_de_la_Solucitud as "Motivo de la Solucitud"
				Aprobado as "Estado"
				custom action "Confirmar"
				(
	  			workflow = Confirmar_EPI
				show action in view header = true
				show action in edit record menu = true
				column header = "Confirmar"
				condition = (Aprobado == "Entregado")
				confirmation before execution
				(
					message for individual record = "¿Está seguro que desea confirmar que ha recibido el equipo solicitado?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
				Equipo_Solicitado as "Equipo Solicitado"
				Nota_Sobre_Respuesta_a_la_Soilicitud as "Nota Sobre Respuesta a la Soilicitud"
				Fecha_Prevista_de_Entrega as "Fecha Prevista de Entrega"
				Equipo_Asignado as "Equipo Asignado"
				Historia_de_la_Solicitud as "Historia de la Solicitud"
				Tipo_de_equipo_solicitado as "Tipo de equipo solicitado"
			)
			conditional formatting
			(
				"Aprobado Entregado"
				{
				condition = (Aprobado == "Aprobado" || Aprobado == "Entregado")
				fields = [Aprobado]
				format = "background-color:#92d191;"
				}
				"Rechazado"
				{
				condition = (Aprobado == "Rechazado")
				fields = [Aprobado]
				format = "background-color:#f27d7d;"
				}
				"Gestionandose"
				{
				condition = (Aprobado == "Gestiónandose")
				fields = [Aprobado]
				format = "background-color:#f2c47d;"
				}
				"Confirmado"
				{
				condition = (Aprobado == "Confirmado")
				fields = [Aprobado]
				format = "background-color:#aec6f8;"
				}
			)
		}
		list Trabajadores_Documentos
		{
			displayName = "Cliente - Empleado"
			show all rows from Nueva_Lista_de_Requisitos  [Es_Lista_con_empresa is null || Es_Lista_con_empresa != "SI" || Es_Lista_con_empresa == "NO" || Trabajador.ID is not null || Trabajador.ID is null]  
			(
				N_Orden as "Nº Orden"
				Trabajador
				(
					view = Employee_Details
				)
				Cliente1 as "Cliente"
				(
					view = Ver_Clientes
				)
				Estado
				Trabajador_Color as "Trabajador"
				Cliente_Color as "Cliente"
				custom action "Validar"
				(
	  			workflow = Aprobado_por_Cliente
				show action in edit record menu = true
				column header = "Validar"
				condition = (Estado_Cliente == "Enviada" || ContadorEnviadosNoAprobados > 0)
				)
				custom action "Enviar"
				(
	  			workflow = Enviar_Documentos_trabaja
				show action in view header = true
				show action in edit record menu = true
				column header = "Enviar"
				condition = (Estado_Cliente == "No Enviada" && Estado == "Actualizado" || Estado == "Cerca de Caducar")
				)
				Estado_Cliente as "Estado con Cliente"
				ContadorPendietesSubir as "Pend. Subir"
				ContadorCaducados as "Cad."
				ContadorCercaCaducar as "Prox. Cad."
				ContadorActualizados as "Actualiz."
				ContadorNoEnviados as "No Enviados"
				ContadorEnviadosNoAprobados as "Enviados"
				ContadorEnviadosAprobados as "Validados"
				Total_Requisitos as "Total Requisitos"
				custom action "Subir Documento"
				(
	  			workflow = Subir_Documento_Cliente_T
				show action in edit record menu = true
				column header = "Subir Documento"
				)
			)
			group by
			(
				Cliente1 ascending
			)
			custom actions
			(
				"Ver Documentación"
				(
	  			workflow = Vista_Detallada_Requisito
				show action in edit record menu = true
				)
			)
			conditional formatting
			(
				"Cliente"
				{
				condition = (Cliente1.Estado_General_Documentacion == "No Enviada")
				fields = [Cliente1]
				format = "color:#cc1111;"
				}
				"Cliente"
				{
				condition = (Cliente1.Estado_General_Documentacion == "Enviada")
				fields = [Cliente1]
				format = "color:#8b4908;"
				}
				"Cliente"
				{
				condition = (Cliente1.Estado_General_Documentacion == "Enviada y Aprobada")
				fields = [Cliente1]
				format = "color:#2f78d0;"
				}
				"Trabajador"
				{
				condition = (Estado_Cliente == "No Enviada")
				fields = [Trabajador]
				format = "color:#cc1111;background-color:#ffffff;"
				}
				"Trabajador"
				{
				condition = (Estado_Cliente == "Enviada")
				fields = [Trabajador]
				format = "color:#8b4908;background-color:#ffffff;"
				}
				"Trabajador"
				{
				condition = (Estado_Cliente == "Enviada y Aprobada")
				fields = [Trabajador]
				format = "color:#2f78d0;"
				}
				"Contador Pendiete Subir"
				{
				condition = (ContadorPendietesSubir > 0)
				fields = [ContadorPendietesSubir]
				format = "color:#ff2424;background-color:#f3f3f3;"
				}
				"Contador Caducado"
				{
				condition = (ContadorCaducados > 0)
				fields = [ContadorCaducados]
				format = "color:#c90000;background-color:#f3f3f3;"
				}
				"Contador Cerca Caducar"
				{
				condition = (ContadorCercaCaducar > 0)
				fields = [ContadorCercaCaducar]
				format = "color:#fcc019;background-color:#f3f3f3;"
				}
				"Contador Actualizados"
				{
				condition = (ContadorActualizados > 0)
				fields = [ContadorActualizados]
				format = "color:#07c900;background-color:#f3f3f3;"
				}
				"Contador No Enviado"
				{
				condition = (ContadorNoEnviados > 0)
				fields = [ContadorNoEnviados]
				format = "color:#ff2424;"
				}
				"Contador Enviado No Aprobado"
				{
				condition = (ContadorEnviadosNoAprobados > 0)
				fields = [ContadorEnviadosNoAprobados]
				format = "color:#ba2800;"
				}
				"Contador Enviado Aprobado"
				{
				condition = (ContadorEnviadosAprobados > 0)
				fields = [ContadorEnviadosAprobados]
				format = "color:#309fff;"
				}
				"New Formatting"
				{
				condition = (ContadorPendietesSubir == 0 || ContadorPendietesSubir is null)
				fields = [ContadorPendietesSubir]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorCaducados == 0 || ContadorCaducados is null)
				fields = [ContadorCaducados]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorCercaCaducar == 0 || ContadorCercaCaducar is null)
				fields = [ContadorCercaCaducar]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorActualizados == 0 || ContadorActualizados is null)
				fields = [ContadorActualizados]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				fields = [Total_Requisitos]
				format = "color:#ffffff;background-color:#7c7c7c;"
				}
			)
		}
