				 void NuevoCliente.AccionActualizarRequisitosAutomatico(int clienteID)
                 {
                 	//En instancia CLiente, Restablecer contadores de requisitos.
                 	cliente = Nuevo_Cliente[ID == clienteID];
                 	thisapp.NuevoCliente.LlevarContadoresrRequisitosACero(cliente);
                 	// Ahora se procede a contrastar el listado de trabajadores con las listas de requisitos.
                 	// Debe existir una lista de requisitos asociada a cada trabajador. 
                 	// De faltar o sobrar alguna lista de requisitos, debe crearse o eliminarse respectivamente.
                 	//Por cada Lista de requisitos, incluyendo la lista con la empresa:
                 	for each  listaID in cliente.Lista_de_Requisitos
                 	{
                 		lista = Nueva_Lista_de_Requisitos[ID == listaID];
                 		thisapp.NuevoCliente.ActualizarContadorRequisitosLista(lista);
                 	}
                 	// Contar requisitos de Lista con Empresa
                 	lista = Nueva_Lista_de_Requisitos[ID == cliente.Lista_Documentos_Requeridos_Empresa];
                 	if(lista.ID == null)
                 	{
                 		info "Lista de requisitos con empresa no existe. Se procede a crear esta lista:";
                 		thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitosEmpresa(cliente);
                 	}
                 	//thisapp.NuevoCliente.ChecarAgregarRequisitos(cliente);
                 	//thisapp.NuevoCliente.SetTrabajadores(clienteID, cliente.Trabajadores);
                 	openUrl("#Script:page.refresh","same window");
                 }
				 void NuevoCliente.ActualizarContadorRequisitosLista(Nueva_Lista_de_Requisitos lista)
                 {
                 	trabajador = Nuevo_Empleado[ID == lista.Trabajador];
                 	// Debug
                 	//info "Nombre de Empleado: " + trabajador.Nombre;
                 	// Si la lista iterada es la correspondiente al trabajador iterado:
                 	// Restablecer a 0 los contadores de requisitos de la lista para realizar un nuevo conteo.
                 	//Debug:
                 	//info "Lista de Requisitos del Trabajador encontrada.";
                 	found = true;
                 	// Conteo de Requisitos Por Estado
                 	thisapp.NuevaListaDeRequisitos.LlevarContadoresrRequisitosACero(lista);
                 	// Por cada requisito en la lista de requisitos
                 	for each  requisitoID in lista.Lista_Requisitos_Documentaci_n
                 	{
                 		//thisapp.NuevoRequisitoDoc.ActualizarEstado(requisitoID);
                 		requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 		// Determinar el estado (indice) del requisito
                 		estadoIndice = thisapp.NuevoRequisitoDoc.getEstadoIndice(requisitoID);
                 		info "Estado del requisito: " + requisito.Estado + ", " + estadoIndice;
                 		thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lista.ID,estadoIndice,true);
                 		thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lista.ID,6,true);
                 		//Si estado de requisito es Pendiente subir, contar requisito como pendiente subir
                 	}
                 }
