			Env_o_de_Formulario17 as "Envío de Formulario"
			{
				type =  form
				form = Asignacion_T_cnico_Cliente
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											asignacion = Asignacion_T_cnico_Cliente[ID == input.ID];
										for each  fecha in input.Fechas
										{
											fecha.Asignacion_T_cnico_Cliente=input.ID;
											fecha.Tecnico=input.Tecnico;
											fecha.Etiqueta=input.Etiqueta;
											fecha.Tipo="Cliente";
										}
										thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asignacion);
										//Creando jornadas en el calendario detallado
										for each  rangoID in asignacion.Fechas
										{
											rango = Rango_Fechas_Asingacion[ID == rangoID];
											thisapp.JornadaCalendario.GenerarJornadasRangoFechas(rango);
										}
										//thisapp.ProgramaAnualActividadTecnico.CrearJornadas(asignacion);
						)
					}
				}

			}
			OnDelete as "OnDelete"
			{
				type =  form
				form = Asignacion_Tecnico_Cliente_Anio
				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											tecnico = Nuevo_Empleado[ID == input.Tecnico];
										cliente = Nuevo_Cliente[ID == input.Cliente];
										if(Tipo == null || Tipo == "Cliente")
										{
											if(Fecha_de_Inicio <= zoho.currenttime && Fecha_de_Fin == null || Fecha_de_Fin >= zoho.currenttime)
											{
												esClienteHabitual = input.Asignacion_T_cnico_Cliente.Cliente_habitual == "SI";
												thisapp.NuevoEmpleado.DesasignarCliente(tecnico,cliente,esClienteHabitual);
											}
											delete from Asignacion_Tecnico_Cliente_Anio[Asignacion_T_cnico_Cliente == input.Asignacion_T_cnico_Cliente];
											delete from Rango_Fechas_Asingacion[Asignacion_T_cnico_Cliente == input.ID];
											delete from Jornada[Asignacion_T_cnico_Cliente == input.ID];
											delete from Asignacion_T_cnico_Cliente[ID == input.Asignacion_T_cnico_Cliente];
										}
										else
										{
											delete from Asignacion_Tecnico_Cliente_Anio[Solicitud == input.Solicitud];
											solicitudRegistro = Solicitud[ID == input.Solicitud];
											if(solicitudRegistro.ID != null)
											{
												solicitudRegistro.Aprobado="NO";
												delete from Rango_Fechas_Asingacion[Solicitud == solicitudRegistro.ID];
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											delete from Rango_Fechas_Asingacion[Asignacion_T_cnico_Cliente == input.Asignacion_T_cnico_Cliente];
						)
					}
				}

			}
