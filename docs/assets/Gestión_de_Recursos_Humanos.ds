	 			column = 1   
				width = medium
			)
			must have Date_of_Joining
			(
    			type = date
				displayname = "Date of Joining"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have CTC
			(
				type = picklist	
				values  = Salary_Structure.ID
    			displayformat = [CTC]
				allow new entries
				[
					displayname = "Add New CTC"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Designation
			(
				type = picklist	
