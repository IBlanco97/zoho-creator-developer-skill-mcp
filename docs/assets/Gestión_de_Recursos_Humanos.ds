		list Archivados
		{
			displayName = "Archivados"
			show all rows from Subir_Documento  [Archivado == "SI"]  
			(
				Plantilla
				(
					view = Ver_Plantillas
				)
				TRABAJADOR as "Trabajador"
				(
					view = Employee_Details
				)
				EMPRESA as "Empresa"
				(
					view = Ver_Empresa
				)
				CLIENTE as "Cliente"
				(
					view = Ver_Clientes
				)
				Fecha_creaci_n_documento as "Fecha creación_documento"
				Fecha_validez_documento as "Fecha validez documento"
				Fecha_caducidad_documento as "Fecha caducidad documento"
				Observaciones
				Nombre_Documento as "Nombre Documento"
				Numero_Documento as "Numero Documento"
				Documento
				Estado
				Requisitos_enlazados as "Requisitos enlazados"
				Archivado
			)
			group by
			(
				EMPRESA ascending
				CLIENTE ascending
				TRABAJADOR ascending
			)
			sort by
			(
