                 		//for each  tc in trabajadoresCreatorLista
                 		//{
                 		//	tc2 = Nuevo_Empleado[ID == tc];
                 		//	if(tc2.CANDIDATEID_Recruit1 == id.toString() || tc2.ID_de_Candidato_Recruit == id_legible)
                 		//	{
                 		//		found = true;
                 		//		break;
                 		//	}
                 		//	else
                 		//	{
                 		//		//		listToRemove.add(tc2);
                 		//	}
                 		//}
                 		//if(found)
                 		//{
                 		//	trabajadoresCreatorLista.removeAll(listToRemove);
                 		//}
                 		if(!found)
                 		{
                 			trabajadorRecord = zoho.recruit.getRecordById("Candidates",id);
                 			//info trabajadorRecord.get("First Name");
                 			firstName = trabajadorRecord.get("First Name");
                 			lastName = trabajadorRecord.get("Last Name");
                 			Official_Email = trabajadorRecord.get("Email");
                 			M_vil = trabajadorRecord.get("Mobile");
                 			Comarca = trabajadorRecord.get("COMARCA");
                 			Area_Profesional = trabajadorRecord.get("Area Profesional");
                 			DNI = trabajadorRecord.get("DNI");
                 			Calle = trabajadorRecord.get("Street");
                 			Empresa_que_Contrata1 = Empresa1[ID != 0].ID;
                 			Especialidad1 = trabajadorRecord.get("ESPECIALIDAD");
                 			Delegacion = trabajadorRecord.get("DELEGACIÓN");
                 			Jornada_Laboral1 = trabajadorRecord.get("JORNADA LABORAL");
                 			Veh_culo_propio = trabajadorRecord.get("Vehiculo propio");
                 			if(Veh_culo_propio != null && Veh_culo_propio == "true")
                 			{
                 				Veh_culo_propio = "SI";
                 			}
                 			else
                 			{
                 				Veh_culo_propio = null;
                 			}
                 			Estado_provincia1 = trabajadorRecord.get("State");
                 			Pa_s = trabajadorRecord.get("Country");
                 			Tel_fono = trabajadorRecord.get("Phone");
                 			CANDIDATEID_Recruit1 = trabajadorRecord.get("CANDIDATEID");
                 			ID_de_Candidato_Recruit = trabajadorRecord.get("Candidate ID");
                 			Tipo_de_Contrato1 = trabajadorRecord.get("TIPO DE CONTRATO");
                 			Carnet_de_Conducir = trabajadorRecord.get("Carnet de Conducir");
                 			if(Carnet_de_Conducir != null && Veh_culo_propio == "true")
                 			{
                 				Carnet_de_Conducir = "SI";
                 			}
                 			else
                 			{
                 				Carnet_de_Conducir = null;
                 			}
                 			Puesto_laboral_actual = trabajadorRecord.get("Current Job Title");
                 			Correo_Electr_nico = trabajadorRecord.get("Email");
                 			Tipo_de_R_gimen = trabajadorRecord.get("AUTONOMO");
                 			if(Tipo_de_R_gimen != null && Tipo_de_R_gimen == "true")
                 			{
                 				Tipo_de_R_gimen = "Especial/Autónomo";
                 			}
                 			else
                 			{
                 				Tipo_de_R_gimen = "Régimen General";
                 			}
                 			Necesita_Habitaci_n1 = trabajadorRecord.get("NECESITARA HABITACIÓN");
                 			if(Necesita_Habitaci_n1 != null && Necesita_Habitaci_n1 == "true")
                 			{
                 				Necesita_Habitaci_n1 = "SI";
                 			}
                 			else
                 			{
                 				Necesita_Habitaci_n1 = null;
                 			}
                 			Idioma = trabajadorRecord.get("Idiomas2");
                 			Ciudad = trabajadorRecord.get("City");
                 			x = Nuevo_Empleado[ID != 0] sort by N_Orden desc;
                 			N_Orden = x.N_Orden + 1;
                 			Categoria_Profesional1 = trabajadorRecord.get("CATEGORIA PROFESIONAL");
                 			C_digo_postal = trabajadorRecord.get("Zip Code");
                 			Profesion = trabajadorRecord.get("PROFESION");
                 			Moneda = trabajadorRecord.get("Currency");
                 			//iterations = [1,2,3];
                 			//for each i in iterations {
                 			try 
                 			{
                 				nuevoEmpladoCreator = insert into Nuevo_Empleado
                 				[
                 					Nombre.first_name=firstName
                 					Nombre.last_name=lastName
                 					Official_Email=Official_Email
                 					M_vil=M_vil
                 					Comarca=Comarca
                 					Area_Profesional=Area_Profesional
                 					DNI=DNI
                 					Calle=Calle
                 					Added_User=zoho.loginuser
                 					Empresa_que_Contrata1=Empresa_que_Contrata1
                 					Especialidad1=Especialidad1
                 					Delegacion=Delegacion
                 					Jornada_Laboral1=Jornada_Laboral1
                 					Veh_culo_propio=Veh_culo_propio
                 					Estado_provincia1=Estado_provincia1
                 					Pa_s=Pa_s
                 					Tel_fono=Tel_fono
                 					CANDIDATEID_Recruit1=CANDIDATEID_Recruit1
                 					ID_de_Candidato_Recruit=ID_de_Candidato_Recruit
                 					Tipo_de_Contrato1=Tipo_de_Contrato1
                 					Carnet_de_Conducir=Carnet_de_Conducir
                 					Puesto_laboral_actual=Puesto_laboral_actual
                 					Correo_Electr_nico=Correo_Electr_nico
                 					Tipo_de_R_gimen=Tipo_de_R_gimen
                 					Necesita_Habitaci_n1=Necesita_Habitaci_n1
                 					Idioma=Idioma
                 					Ciudad=Ciudad
                 					N_Orden=N_Orden
                 					Categoria_Profesional1=Categoria_Profesional1
                 					C_digo_postal=C_digo_postal
                 					Profesion=Profesion
                 					Moneda=Moneda
                 				];
                 				//info "nuevoEmpladoCreator: " + nuevoEmpladoCreator;
                 			}
                 			catch (e)
                 			{
                 				if(e.message == "Enter a valid email address for Official_Email")
                 				{
                 					info "Official_Email no válido para el trabajador: " + trabajadorRecord.get("First Name") + " " + trabajadorRecord.get("Last Name") + " ID: " + trabajadorRecord.get("Candidate ID");
                 					info "Email incorrecto: " + Official_Email;
                 					//info "El campo Official_Email es obligatorio y no puede quedar vacío. Modifique el email en el registro original en Zoho Recruit para poder importar los datos de este trabajador.";
                 				}
                 				else if(e.message == "The field 'com' for key 'Official_E' is configured to reject duplicate values, and the input 'Official_Email' already exists. Please ensure the input value is unique.")
                 				{
                 					//info "Email duplicado para " + trabajadorRecord.get("First Name") + " " + trabajadorRecord.get("Last Name") + " ID: " + trabajadorRecord.get("Candidate ID");
                 					//info "- Verifique si se trata de un trabajador que ya ha sido importado desde Recruit, en cuyo caso, puede ignorar este mensaje.";
                 					//info "- Verifique si se trata de un registro duplicado de un trabajador, existente en Zoho Recruit.";
                 					//info "De no ser los casos anteriores, contacte al soporte técnico de la empresa Sicma 21, o al equipo de desarrolo de esta app.";
                 				}
                 				else
                 				{
                 					info "Error mientras se iteraba sobre el trabajador: " + trabajadorRecord.get("First Name") + " " + trabajadorRecord.get("Last Name") + " ID: " + trabajadorRecord.get("Candidate ID");
                 					// Displays line number of the statement that caused the error 
                 					info e.message;
                 					// Displays the error message 
                 					info e;
                 					// Displays both line number and error message
                 				}
                 			}
                 			//}
                 		}
                 	}
                 	thisapp.NuevoEmpleado.CorregirMaysculasNombre();
                 }
				 void NuevoEmpleado.whatsapp(string cuenta, string numero_destino, string mensaje)
                 {
                 	config = Configuraci_n_General[ID != 0];
                 	url = "https://" + config.URL + "/message/sendText/" + cuenta;
                 	headers = Map();
                 	headers.put("Content-Type","application/json");
                 	//headers.put("apikey","4DgKrDaUvuxekuuqoAe04a3xZRQcPU2rBDSsDm0wiYkdzI0msjGiCYdkpBpxjawm");
                 	headers.put("apikey",config.API_Key);
                 	options = Map();
                 	options.put("delay",1200);
                 	options.put("presence","composing");
                 	options.put("linkPreview",false);
                 	body = Map();
                 	body.put("number",numero_destino);
                 	body.put("options",options);
                 	body.put("text",mensaje);
                 	info "URL: " + url;
                 	info "Method: POST";
                 	info "Body: " + body.toString();
                 	info "Headers: " + headers;
                 	response = invokeurl
                 	[
                 		url :url
                 		type :POST
                 		body:body.toString()
                 		headers:headers
                 	];
                 	info response;
                 }
				 void NuevoEmpleado.whatsappMasivo(Nuevo_Empleado empleados)
                 {
                 	empleados2 = List();
                 	for each  empleadoID in empleados
                 	{
                 		empleado = Nuevo_Empleado[ID = empleadoID];
                 		empleados2.add(empleado);
                 	}
                 	openUrl("#Form:WhatsApp?Trabajadores_Seleccionados=" + input.empleados2 + "&Enviar_a=Solo trabajadores seleccionados","popup window");
                 }
				 void NuevoEPIRopaHerramienta.DesasignarUnidadEPIHerramienta(Unidad_de_EPI_Herramienta unidad)
                 {
                 	unidad.Estado="No Asignado";
                 	unidad.Asignado_a=null;
                 	epi = Nuevo_EPI_Herramienta[ID == unidad.EPI_Herramienta];
                 	thisapp.NuevoEPIRopaHerramienta.ModificarCantidadUnidades(epi,1,true,false);
                 }
				 void NuevoEPIRopaHerramienta.ModificarCantidadEPI(Nuevo_EPI_Herramienta epi, int cantidad, bool disponibles, bool total_)
                 {
                 	if(total_)
                 	{
                 		epi.Total_Unidades=epi.Total_Unidades + cantidad;
                 	}
                 	if(disponibles)
                 	{
                 		epi.Unidades_Disponibles=epi.Unidades_Disponibles + cantidad;
                 	}
                 }
				 void NuevoEPIRopaHerramienta.ModificarCantidadUnidades(Nuevo_EPI_Herramienta unidad, int cantidad, bool disponibles, bool total_)
                 {
                 	if(total_)
                 	{
                 		unidad.Total_Unidades=unidad.Total_Unidades + cantidad;
                 	}
                 	if(disponibles)
                 	{
                 		unidad.Unidades_Disponibles=unidad.Unidades_Disponibles + cantidad;
                 	}
                 }
				 void NuevoEPIRopaHerramienta.NotificarCambioSolicitudEPI(Solicitud_de_EPIs_Herramientas solicitud, string registroEstadoPrevio)
                 {
                 	if(registroEstadoPrevio != null && registroEstadoPrevio != solicitud.Aprobado)
                 	{
                 		mail = solicitud.Trabajador_Solicitante.Correo_Electr_nico;
                 		mail2 = solicitud.Trabajador_Solicitante.Official_Email;
                 		title = "Solicitud de " + solicitud.Tipo_de_equipo_solicitado + " pasa a estado: " + solicitud.Aprobado;
                 		message_ = "Su solicitud de " + solicitud.Tipo_de_equipo_solicitado + " pasa al estado: " + solicitud.Aprobado + ".";
                 		if(solicitud.Nota_Sobre_Respuesta_a_la_Soilicitud != null && solicitud.Nota_Sobre_Respuesta_a_la_Soilicitud != "")
                 		{
                 			message_ = message_ + "\n" + solicitud.Nota_Sobre_Respuesta_a_la_Soilicitud;
                 		}
                 		if(mail != null && mail != "")
                 		{
                 			notificacion = zoho.pushNotification(mail,title,message_,"Ver_Solicitud_de_EPIs_Herramientas",solicitud.ID);
                 		}
                 		if(mail2 != null && mail2 != "")
                 		{
                 			notificacion = zoho.pushNotification(mail2,title,message_,"Ver_Solicitud_de_EPIs_Herramientas",solicitud.ID);
                 		}
                 	}
                 }
				 void NuevoEPIRopaHerramienta.SetAsignada(Unidad_de_EPI_Herramienta epi, bool isAsignada, int Trabajador)
                 {
                 	if(isAsignada)
                 	{
                 		epi.Estado="Asignado";
                 		epi.Asignado_a=Trabajador;
                 	}
                 	else
                 	{
                 		epi.Estado="No Asignado";
                 		epi.Asignado_a=null;
                 	}
                 }
				 void NuevoEPIRopaHerramienta.VerHistorialAsignacionesEPI(int EPIID)
                 {
                 	epi = Nuevo_EPI_Herramienta[ID == EPIID];
                 	openUrl("#Report:Asignacion_EPI_Ropa_Herramienta_Report?EPI_Herramienta=" + epi.Nombre,"popup window");
                 }
				 void NuevoRequisitoDoc.ActualizarEstado(int idRequisito)
                 {
                 	req = Nuevo_Requisitos_Doc[ID == idRequisito];
                 	if(req.Documento == null)
                 	{
                 		info "Colocando Estado Pendiente Subir";
                 		thisapp.NuevoRequisitoDoc.SetEstado(req.ID,1);
                 	}
                 	else
                 	{
                 		idDoc = req.Documento;
                 		doc = Subir_Documento[ID = idDoc];
                 		indiceEstadoDOcumento = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(doc.Estado);
                 		thisapp.NuevoRequisitoDoc.SetEstado(req.ID,indiceEstadoDOcumento);
                 	}
                 }
				 void NuevoRequisitoDoc.ActualizarEstadosRequisitos()
                 {
                 	cercaDeCaducar = List();
                 	caducados = List();
                 	for each  r in Nuevo_Requisitos_Doc[ID != 0]
                 	{
                 		if(r.Documento != null)
                 		{
                 			indiceEstado = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(thisapp.NuevoRequisitoDoc.GetEstado(r.ID));
                 			huboCambio = thisapp.NuevoRequisitoDoc.SetEstado(r.ID,indiceEstado);
                 			if(huboCambio && indiceEstado == 4)
                 			{
                 				cercaDeCaducar.add(r);
                 			}
                 			else if(huboCambio && indiceEstado == 3)
                 			{
                 				caducados.add(r);
                 			}
                 		}
                 	}
                 	mailList = List();
                 	mailList.add("intiblanco97@gmail.com");
                 	mailList.add(zoho.adminuserid);
                 	if(!cercaDeCaducar.isEmpty())
                 	{
                 		message_ = "Los siguientes documentos están a 15 días de caducar:\n\n";
                 		for each  requisitoID in cercaDeCaducar
                 		{
                 			requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 			fechacaducidad = Subir_Documento[ID == requisito.Documento].Fecha_caducidad_documento;
                 			message_ = message_ + requisito.Nombre + ". Fecha de caducidad: " + fechacaducidad;
                 		}
                 		for each  mail in mailList
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :mail
                 				subject :"Documentos Cerca de Caducar"
                 				message :message_
                 			]
                 		}
                 	}
                 	if(!caducados.isEmpty())
                 	{
                 		message_ = "Los siguientes documentos están Caducados:\n\n";
                 		for each  requisitoID in cercaDeCaducar
                 		{
                 			requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 			fechacaducidad = Subir_Documento[ID == requisito.Documento].Fecha_caducidad_documento;
                 			message_ = message_ + requisito.Nombre + ". Fecha de caducidad: " + fechacaducidad;
                 		}
                 		for each  mail in mailList
                 		{
                 			sendmail
                 			[
                 				from :zoho.adminuserid
                 				to :"intiblanco97@gmail.com"
                 				subject :"Documentos Caducados"
                 				message :message_
                 			]
                 		}
                 	}
                 }
				 void NuevoRequisitoDoc.ActualizarEstadosTodosRequisitos(int beguin, int end)
                 {
                 	for each  lista in Nueva_Lista_de_Requisitos[ID != 0 && N_Orden >= beguin && N_Orden < end]
                 	{
                 		for each  requisitoID in lista.Lista_Requisitos_Documentaci_n
                 		{
                 			requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 			if(requisito.Documento == null)
                 			{
                 				requisito.Estado=thisapp.FuncionesEstaticas.GetEstadosRequisitos(1);
                 				if(requisito.Lista_Requisitos_Pertenece != null)
                 				{
                 					//incrementar contador pendientes
                 					thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(requisito.Lista_Requisitos_Pertenece,1,true);
                 				}
                 			}
                 		}
                 	}
                 }
				 void NuevoRequisitoDoc.ActualizarRequisitos()
                 {
                 	for each  cliente in Nuevo_Cliente[ID != 0]
                 	{
                 		for each  trabajadorID in cliente.Trabajadores_Habituales
                 		{
                 			trabajador = Nuevo_Empleado[ID == trabajadorID];
                 			found = false;
                 			for each  listaID in cliente.Lista_de_Requisitos
                 			{
                 				lista = Nueva_Lista_de_Requisitos[ID == listaID];
                 				if(lista.Trabajador == trabajador)
                 				{
                 					found = true;
                 				}
                 			}
                 			if(!found)
                 			{
                 				thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitos(trabajadorID,trabajador.Nombre,cliente);
                 			}
                 		}
                 		thisapp.NuevoCliente.ChecarAgregarRequisitos(cliente);
                 	}
                 }
				 string NuevoRequisitoDoc.AutollenarNombreColorCaducidad(string Estado, string NombrePlantilla)
                 {
                 	color = "";
                 	idEstado = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(Estado);
                 	if(idEstado == 5)
                 	{
                 		color = "green";
                 	}
                 	else if(idEstado == 4)
                 	{
                 		color = "orange";
                 	}
                 	else
                 	{
                 		color = "red";
                 	}
                 	texto = NombrePlantilla;
                 	result = "<span style=\"color: " + color + "\">" + texto + "</span>";
                 	return result;
                 }
				 string NuevoRequisitoDoc.AutorrellenarNombreColorEnviado(string enviado, string aprobadoCliente, string NombrePlantilla)
                 {
                 	color = "gray";
                 	if(enviado == "SI")
                 	{
                 		if(aprobadoCliente == "SI")
                 		{
                 			color = "blue";
                 		}
                 		else
                 		{
                 			color = "#d35400";
                 		}
                 	}
                 	else
                 	{
                 		color = "red";
                 	}
                 	texto = NombrePlantilla;
                 	result = "<span style=\"color: " + color + "\">" + texto + "</span>";
                 	return result;
                 }
				 string NuevoRequisitoDoc.CalcularCaducidadTolerancia(date fechaCaducidad, int tolerancia)
                 {
                 	resultado = "";
                 	if(fechaCaducidad != null)
                 	{
                 		resultado = "" + fechaCaducidad;
                 		if(tolerancia != null && tolerancia > 0)
                 		{
                 			resultado = resultado + " (+" + tolerancia + ")";
                 		}
                 	}
                 	return resultado;
                 }
				 int NuevoRequisitoDoc.CrearRequsitoAtomaticamente(int trabajadorID, string trabajadorNombre, Nuevo_Cliente cliente, int plantID, string plantNombre, string plantTRABAJADOR, string plantCLIENTE, Nueva_Lista_de_Requisitos lista_requisitos_iterada)
                 {
                 	row_coll = Collection();
                 	//Crear Nueva instancia de Requisito Doc para llenarla con los datos
                 	row_ = Nueva_Lista_de_Requisitos.Lista_Requisitos_Documentaci_n();
                 	//ID autoincrementado para Nuevo Requisito Doc
                 	maxID = Nuevo_Requisitos_Doc[ID != 0].N_Orden sort by N_Orden desc;
                 	id_row = maxID + 1;
                 	//Atributos del nuevo requisito
                 	row_.N_Orden=id_row;
                 	row_.Trabajador=trabajadorID;
                 	row_.Cliente1=cliente.ID;
                 	row_.Plantilla=plantID;
                 	row_.Nombre=thisapp.RequisitoDoc.NombreAutomaticoRequisitos(null,trabajadorID,cliente.ID,plantID);
                 	if(row_.Plantilla.EMPRESA1 == "SI")
                 	{
                 		row_.Empresa1=row_.Plantilla.EMPRESA;
                 	}
                 	//Preparando variable para documento
                 	//Buscar Nuevo Documetno que se quiere entregar
                 	documento = null;
                 	//solo itera una vez para abrir el wrap de los resltados (solo debe haber un resultado)			
                 	for each  doc in Subir_Documento[Plantilla.ID == plantID]
                 	{
                 		if(plantTRABAJADOR != "SI" || trabajadorID == doc.TRABAJADOR)
                 		{
                 			if(plantCLIENTE != "SI" || cliente.ID == doc.CLIENTE)
                 			{
                 				// Si existe un documento para ese trabajador y de esa plantilla
                 				estadoIndex = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(doc.Estado);
                 				// Si el estado del documento es mejor que Caducado (Cerca de Caducar, Actualizado)
                 				if(estadoIndex > 3)
                 				{
                 					info "Documento Enontrado para " + plantNombre;
                 					documento = doc;
                 					row_.Empresa1=doc.EMPRESA;
                 					break;
                 				}
                 			}
                 		}
                 	}
                 	if(documento == null)
                 	{
                 		info "Documento NO Enontrado para " + plantNombre;
                 		//Crear nuevo documento con nombre Subir Documento
                 		/*N_orden_doc = 0;
                 		for each  doc in Subir_Documento[ID != 0]
                 		{
                 			if(N_orden_doc < doc.Numero_Documento)
                 			{
                 				N_orden_doc = doc.Numero_Documento;
                 			}
                 		}
                 		N_orden_doc = N_orden_doc + 1;
                 		idDoc = insert into Subir_Documento
                 		[
                 			Plantilla=plantID
                 			Added_User=zoho.loginuser
                 			TRABAJADOR=trabajadorID
                 			CLIENTE=cliente
                 			EMPRESA=row_.Empresa1
                 			Numero_Documento=N_orden_doc
                 			Nombre_Documento="Subir Documento de tipo " + plantNombre
                 			Estado="Pendiente Subir"
                 		];
                 		docReg = Subir_Documento[ID == idDoc];
                 		documento = docReg;
                 		*/
                 	}
                 	if(documento != null)
                 	{
                 		row_.Documento=documento.ID;
                 		row_.Estado=row_.Documento.Estado;
                 	}
                 	else
                 	{
                 		// 1 es el indice del estado Pendiente subir
                 		row_.Estado=thisapp.FuncionesEstaticas.GetEstadosRequisitos(1);
                 	}
                 	row_.Enviado="NO";
                 	row_.Aprobado_Cliente="NO";
                 	if(plantTRABAJADOR == "NO")
                 	{
                 		row_.Con_Empresa_o_Con_Trabajador="Requisitos de Empresa";
                 	}
                 	//else if ( row_.Plantilla.Trabajador_de_R_gimen_Especial="SI" ) 
                 	//{
                 	//	row_.Con_Empresa_o_Con_Trabajador="Requisitos de Autónomo";
                 	//}
                 	else
                 	{
                 		row_.Con_Empresa_o_Con_Trabajador="Requisitos de Trabajador";
                 	}
                 	row_.Caducidad_Tolerancia=thisapp.NuevoRequisitoDoc.CalcularCaducidadTolerancia(row_.Documento.Fecha_caducidad_documento,row_.Plantilla.Tolerancia);
                 	thisapp.NuevoCliente.setCaducidadTolerancia(row_.Cliente1,row_.Caducidad_Tolerancia);
                 	row_coll.insert(row_);
                 	lista_requisitos_iterada.Lista_Requisitos_Documentaci_n.insert(row_coll);
                 	requisito = Nuevo_Requisitos_Doc[N_Orden == id_row];
                 	requisito.Estado1=thisapp.NuevoRequisitoDoc.EstadoGeneral(requisito.ID);
                 	id_row = id_row + 1;
                 	//thisapp.NuevoRequisitoDoc.ActualizarEstado(row_.ID);
                 	//thisapp.NuevoRequisitoDoc.SetEstado(row_.ID,6);
                 	return row_.N_Orden;
                 }
				 void NuevoRequisitoDoc.EliminarRequisito(int RequisitoID)
                 {
                 	requisito = Nuevo_Requisitos_Doc[ID == RequisitoID];
                 	doc = Subir_Documento[ID == requisito.Documento];
                 	indexEstado = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(doc.Estado);
                 	if(indexEstado == 1)
                 	{
                 		delete from Subir_Documento[ID == doc];
                 	}
                 	indiceEstado = thisapp.NuevoRequisitoDoc.getEstadoIndice(RequisitoID);
                 	thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(requisito.Lista_Requisitos_Pertenece,indiceEstado,false);
                 	indiceEstadoEnviado = thisapp.NuevoRequisitoDoc.getIndiceEviadoAprobado(RequisitoID);
                 	thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(requisito.Lista_Requisitos_Pertenece,indiceEstadoEnviado,false);
                 	delete from Nuevo_Requisitos_Doc[ID == RequisitoID];
                 }
				 string NuevoRequisitoDoc.EstadoGeneral(int idRequisito)
                 {
                 	estadoGeneral = "";
                 	requisito = Nuevo_Requisitos_Doc[ID == idRequisito];
                 	// indice de estados, 1" Pendiente Subir ... 5: Actualizado"
                 	indiceEstado = thisapp.NuevoRequisitoDoc.getEstadoIndice(idRequisito);
                 	indiceEstadoConCliente = thisapp.NuevoRequisitoDoc.getIndiceEstadoEnviadoACliente(requisito.Enviado,requisito.Aprobado_Cliente);
                 	if(indiceEstado < 4)
                 	{
                 		estadoGeneral = requisito.Estado;
                 	}
                 	else if(requisito.Aprobado_Cliente == "SI")
                 	{
                 		estadoGeneral = "Validado";
                 	}
                 	else if(requisito.Enviado == "SI")
                 	{
                 		estadoGeneral = "Enviado - Pendiente Validar";
                 	}
                 	else if(indiceEstado == 5)
                 	{
                 		estadoGeneral = "Actualizado - Pendeinte Enviar";
                 	}
                 	else
                 	{
                 		estadoGeneral = "Pendiente Enviar";
                 	}
                 	if(indiceEstado == 4)
                 	{
                 		estadoGeneral = estadoGeneral + " - Cerca de Caducar";
                 	}
                 	return estadoGeneral;
                 }
				 string NuevoRequisitoDoc.GetEnviado(int requisitoID)
                 {
                 	return Nuevo_Requisitos_Doc[ID == requisitoID].Enviado;
                 }
				 string NuevoRequisitoDoc.GetEstado(int requisitoID)
                 {
                 	return Nuevo_Requisitos_Doc[ID == requisitoID].Estado;
                 }
				 collection NuevoRequisitoDoc.getEstadoEnviadoAClienteSegunIndice(int indiceEstado)
                 {
                 	estados = List();
                 	// Enviado
                 	if(indiceEstado == 7)
                 	{
                 		estados.add("SI");
                 		//Aprobado por cliente
                 		if(indiceEstado == 8)
                 		{
                 			estados.add("SI");
                 		}
                 		// No Aprobado por cliente
                 		else
                 		{
                 			estados.add("Sin respuesta");
                 		}
                 	}
                 	//No enviado ni aporbado por cliente
                 	else
                 	{
                 		estados.add("NO");
                 		estados.add("Sin respuesta");
                 	}
                 	return estados;
                 }
				 int NuevoRequisitoDoc.getEstadoIndice(int requisitoID)
                 {
                 	estado = Nuevo_Requisitos_Doc[ID == requisitoID].Estado;
                 	return thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(estado);
                 }
				 int NuevoRequisitoDoc.getIndiceEstadoEnviadoACliente(string estadoEnviadoACliente, string aprobadoPorCliente)
                 {
                 	respuesta = 0;
                 	if(estadoEnviadoACliente == "SI")
                 	{
                 		respuesta = 7;
                 		if(input.aprobadoPorCliente == "SI")
                 		{
                 			respuesta = 8;
                 		}
                 	}
                 	else
                 	{
                 		respuesta = 6;
                 	}
                 	return respuesta;
                 }
				 int NuevoRequisitoDoc.getIndiceEviadoAprobado(int requisitoID)
                 {
                 	resultado = -1;
                 	requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 	if(requisito.Enviado == "NO" || requisito.Enviado == null)
                 	{
                 		resultado = 6;
                 	}
                 	else if(requisito.Aprobado_Cliente == "SI" && requisito.Enviado == "SI")
                 	{
                 		resultado = 8;
                 	}
                 	else if(requisito.Aprobado_Cliente == "Sin respuesta" && requisito.Enviado == "SI")
                 	{
                 		resultado = 7;
                 	}
                 	return resultado;
                 }
				 bool NuevoRequisitoDoc.isEnviado(Nuevo_Requisitos_Doc req)
                 {
                 	result = false;
                 	if(req.Enviado == "SI")
                 	{
                 		result = true;
                 	}
                 	return result;
                 }
				 void NuevoRequisitoDoc.MatchDocumentWithRequirement(int idReq)
                 {
                 	for each  req in Nuevo_Requisitos_Doc[ID == idReq]
                 	{
                 		//Buscar Nuevo Documetno que se quiere entregar
                 		documento = null;
                 		plantID = req.Plantilla;
                 		plantNombre = req.Plantilla.Nombre_de_la_plantilla;
                 		plantTRABAJADOR = req.Plantilla.Trabajador1;
                 		plantCLIENTE = req.Plantilla.CLIENTE;
                 		trabajadorID = req.Trabajador;
                 		cliente = req.Cliente1;
                 		for each  doc in Subir_Documento[Plantilla.ID == plantID]
                 		{
                 			if(plantTRABAJADOR != "SI" || trabajadorID == doc.TRABAJADOR)
                 			{
                 				if(plantCLIENTE != "SI" || cliente.ID == doc.CLIENTE)
                 				{
                 					//info "Doc encontrado: " + doc.Nombre_Documento + ", Estado doc: " + doc.Estado;
                 					documento = doc;
                 				}
                 			}
                 		}
                 		if(documento == null)
                 		{
                 			//Crear nuevo documento con nombre Subir Documento
                 			N_orden_doc = 0;
                 			for each  doc in Subir_Documento[ID != 0]
                 			{
                 				if(N_orden_doc < doc.Numero_Documento)
                 				{
                 					N_orden_doc = doc.Numero_Documento;
                 				}
                 			}
                 			N_orden_doc = N_orden_doc + 1;
                 			empresa = null;
                 			for each  p in Plantilla
                 			{
                 				if(p.EMPRESA1 == "SI")
                 				{
                 					empresa = p.EMPRESA;
                 				}
                 			}
                 			idDoc = insert into Subir_Documento
                 			[
                 				Plantilla=plantID
                 				Added_User=zoho.loginuser
                 				TRABAJADOR=trabajadorID
                 				EMPRESA=empresa
                 				CLIENTE=cliente
                 				Numero_Documento=N_orden_doc
                 				Nombre_Documento="Subir Documento de tipo " + plantNombre
                 				Estado="Pendiente Subir"
                 			];
                 			for each  docReg in Subir_Documento[ID == idDoc]
                 			{
                 				documento = docReg;
                 			}
                 		}
                 		indiceEstadoDoc = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(documento.Estado);
                 		thisapp.NuevoRequisitoDoc.SetEstado(req.ID,indiceEstadoDoc);
                 		if(documento != null)
                 		{
                 			req.Documento=documento.ID;
                 		}
                 		documento.Archivado="NO";
                 	}
                 }
				 bool NuevoRequisitoDoc.SetEstado(int requisitoID, int indiceEstado)
                 {
                 	// DEBUG
                 	//info "Set Estado: " + thisapp.FuncionesEstaticas.GetEstadosRequisitos(indiceEstado);
                 	// Requisito al que se le va acolocar el estado
                 	requisito = Nuevo_Requisitos_Doc[ID == requisitoID];
                 	//Estado actual llevado a un numero para simplificar su manipulacion
                 	estadoActualIndice = 0;
                 	// SI el indice del estado es menor que 5, se refiere al estado de caducidad (Actualizado, Cadudado, etc)
                 	if(indiceEstado < 6)
                 	{
                 		estadoActualIndice = thisapp.NuevoRequisitoDoc.getEstadoIndice(requisito.ID);
                 		info "Estado determinado para el indiceEstado " + indiceEstado + ", estadoActualIndice " + estadoActualIndice;
                 	}
                 	else
                 	{
                 		estadoActualIndice = thisapp.NuevoRequisitoDoc.getIndiceEviadoAprobado(requisito.ID);
                 	}
                 	// SI el estado que se quiere colocar no estaba colocado previamente
                 	huboCambio = false;
                 	if(estadoActualIndice != indiceEstado)
                 	{
                 		huboCambio = true;
                 		if(requisito.Lista_Requisitos_Pertenece != null)
                 		{
                 			thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(requisito.Lista_Requisitos_Pertenece,estadoActualIndice,false);
                 		}
                 		// Proceder a modificar el estado del requisito
                 		if(indiceEstado < 6)
                 		{
                 			requisito.Estado=thisapp.FuncionesEstaticas.GetEstadosRequisitos(indiceEstado);
                 		}
                 		else if(indiceEstado == 6)
                 		{
                 			//pasar el estado a no enviado
                 			requisito.Enviado="NO";
                 			requisito.Aprobado_Cliente="Sin respuesta";
                 		}
                 		else if(indiceEstado == 7)
                 		{
                 			requisito.Enviado="SI";
                 			requisito.Aprobado_Cliente="Sin respuesta";
                 		}
                 		else if(indiceEstado == 8)
                 		{
                 			requisito.Enviado="SI";
                 			requisito.Aprobado_Cliente="SI";
                 		}
                 		if(requisito.Lista_Requisitos_Pertenece != null)
                 		{
                 			//incrementar contador pendientes
                 			thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(requisito.Lista_Requisitos_Pertenece,indiceEstado,true);
                 		}
                 	}
                 	//Colocar como no enviado ya que no puede estar enviado si esta pendiente subir
                 	if(indiceEstado == 1 || indiceEstado == 3)
                 	{
                 		thisapp.NuevoRequisitoDoc.SetEstado(input.requisitoID,6);
                 	}
                 	PlantillaNombre = Plantilla[ID == requisito.Plantilla].Nombre_de_la_plantilla;
                 	requisito.Nombre_con_Color_Estado=thisapp.NuevoRequisitoDoc.AutollenarNombreColorCaducidad(requisito.Estado,PlantillaNombre);
                 	requisito.Nombre_Color_Enviado=thisapp.NuevoRequisitoDoc.AutorrellenarNombreColorEnviado(requisito.Enviado,requisito.Aprobado_Cliente,PlantillaNombre);
                 	requisito.Estado1=thisapp.NuevoRequisitoDoc.EstadoGeneral(requisito.ID);
                 	return huboCambio;
                 }
				 string NuevoRequisitoDoc.ThreeLeftCeros(int number, int cifras)
                 {
                 	result = "";
                 	if(number == null)
                 	{
                 		result = number;
                 	}
                 	else
                 	{
                 		if(cifras >= 4 && number / 1000 < 1)
                 		{
                 			result = result + "0";
                 		}
                 		if(cifras >= 3 && number / 100 < 1)
                 		{
                 			result = result + "0";
                 		}
                 		if(number / 10 < 1)
                 		{
                 			result = result + "0";
                 		}
                 		result = result + number.toString();
                 	}
                 	return result;
                 }
				 void PaginaImportacionRecruit.ActualizarCamposListadoOficial()
                 {
                 	for each  t in Nuevo_Empleado[ID != 0]
                 	{
                 		for each  tr in Importaci_n_Empleado_Recruit[DNI == t.DNI]
                 		{
                 			t.Moneda=tr.Moneda;
                 			new_val = tr.M_vil;
                 			if(new_val != null && t.M_vil == null)
                 			{
                 				t.M_vil=new_val;
                 			}
                 			new_val = tr.Tel_fono;
                 			if(new_val != null && t.Tel_fono == null)
                 			{
                 				t.Tel_fono=new_val;
                 			}
                 			new_val = tr.Idioma;
                 			if(new_val != null && t.Idioma == null)
                 			{
                 				t.Idioma=new_val;
                 			}
                 			new_val = tr.Delegacion;
                 			if(new_val != null && t.Delegacion == null)
                 			{
                 				t.Delegacion=new_val;
                 			}
                 			new_val = tr.Tipo_de_Contrato1;
                 			if(new_val != null && t.Tipo_de_Contrato1 == null)
                 			{
                 				t.Tipo_de_Contrato1=new_val;
                 			}
                 			t.CANDIDATEID_Recruit1=tr.CANDIDATEID_Recruit1;
                 			t.ID_de_Candidato_Recruit=tr.ID_de_Candidato_Recruit;
                 			new_val = tr.Area_Profesional;
                 			if(new_val != null && t.Area_Profesional == null)
                 			{
                 				t.Area_Profesional=new_val;
                 			}
                 			t.Profesion=tr.Profesion;
                 			t.Categoria_Profesional1=tr.Categoria_Profesional1;
                 			t.Puesto_laboral_actual=tr.Puesto_laboral_actual;
                 			new_val = tr.Especialidad1;
                 			if(new_val != null && t.Especialidad1 == null)
                 			{
                 				t.Especialidad1=new_val;
                 			}
                 			new_val = tr.Tipo_de_R_gimen;
                 			if(new_val != null && t.Tipo_de_R_gimen == null)
                 			{
                 				t.Tipo_de_R_gimen=new_val;
                 			}
                 		}
                 	}
                 }
