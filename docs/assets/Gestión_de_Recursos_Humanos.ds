		map Mapa_Empleados
		{
			displayName = "Mapa Empleados"
			show all rows from Nuevo_Empleado  [C_digo_de_Operario is null]  
			(
				Nombre 
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Official_Email as "Email"
				Correo_Electr_nico as "Email Personal o Secundairo"
				Moneda
