		list Listado_Empleados_Salario
		{
			displayName = "Listado Empleados"
			show all rows from Nuevo_Empleado    
			(
				Estado_del_Empleado as "Estado del Empleado"
				Sexo
				Fecha_de_Nacimiento as "Fecha de Nacimiento"
				M_vil as "Móvil"
				Foto
				Nombre 
	 			(
	      			displayformat = [first_name+""+last_name]
	      			enable = LastName_FirstName
	 			)
				Correo_Electr_nico as "Email Personal o Secundairo"
				Tel_fono as "2do Teléfono"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Moneda
				DNI as "DNI / NIE / Pasaporte"
				Idioma
				Delegacion as "Delegación"
				Tipo_de_Contrato1 as "Tipo de Contrato"
				Comarca
				Area_Profesional as "Area Profesional"
				Puesto_laboral_actual as "Puesto laboral actual"
				Profesion as "Profesión"
				Especialidad1 as "Especialidad"
				Categoria_Profesional1 as "Categoría Profesional"
				Informaci_n_adicional as "Información adicional"
				Precio_Base_Autonomo1 as "Precio Base Autónomo"
				Carnet_de_Conducir as "Carnet de Conducir"
				Veh_culo_propio as "Vehículo propio"
				Calle
				C_digo_postal as "Código postal"
				ID
				N_Orden as "Nº Orden"
				Lista_de_Requisitos as "Lista de Requisitos"
				(
					view = Ver_Listas_de_Documentaci_n_Requerida
					delimiter = newline
				)
				Clientes_Habituales as "Clientes Habituales"
				(
					view = Ver_Clientes
					delimiter = newline
				)
				custom action "Asignar un EPI - Herramienta"
				(
	  			workflow = Asignar_EPI
				show action in view header = true
				show action in edit record menu = true
				column header = "Asignar un EPI - Herramienta"
				)
				Official_Email as "Email"
				custom action "Asignar / Desasignar Cliente"
				(
	  			workflow = Asignar_trabajador_a_clie
				show action in view header = true
				show action in edit record menu = true
				column header = "Asignar / Desasignar Cliente"
				)
				Empresa_que_Contrata1 as "Empresa que Contrata"
				Lista_de_Requisitos.Campo_Etiqueta_Coloreada_para_Empresa as "Campo Etiqueta Coloreada para Empresa"
				Jornada_Laboral1 as "Jornada Laboral"
				custom action "Historial de Vehículos Asignados"
				(
	  			workflow = Historial_de_Veh_culos_As
				show action in view header = true
				show action in edit record menu = true
				column header = "Historial de Vehículos Asignados"
				)
				Pa_s as "País"
				Ciudad
				Estado_provincia1 as "Estado/provincia"
				Tipo_de_R_gimen as "Tipo de Régimen"
				custom action "Historial EPI - Herramientas"
				(
	  			workflow = Abrir_Historial_EPI_Herra
				show action in view header = true
				show action in edit record menu = true
				column header = "Historial EPI - Herramientas"
				)
				Antig_edad as "Antigüedad"
				custom action "Asignar Activos"
				(
	  			workflow = Asignar_Activo_a_Empleado
				show action in view header = true
				show action in edit record menu = true
				column header = "Asignar Activos"
				)
				custom action "Historial Activos"
				(
	  			workflow = Historial_Activos_Emplead
				show action in view header = true
				show action in edit record menu = true
				column header = "Historial Activos"
				)
				Fecha_de_Alta as "Fecha de Alta"
				C_digo_de_Operario as "Código de Operario"
				Necesita_Habitaci_n1 as "Necesita Habitación"
				Habitaci_n_Empresa1 as "Habitación Empresa"
				Direcci_n_Habitaci_n_Empresa as "Dirección Habitación Empresa"
				Tipo_Aut_nomo as "Tipo Autónomo"
				SAGE
				ID_de_Candidato_Recruit as "ID de Candidato - Recruit"
				Documentos
				(
					view = Otros_Documentos
					delimiter = newline
				)
				Encargado_de_RRHH as "Encargado de RRHH"
				Activos_Asignados as "Activos Asignados"
				(
					view = Instancia_Activo_Report
					delimiter = newline
				)
				EPI_Herramientas as "EPI - Herramientas"
				Clientes_No_Habituales as "Clientes No Habituales"
				Salario
			)
			filters
			(
				"Mecánicos"  :  Profesion.contains("Mecánico")
				"Autónomos"  :  Tipo_de_Contrato1.contains("Autónomo")
			)
			group by
			(
				Estado_del_Empleado custom
			)
			sort by
			(
				Nombre.last_name ascending
			)
			custom actions
			(
				"WhatsApp"
				(
	  			workflow = WhatsApp1
				show action in view header = true
				show action in edit record menu = true
				execute action for collection of records
				)
				"Documentos"
				(
	  			workflow = VerDocumentosTrabajador
				show action in view header = true
				show action in edit record menu = true
				)
				"Subir Documento"
				(
	  			workflow = Subir_Documento_Empleado
				show action in view header = true
				show action in edit record menu = true
				)
				"Dar Baja"
				(
	  			workflow = Dar_Baja_a_Empleado
				show action in edit record menu = true
				condition = (Estado_del_Empleado == "Activo" || Estado_del_Empleado == "Permiso de Ausencia" || Estado_del_Empleado == "Reasignado" && Dar_de_Baja.ID is null)
				)
				"Gestionar Baja"
				(
	  			workflow = GestionarBajaAccion
				show action in view header = true
				show action in edit record menu = true
				condition = (Estado_del_Empleado == "Activo" || Estado_del_Empleado == "Reasignado" || Estado_del_Empleado == "Permiso de Ausencia" && Dar_de_Baja.ID is null)
				confirmation before execution
				(
					message for individual record = "¿Desea iniciar un proceso de gestión de la baja de este empleado?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
				"Enviar Documentación Bienvenida"
				(
	  			workflow = Enviar_Documentos_Bienven
				show action in view header = true
				show action in edit record menu = true
				condition = (Le_da_Documentaci_n_Bienvenida == "NO" || Le_da_Documentaci_n_Bienvenida is null)
				confirmation before execution
				(
					message for individual record = "¿Enviar vía email la documentación de bienvenida y enlace de registro en Portal Empleado al trabajador ${Nombre} ?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
				"Documentación"
				(
	  			workflow = AbrirDetallesDocumetnaci_
				show action in edit record menu = true
				)
				"Pasar a Inactivos"
				(
	  			workflow = Cambiar_Estado_a_Inactivo
				show action in view header = true
				show action in edit record menu = true
				condition = (Estado_del_Empleado != "Inactivo")
				confirmation before execution
				(
					message for individual record = "¿Pasar el empleado ${Nombre} a inactivo?"
					message for multiple records = "¿Pasar a estado inactivo ${record_count} empleados?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
				"Pasar a Activo"
				(
	  			workflow = Cambiar_estado_a_activo
				show action in view header = true
				show action in edit record menu = true
				condition = (Estado_del_Empleado != "Activo")
				confirmation before execution
				(
					message for individual record = "¿Pasar a estado Activo al empleado  ${Nombre} ?"
					message for multiple records = "¿Pasar a Activos ${record_count} empleados?"
					confirm button text = "Sí"		
					cancel button text = "No"
				)
				)
			)
			conditional formatting
			(
				"Alta Reciente no lectura documentación"
				{
				condition = (Le_da_Documentaci_n_Bienvenida == "NO" || Le_da_Documentaci_n_Bienvenida is null)
				fields = [Nombre]
				format = "color:#000000;background-color:#fdff99;"
				}
			)
		}
