		list EPI_Herramientas
		{
			displayName = "EPI"
			show all rows from Nuevo_EPI_Herramienta  [TIPO == "EPI"]  
			(
				Nombre as "Nombre Descriptivo"
				Foto
				N_Orden as "Nº Orden"
				TIPO as "Tipo"
				Tipo_de_Ropa as "Tipo de Ropa"
				Talla
				CADUCIDAD as "Caducidad"
				TIPO_CADUCIDAD_A_OS as "Tipo de Caducidad (Años)"
				CERTIFICACI_N_FABRICANTE as "Certificación Fabricante"
				OBLIGATORIO as "Obligatorio"
				Descripci_n as "Descripción"
				Proveedor
				C_digo_Fabricante as "Código Fabricante"
				Fecha_Alta as "Fecha Alta"
				Observaciones
				Total_Unidades as "Total Unidades"
				Unidades_Disponibles as "Unidades Disponibles"
				custom action "Asignar"
				(
	  			workflow = Asignar_EPI1
				show action in edit record menu = true
				column header = "Asignar"
				condition = (Unidades_Disponibles > 0)
				)
				custom action "Historial"
				(
	  			workflow = VerHistorialAsignacionesE
				show action in edit record menu = true
				column header = "Historial"
				)
				custom action "Alta / Baja"
				(
	  			workflow = Dar_de_Alta_EPI_Herramien
				show action in edit record menu = true
				column header = "Alta / Baja"
				)
				custom action "Desasignar"
				(
	  			workflow = Abrir_Reporte_Unidades_EP
				show action in edit record menu = true
				column header = "Desasignar"
				condition = (Total_Unidades > input.Unidades_Disponibles)
				)
				Forma_de_Contabilizar_Unidades as "Contabilidad"
			)
			filters
			(
				TIPO
				"Untitled"  :  TIPO == "ROPA"
				"Ropa"  :  TIPO.contains("ROPA")
				"EPIs"  :  TIPO.contains("EPI")
				"Herramientas"  :  TIPO.contains("HERRAMIENTA")
			)
			custom actions
			(
				"Ver Unidades"
				(
	  			workflow = Ver_Reporte_Unidades_EPI
				show action in edit record menu = true
				)
			)
		}
