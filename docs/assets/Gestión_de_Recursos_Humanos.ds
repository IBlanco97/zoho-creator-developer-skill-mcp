				 void NuevoEmpleado.EnviarMailBienvenida(Nuevo_Empleado empleado)
                 {
                 	conf = Configuraci_n_General[ID != 0];
                 	subject_ = conf.Asunto_Mail_Bienvenida_Trabajadores;
                 	name = empleado.Nombre;
                 	message_ = conf.Plantilla_Mail_Bienvenida_Trabajadores;
                 	x = List();
                 	x = message_.toList("{nombre}");
                 	newMessage = x.get(0) + empleado.Nombre + x.get(1);
                 	x = message_.toList("{enlace}");
                 	newMessage = x.get(0) + "https://domo21.zohocreatorportal.com" + x.get(1);
                 	ficheros = List();
                 	ficheros = conf.Documentos_Bienvenida_Trabajador;
                 	sendmail
                 	[
                 		from :zoho.loginuserid
                 		to :empleado.Official_Email
                 		subject :subject_
                 		message :newMessage
                 		Attachments :file:conf.Documentos_Bienvenida_Trabajador
                 	]
                 }
