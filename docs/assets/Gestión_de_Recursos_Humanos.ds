					(
						url = "#Form:Responder_Solicitud_EPI?Solicitud_a_la_que_se_responde1=" + input.ID + "&Respuesta=" + input.Aprobado;
										if(Fecha_Prevista_de_Entrega != null)
										{
											url = url + "&Fecha_Prevista_de_Entrega=" + input.Fecha_Prevista_de_Entrega;
										}
										if(Equipo_Asignado != null)
										{
											url = url + "&Equipo_Asignado=" + input.Equipo_Asignado;
