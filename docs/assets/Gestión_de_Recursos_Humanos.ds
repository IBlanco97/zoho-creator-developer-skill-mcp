		default list Ver_Clientes
		{
			displayName = "Clientes Documentación"
			show all rows from Nuevo_Cliente    
			(
				Nombre_de_Cuenta as "Cliente"
				Plantillas_Requeridas as "Documentos Trabajadores"
				(
					view = Ver_Plantillas
					delimiter = newline
				)
				Trabajadores_Habituales as "Trabajadores Habituales"
				(
					view = Employee_Details
					delimiter = newline
				)
				Documentos
				(
					view = Documentos_Trabajador
					delimiter = newline
				)
				Plantillas_con_Empresa as "Documentos Empresa"
				(
					view = Ver_Plantillas
					delimiter = newline
				)
				Imagen_de_Cuenta as "Imagen de Cuenta"
				Nombre_Comercial as "Nombre Comercial"
				N_Orden as "Nº Orden"
				Tel_fono as "Teléfono"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				EMAIL_GENERAL as "EMAIL GENERAL"
				Fax
				CIF
				Localizacion  as "Localización"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				DETALLE_LOCALIZACI_N as "Google Maps"
				Descripci_n as "Descripción"
				Observaciones
				Estado_General_Documentacion as "Estado General Documentacion"
				custom action "Asignar / Desasignar Trabajador"
				(
	  			workflow = Asignar_Desasignar_Trabaj
				show action in edit record menu = true
				column header = "Asignar / Desasignar Trabajador"
				)
				Formas_de_Env_o as "Formas de Envío"
				(
					view = Ver_Plantillas_Env_o
					delimiter = newline
				)
				ContadorPendietesSubir as "Pend. Subir"
				ContadorActualizados as "Actualiz."
				ContadorCaducados as "Cad."
				ContadorCercaCaducar as "Prox a Cad."
				ContadorNoEnviados as "No Enviados"
				ContadorEnviadosNoAprobados as "Enviados"
				ContadorEnviadosAprobados as "Validados"
				ContadorTotal as "Total Docs."
				custom action "Enviar"
				(
	  			workflow = Enviar_Documentaci_n_Repo
				show action in edit record menu = true
				column header = "Enviar"
				condition = (Estado_General_Documentacion == "No Enviada" && ContadorNoEnviados > 0)
				)
				custom action "Validar"
				(
	  			workflow = Validar_Documentos_Report
				show action in edit record menu = true
				column header = "Validar"
				condition = (ContadorEnviadosNoAprobados > 0 || Estado_General_Documentacion == "Enviada")
				)
				custom action "Modificar Requisitos Trabajadores"
				(
	  			workflow = Modificar_Lista_Documento
				show action in edit record menu = true
				column header = "Modificar Requisitos Trabajadores"
				)
				custom action "Modificar Requisitos Empresa"
				(
	  			workflow = Modificar_Requisitos_Empr
				show action in edit record menu = true
				column header = "Modificar Requisitos Empresa"
				)
				Bloqueo_de_Acceso as "Bloq. de Acceso"
				Documentos_Aut_nomo as "Documentos Autónomos"
				custom action "Modificar Documentos Autónomos"
				(
	  			workflow = ModificarDocumentosAutono
				show action in edit record menu = true
				column header = "Modificar Documentos Autónomos"
				)
			)
			filters
			(
				"Clientes con Personal Asignado"  :  ContadorTotal > 0
				"Clientes con Documentación Pendiente de Publicar"  :  ContadorPendietesSubir > 0 || ContadorCaducados > 0
				"Clientes con Documentación Caducada"  :  ContadorCaducados > 0
				"Clientes con Documentación Incompleta"  :  ContadorPendietesSubir > 0 || ContadorCaducados == 0 || ContadorNoEnviados > 0 || ContadorEnviadosNoAprobados > 0
			)
			sort by
			(
				Nombre_de_Cuenta ascending
			)
			custom actions
			(
				"Ver Documentacion"
				(
	  			workflow = Ver_Documentacion
				)
				"Actualizar Requisitos Automáticamente"
				(
	  			workflow = ActualizarListasDocClient
				show action in edit record menu = true
				)
			)
			conditional formatting
			(
				"Problemas con la documentación"
				{
				condition = (ContadorCaducados > 0 || ContadorPendietesSubir > 0 || ContadorNoEnviados > 0)
				fields = [Nombre_de_Cuenta]
				format = "color:#cc1111;background-color:#ffffff;"
				}
				"Documentación Enviada pendiente de aprobación"
				{
				condition = (ContadorEnviadosNoAprobados > 0 && ContadorNoEnviados == 0 && ContadorCaducados == 0 && ContadorPendietesSubir == 0)
				fields = [Nombre_de_Cuenta]
				format = "color:#8b4908;"
				}
				"New Formatting"
				{
				condition = (ContadorNoEnviados == 0 && ContadorEnviadosNoAprobados == 0 && ContadorCaducados == 0 && ContadorPendietesSubir == 0)
				fields = [Nombre_de_Cuenta]
				format = "color:#2f78d0;"
				}
				"New Formatting"
				{
				fields = [Plantillas_Requeridas, Trabajadores_Habituales, Plantillas_con_Empresa]
				format = "color:#000000;background-color:#ffffff;"
				}
				"Contador Actualizados"
				{
				condition = (ContadorActualizados > 0)
				fields = [ContadorActualizados]
				format = "color:#07c900;background-color:#f3f3f3;"
				}
				"Contador Cerca Caducar"
				{
				condition = (ContadorCercaCaducar > 0)
				fields = [ContadorCercaCaducar]
				format = "color:#fcc019;background-color:#f3f3f3;"
				}
				"Contador Caducado"
				{
				condition = (ContadorCaducados > 0)
				fields = [ContadorCaducados]
				format = "color:#c90000;background-color:#f3f3f3;"
				}
				"Contador Pendiete Subir"
				{
				condition = (ContadorPendietesSubir > 0)
				fields = [ContadorPendietesSubir]
				format = "color:#ff2424;background-color:#f3f3f3;"
				}
				"Contador No Enviado"
				{
				condition = (ContadorNoEnviados > 0)
				fields = [ContadorNoEnviados]
				format = "color:#ff2424;background-color:##ffffff;"
				}
				"Contador Enviado No Aprobado"
				{
				condition = (ContadorEnviadosNoAprobados > 0)
				fields = [ContadorEnviadosNoAprobados]
				format = "color:#ba2800;"
				}
				"Contador Enviado Aprobado"
				{
				condition = (ContadorEnviadosAprobados > 0)
				fields = [ContadorEnviadosAprobados]
				format = "color:#309fff;"
				}
				"New Formatting"
				{
				fields = [ContadorTotal]
				format = "color:#ffffff;background-color:#7c7c7c;"
				}
				"New Formatting"
				{
				condition = (ContadorActualizados == 0 || ContadorActualizados is null)
				fields = [ContadorActualizados]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorCaducados == 0 || ContadorCaducados is null)
				fields = [ContadorCaducados]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorCercaCaducar == 0 || ContadorCercaCaducar is null)
				fields = [ContadorCercaCaducar]
				format = "background-color:#f3f3f3;"
				}
				"New Formatting"
				{
				condition = (ContadorPendietesSubir == 0 || ContadorPendietesSubir is null)
				fields = [ContadorPendietesSubir]
				format = "background-color:#f3f3f3;"
				}
			)
		}
		default list Ver_Plantillas
		{
			displayName = "Modelos de Documentos"
			show all rows from Plantilla    
			(
				CLIENTE as "Cliente"
				Trabajador1 as "Trabajador"
				FIRMA_TRABAJADOR as "Firma Trabajador"
