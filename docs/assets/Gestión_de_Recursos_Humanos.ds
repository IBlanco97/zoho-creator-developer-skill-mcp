		default list Requisito_de_Baja_Report
		{
			displayName = "Requisitos de Baja"
			show all rows from Requisito_de_Baja    
			(
				Empleado
				Tipo_de_Requisito as "Tipo de Requisito"
				EPI
				Herramienta
				Ropa
				Estado
				Etiqueta
				Dar_de_Baja as "Dar de Baja"
				custom action "Completado"
				(
	  			workflow = Confirmar_Entrega_Requisi
				show action in view header = true
				show action in edit record menu = true
				column header = "Completado"
				condition = (Estado == "Pendiente" || Estado is null)
				)
				Asignacion as "Activo"
			)
			conditional formatting
			(
				"Completado"
				{
				condition = (Estado == "Completado")
				fields = [Empleado, Tipo_de_Requisito, EPI, Herramienta, Ropa, Estado]
				format = "background-color:#d2e9d1;"
				}
			)
		}
