			OnDelete1 as "OnDelete"
			{
				type =  form
				form = Asignacion_T_cnico_Cliente
				record event = on delete

				on validate
				{
					actions 
					{
						custom deluge script
						(
											tecnico = Nuevo_Empleado[ID == input.Tecnico];
										cliente = Nuevo_Cliente[ID == input.Cliente];
										if(Fecha_de_Inicio <= zoho.currenttime && Fecha_de_Fin == null || Fecha_de_Fin >= zoho.currenttime)
										{
											esClienteHabitual = input.Cliente_habitual == "SI";
											thisapp.NuevoEmpleado.DesasignarCliente(tecnico,cliente,esClienteHabitual);
										}
										delete from Asignacion_Tecnico_Cliente_Anio[Asignacion_T_cnico_Cliente == input.ID];
										delete from Rango_Fechas_Asingacion[Asignacion_T_cnico_Cliente == input.ID];
										delete from Jornada[Asignacion_T_cnico_Cliente == input.ID];
						)
					}
