                 	}
                 	else if(EstadoDocCliente == thisapp.NuevaListaDeRequisitos.GetStatusEnviadoByIndex(3))
                 	{
                 		color = "blue";
                 	}
                 	texto = TrabajadorNombre;
                 	result = "<span style=\"color: " + color + "\">" + texto + "</span>";
                 	return result;
                 }
