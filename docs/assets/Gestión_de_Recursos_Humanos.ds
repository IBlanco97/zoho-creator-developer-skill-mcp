				Descripci_n as "Descripción"
				(
					foldcontent = enable
				)
				Observaciones
				(
					foldcontent = enable
				)
				TIPO_CADUCIDAD as "Tipo de Caducidad"
				CR_TICA as "Crítica"
				FOTO as "Foto"
				EMPRESA as "Empresa"
				(
					view = Ver_Empresa
				)
				EMPRESA1 as "Empresa"
				Validaci_n_Autom_tica as "Validación Automática"
