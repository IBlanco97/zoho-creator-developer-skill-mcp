				column header = "Historial"
				)
				custom action "Alta / Baja"
				(
	  			workflow = Dar_de_Alta_EPI_Herramien
				show action in edit record menu = true
				column header = "Alta / Baja"
				)
				custom action "Desasignar"
				(
	  			workflow = Abrir_Reporte_Unidades_EP
				show action in edit record menu = true
				column header = "Desasignar"
				condition = (Total_Unidades > input.Unidades_Disponibles)
				)
				Forma_de_Contabilizar_Unidades as "Contabilidad"
			)
			filters
			(
				TIPO
				"Untitled"  :  TIPO == "ROPA"
				"Ropa"  :  TIPO.contains("ROPA")
				"EPIs"  :  TIPO.contains("EPI")
				"Herramientas"  :  TIPO.contains("HERRAMIENTA")
			)
			custom actions
			(
				"Ver Unidades"
				(
	  			workflow = Ver_Reporte_Unidades_EPI
				show action in edit record menu = true
				)
			)
		}
