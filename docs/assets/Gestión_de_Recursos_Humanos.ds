		calendar Calendario_Solicitudes
		{
			displayName = "Calendario Solicitudes"
			show all rows from Solicitud  [Aprobado == "SI" || Aprobado == "Sin Respuesta" || Aprobado is null]  
			(
				Trabajador_Solicitante as "Trabajador Solicitante"
				(
					view = Employee_Details
				)
				Tipo
				Fecha_de_comienzo as "Fecha de comienzo"
				Fecha_de_Fin as "Fecha de Fin"
				Nota
				Aprobado
				Trabajador_Solicitante.Foto
				custom action "Aprobar"
				(
	  			workflow = Aprobar_Solicitud_Reporte
				show action in edit record menu = true
				column header = "Aprobar"
				condition = (Aprobado == "Sin Respuesta" || Aprobado is null)
				)
				custom action "Rechazar"
				(
	  			workflow = Rechazar_Solicitud_Report
				show action in edit record menu = true
				column header = "Rechazar"
				condition = (Aprobado == "Sin Respuesta" || Aprobado is null)
				)
			)
			options
			(
				display type = month
				week start day = sunday
				display field = Trabajador_Solicitante
				start date = Fecha_de_comienzo
				end date = Fecha_de_Fin
				default date 
				(
	    			day   = Today
	    			month = Currentmonth
	    			year  = Currentyear
				)
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Aprobado == "SI")
				fields = [Trabajador_Solicitante]
				format = "background-color:##b6deb5;"
				}
				"New Formatting"
				{
				condition = (Aprobado == "SI")
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
