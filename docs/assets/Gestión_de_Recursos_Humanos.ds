			(
				type = picklist	
				values  = Nuevo_Empleado.ID
    			displayformat = [" " + Nombre.first_name + " " + Nombre.last_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Contenido
			(
    			type = textarea
