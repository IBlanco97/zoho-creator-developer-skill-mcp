			Env_o_de_Formulario15 as "Envío de Formulario"
			{
				type =  form
				form = Asignacion_EPI_Ropa_Herramienta
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											unidad = null;
										if(Forma_Contabilidad == null || Forma_Contabilidad == "Serializadas")
										{
											unidad = Unidad_de_EPI_Herramienta[ID == input.Codigo_de_Serie];
											thisapp.NuevoEPIRopaHerramienta.SetAsignada(unidad,true,input.Trabajador);
											epi = Nuevo_EPI_Herramienta[ID == unidad.EPI_Herramienta];
											thisapp.NuevoEPIRopaHerramienta.ModificarCantidadUnidades(epi,-1,true,false);
										}
										else if(Forma_Contabilidad == "No Serializadas")
										{
											unidad = insert into Unidad_de_EPI_Herramienta
											[
												EPI_Herramienta=input.EPI_Herramienta
												Added_User=zoho.loginuser
												Etiqueta=input.EPI_Herramienta.Nombre
												Asignado_a=input.Trabajador
												Estado="Asignado"
												Cantidad=input.Unidades
												Contabilidad=input.Forma_Contabilidad
											];
											input.Codigo_de_Serie = unidad;
											epi = Nuevo_EPI_Herramienta[ID == input.EPI_Herramienta];
											restar = input.Unidades * -1;
											thisapp.NuevoEPIRopaHerramienta.ModificarCantidadUnidades(epi,restar,true,false);
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
