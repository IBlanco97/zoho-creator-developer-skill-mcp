			Verificar_Si_Hay_Extensio as "Verificar Si Hay Extension del Rango de Fechas"
			{
				type =  form
				form = Jornada
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											asingacion = Asignacion_T_cnico_Cliente[ID == input.Asignacion_T_cnico_Cliente];
										if(Hora_de_Inicio < asingacion.Fecha_de_Inicio)
										{
											asingacion.Fecha_de_Inicio=input.Hora_de_Inicio;
											for each  rangoID in asingacion.Fechas
											{
												rango = Rango_Fechas_Asingacion[ID == rangoID];
												rango.Fecha_de_Comienzo1=input.Hora_de_Inicio;
												break;
											}
											thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asingacion);
										}
										if(Hora_de_Fin > asingacion.Fecha_de_Fin)
										{
											asingacion.Fecha_de_Fin=input.Hora_de_Fin;
											rango = null;
											for each  rangoID in asingacion.Fechas
											{
												rango = Rango_Fechas_Asingacion[ID == rangoID];
											}
											rango.Fecha_de_Fin=input.Hora_de_Fin;
											thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asingacion);
										}
						)
					}
				}

			}
			Seleccionar_Horas_seg_n_t as "Seleccionar Horas según turno"
			{
				type =  form
				form = Turno
				record event = on add or edit

				on user input of Turno
				{
					actions 
					{
						custom deluge script
						(
											if(Hora_de_Entrada == null)
										{
											if(Turno == "Mañana")
											{
												input.Hora_de_Entrada = '08:00:00';
												input.Hora_de_Salida = '16:00:00';
											}
											if(Turno == "Tarde")
											{
												input.Hora_de_Entrada = '16:00:00';
												input.Hora_de_Salida = '23:59:59';
											}
											if(Turno == "Noche")
											{
												input.Hora_de_Entrada = '00:00:00';
												input.Hora_de_Salida = '08:00:00';
											}
										}
						)
					}
				}

			}
