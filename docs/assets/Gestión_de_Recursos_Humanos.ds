			Verificar_formato_y_tama_ as "Verificar formato y tamaño de documento"
			{
				type =  form
				form = Subir_Documento
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(!(Documento.endswith(".pdf") || Documento.endswith(".jpg") || Documento.endswith(".png") || Documento.endswith(".zip")))
										{
											alert "El archivo debe estar en formato PDF, JPG, PNG o ZIP";
											cancel submit;
										}
						)
					}
				}

			}
