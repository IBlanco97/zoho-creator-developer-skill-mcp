				 void NuevoCliente.ImportarClientesUnaVez()
                 {
                 	records_ = zoho.crm.searchRecords("Accounts","ACTIVO:equals:true");
                 	lastNOrden = null;
                 	lastNOrden = Nuevo_Cliente[ID != 0].N_Orden sort by N_Orden desc;
                 	if(lastNOrden == null)
                 	{
                 		lastNOrden = 0;
                 	}
                 	for each  c in records_
                 	{
                 		existecliente = null;
                 		existecliente = Nuevo_Cliente[Nombre_de_Cuenta == c.get("Account_Name")].ID;
                 		if(existecliente == null)
                 		{
                 			Tel_fono = c.get("Phone");
                 			Nombre_de_Cuenta = c.get("Account_Name");
                 			Localizacion_country = c.get("PA_S");
                 			Localizacion_state_province = c.get("PROVINCIA");
                 			Localizacion_district_city = c.get("Billing_City");
                 			Localizacion_postal_Code = c.get("Billing_Code");
                 			Localizacion_address_line_1 = c.get("Billing_Street");
                 			Fax = c.get("Fax");
                 			lastNOrden = lastNOrden + 1;
                 			N_Orden = lastNOrden;
                 			EMAIL_GENERAL = c.get("Email");
                 			CIF = c.get("CIF");
                 			Propietario_de_Cuenta = c.get("Owner").get("name");
                 			DETALLE_LOCALIZACI_N = c.get("DETALLE_LOCALIZACI_N");
                 			Descripci_n = "Descripcion: " + c.get("Description") + "\n" + "Lineas de Negocio: " + c.get("LINEAS_NEGOCIO") + "\n" + "Proveedor: " + c.get("PROVEEDOR") + "\n" + "Tamaño de Cuenta: " + c.get("TAMA_O_CUENTA") + "\n" + "Detalle de Actividad: " + c.get("DETALLE_ACTIVIDAD") + "\n" + "Calificación: " + c.get("CALIFICACI_N");
                 			Imagen_de_Cuenta = c.get("Record_Image");
                 			Estado_Activo = c.get("ACTIVO");
                 			ID_CRM = c.get("id");
                 			try 
                 			{
                 				cliente = insert into Nuevo_Cliente
                 				[
                 					Tel_fono=Tel_fono
                 					Nombre_de_Cuenta=Nombre_de_Cuenta
                 					Localizacion.country=Localizacion_country
                 					Localizacion.state_province=Localizacion_state_province
                 					Localizacion.district_city=Localizacion_district_city
                 					Localizacion.address_line_1=Localizacion_address_line_1
                 					Localizacion.postal_Code=Localizacion_postal_Code
                 					Added_User=zoho.loginuser
                 					Fax=Fax
                 					N_Orden=N_Orden
                 					EMAIL_GENERAL=EMAIL_GENERAL
                 					CIF=CIF
                 					Propietario_de_Cuenta=Propietario_de_Cuenta
                 					DETALLE_LOCALIZACI_N=DETALLE_LOCALIZACI_N
                 					Descripci_n=Descripci_n
                 					Imagen_de_Cuenta=Imagen_de_Cuenta
                 					Estado_Activo=Estado_Activo
                 					ID_CRM=ID_CRM
                 				];
                 				info "cliente insertado: " + cliente;
                 			}
                 			catch (e)
                 			{
                 				info e;
                 				info "C: " + c.get("Account_Name");
                 				info c;
                 			}
                 		}
                 	}
                 	//}
                 }
				 void NuevoCliente.LlevarContadoresrRequisitosACero(Nuevo_Cliente cliente)
                 {
                 	cliente.ContadorPendietesSubir=0;
                 	cliente.ContadorCaducados=0;
                 	cliente.ContadorCercaCaducar=0;
                 	cliente.ContadorActualizados=0;
                 	cliente.ContadorNoEnviados=0;
                 	cliente.ContadorEnviadosNoAprobados=0;
                 	cliente.ContadorEnviadosAprobados=0;
                 	cliente.ContadorTotal=0;
                 }
