                 			lr = Nueva_Lista_de_Requisitos[ID == lrID];
                 			for each  reqID in lr.Lista_Requisitos_Documentaci_n
                 			{
                 				req = Nuevo_Requisitos_Doc[ID == reqID];
                 				//if ()
                 				//Pendiente terminar de implementar
                 				// mejor pasar a implementar getters y setters que actualicen los contadores
                 			}
                 		}
                 	}
                 }
				 list NuevoEmpleado.getClientesAll(Nuevo_Empleado empleado)
                 {
                 	clientesAll = List();
                 	clientesAll.addAll(empleado.Clientes_Habituales);
                 	clientesAll.addAll(empleado.Clientes_No_Habituales);
                 	return clientesAll;
                 }
