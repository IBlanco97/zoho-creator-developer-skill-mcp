										etiqueta = solicitud.Tipo + " - " + solicitud.Trabajador_Solicitante.Nombre;
										fecha = insert into Rango_Fechas_Asingacion
										[
											Added_User=zoho.loginuser
											Fecha_de_Comienzo1=solicitud.Fecha_de_comienzo
