			Asignar_Documento_A_Requs as "Asignar Documento A Requsito"
			{
				type =  form
				form = Subir_Documento
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  req in Nuevo_Requisitos_Doc[Plantilla == input.Plantilla]
										{
											listasAActualizar = List();
											tReq = req.Trabajador;
											eReq = req.Empresa1;
											cReq = req.Cliente1;
											tInp = input.TRABAJADOR;
											eInp = input.EMPRESA;
											//Si el requisito es de la misma empresa, trabajador, Clietne
											esRequisitoDeEmpresa = input.Plantilla.EMPRESA1 == "SI" && input.Plantilla.Trabajador1 == "NO" || input.Plantilla.Trabajador1 == null && input.Plantilla.CLIENTE == "NO" || input.Plantilla == null;
											esRequisitoDeClienteEnLaLista = input.Clientes_Seleccionados.contains(req.Cliente1) || input.CLIENTE == req.Cliente1 || input.Subir_tambi_n_a_otros_clientes == "Subir a todos los Clientes con el mismo requisito.";
											if((esRequisitoDeEmpresa && esRequisitoDeClienteEnLaLista) || (tReq == null || tReq == tInp && eReq == null || eReq == eInp && cReq == null || cReq == input.CLIENTE))
											{
												if(input.ID != req.Documento)
												{
													doc = Subir_Documento[ID == input.ID];
													docReq = Subir_Documento[ID == req.Documento];
													if(docReq != null)
													{
														if(docReq.Estado == thisapp.FuncionesEstaticas.GetEstadosRequisitos(1))
														{
															delete from Subir_Documento[ID == req.Documento];
														}
													}
													else
													{
														//Archivar el documento que estaba
														docReq.Archivado="SI";
													}
													req.Documento=doc;
													req.Caducidad_Tolerancia=thisapp.NuevoRequisitoDoc.CalcularCaducidadTolerancia(doc.Fecha_caducidad_documento,req.Plantilla.Tolerancia);
													thisapp.NuevoCliente.setCaducidadTolerancia(req.Cliente1,req.Caducidad_Tolerancia);
													input.Archivado = "NO";
													thisapp.NuevoRequisitoDoc.ActualizarEstado(req.ID);
													thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(input.TRABAJADOR,input.CLIENTE);
													nombreTrabajador = Nuevo_Empleado[ID == input.TRABAJADOR].Nombre;
													nombreCliente = Nuevo_Cliente[ID == input.CLIENTE].Nombre_de_Cuenta;
													lr = Nueva_Lista_de_Requisitos[ID == req.Lista_Requisitos_Pertenece];
													lr.Trabajador_Color=thisapp.NuevaListaDeRequisitos.TrabajadorColorDoc(nombreTrabajador,lr.Estado_Cliente);
													lr.Cliente_Color=thisapp.NuevaListaDeRequisitos.ClienteColorDoc(nombreCliente,lr.Estado_Cliente);
													listasAActualizar.add(lr.ID);
												}
											}
											thisapp.NuevaListaDeRequisitos.ActualizarEstadosListasRequisitos(listasAActualizar);
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											/*if () {
											for each req in Nuevo_Requisitos_Doc[Plantilla == input.Plantilla] {
												req.Documento = Subir_Documento[ID == input.ID];
											}
										}*/
						)
					}
				}

			}
			Calcular_fecha_de_caducid2 as "Calcular fecha de caducidad"
			{
				type =  form
				form = Subir_Documento
				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Plantilla != null && input.Fecha_caducidad_documento == null)
										{
											try 
											{
												if(input.Plantilla.TIPO_CADUCIDAD != null)
												{
													caducidad = input.Plantilla.TIPO_CADUCIDAD;
													if(caducidad.equalsIgnoreCase("Mensual"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addMonth(1);
													}
													if(caducidad.equalsIgnoreCase("Trimestral"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addMonth(3);
													}
													if(caducidad.equalsIgnoreCase("Semestral"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addMonth(6);
													}
													if(caducidad.equalsIgnoreCase("Anual"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addYear(1);
													}
													if(caducidad.equalsIgnoreCase("Bianual"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addYear(2);
													}
													if(caducidad.equalsIgnoreCase("Trianual"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addYear(3);
													}
													if(caducidad.equalsIgnoreCase("Quinquenal"))
													{
														input.Fecha_caducidad_documento = input.Fecha_validez_documento.addYear(5);
													}
												}
											}
											catch (e)
											{
												info "Error en la linea " + e.lineNo;
												// Displays line number of the statement that caused the error 
												info e.message;
												// Displays the error message 
												info e;
												// Displays both line number and error message 
											}
										}
						)
					}
				}

			}
			Campos_seg_n_plantilla as "Campos según plantilla"
			{
				type =  form
				form = Subir_Documento
				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(Plantilla != null)
										{
											if(input.Plantilla != null)
											{
												if(Plantilla.EMPRESA1 == "SI")
												{
													show EMPRESA;
													if(input.Plantilla.EMPRESA != null)
													{
														input.EMPRESA = input.Plantilla.EMPRESA;
														disable EMPRESA;
													}
												}
												else
												{
													input.EMPRESA = null;
													hide EMPRESA;
												}
												if(Plantilla.Trabajador1.equalsIgnoreCase("SI"))
												{
													show TRABAJADOR;
												}
												else if(Plantilla.Trabajador1 == null)
												{
													input.TRABAJADOR = null;
													hide TRABAJADOR;
												}
												else
												{
													input.TRABAJADOR = null;
													hide TRABAJADOR;
												}
												if(Plantilla.CLIENTE.equalsIgnoreCase("SI"))
												{
													show CLIENTE;
												}
												else
												{
													input.CLIENTE = null;
													hide CLIENTE;
												}
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											if(Plantilla != null)
										{
											if(Plantilla.Trabajador1 == "SI")
											{
												show TRABAJADOR;
											}
											else if(Plantilla.Trabajador1 == "NO")
											{
												hide TRABAJADOR;
											}
										}
						)
					}
				}

			}
			On_Delete as "On Delete"
			{
				type =  form
				form = Subir_Documento
				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											//Actualizar requisitos que cuentan con este documento
										for each  req in input.Requisitos_enlazados
										{
											thisapp.NuevoRequisitoDoc.MatchDocumentWithRequirement(req);
											thisapp.NuevoRequisitoDoc.ActualizarEstado(req.ID);
										}
						)
					}
				}

			}
			On_Delete1 as "On Delete"
			{
				type =  form
				form = Nuevo_Requisitos_Doc
				record event = on delete

				on success
				{
					actions 
					{
						custom deluge script
						(
											//Eliminar documento si no fue siquiera subido
										if(Documento.Estado == thisapp.FuncionesEstaticas.GetEstadosRequisitos(1))
										{
											idDoc = input.Documento;
											delete from Subir_Documento[ID == idDoc];
										}
										// Acutualizar documetnacion Lista requisitos
										thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(input.Trabajador,input.Cliente1);
										indiceEstado = thisapp.NuevoRequisitoDoc.getEstadoIndice(input.ID);
										thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(input.Lista_Requisitos_Pertenece,indiceEstado,false);
										indiceEstadoEnviado = thisapp.NuevoRequisitoDoc.getIndiceEviadoAprobado(input.ID);
										thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(input.Lista_Requisitos_Pertenece,indiceEstadoEnviado,false);
						)
					}
				}

			}
