			Actualizar_Documentacion_ as "Actualizar Documentacion Plantillas Empresa"
			{
				type =  form
				form = Nuevo_Cliente
				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(Lista_Documentos_Requeridos_Empresa == null)
										{
											new_n_orden = 0;
											for each  l in Nueva_Lista_de_Requisitos
											{
												if(new_n_orden < l.N_Orden)
												{
													new_n_orden = l.N_Orden;
												}
											}
											//buscando empresa
											empresa = null;
											for each  e in Empresa1
											{
												empresa = e;
											}
											new_n_orden = new_n_orden + 1;
											idLista = insert into Nueva_Lista_de_Requisitos
											[
												Added_User=zoho.loginuser
												Cliente1=input.ID
												Empresa1=empresa
												N_Orden=new_n_orden
												Es_Lista_con_empresa="SI"
											];
											input.Lista_Documentos_Requeridos_Empresa = idLista;
										}
										//creando requisitos
										//buscando cliente
										cliente = Nuevo_Cliente[ID = input.ID];
										//buscando lista de requisitos
										idLista = input.Lista_Documentos_Requeridos_Empresa.ID;
										lista_req_empresa = Nueva_Lista_de_Requisitos[ID == idLista];
										for each  p in input.Plantillas_con_Empresa
										{
											found = false;
											for each  reqID in lista_req_empresa.Lista_Requisitos_Documentaci_n
											{
												for each  req in Nuevo_Requisitos_Doc[ID == reqID]
												{
													if(req.Plantilla == p)
													{
														found = true;
													}
												}
											}
											if(!found)
											{
												id_req = thisapp.NuevoRequisitoDoc.CrearRequsitoAtomaticamente(null,null,cliente,p,p.Nombre_de_la_plantilla,p.Trabajador1,p.CLIENTE,lista_req_empresa);
												req = Nuevo_Requisitos_Doc[N_Orden == id_req];
												modeloNombre = Plantilla[ID == req.Plantilla].Nombre_de_la_plantilla;
												req.Nombre_con_Color_Estado=thisapp.NuevoRequisitoDoc.AutollenarNombreColorCaducidad(req.Estado,modeloNombre);
												req.Nombre_Color_Enviado=thisapp.NuevoRequisitoDoc.AutorrellenarNombreColorEnviado(req.Enviado,req.Aprobado_Cliente,modeloNombre);
												indiceEstadoCaducidad = thisapp.NuevoRequisitoDoc.getEstadoIndice(req.ID);
												indiceEstadoEnviadoAprobado = thisapp.NuevoRequisitoDoc.getIndiceEviadoAprobado(req.ID);
												thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lista_req_empresa.ID,indiceEstadoCaducidad,true);
												thisapp.NuevaListaDeRequisitos.ContadorRrequisitoSegunEstado(lista_req_empresa.ID,indiceEstadoEnviadoAprobado,true);
											}
										}
										lista_req_empresa.Estado=thisapp.RequisitoDoc.EstadoListaSegunRequisitos(lista_req_empresa);
										thisapp.NuevaListaDeRequisitos.EstadoDocumentacionClienteTrabajador(lista_req_empresa.Trabajador,lista_req_empresa.Cliente1);
						)
					}
				}

			}
