	pages
	{
		page Admin_Dashboard
		{
			displayname = "Admin Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\",\"design\":\"fluid\",\"displayType\":\"plain\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='Admin_Dashboard1' elementName='HTML Snippet'\n bgColor=\"\" \n>\n\t<![CDATA[htmlpage Admin_Dashboard1()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n\t\t\t\t\t\t\t\t\t  .page_content_wrapper{\n\t\t\t\t\t\t\t\t\t  background:whitesmoke;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  /*.straightbar{\n\t\t\t\t\t\t\t\t\t     display: inline-block;\n\t\t\t\t\t\t\t\t\t    height: 80px;\n\t\t\t\t\t\t\t\t\t    width: 98%;\n\t\t\t\t\t\t\t\t\t    position: relative;\n\t\t\t\t\t\t\t\t\t    box-sizing: border-box;\n\t\t\t\t\t\t\t\t\t    margin: 1% 1% 0 1%;\n\t\t\t\t\t\t\t\t\t}*/\n\t\t\t\t\t\t\t\t\t  .straightbar{\n\t\t\t\t\t\t\t\t\t      display: inline-table;\n\t\t\t\t\t\t\t\t\t    height: 80px;\n\t\t\t\t\t\t\t\t\t    width: 100%;\n\t\t\t\t\t\t\t\t\t    position: relative;\n\t\t\t\t\t\t\t\t\t    box-sizing: border-box;\n\t\t\t\t\t\t\t\t\t    padding: 10px 13px 0 13px;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .box{\n\t\t\t\t\t\t\t\t\t  background : white;\n\t\t\t\t\t\t\t\t\t  border : 1px solid #e8e8e8;\n\t\t\t\t\t\t\t\t\t  height:80px;\n\t\t\t\t\t\t\t\t\t  text-align:center;\n\t\t\t\t\t\t\t\t\t  box-sizing:border-box;\n\t\t\t\t\t\t\t\t\t  position:relative;\n\t\t\t\t\t\t\t\t\t  color : #3aa3ea;\n\t\t\t\t\t\t\t\t\t  width:18.3%;\n\t\t\t\t\t\t\t\t\t  float : left;\n\t\t\t\t\t\t\t\t\t  margin:1%\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .box:before\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  content : &quot;&quot;;\n\t\t\t\t\t\t\t\t\t  height: 45px;\n\t\t\t\t\t\t\t\t\t  width : 10px;\n\t\t\t\t\t\t\t\t\t  background : #3394d8;\n\t\t\t\t\t\t\t\t\t  position : absolute;\n\t\t\t\t\t\t\t\t\t  top : 17px;\n\t\t\t\t\t\t\t\t\t  left : -5px;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  .box_Header{\n\t\t\t\t\t\t\t\t\t   color:#a29f9f;\n\t\t\t\t\t\t\t\t\t   height: 35px;\n\t\t\t\t\t\t\t\t\t   line-height: 20px;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .box_count{\n\t\t\t\t\t\t\t\t\t\tbox-sizing: border-box;\n\t\t\t\t\t\t\t\t\t    height: 45px;\n\t\t\t\t\t\t\t\t\t    width: 100%;\n\t\t\t\t\t\t\t\t\t    display: inline-block;\n\t\t\t\t\t\t\t\t\t    line-height: 62px;\n\t\t\t\t\t\t\t\t\t    font-size: 30px;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  .view-header&gt;.row .view-name-wrapper{\n\t\t\t\t\t\t\t\t\t  max-width:100% !important;\n\t\t\t\t\t\t\t\t\t  display:table;}\n\t\t\t\t\t\t\t\t\t  .view-header\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  background : #f5f6f6;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .view-header&gt;.row h3\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  color : #666;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .JoineeReport\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  //height: 380px;\n\t\t\t\t\t\t\t\t\t  border:1px solid #ececec;\n\t\t\t\t\t\t\t\t\t  box-sizing:border-box;\n\t\t\t\t\t\t\t\t\t  background : white;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .JoineeReport  #zohoreportel\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  height:300px !important;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .LocationReport\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  //height: 380px;\n\t\t\t\t\t\t\t\t\t  border:1px solid #ececec;\n\t\t\t\t\t\t\t\t\t  box-sizing:border-box;\n\t\t\t\t\t\t\t\t\t  background : white;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .LocationReport  #zohoreportel\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  height:300px !important;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .DepartmentReport\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  //height: 350px;\n\t\t\t\t\t\t\t\t\t  box-sizing:border-box;\n\t\t\t\t\t\t\t\t\t  border:1px solid #ececec;\n\t\t\t\t\t\t\t\t\t  background : white;\n\t\t\t\t\t\t\t\t\t  height: 100% !important;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .DepartmentReport  #zohoreportel\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  height:280px !important;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  div#ChartToolbar {\n\t\t\t\t\t\t\t\t\t    color: #555;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t.container-fluid\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  background : transparent;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  .reportheader\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t  padding: 12px;background: rgb(250, 250, 250);box-sizing: border-box;border: 1px solid #ececec;border-bottom: none;font-size: 18px;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t  &lt;/style&gt;\n&lt;%\n\tif(zoho.loginuserid == zoho.adminuserid)\n\t{\n\t\tif(Add_Your_Organisation[ID != 0].count() = 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Your_Organisation?zc_NextUrl=#Form:Add_Weekdays&quot;,&quot;Same Window&quot;);\n\t\t}\n\t\telse if(Add_Weekdays[ID != 0].count() == 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Weekdays&quot;,&quot;Same Window&quot;);\n\t\t}\n\t\telse if(Nuevo_Empleado[Official_Email == zoho.adminuserid].count() == 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Employee&quot;,&quot;Same Window&quot;);\n\t\t}\n\t}\n\trequirementCount = Raise_Your_Requirement[No_of_Vacancy &gt; 0].sum(No_of_Vacancy);\n\tapplicantCount = Job_Application[Status == &quot;Applied&quot; || Status == &quot;Interview Scheduled&quot;].count();\n\tselectedCount = Job_Application[Status == &quot;Selected&quot;].count();\n\tonboardingCount = Add_Candidate_Details[Status == &quot;Offer Letter Accepted&quot;].count();\n\temployeeCount = Nuevo_Empleado[Estado_del_Empleado == &quot;Active&quot;].count();\n\t%&gt;\n&lt;div class=&quot;container-fluid&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div class=&quot;row&quot;&gt;\n\t\t\t\t\t\t\t\t\t  \t&lt;div class=&quot;straightbar&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t    &lt;a href=&quot;#Report:Open_Requirements&quot; target=&quot;_blank&quot;&gt;&lt;div class=&quot;box&quot; style=&quot;margin-left:0.3%;&quot;&gt;  &lt;div class=&quot;box_count&quot;&gt; &lt;%=requirementCount%&gt; &lt;/div&gt;&lt;! end of box_count--&gt; &lt;div class=&quot;box_Header&quot;&gt; Requirements &lt;/div&gt; &lt;!end of box text--&gt;&lt;/div&gt; &lt;! end of first box--&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t  \t\t&lt;a href=&quot;#Report:Applied_Candidates&quot; target=&quot;_blank&quot; &gt;&lt;div class=&quot;box&quot;&gt;&lt;div class=&quot;box_count&quot;&gt;  &lt;%=applicantCount%&gt; &lt;/div&gt;&lt;! end of box_count--&gt;&lt;div class=&quot;box_Header&quot;&gt; Applicants &lt;/div&gt; &lt;!end of box text--&gt;&lt;/div&gt; &lt;! end of second box--&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t  \t\t&lt;a href=&quot;#Report:Selected_Candidates&quot; target=&quot;_blank&quot; &gt;&lt;div class=&quot;box&quot;&gt; &lt;div class=&quot;box_count&quot;&gt;  &lt;%=selectedCount%&gt; &lt;/div&gt;&lt;! end of box_count--&gt;&lt;div class=&quot;box_Header&quot;&gt; Selected &lt;/div&gt; &lt;!end of box text--&gt;&lt;/div&gt; &lt;! end of third box--&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t  \t\t&lt;a href=&quot;#Report:Accepted_Offers?Status=Offer Letter Accepted&quot; target=&quot;_blank&quot; &gt;&lt;div class=&quot;box&quot;&gt;&lt;div class=&quot;box_count&quot;&gt;  &lt;%=onboardingCount%&gt; &lt;/div&gt;&lt;! end of box_count--&gt;&lt;div class=&quot;box_Header&quot;&gt; On Boarding &lt;/div&gt; &lt;!end of box text--&gt;&lt;/div&gt; &lt;! end of fourth box--&gt;&lt;/a&gt;\n\t\t\t\t\t\t\t\t\t   \t\t&lt;a href=&quot;#Report:Employee_Details?Status=Active&quot; target=&quot;_blank&quot; &gt;&lt;div class=&quot;box&quot; style=&quot;margin-right:0px;&quot;&gt; &lt;div class=&quot;box_count&quot;&gt;  &lt;%=employeeCount%&gt; &lt;/div&gt;&lt;! end of box_count--&gt;&lt;div class=&quot;box_Header&quot;&gt; Employee &lt;/div&gt; &lt;!end of box text--&gt;&lt;/div&gt; &lt;! end of fifth box--&gt; &lt;/a&gt;\n\t\t\t\t\t\t\t\t\t  \t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;&lt;!end of row--&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div class=&quot;row&quot; &gt;\n\t\t\t\t\t\t\t\t\t  \t\t&lt;div class=&quot;col-md-12&quot; style=&quot;margin: 0.5% 0 0.8% 0;&quot;&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;reportheader&quot;&gt;Employees by Department&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;DepartmentReport&quot; elName=&apos;zc-component&apos; reportLinkName=&apos;Employees_by_Department&apos; params=&apos;zc_Header=false&apos;&gt;&lt;/div&gt;  \n\t\t\t\t\t\t\t\t\t        &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;&lt;!end of row--&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div class=&quot;row&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div class=&quot;col-md-8&quot;  style=&quot;margin:0 0 1% 0;padding-right:0.7%;&quot;&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;reportheader&quot;&gt;Monthly Joinees and Resignees&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;JoineeReport&quot; elName=&apos;zc-component&apos; reportLinkName=&apos;Monthly_Joinees_and_Resignees&apos; params=&apos;zc_Header=false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t        &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  \t\t&lt;div class=&quot;col-md-4&quot; style=&quot;margin:0 0 1% 0;padding-left: 1px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;reportheader&quot;&gt;Employees by Location&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t         &lt;div class=&quot;LocationReport&quot; elName=&apos;zc-component&apos; reportLinkName=&apos;Employees_by_Location&apos; params=&apos;zc_Header=false&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t        &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;&lt;!end of row--&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;&lt;! end of container fluid div--&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Profile_Page
		{
			displayname = "Profile Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\",\"design\":\"fluid\",\"displayType\":\"plain\"}}'\n\t\t\n\t\t\tmobileDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n\t\t\n\t\t\ttabletDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\temp = Nuevo_Empleado[Official_Email == zoho.loginuserid];\n\tif(emp.count() == 0)\n\t{\n\t\t%&gt;\n&lt;div style=&quot;font-size:20px;text-align:center;&quot;&gt;You are not a registered Employee!&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;iframe name=&apos;profile_frame&apos; height=&apos;500px&apos; width=&apos;100%&apos; zc_mobileView=&apos;inline&apos; style=&quot;border:none;&quot;src=&apos;https://app.zohocreator.com&lt;%=zoho.appuri%&gt;record-summary/Employee_Details/&lt;%=emp.ID%&gt;&apos; &gt;&lt;/iframe&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml    \n\t\t\tisPdfEnabled='true'\n\t\t\n\t\t\tisPrintEnabled='true'\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"transparent\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\tif(zoho.loginuserid == zoho.adminuserid)\n\t{\n\t\tif(Add_Your_Organisation[ID != 0].count() = 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Your_Organisation?zc_NextUrl=#Form:Add_Weekdays&quot;,&quot;Same Window&quot;);\n\t\t}\n\t\telse if(Add_Weekdays[ID != 0].count() == 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Weekdays&quot;,&quot;Same Window&quot;);\n\t\t}\n\t\telse if(Nuevo_Empleado[Official_Email == zoho.adminuserid].count() == 0)\n\t\t{\n\t\t\topenUrl(&quot;#Form:Add_Employee&quot;,&quot;Same Window&quot;);\n\t\t}\n\t}\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '8%'\n\tpaddingLeft = '0%'\n\tpaddingRight = '26px'\n\tpaddingBottom = '8%'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '3%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='100%'\n>\n\t<pc \n\t\tbgColor = '#3AA3EA'\n\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '|||'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '20px'\n\tpaddingRight = '20px'\n\tpaddingBottom = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Open_Requirements'\n\t\ttarget = 'new-window'\n\t\twidth = '97%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '33px'\n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t  value = 'thisapp.Raise_Your_Requirement.No_of_Vacancy.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#A29F9F'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Requirements'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '8%'\n\tpaddingLeft = '0px'\n\tpaddingRight = '3%'\n\tpaddingBottom = '8%'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '3%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='100%'\n>\n\t<pc \n\t\tbgColor = '#3AA3EA'\n\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '|||'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '20px'\n\tpaddingBottom = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Applied_Candidates'\n\t\ttarget = 'new-window'\n\t\twidth = '97%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '33px'\n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Status == &quot;Applied&quot; || Status == &quot;Interview Scheduled&quot;'\n\t  value = 'thisapp.Job_Application.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#A29F9F'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Applicants'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '8%'\n\tpaddingLeft = '0px'\n\tpaddingRight = '3%'\n\tpaddingBottom = '8%'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '3%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='100%'\n>\n\t<pc \n\t\tbgColor = '#3AA3EA'\n\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '|||'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '20px'\n\tpaddingBottom = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '97%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '33px'\n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Status == &quot;Selected&quot;'\n\t  value = 'thisapp.Job_Application.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#A29F9F'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Selected'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '8%'\n\tpaddingLeft = '0px'\n\tpaddingRight = '3%'\n\tpaddingBottom = '8%'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '3%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='100%'\n>\n\t<pc \n\t\tbgColor = '#3AA3EA'\n\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '|||'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '20px'\n\tpaddingBottom = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Accepted_Offers'\n\t\ttarget = 'new-window'\n\t\twidth = '97%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '33px'\n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Status == &quot;Offer Letter Accepted&quot;'\n\t  value = 'thisapp.Add_Candidate_Details.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#A29F9F'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'On Boarding'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='20%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '8%'\n\tpaddingLeft = '0px'\n\tpaddingRight = '3%'\n\tpaddingBottom = '8%'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '3%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='100%'\n>\n\t<pc \n\t\tbgColor = '#3AA3EA'\n\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '|||'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '20px'\n\tpaddingLeft = '0px'\n\tpaddingRight = '20px'\n\tpaddingBottom = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '97%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#3AA3EA'\n\tsize = '33px'\n\ttype = 'Form Data'\n\n\n\n\tdisplayType = 'actual'\n\n\n\n\n\t\tcriteria = 'Estado_del_Empleado == &quot;Active&quot; || Estado_del_Empleado == &quot;Leave Of Absence&quot;'\n\t  value = 'thisapp.Nuevo_Empleado.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#A29F9F'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Employees'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\n\ttitle = 'Monthly Joinees  and Resignees'\n\t\n\t\ttitleColor = '#444444'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Monthly_Joinees_and_Resignees'\n\t\n\t\tiszreport = 'true'\n\theightType = 'custom'\n\theightValue = '450'\n\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page SearchPage(searchKey, type)
		{
			displayname = "SearchPage"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\",\"design\":\"fluid\",\"displayType\":\"plain\"}}'\n\t\t\n\t\t\tmobileDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n\t\t\n\t\t\ttabletDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n>\n\t<layout>\n\t\n</layout>\n</zml>"
		}
		page Offer_Letter(RecID)
		{
			displayname = "Offer Letter"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\",\"design\":\"fluid\",\"displayType\":\"plain\"}}'\n\t\t\n\t\t\tmobileDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n\t\t\n\t\t\ttabletDeviceConfig='{\"layout\":{\"design\":\"onebyone\",\"displayType\":\"plain\",\"forcedOrientation\":false}}'\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='Offer_Letter1' elementName='HTML Snippet'\n bgColor=\"\" \n>\n\t<![CDATA[htmlpage Offer_Letter1()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  .OfferPage\n\t\t\t\t\t\t\t\t\t  {\n\t\t\t\t\t\t\t\t\t    padding: 30px;\n\t\t\t\t\t\t\t\t\t    border: 1px solid #eee;\n\t\t\t\t\t\t\t\t\t    background-color:white;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t    font-family: &apos;Helvetica Neue&apos;, &apos;Helvetica&apos;, Helvetica, Arial, sans-serif;\n\t\t\t\t\t\t\t\t\t    color: #555;\n\t\t\t\t\t\t\t\t\t  }\n\t\t\t\t\t\t\t\t\t  &lt;/style&gt;\n&lt;%\n\trecord = Add_Candidate_Details[ID == input.RecID.toLong()];\n\tofferIssuedDate = record.Added_Time.toDate();\n\t%&gt;\n&lt;div style=&quot;margin-top:10px;margin-bottom:40px;width:100%&quot;&gt;\n\t\t\t\t\t\t\t\t\t    &lt;div class=&quot;OfferPage&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div style=&quot;width:100%;height:200px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div style=&quot;margin-top: 25px;width:70%;float:left;&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;p style=&quot;margin: 0 0 5px 0; text-align: justify;font-size:15px;text&quot;&gt;To&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  &lt;p style=&quot;margin: 0px;padding-left: 20px;line-height: 20px;font-size: 16px;text-align: left;font-weight: bold;&quot;&gt;&lt;%=record.Reference_No.Name%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t  &lt;p style=&quot;margin: 0px;width:30%;padding-left: 20px;line-height: 20px;font-size: 15px;text-align: left;&quot;&gt;&lt;%=record.Reference_No.Present_Address1%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/p&gt;\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div style=&quot;width:30%;float:right;margin-top: 20px;text-align: right;&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;p style=&quot;margin: 0px;&quot;&gt;&lt;strong&gt;Ref No : &lt;%=record.Reference_No.Reference_No%&gt;&lt;/strong&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t  &lt;p style=&quot;margin: 0px;&quot;&gt;&lt;strong&gt;Date: &lt;%=offerIssuedDate%&gt;&lt;/strong&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  &lt;div style=&quot;font-size:15px;&quot;&gt;  \n\t\t\t\t\t\t\t\t\t  Dear &lt;%=record.Reference_No.Name.first_name%&gt;,&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;br&gt;\n\t\t\t\t\t\t\t\t\tWe\u2019re delighted to extend this offer of employment for the position of &lt;strong&gt;&lt;%=record.Designation.Designation%&gt;&lt;/strong&gt; with our organization. Please review this summary of terms and conditions for your anticipated employment with us.&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tIf you accept this offer, your start date will be &lt;strong&gt;&lt;%=record.Date_of_Joining%&gt;&lt;/strong&gt; or another mutually agreed upon date.&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;br&gt;\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Terms and Conditions&lt;/strong&gt;&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  &lt;strong style=&quot;font-size:16px;&quot;&gt;Position&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  Your title will be &lt;%=record.Designation.Designation%&gt;. While you are employed at this Company, you will not engage in any other employment, consulting or other business activity (whether full-time or part-time) that would create a conflict of interest with the Company.  By signing this letter of agreement, you confirm that you have no contractual commitments or other legal obligations that would prohibit you from performing your duties for the Company.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot; &gt;Cash Compensation&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  The Company will pay you a starting salary at the rate of &lt;strong&gt;Rs.&lt;%=record.CTC.CTC%&gt;&lt;/strong&gt; per annum, payable in accordance with the Company\u2019s standard payroll schedule. This salary will be subject to adjustment pursuant to the Company\u2019s employee compensation policies in effect from time to time.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Bonus (or Commission) potential&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  In addition, you will be eligible to be considered for an incentive bonus for each fiscal year of the Company. The bonus (if any) will be awarded based on objective or subjective criteria established by the Company\u2019s Chief Executive Officer and approved by the Company\u2019s Board of Directors.  Your target bonus will be equal to 20% of your annual base salary.  Any bonus for the fiscal year in which your employment begins will be prorated, based on the number of days you are employed by the Company during that fiscal year.  Any bonus for a fiscal year will be paid within 2 months after the close of that fiscal year, but only if you are still employed by the Company at the time of payment.  The determinations of the Company\u2019s Board of Directors with respect to your bonus will be final and binding.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Employee Benefits&lt;/strong&gt;&lt;br&gt;  As a regular employee of the Company, you will be eligible to participate in a number of Company-sponsored benefits.  In addition, you will be entitled to paid vacation in accordance with the Company\u2019s vacation policy.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t &lt;/div&gt;  \n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t    &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;div class=&quot;OfferPage&quot; style=&quot;margin-top:100px&quot;&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t  &lt;div style=&quot;font-size:15px;padding-top:30px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t  &lt;strong style=&quot;font-size:16px;&quot;&gt;Employment Relationship&lt;/strong&gt;&lt;br&gt;  Employment with the Company is for no specific period of time.  Your employment with the Company will be \u201Cat will,\u201D meaning that either you or the Company may terminate your employment at any time and for any reason, with or without cause.  Any contrary representations that may have been made to you are superseded by this letter agreement.  This is the full and complete agreement between you and the Company on this term.  Although your job duties, title, compensation and benefits, as well as the Company\u2019s personnel policies and procedures, may change from time to time, the \u201Cat will\u201D nature of your employment may only be changed in an express written agreement signed by you and a duly authorized officer of the Company (other than you).&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;strong style=&quot;font-size:16px;&quot;&gt;Termination&lt;/strong&gt;&lt;br&gt; The Company reserves the right to terminate employment of any employee for just cause at any time without notice and without payment in lieu of notice.  The Company will be entitled to terminate your employment for any reason other than for just cause, upon providing to you such minimum notice as required by law.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Proprietary Information and Inventions Agreement&lt;/strong&gt;&lt;br&gt;   Like all Company employees, you will be required, as a condition of your employment with the Company, to sign the Company\u2019s standard Proprietary Information and Inventions Agreement.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Privacy&lt;/strong&gt;&lt;br&gt;  You are required to observe and uphold all of the Company\u2019s privacy policies and procedures as implemented or varied from time to time. Collection, storage, access to and dissemination of employee personal information will be in accordance with privacy legislation.&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\tYou may indicate your agreement with these terms and accept this offer by signing and dating this agreement on or before &lt;%=record.Offer_Expires_On%&gt;. Upon your acceptance of this employment offer, Company will provide you with the necessary paperwork and instructions.&lt;br&gt;&lt;br&gt; \n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tSincerely,&lt;br&gt;\n\t\t\t\t\t\t\t\t\tHR Team&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;br&gt;\n\t\t\t\t\t\t\t\t\t&lt;strong style=&quot;font-size:16px;&quot;&gt;Signatures:&lt;/strong&gt;&lt;br&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t &lt;div style=&quot;display: inline-block;width: 100%;&quot;&gt; &lt;div style=&quot;width:50%;float:left;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Company Representative (Sign)&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Company Representative (Print)&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Date&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t &lt;div style=&quot;width:50%;float:left;&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Applicant (Sign)&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Applicant (Print)&lt;br&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t_________________________________\n\t\t\t\t\t\t\t\t\t&lt;br&gt;Date&lt;br&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t    &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t  \n\t\t\t\t\t\t\t\t\t    &lt;/div&gt;\n\t\t\t\t\t\t\t\t\t  &lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
