			On_Send_Enviar_correo as "On Send Enviar correo"
			{
				type =  form
				form = Env_o_de_documentaci_n
				record event = on add

				on success
				{
					actions  (Programar_Env_o != "SI" || Programar_Env_o is null && Fecha_y_hora is not null)
					{
						custom deluge script
						(
											if(Forma_de_env_o.Forma_de_env_o1 == "Mail")
										{
											docs = List();
											for each  req_id in input.Documentos_req
											{
												req = Nuevo_Requisitos_Doc[ID == req_id];
												doc = Subir_Documento[ID == req.Documento];
												docs.add(doc.Documento);
											}
											message_content = input.Mensaje;
											iterar = List("1,2,3");
											for each  i in iterar
											{
												try 
												{
													sendmail
													[
														from :zoho.adminuserid
														to :input.Email
														subject :"Documentos Domo21"
														message :message_content
														Attachments :file:docs
													]
													break;
												}
												catch (e)
												{
													info e.lineNo;
													// Displays line number of the statement that caused the error 
													info e.message;
													// Displays the error message 
													info e;
													// Displays both line number and error message
												}
											}
										}
										for each  req_id in input.Documentos_req
										{
											thisapp.NuevoRequisitoDoc.SetEstado(req_id,7);
											req.Nombre_Color_Enviado=thisapp.NuevoRequisitoDoc.AutorrellenarNombreColorEnviado(req.Enviado,req.Aprobado_Cliente,req.Plantilla.Nombre_de_la_plantilla);
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
			Llenar_cuando_se_especifi as "Llenar cuando se especifique el cliente"
			{
				type =  form
				form = Env_o_de_documentaci_n
				record event = on add

				on user input of Cliente
				{
					actions 
					{
						custom deluge script
						(
											//buscando documentos para enviar
										requisitos_ = List();
										listas_req = List();
										cliente = Nuevo_Cliente[ID == input.Cliente];
										for each  listaRequisitos_id in cliente.Lista_de_Requisitos
										{
											listaRequisitos = Nueva_Lista_de_Requisitos[ID == listaRequisitos_id];
											nombreContraparte = "";
											if(listaRequisitos_id != cliente.Lista_Documentos_Requeridos_Empresa)
											{
												nombreContraparte = "" + Nuevo_Empleado[ID == listaRequisitos.Trabajador].Nombre;
											}
											else
											{
												nombreContraparte = "" + Empresa1[ID == listaRequisitos.Empresa1].Nombre;
											}
											listaRequisitos.Nombre_Contraparte=nombreContraparte;
											for each  requisito_id in listaRequisitos.Lista_Requisitos_Documentaci_n
											{
												requisito = Nuevo_Requisitos_Doc[ID == requisito_id];
												estado_index = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(thisapp.NuevoRequisitoDoc.GetEstado(requisito.ID));
												if(requisito.Enviado == null || requisito.Enviado == "NO" && estado_index > 3)
												{
													requisitos_.add(requisito);
												}
											}
										}
										input.Documentos_req = requisitos_;
										input.Trabajadores = input.Cliente.Lista_de_Requisitos;
										//obteniendo forma de envio de cliente
						)
					}
				}

			}
