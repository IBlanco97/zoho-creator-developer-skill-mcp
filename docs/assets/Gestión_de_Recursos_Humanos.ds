			Asignar_Cliente_a_Trabaja1 as "Asignar Cliente a Trabajador"
			{
				type =  form
				form = Importaci_n_Empleado_Recruit
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											for each  cliente in input.Clientes
										{
											found = false;
											for each  req_list in cliente.Lista_de_Requisitos
											{
												if(req_list.Trabajador == input.ID)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												cliente_arg = null;
												for each  c in Nuevo_Cliente[ID == cliente]
												{
													cliente_arg = c;
												}
												thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitos(input.ID,input.Nombre,cliente_arg);
											}
										}
						)
					}
				}

			}
