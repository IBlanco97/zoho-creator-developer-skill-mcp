                 }
				 string SubirDocumento.getEnlace(string linkType)
                 {
                 	enlaceForm = "Subir_Documento";
                 	enlaceReport = "Otros_Documentos";
                 	if(linkType == "Form")
                 	{
                 		return enlaceForm;
                 	}
                 	else
                 	{
                 		return enlaceReport;
                 	}
                 }
				 void SubirDocumento.NombrarUnDocumento(Subir_Documento doc)
                 {
                 	empresa = Empresa1[ID != 0];
                 	numeroempresa = thisapp.FuncionesEstaticas.NumeroACadenaCerosIzq(empresa.N_Orden,3);
                 	nombreempresa = empresa.Nombre;
                 	trabajador = Nuevo_Empleado[ID == doc.TRABAJADOR];
                 	lineatrabajador = "";
                 	if(trabajador != null)
                 	{
                 		numeroempleado = thisapp.FuncionesEstaticas.NumeroACadenaCerosIzq(trabajador.N_Orden,4);
                 		apellidoempleado = trabajador.Nombre.last_name;
                 		nombreempleado = trabajador.Nombre.first_name;
                 		lineatrabajador = numeroempleado + "_" + apellidoempleado + " " + nombreempleado;
                 	}
                 	cliente = Nuevo_Cliente[ID == doc.CLIENTE];
                 	lineacliente = "";
                 	if(cliente != null)
                 	{
                 		numerocliente = thisapp.FuncionesEstaticas.NumeroACadenaCerosIzq(cliente.N_Orden,4);
                 		nombrecliente = cliente.Nombre_de_Cuenta;
                 		lineacliente = numerocliente + "_" + nombrecliente;
                 	}
                 	plantilla = Plantilla[ID == doc.Plantilla];
                 	nombreplantilla = plantilla.Nombre_de_la_plantilla;
                 	numerodoc = thisapp.FuncionesEstaticas.NumeroACadenaCerosIzq(doc.Numero_Documento,7);
                 	nombrefinal = "" + numeroempresa + "_" + nombreempresa;
                 	if(doc.CLIENTE != null)
                 	{
                 		nombrefinal = nombrefinal + "_" + lineacliente;
                 	}
                 	if(doc.TRABAJADOR != null)
                 	{
                 		nombrefinal = nombrefinal + "_" + lineatrabajador;
                 	}
                 	nombrefinal = nombrefinal + "_" + numerodoc + "_" + nombreplantilla;
                 	doc.Nombre_Documento=nombrefinal;
                 }
				 void SubirDocumento.NotificarCaducidadDocumento(Subir_Documento documento)
                 {
                 	conf = Configuraci_n_General[ID != 0];
                 	tittle = "Notificación sobre Caducidad de Documento";
                 	mensaje = "El documento " + documento.Nombre_Documento + " ha pasado a estado " + documento.Estado + ". Fecha de caducidad: " + documento.Fecha_caducidad_documento + ". Fecha de validez: " + documento.Fecha_validez_documento + ".";
                 	personalANotificar = conf.Personal_a_Notificar_Caducidad_de_Documentos;
                 	reporteRedireccion = thisapp.SubirDocumento.getEnlace("Report");
                 	idRegistroRedireccion = documento.ID;
                 	sendWhatsApp = conf.V_as_de_Notificaci_n_Caducidad_de_Documentos.contains("WhatsApp");
                 	sendEmail = conf.V_as_de_Notificaci_n_Caducidad_de_Documentos.contains("Correo Electrónico");
                 	thisapp.FuncionesEstaticas.Notificacion(tittle,mensaje,personalANotificar,reporteRedireccion,idRegistroRedireccion,sendWhatsApp,sendEmail);
                 }
				 void SubirDocumento.RenombrarDocumentosEstandarAdecuado(int inicio, int fin)
                 {
                 	for each  doc in Subir_Documento[ID != 0 && Numero_Documento >= inicio && Numero_Documento <= fin]
                 	{
                 		thisapp.SubirDocumento.NombrarUnDocumento(doc);
                 	}
                 }
				 void SubirDocumento.RestablecerNumeroOrdenDOcumentos()
                 {
                 	n = 1;
                 	for each  docuemnto in Subir_Documento[ID != 0] sort by Numero_Documento asc
                 	{
                 		docuemnto.Numero_Documento=n;
                 		n = n + 1;
                 	}
                 }
				 void SubirDocumento.SetEstado(Subir_Documento doc, int indiceEstado)
                 {
                 	if(indiceEstado > 0 && indiceEstado < 5)
                 	{
                 		doc.Estado=thisapp.FuncionesEstaticas.GetEstadosRequisitos(indiceEstado);
                 		if(indiceEstado <= 3)
                 		{
                 			color = "red";
                 		}
                 		else if(indiceEstado == 4)
                 		{
                 			color = "orange";
                 		}
                 		else if(indiceEstado == 5)
                 		{
                 			color = "green";
                 		}
                 	}
                 }
				 string Time.GetDifference(date startDate, date endDate)
                 {
                 	millihrs = (endDate - startDate);
                 	if(millihrs <= 0)
                 	{
                 		timeVal = "00:00";
                 	}
                 	else
                 	{
                 		hrsVal = ((millihrs % 86400000) / 3600000).toLong();
                 		minsVal = ((millihrs % 86400000 % 3600000) / 60000).toLong();
                 		secsVal = ((millihrs % 86400000 % 3600000 % 60000) / 1000).toLong();
                 		timeVal = thisapp.Time.GetStringTime(hrsVal,minsVal,secsVal);
                 	}
                 	return timeVal;
                 }
				 string Time.GetStringTime(int hrsVal, int minsVal, int secsVal)
                 {
                 	strhrs = hrsVal.toString();
                 	strmins = minsVal.toString();
                 	strsecs = secsVal.toString();
                 	if(input.hrsVal < 10)
                 	{
                 		strhrs = "0" + hrsVal;
                 	}
                 	if(input.minsVal < 10)
                 	{
                 		strmins = "0" + minsVal;
                 	}
                 	if(input.secsVal < 10)
                 	{
                 		strsecs = "0" + secsVal;
                 	}
                 	return strhrs + ":" + strmins + ":" + strsecs;
                 }
				 date TimeCalc.AddHoursToDate(date logDate, string hrs)
                 {
                 	hrsVal = hrs.getPrefix(":").toLong();
                 	minsVal = hrs.getSuffix(":").toLong();
                 	return logDate.toTime().addHour(hrsVal).addMinutes(minsVal);
                 }
				 void TimeCalc.autoStopTimer(int recID)
                 {
                 	logRecords = Add_Time_Logs[ID = input.recID];
                 	hrsVal = logRecords.Timer_Stop_At.getHour();
                 	minsVal = logRecords.Timer_Stop_At.getMinutes();
                 	logRecords.End_Time=thisapp.TimeCalc.GetStringTime(hrsVal,minsVal);
                 	logRecords.Hours=thisapp.TimeCalc.HoursCalculation(logRecords.Start_Time,logRecords.End_Time,logRecords.Log_Date);
                 	logRecords.Status="Tracked";
                 }
				 string TimeCalc.GetDifference(date startDate, date endDate)
                 {
                 	millihrs = (endDate - startDate);
                 	if(millihrs <= 0)
                 	{
                 		timeVal = "00:00";
                 	}
                 	else
                 	{
                 		hrsVal = ((millihrs % 86400000) / 3600000).toLong();
                 		minsVal = ((millihrs % 86400000 % 3600000) / 60000).toLong();
                 		timeVal = thisapp.TimeCalc.GetStringTime(hrsVal,minsVal);
                 	}
                 	return timeVal;
                 }
				 string TimeCalc.GetStringTime(int hrsVal, int minsVal)
                 {
                 	strhrs = hrsVal.toString();
                 	strmins = minsVal.toString();
                 	if(input.hrsVal < 10)
                 	{
                 		strhrs = "0" + hrsVal;
                 	}
                 	if(input.minsVal < 10)
                 	{
                 		strmins = "0" + minsVal;
                 	}
                 	return strhrs + ":" + strmins;
                 }
				 string TimeCalc.HoursCalculation(string startTime, string endTime, date dateVal)
                 {
                 	startDate = thisapp.TimeCalc.AddHoursToDate(dateVal,startTime);
                 	endDate = thisapp.TimeCalc.AddHoursToDate(dateVal,endTime);
                 	timeVal = thisapp.TimeCalc.GetDifference(startDate,endDate);
                 	return timeVal;
                 }
				 bool TimeCalc.TimeVal(string timeVal)
                 {
                 	hrsVal = timeVal.getPrefix(":");
                 	minsVal = timeVal.getSuffix(":");
                 	if(isNumber(hrsVal) && isNumber(minsVal))
                 	{
                 		hrsValInt = hrsVal.toLong();
                 		minsValInt = minsVal.toLong();
                 		if(hrsValInt < 24 && minsValInt < 60)
                 		{
                 			return true;
                 		}
                 		else
                 		{
                 			return false;
                 		}
                 	}
                 	else
                 	{
                 		return false;
                 	}
                 }
				 bool TimeCalc.TimeValidation(string timeVal)
                 {
                 	hrsVal = timeVal.getPrefix(":");
                 	minsVal = timeVal.getSuffix(":");
                 	if(isNumber(hrsVal) && isNumber(minsVal))
                 	{
                 		hrsValInt = hrsVal.toLong();
                 		minsValInt = minsVal.toLong();
                 		if(hrsValInt <= 24 && minsValInt < 60)
                 		{
                 			return true;
                 		}
                 		else
                 		{
                 			return false;
                 		}
                 	}
                 	else
                 	{
                 		return false;
                 	}
                 }
				 date TimeCalc.TotalHours(date logDate, list:string logHoursList)
                 {
                 	totalHrs = logDate;
                 	for each  eachLogDateRec in logHoursList
                 	{
                 		totalHrs = thisapp.TimeCalc.AddHoursToDate(totalHrs,eachLogDateRec);
                 	}
                 	return totalHrs;
                 }
				 void TrabajadorExcel.AsociarClienteATrabajador()
                 {
                 	for each  txcel in TrabajadorExcel[DNI_NIE_Pasap != null && DNI_NIE_Pasap != ""]
                 	{
                 		trab = Nuevo_Empleado[DNI == txcel.DNI_NIE_Pasap];
                 		cliente = Nuevo_Cliente[Nombre_de_Cuenta.contains(txcel.Centro_Trabajo)];
                 		if(cliente.ID != null)
                 		{
                 			info "t: " + trab.Nombre + ", c: " + cliente.Nombre_de_Cuenta;
                 			trab.Clientes_Habituales=cliente.ID;
                 		}
                 	}
                 }
				 void TrabajadorExcel.PasarTrabajadoresImportadosExcel()
                 {
                 	//Este script elimina todos los registros de Nuevo Empleado cuyo DNI no coincida con los trabajadores del formulario TrabajadorExcel, he inserta los que faltan en Nuevo EMpleado y que estan en TrabajadorExcel
                 	for each  trab in Nuevo_Empleado[ID != 0]
                 	{
                 		found = false;
                 		for each  trab_excel in TrabajadorExcel[DNI_NIE_Pasap == trab.DNI]
                 		{
                 			found = true;
                 			trab.C_digo_de_Operario=trab_excel.C_digo_Operario;
                 			if(trab_excel.Fecha_de_Nacimiento != "" && trab_excel.Fecha_de_Nacimiento != null && isDate(trab_excel.Fecha_de_Nacimiento))
                 			{
                 				trab.Fecha_de_Nacimiento=trab_excel.Fecha_de_Nacimiento;
                 			}
                 			if(trab_excel.Antiguedad != "" && trab_excel.Antiguedad != null && isDate(trab_excel.Antiguedad))
                 			{
                 				trab.Fecha_de_Alta=trab_excel.Antiguedad;
                 			}
                 		}
                 		if(!found)
                 		{
                 			if(trab.Nombre.first_name != "Inti")
                 			{
                 				delete from Nuevo_Empleado[ID == trab.ID];
                 			}
                 		}
                 	}
                 	index_ = 0;
                 	for each  trab_excel in TrabajadorExcel[ID != 0]
                 	{
                 		index_ = index_ + 1;
                 		found = false;
                 		for each  trab in Nuevo_Empleado[DNI == trab_excel.DNI_NIE_Pasap]
                 		{
                 			found = true;
                 		}
                 		// Insertando trabajadores del excel que no están aún en el sistema
                 		if(!found)
                 		{
                 			fecha_nacimiento = null;
                 			if(trab_excel.Fecha_de_Nacimiento != "" && trab_excel.Fecha_de_Nacimiento != null && isDate(trab_excel.Fecha_de_Nacimiento))
                 			{
                 				fecha_nacimiento = trab_excel.Fecha_de_Nacimiento;
                 			}
                 			fecha_alta = null;
                 			if(trab_excel.Antiguedad != "" && trab_excel.Antiguedad != null && isDate(trab_excel.Antiguedad))
                 			{
                 				fecha_alta = trab_excel.Fecha_de_Nacimiento;
                 			}
                 			try 
                 			{
                 				trabajador = insert into Nuevo_Empleado
                 				[
                 					Nombre.last_name=trab_excel.Nombre.getprefix(",").proper()
                 					Nombre.first_name=trab_excel.Nombre.getsuffix(", ").proper()
                 					Official_Email=trab_excel.Email
                 					M_vil=trab_excel.Movil
                 					Area_Profesional=trab_excel.Area
                 					DNI=trab_excel.DNI_NIE_Pasap
                 					Added_User=zoho.loginuser
                 					Especialidad1=trab_excel.Especialidad
                 					Fecha_de_Alta=fecha_alta
                 					Tipo_de_Contrato1=trab_excel.Tipo_Contrato
                 					Informaci_n_adicional=trab_excel.Centro_Trabajo
                 					C_digo_de_Operario=trab_excel.C_digo_Operario
                 					Fecha_de_Nacimiento=fecha_nacimiento
                 				];
                 			}
                 			catch (e)
                 			{
                 				info trab_excel.Nombre + "" + e;
                 			}
                 		}
                 	}
                 }
				 void TrabajadorExcel.PasarTrabajadoresOmportadosExcel()
                 {
                 }
			 }
		 }
