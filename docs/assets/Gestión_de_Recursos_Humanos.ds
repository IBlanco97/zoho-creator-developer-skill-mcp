			Entrada_de_Fecha_de_Alta as "Entrada de Fecha de Alta"
			{
				type =  form
				form = Nuevo_Empleado
				record event = on add or edit

				on user input of Fecha_de_Alta
				{
					actions 
					{
						custom deluge script
						(
											if(Fecha_de_Alta != null)
										{
											months = input.Fecha_de_Alta.monthsDiff(zoho.currentdate) % 12;
											years = input.Fecha_de_Alta.yearsDiff(zoho.currentdate);
											Antig_edad_ = "";
											Antig_edad_ = years + " años y ";
											Antig_edad_ = Antig_edad_ + months + " meses";
											input.Antig_edad = Antig_edad_;
										}
										else
										{
											input.Antig_edad = "";
										}
						)
					}
				}

			}
			Entrada_Fecha_Comienzo as "Entrada Fecha Comienzo"
			{
				type =  form
				form = Solicitud
				record event = on add or edit

				on user input of Fecha_de_comienzo
				{
					actions 
					{
						custom deluge script
						(
											if(Fecha_de_comienzo < zoho.currentdate.addDay(15))
										{
											alert "La solicitud debería hacerse con al menos 15 días de antelación.";
										}
										if(Fecha_de_comienzo < zoho.currentdate)
										{
											alert "Solo fechas posteriores a la actual.";
										}
						)
					}
				}

			}
