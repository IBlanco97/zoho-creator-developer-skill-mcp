			On_Send2 as "On Send"
			{
				type =  form
				form = Asignar_Desasignar_Trabajadores
				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											cliente = Nuevo_Cliente[ID == input.Cliente];
										trabajadores2 = thisapp.NuevoCliente.getAllTecnicos(cliente);
										// Por cada tecnicoID en la lista general de tecnicos
										for each  tecnicoID in input.Tecnicos
										{
											tecnico = Nuevo_Empleado[ID == tecnicoID];
											found = false;
											//Por cada cliente en la lista de clientes
											//ClienteID2 es un cliente en la lista actual de clientes del trabajador.
											for each  tecnicoID2 in trabajadores2
											{
												if(tecnicoID == tecnicoID2)
												{
													//SI es encontrado el cliente del trabajador en la lista global de clientes, terminar ciclo
													found = true;
													break;
												}
											}
											// Si el cliente global no fue encontrado entre los clientes del trabajador
											if(!found)
											{
												clientes = List();
												clientes.addAll(tecnico.Clientes_Habituales);
												// Agregar cliente nuevo a la lista de clientes del trabajador.
												clientes.add(input.Cliente);
												thisapp.NuevoEmpleado.SetClientes(tecnicoID,clientes);
											}
										}
										//desasignando
										// Ahora pasemos a buscar clientes que estan en la lista del trabajador pero que no estan en la lista introducida por el usuario,
										// o sea, que el usuario ha quitado de la lsita para desasignar al trabajador de ese cliente.
										// Por cada cliente en la lista de clientes del trabajador...
										for each  tecnicoID2 in trabajadores2
										{
											tecnico = Nuevo_Empleado[ID == tecnicoID2];
											found = false;
											// Por cada tecnicoID en el input de clientes dado por el usuario
											for each  tecnicoID in input.Tecnicos
											{
												if(tecnicoID == tecnicoID2)
												{
													// si el cliente en la lista de clientes del trabajador aparece tambien en la lista input:
													// cerrar ciclo y luego no se eliminara este cliente de los clientes del trabajador,
													// ya que el usuario ha querido que se mantenga
													found = true;
													break;
												}
											}
											// Por el contrario, si el cliente en la lista del trabajador no aparece en el input, significa que debe ser eliminado de la l
											if(!found)
											{
												clientes = List();
												for each  cli in tecnico.Clientes_Habituales
												{
													if(cli != input.Cliente)
													{
														clientes.add(cli);
													}
												}
												thisapp.NuevoEmpleado.SetClientes(tecnicoID2,clientes);
											}
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
			Registrar_Modificacion_As1 as "Registrar Modificacion Asignaciones"
			{
				type =  form
				form = Asignar_Desasignar_Trabajadores
				record event = on add or edit

				on user input of Clientes
				{
					actions 
					{
						custom deluge script
						(
											trabajador = Nuevo_Empleado[ID == input.Trabajador];
										clientesListaPrevia = thisapp.NuevoEmpleado.getClientesAll(trabajador);
										// Checar si se ha quitado algún cliente de la lista
										// Declaro found afuera para saber fuera del ciclo si hubo un cliente que no fue encontrado
										// El ciclo para al primer cliente que no aparezca
										found = false;
										for each  c2ID in clientesListaPrevia
										{
											c2 = Nuevo_Cliente[ID == c2ID];
											found = false;
											for each  c in input.Clientes
											{
												if(c == c2)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												// Primero Eliminar lista de requisitos
												listaRequisitos = Nueva_Lista_de_Requisitos[Trabajador == input.Trabajador && Cliente1 == c2];
												if(listaRequisitos.ID != null)
												{
													thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(listaRequisitos);
												}
												// Desligar Técnico de CLiente
												cliente = Nuevo_Cliente[ID == c2];
												if(cliente.ID != null)
												{
													esClienteHabitual = trabajador.Clientes_Habituales.contains(cliente.ID);
													thisapp.NuevoEmpleado.DesasignarCliente(trabajador,cliente,esClienteHabitual);
												}
												// Registrar fecha de fin en el registro de asignaciones
												asignacion = Asignacion_T_cnico_Cliente[Tecnico == input.Trabajador && Cliente = c2] sort by Added_Time desc;
												if(asignacion.ID != null)
												{
													fechaID = asignacion.Fechas.ID;
													fecha = Rango_Fechas_Asingacion[ID == fechaID];
													fecha.Fecha_de_Fin=zoho.currenttime;
													delete from Jornada[Asignacion_T_cnico_Cliente == asignacion.ID && Hora_de_Inicio > zoho.currenttime];
													asignacion.Estado="Finalizada";
													//Rectificar registro de calendario
													info "Redistribuyendo fechas de asignacion";
													thisapp.ProgramaAnualActividadTecnico.CrearAsignacionEnCalendario52Semanas(asignacion);
												}
											}
										}
										clientesListaPrevia = thisapp.NuevoEmpleado.getClientesAll(trabajador);
										// Checar si se ha añadido algún cliente
										for each  c in input.Clientes
										{
											found = false;
											for each  c2 in clientesListaPrevia
											{
												if(c == c2)
												{
													found = true;
													break;
												}
											}
											if(!found)
											{
												openUrl("#Form:Asignacion_T_cnico_Cliente?Tecnico=" + input.Trabajador + "&Cliente=" + c,"popup window");
												break;
											}
										}
						)
