                 	employees.add({"Nombre":"POVEDA MORAL, JOAQUIN","Tipo contrato":"AUTÓNOMO","Especialidad":"Electromecanico","Área":"INDUSTRIAL","Centro Trabajo":"PUNTUAL","Movil":"680963685","Email":"kini_00@hotmail.com","Antigüedad":"18-04-2024","Código Operario":"JPM","DNI / NIE/ PASAP.":"47272635E","Fecha de Nacimiento":"27-07-1984"});
                 	conteoPositivo = 0;
                 	contadorApellidoNoEncontrado = 0;
                 	for each  line in employees
                 	{
                 		try 
                 		{
                 			lastName = line.get("Nombre").getPrefixIgnoreCase(",").proper();
                 			primerapellido = lastName.getprefix(" ");
                 			segundoapellido = lastName.getsuffix(" ");
                 			firtsName = line.get("Nombre").getsuffix(", ");
                 			primerNombre = firtsName.getprefix(" ");
                 			segundoNombre = firtsName.getsuffix(" ");
                 			trabajador = Nuevo_Empleado[DNI == line.get("DNI / NIE/ PASAP.") || Nombre.last_name == lastName];
                 			if(trabajador.ID == null)
                 			{
                 				info "1. No encontrado: " + line;
                 				contadorApellidoNoEncontrado = contadorApellidoNoEncontrado + 1;
                 			}
                 			else
                 			{
                 				trabajador.C_digo_de_Operario=line.get("Código Operario");
                 				trabajador.Fecha_de_Alta=line.get("Antigüedad");
                 				trabajador.Fecha_de_Nacimiento=line.get("Fecha de Nacimiento");
                 				trabajador.Tipo_de_Contrato1=line.get("Tipo contrato");
                 				cliente = Nuevo_Cliente[Nombre_de_Cuenta == line.get("Centro Trabajo")];
                 				if(cliente.ID != null)
                 				{
                 					info "Cliente: " + cliente.Nombre_de_Cuenta;
                 					trabajador.Clientes_Habituales.add(cliente);
                 				}
                 				info "2. Encontrado: " + line;
                 				conteoPositivo = conteoPositivo + 1;
                 			}
                 		}
                 		catch (e)
                 		{
                 			info e;
                 		}
                 	}
                 	info "conteoPositivo: " + conteoPositivo;
                 	info "contadorApellidoNoENcontrado: " + contadorApellidoNoEncontrado;
                 }
				 void NuevoEmpleado.PasarDatosADireccion()
                 {
                 	for each  empleado in Nuevo_Empleado[ID != 0]
                 	{
                 		empleado.Address.address_line_1=empleado.Calle;
                 		empleado.Address.address_line_2=empleado.Comarca;
                 		empleado.Address.district_city=empleado.Ciudad;
                 		empleado.Address.state_province=empleado.Estado_provincia1;
                 		empleado.Address.postal_Code=empleado.C_digo_postal;
                 		empleado.Address.country=empleado.Pa_s;
                 	}
                 }
				 void NuevoEmpleado.SetClientes(int trabajadorID, list clientesNuevaLista)
                 {
                 	cliente = Nuevo_Cliente[ID == trabajadorID];
                 	//creando nuevas listas de requisitos para nuevos trabajadores
                 	for each  trabajadorNuevoID in clientesNuevaLista
                 	{
                 		trabajadorNuevo = Nuevo_Empleado[ID == trabajadorNuevoID];
                 		info "Trabajador Revisado: " + trabajadorNuevo.Nombre;
                 		found = false;
                 		for each  trabajadorCliID in cliente.Trabajadores_Habituales
                 		{
                 			if(trabajadorCliID == trabajadorNuevoID)
                 			{
                 				info "Nuevo Trabajador Encontrado.";
                 				found = true;
                 				break;
                 			}
                 		}
                 		if(!found)
                 		{
                 			thisapp.NuevaListaDeRequisitos.CrearNuevaListaRequisitos(trabajadorNuevoID,trabajadorNuevo.Nombre,cliente);
                 		}
                 	}
                 	//eliminando listas de requisitos de trabajadores que fueron eliminados
                 	for each  lrID in cliente.Lista_de_Requisitos
                 	{
                 		if(lrID != cliente.Lista_Documentos_Requeridos_Empresa)
                 		{
                 			lr = Nueva_Lista_de_Requisitos[ID == lrID];
                 			found = false;
                 			for each  trabajadorNuevoID in clientesNuevaLista
                 			{
                 				if(lr.Trabajador == trabajadorNuevoID)
                 				{
                 					found = true;
                 					break;
                 				}
                 			}
                 			if(!found)
                 			{
                 				thisapp.NuevaListaDeRequisitos.EliminarListaDeRequisitos(lr);
                 			}
                 		}
                 	}
                 	//trabajador = Nuevo_Empleado[ID == TrabajadorID];
                 	cliente.Trabajadores_Habituales=clientesNuevaLista;
                 }
				 void NuevoEmpleado.SiguienteEmpleado(int empleadoID)
                 {
                 	empleado = Nuevo_Empleado[ID == empleadoID];
                 	nextEmpl = null;
                 	stopInNextIteration = false;
                 	for each  empl in Nuevo_Empleado[ID != 0] sort by C_digo_de_Operario asc
                 	{
                 		if(stopInNextIteration)
                 		{
                 			nextEmpl = empl.ID;
                 			break;
                 		}
                 		if(!stopInNextIteration && empl.ID == empleadoID)
                 		{
                 			stopInNextIteration = true;
                 		}
                 	}
                 	openUrl("#Page:Documentaci_n_Empleado?Empleado=" + nextEmpl,"same window");
                 }
				 void NuevoEmpleado.SolicitarConfirmacionLenturaManualBienvenida(Nuevo_Empleado empleado)
                 {
                 	confirmacion = insert into Confirmaciones_de_Entrega
                 	[
                 		Added_User=zoho.loginuser
                 		Estado="Sin Respuesta"
                 		Empleado=empleado.ID
                 		Mensaje="Indique \"Confirmar\" cuando haya compleatado la lectura de la documentación de bienvenida."
                 		Tipo="Lectura Documentación Bienvenida"
                 	];
                 	title_ = "Confirme recibo y lectura de documentación";
                 	message_ = "Confirme que ha recinido y leído la documentación de bienvenida. Diríjase al apartado Confirmaciones de Entrega.";
                 	not = zoho.pushNotification(empleado.Official_Email,title_,message_,"Confirmaciones_de_Entrega_Report",confirmacion);
                 }
