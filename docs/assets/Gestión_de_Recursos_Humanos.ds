						custom deluge script
						(
											tecnico = Nuevo_Empleado[ID == input.Tecnico];
										cliente = Nuevo_Cliente[ID == input.Cliente];
										sendWhatsApp = input.Vias_extra_de_notificacion.contains("WhatsApp");
										sendEmail = input.Vias_extra_de_notificacion.contains("Correo Electrónico");
