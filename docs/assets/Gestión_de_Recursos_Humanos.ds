				 void RequisitoDoc.defaultFunction()
                 {
                 	openUrl("#Form:Subir_Documento","Popup window");
                 }
				 string RequisitoDoc.EstadoListaSegunRequisitos(Nueva_Lista_de_Requisitos listaReq)
                 {
                 	status = 5;
                 	result = thisapp.FuncionesEstaticas.GetEstadosRequisitos(status);
                 	for each  req in listaReq.Lista_Requisitos_Documentaci_n
                 	{
                 		indiceEstado = thisapp.FuncionesEstaticas.GetIndiceEstadoRequisito(thisapp.NuevoRequisitoDoc.GetEstado(req));
                 		if(indiceEstado == 4)
                 		{
                 			if(status > 4)
                 			{
                 				status = 4;
                 			}
                 		}
                 		if(indiceEstado == 3)
                 		{
                 			if(status > 3)
                 			{
                 				status = 3;
                 			}
                 		}
                 		if(indiceEstado == 2)
                 		{
                 			if(status > 2)
                 			{
                 				status = 2;
                 			}
                 		}
                 		if(indiceEstado == 1)
                 		{
                 			if(status > 1)
                 			{
                 				status = 1;
                 			}
                 		}
                 	}
                 	result = thisapp.FuncionesEstaticas.GetEstadosRequisitos(status);
                 	return result;
                 }
				 string RequisitoDoc.NombreAutomaticoRequisitos(int empresaID, int trabajadorID, int clienteID, int plantillaID)
                 {
                 	nombre = "";
                 	for each  empresa in Empresa1[ID == empresaID]
                 	{
                 		nombre = nombre + thisapp.NuevoRequisitoDoc.ThreeLeftCeros(empresa.N_Orden,2) + "_" + empresa.Nombre + "_";
                 	}
                 	for each  cliente in Nuevo_Cliente[ID == clienteID]
                 	{
                 		nombre = nombre + thisapp.NuevoRequisitoDoc.ThreeLeftCeros(cliente.N_Orden,3) + "_" + cliente.Nombre_de_Cuenta + "_";
                 	}
                 	for each  trabajador in Nuevo_Empleado[ID == trabajadorID]
                 	{
                 		nombre = nombre + thisapp.NuevoRequisitoDoc.ThreeLeftCeros(trabajador.N_Orden,3) + "_" + trabajador.Nombre.last_name + " " + trabajador.Nombre.first_name + "_";
                 	}
                 	for each  plantilla in Plantilla[ID == plantillaID]
                 	{
                 		nombre = nombre + thisapp.NuevoRequisitoDoc.ThreeLeftCeros(plantilla.N_Orden_Plantilla,3) + "_" + plantilla.Nombre_de_la_plantilla;
                 	}
                 	return nombre;
                 }
