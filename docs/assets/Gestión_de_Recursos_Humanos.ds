		default list Asignacion_T_cnico_Cliente_Report
		{
			displayName = "Asignacion Técnico Cliente Report"
			show all rows from Asignacion_T_cnico_Cliente    
			(
				Etiqueta
				Tecnico as "Técnico"
				Cliente
				Fecha_de_Inicio as "Fecha de Inicio"
				Fecha_de_Fin as "Fecha de Fin"
				Estado
				Observaciones
				Enlace_de_regreso as "Enlace de regreso"
				Status
				Tipo_de_Asignacion as "Tipo de Asignación"
				Cliente_habitual as "Cliente Habitual"
				Fechas
				(
					field = Fechas.Fecha_de_Comienzo1 + " " + Fechas.Fecha_de_Fin
				)
				Dias_Laborales as "Días Laborales"
				Vias_extra_de_notificacion as "Notificacar a personal de RRHH vía:"
			)
			group by
			(
				Estado custom
			)
			sort by
			(
				Fecha_de_Inicio ascending
				Tecnico ascending
				Cliente ascending
			)
		}
