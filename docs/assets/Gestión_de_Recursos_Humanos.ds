			script
			{
				/* Escriba la lógica de la secuencia de comandos aquí. Puede asignar valores a las variables de página que ha creado en la pestaña anterior. Ingrese “input” para enumerar las variables de página creadas. */
				empleado = Nuevo_Empleado[ID == input.Empleado];
				input.Nombre = empleado.Nombre;
				input.Documentos = empleado.Documentos;
				input.Clientes = List();
				for each  clienteID in empleado.Clientes_Habituales
				{
					cliente = Nuevo_Cliente[ID == clienteID];
					input.Clientes = cliente.Nombre_de_Cuenta;
				}
				if(input.Clientes.isEmpty())
				{
					input.Clientes = null;
				}
			}
		}
