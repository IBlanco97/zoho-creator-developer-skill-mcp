			Run_Scripts_While_Editing2 as "Run Scripts - While Editing a Record"
			{
				type =  form
				form = Add_Candidate_Details
				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Blood_Group:ui.add(thisapp.DropdownList.BloodGroupList());
										Blood_Group.select(input.Blood_Group);
										ApplicationDetails = Job_Application[ID == input.Reference_No];
										input.BasicInfo = "<b>Basic Info</b><div><br></div><div>First Name :" + ApplicationDetails.Name.first_name + "</div><div><br></div><div>Last Name : " + ApplicationDetails.Name.last_name + "</div><div><br></div><div>Gender : " + ApplicationDetails.Gender + "</div><div><br></div><div>Mobile Number : " + ApplicationDetails.Mobile_Number1 + "</div><div><br></div><div>Present Address : " + ApplicationDetails.Present_Address1 + "</div><div><br></div><div><br></div><div><br></div>";
										CandidateID = Job_Application[Personal_Email == zoho.loginuserid && Status == "Offer Letter Sent"].ID;
										if(Add_Candidate_Details[Reference_No == CandidateID && Status == "Offer Letter Sent"].count() != 0)
										{
											if(zoho.loginuserid != zoho.adminuserid)
											{
												hide plain;
												hide Offer_Expires_On;
												hide CTC;
												hide Designation;
												hide Reference_No;
												hide Date_of_Joining;
												hide Status;
												hide Declined_By;
												hide Reason_for_Declination;
											}
										}
										hide Education_Subform.Employee_ID;
										hide Work_Experience_Subform.Employee_ID;
						)
					}
				}

			}
			Run_Scripts_While_Editing3 as "Run Scripts - While Editing a Record"
			{
				type =  form
				form = Add_Candidate_Details
				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											CandidateID = Job_Application[Personal_Email == zoho.loginuserid && Status == "Offer Letter Sent"].ID;
										if(Add_Candidate_Details[Reference_No == CandidateID && Status == "Offer Letter Sent"].count() != 0)
										{
											if(zoho.loginuserid != zoho.adminuserid)
											{
												countVar = 0;
												for each  Rec in input.Education_Subform
												{
													countVar = countVar + 1;
												}
												if(input.Photo == null || input.Marital_Status == null || input.Blood_Group == null || input.Work_Experience == null || input.Permanent_Address1.isEmpty() || countVar == 0)
												{
													alert "Please enter value for all the fields!";
													cancel submit;
												}
												else if(input.Work_Experience == "Experienced")
												{
													countVar = 0;
													for each  ExperienceRec in input.Work_Experience_Subform
													{
														countVar = countVar + 1;
													}
													if(countVar == 0)
													{
														alert "Please enter value for all the fields!";
														cancel submit;
													}
												}
												ApplicantEmail = Job_Application[ID == input.Reference_No].Personal_Email;
											}
										}
						)
					}
				}

			}
