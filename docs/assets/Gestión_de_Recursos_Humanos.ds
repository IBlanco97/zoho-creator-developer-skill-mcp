			Env_o_de_Formulario9 as "Envío de Formulario"
			{
				type =  form
				form = Subir_Multiples_Documentos_Otro
				record event = on add
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  mID in input.Modelos_Trabajador
										{
											info "X";
											m = Plantilla[ID == mID];
											//d = input.Documentos.get(index);
											cliente = null;
											empresa = null;
											trabajador = input.Empleado;
											if(m.CLIENTE == "SI")
											{
												if(input.Cliente != null)
												{
													cliente = input.Cliente;
												}
											}
											if(m.EMPRESA1 == "SI")
											{
												empresa = Empresa1[ID != 0];
											}
											fechaCaducidad = zoho.currentdate.addMonth(1);
											url = "#Form:Subir_Documento?";
											url = url + "Plantilla=" + m;
											url = url + "&TRABAJADOR=" + trabajador;
											url = url + "&EMPRESA=" + empresa;
											url = url + "&CLIENTE=" + cliente;
											openUrl(url,"popup window");
											/*documento = insert into Subir_Documento
											[
												Fecha_validez_documento=zoho.currentdate
												Fecha_creaci_n_documento=zoho.currentdate
												Plantilla=m
												Documento=null
												Numero_Documento=N_doc
												Fecha_caducidad_documento=fechaCaducidad
												Estado="Actualizado"
												Nombre_Documento="Prueba "
												EMPRESA=empresa
												TRABAJADOR=trabajador
												Fecha_creaci_n_documento=zoho.currentdate
												Fecha_validez_documento=fechaCaducidad
												Added_User=zoho.loginuser
											];
											*/
										}
						)
					}
				}

			}
			Al_Enviar as "Al Enviar"
			{
				type =  form
				form = Subir_Multiples_Documentos_Otro
				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											index_ = 0;
										doc = Subir_Documento[ID != 0] sort by Numero_Documento desc;
										N_doc = doc.Numero_Documento;
										for each  d in input.Documentos_Trabajador
										{
											N_doc = N_doc + 1;
											mID = input.Modelos_Trabajador.get(index_);
											m = Plantilla[ID == mID];
											//d = input.Documentos.get(index);
											cliente = input.Cliente;
											empresa = Empresa1[ID != 0];
											trabajador = input.Empleado;
											if(m.CLIENTE == "NO")
											{
												cliente = null;
											}
											if(m.EMPRESA1 == "NO")
											{
												empresa = null;
											}
											fechaCaducidad = zoho.currentdate.addMonth(1);
											url = "#Form:Subir_Documento?Plantilla=" + m.ID + "&TRABAJADOR=" + trabajador;
											//url = url + "&EMPRESA=" + empresa;
											//url = url + "&CLIENTE=" + cliente;
											//openUrl( url, "new window");	
											nombre = "Prueba " + N_doc;
											documento = insert into Subir_Documento
											[
												Fecha_validez_documento=zoho.currentdate
												Fecha_creaci_n_documento=zoho.currentdate
												Plantilla=m
												Documento=d
												Numero_Documento=N_doc
												Fecha_caducidad_documento=fechaCaducidad
												Estado="Actualizado"
												Nombre_Documento=nombre
												EMPRESA=empresa
												TRABAJADOR=input.Empleado
												Fecha_creaci_n_documento=zoho.currentdate
												Fecha_validez_documento=fechaCaducidad
												Added_User=zoho.loginuser
											];
											index_ = index_ + 1;
										}
										for each  d in input.Documentos_de_Aut_nomo
										{
											N_doc = N_doc + 1;
											mID = input.Modelos_Trabajador.get(index_);
											m = Plantilla[ID == mID];
											//d = input.Documentos.get(index);
											cliente = input.Cliente;
											empresa = Empresa1[ID != 0];
											trabajador = input.Empleado;
											if(m.CLIENTE == "NO")
											{
												cliente = null;
											}
											if(m.EMPRESA1 == "NO")
											{
												empresa = null;
											}
											fechaCaducidad = zoho.currentdate.addMonth(1);
											url = "#Form:Subir_Documento?Plantilla=" + m.ID + "&TRABAJADOR=" + trabajador;
											//url = url + "&EMPRESA=" + empresa;
											//url = url + "&CLIENTE=" + cliente;
											//openUrl( url, "new window");	
											nombre = "Prueba " + N_doc;
											documento = insert into Subir_Documento
											[
												Fecha_validez_documento=zoho.currentdate
												Fecha_creaci_n_documento=zoho.currentdate
												Plantilla=m
												Documento=d
												Numero_Documento=N_doc
												Fecha_caducidad_documento=fechaCaducidad
												Estado="Actualizado"
												Nombre_Documento=nombre
												EMPRESA=empresa
												TRABAJADOR=input.Empleado
												Fecha_creaci_n_documento=zoho.currentdate
												Fecha_validez_documento=fechaCaducidad
												Added_User=zoho.loginuser
											];
											index_ = index_ + 1;
										}
						)
					}
				}

			}
