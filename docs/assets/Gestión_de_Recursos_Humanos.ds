			Env_o_de_Formulario7 as "Envío de Formulario"
			{
				type =  form
				form = Responder_Solicitud_EPI
				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											solicitud = Solicitud_de_EPIs_Herramientas[ID == input.Solicitud_a_la_que_se_responde1];
										thisapp.NuevoEPIRopaHerramienta.NotificarCambioSolicitudEPI(solicitud,solicitud.Aprobado);
						)
					}
					actions 
					{
						custom deluge script
						(
											solicitud = Solicitud_de_EPIs_Herramientas[ID == input.Solicitud_a_la_que_se_responde1.ID];
										if(solicitud.Aprobado != input.Respuesta)
										{
											estadoPrevio = solicitud.Aprobado;
											solicitud.Aprobado=input.Respuesta;
											solicitud.Historia_de_la_Solicitud="" + solicitud.Historia_de_la_Solicitud + "\n" + input.Respuesta + " - " + zoho.currenttime;
											thisapp.NuevoEPIRopaHerramienta.NotificarCambioSolicitudEPI(solicitud,estadoPrevio);
										}
										if(input.Fecha_Prevista_de_Entrega != null)
										{
											solicitud.Fecha_Prevista_de_Entrega=input.Fecha_Prevista_de_Entrega;
										}
										if(input.Nota_Sobre_Respuesta_a_la_Soilicitud != "" && input.Nota_Sobre_Respuesta_a_la_Soilicitud != null)
										{
											solicitud.Nota_Sobre_Respuesta_a_la_Soilicitud=input.Nota_Sobre_Respuesta_a_la_Soilicitud;
										}
										if(input.Equipo_Asignado != "" && input.Equipo_Asignado != null)
										{
											solicitud.Equipo_Asignado=input.Equipo_Asignado;
										}
						)
					}
					actions 
					{
						custom deluge script
						(
											openUrl("#Script:page.refresh","same window");
						)
					}
				}

			}
