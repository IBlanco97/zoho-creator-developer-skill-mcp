# Zoho OAuth 2.0 credentials
# Obtain from https://api-console.zoho.com/ -> Self Client
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Creator app info
ZOHO_OWNER_ID=your_zoho_account_owner_name
ZOHO_APP_LINK_NAME=your_app_link_name

# Optional: override the default accounts domain (default: accounts.zoho.com)
# For EU: accounts.zoho.eu  |  For AU: accounts.zoho.com.au  |  For IN: accounts.zoho.in
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
